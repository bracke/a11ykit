with "../i18n/i18n.gpr";

library project A11y_Messages is

   for Library_Name use "A11y_Messages";
   for Source_Dirs use ("../messages/src", "../messages/config");
   for Object_Dir use "obj/messages";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib/messages";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

end A11y_Messages;
