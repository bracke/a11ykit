project A11ykit_Proof is

   for Languages use ("Ada");
   for Source_Dirs use ("src/", "proof/src");
   for Source_Files use
     ("a11y.ads",
      "a11y.adb",
      "a11y-actions.ads",
      "a11y-actions.adb",
      "a11y-actions-classification.ads",
      "a11y-actions-classification.adb",
      "a11y-backends.ads",
