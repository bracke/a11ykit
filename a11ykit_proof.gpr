      "a11y-diagnostics-classification.ads",
      "a11y-diagnostics-classification.adb",
      "a11y-dispatchers.ads",
      "a11y-dispatchers-classification.ads",
      "a11y-dispatchers-classification.adb",
      "a11y-documents.ads",
      "a11y-documents.adb",
      "a11y-documents-classification.ads",
      "a11y-documents-classification.adb",
      "a11y-events.ads",
      "a11y-events.adb",
      "a11y-events-classification.ads",
      "a11y-events-classification.adb",
      "a11y-event_queues.ads",
      "a11y-event_queues.adb",
      "a11y-event_queues-classification.ads",
      "a11y-event_queues-classification.adb",
      "a11y-event_subscriptions.ads",
      "a11y-event_subscriptions.adb",
      "a11y-event_subscriptions-classification.ads",
      "a11y-event_subscriptions-classification.adb",
      "a11y-node_ids.ads",
      "a11y-node_ids.adb",
      "a11y-nodes.ads",
      "a11y-nodes.adb",
      "a11y-nodes-classification.ads",
      "a11y-nodes-classification.adb",
      "a11y-platforms.ads",
      "a11y-platforms-classification.ads",
      "a11y-platforms-classification.adb",
      "a11y-properties.ads",
      "a11y-properties.adb",
      "a11y-properties-classification.ads",
      "a11y-properties-classification.adb",
      "a11y-results.ads",
      "a11y-results.adb",
      "a11y-results-classification.ads",
      "a11y-results-classification.adb",
      "a11y-relations.ads",
      "a11y-relations.adb",
      "a11y-relations-classification.ads",
      "a11y-relations-classification.adb",
      "a11y-resource_limits.ads",
      "a11y-resource_limits.adb",
      "a11y-roles.ads",
      "a11y-roles.adb",
      "a11y-selection.ads",
      "a11y-selection.adb",
      "a11y-selection-classification.ads",
      "a11y-selection-classification.adb",
      "a11y-tables.ads",
      "a11y-tables.adb",
      "a11y-tables-classification.ads",
      "a11y-tables-classification.adb",
      "a11y-states.ads",
      "a11y-states.adb",
      "a11y-text.ads",
      "a11y-text.adb",
      "a11y-text-classification.ads",
      "a11y-text-classification.adb",
      "a11y-trees.ads",
      "a11y-trees.adb",
      "a11y-trees-classification.ads",
      "a11y-trees-classification.adb",
      "a11y-geometry.ads",
      "a11y-geometry.adb",
      "a11y-images.ads",
      "a11y-images.adb",
      "a11y-images-classification.ads",
      "a11y-images-classification.adb",
      "a11y-live_regions.ads",
      "a11y-live_regions.adb",
      "a11y-live_regions-classification.ads",
      "a11y-live_regions-classification.adb",
      "a11y-native_callbacks.ads",
      "a11y-native_callbacks.adb",
      "a11y-native_callbacks-classification.ads",
      "a11y-native_callbacks-classification.adb",
      "a11y-native_boundary_calls.ads",
      "a11y-native_boundary_calls-classification.ads",
      "a11y-native_boundary_calls-classification.adb",
      "a11y-native_identity.ads",
      "a11y-native_identity.adb",
      "a11y-native_identity-classification.ads",
      "a11y-native_identity-classification.adb",
      "a11y-native_object_caches.ads",
      "a11y-native_object_caches.adb",
      "a11y-native_object_caches-classification.ads",
      "a11y-native_object_caches-classification.adb",
      "a11y-native_runtimes.ads",
      "a11y-native_runtimes-classification.ads",
      "a11y-native_runtimes-classification.adb",
      "a11y-values.ads",
      "a11y-values.adb",
      "a11y-values-classification.ads",
      "a11y-values-classification.adb",
      "a11y-windows.ads",
      "a11y-windows.adb",
      "a11y-windows-classification.ads",
      "a11y-windows-classification.adb",
      "a11y_proof_harness.adb");
   for Object_Dir use "obj/proof";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O0", "-g", "-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--mode=prove",
         "--level=1",
         "--report=statistics",
         "--warnings=continue",
         "--no-subprojects");
   end Prove;

end A11ykit_Proof;
