         if Value = "automated_native_qualification_complete" then
            Saw_Automated_Native_Platform_Evidence_Gate := True;
         elsif Value = "pending_public_client_traversal"
           or else Value = "pending"
         then
            Saw_Public_Client_Platform_Evidence_Gate := True;
         end if;
      end Check_Platform_Evidence_Gate_Status;

