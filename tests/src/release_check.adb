      procedure Count_Platform (Value : String) is
      begin
         Seen := Seen + 1;
         if Value = "Linux" then
            Saw_Linux := True;
         elsif Value = "Windows" then
            Saw_Windows := True;
         elsif Value = "macOS" then
            Saw_MacOS := True;
         end if;
      end Count_Platform;

      procedure Count_API (Value : String) is
      begin
         if Value = "AT-SPI2" then
            Saw_ATSPI := True;
         elsif Value = "UI Automation" then
            Saw_UIA := True;
         elsif Value = "NSAccessibility" then
            Saw_NSAX := True;
         end if;
      end Count_API;

