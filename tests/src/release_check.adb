   if Ada.Command_Line.Argument_Count /= 0 then
      Ada.Text_IO.Put_Line ("usage: release_check");
      Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Failure);
      return;
   end if;

   Ensure_Repository_Root;

   Check_Declarations
     (A11y.Conformance.Null_Backend_Declarations,
      "Null",
      Expect_All => True);
   Check_Declarations
     (A11y.Conformance.Disabled_Backend_Declarations,
      "Disabled",
      Expect_All => True,
      Expected_Level => A11y.Conformance.Unsupported);
   Check_Declarations
     (A11y.Conformance.Linux_ATSPI_Declarations,
      "AT-SPI",
      Expect_All => False);
   Check_Declarations
     (A11y.Conformance.Windows_UIA_Declarations,
      "UIA",
      Expect_All => False);
   Check_Declarations
     (A11y.Conformance.MacOS_NSAccessibility_Declarations,
      "NSAccessibility",
      Expect_All => False);
   Check_All_Declarations;
   Check_Capability_Report_JSON;
   Check_Release_Qualification_JSON;
   Check_Documentation;
   Check_Fixture_Report_JSON;
   Check_Fixture_Application_JSON;
   Check_Native_Observation_JSON;
   Check_Native_Client_JSON;
   Check_Public_Surface_Native_Leaks;
   Check_Alire_And_Test_Projects;
   Check_No_Non_Ada_Tooling;

   Check
     (File_Contains
        ("src/a11y-sessions.adb",
         "Contract_Snapshot_Safely")
      and then File_Contains
        ("tests/src/a11y_session_projection_tests.adb",
         "session exposure projection hides invalid provider contracts")
      and then File_Contains
        ("docs/architecture.md",
         "Session exposure projection also uses that contract snapshot"),
      "session exposure projection no longer enforces provider contracts centrally");

   Check
     (File_Contains
        ("src/a11y-event_queues.ads",
         "Destroyed_Node_Set")
      and then File_Contains
        ("src/a11y-event_queues.adb",
         "Is_Destroyed")
      and then File_Contains
        ("tests/src/a11y_event_queue_tests.adb",
         "event queue rejects duplicate node-destroyed events")
      and then File_Contains
        ("tests/src/a11y_event_queue_tests.adb",
         "event queue rejects events after node-destroyed")
      and then File_Contains
        ("docs/events.md",
         "bounded destroyed-node ledger"),
      "event queue no longer enforces Node_Destroyed final-event ordering");

   Check
     (File_Contains
        ("src/a11y-event_subscriptions.ads",
         "Destroyed_Node_Set")
      and then File_Contains
        ("src/a11y-event_subscriptions.adb",
         "Is_Destroyed")
      and then File_Contains
        ("tests/src/a11y_event_subscription_tests.adb",
         "event subscriptions reject duplicate node-destroyed delivery")
      and then File_Contains
        ("tests/src/a11y_event_subscription_tests.adb",
         "event subscriptions reject delivery after node-destroyed")
      and then File_Contains
        ("docs/events.md",
         "Subscription fan-out keeps")
      and then File_Contains
        ("docs/architecture.md",
         "Subscription fan-out also rejects duplicate `Node_Destroyed`"),
      "event subscriptions no longer enforce Node_Destroyed final-event ordering");

   Check
     (Project_Tools.JSON.Field_Value
        ("{""schema"":""org.a11y.release_check.v1""}", "schema")
      = "org.a11y.release_check.v1",
      "project_tools JSON helper is unavailable to release tooling");

   if Failures = 0 then
      Ada.Text_IO.Put_Line ("release_check passed");
      Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Success);
   else
      Ada.Text_IO.Put_Line
        ("release_check failed:" & Natural'Image (Failures));
      Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Failure);
   end if;
exception
   when others =>
      Ada.Command_Line.Set_Exit_Status (Ada.Command_Line.Failure);
end Release_Check;
