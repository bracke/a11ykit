            function Has_Native_Capability_Row (Value : String) return Boolean is
               Prefix : constant String :=
                 """feature"": """ & Value & """, ""backend"": """;

               function Has_Row
                 (Backend : String;
                  Support : String)
                  return Boolean
               is
               begin
                  return Ada.Strings.Fixed.Index
                    (Capability_Report,
                     Prefix
                     & Backend
                     & """, ""support"": """
                     & Support
                     & """") /= 0;
               end Has_Row;
