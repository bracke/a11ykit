   procedure Check_Documentation is
      Report : constant String := A11y_Documentation_Report.JSON;
      Document_Array : constant String :=
        Project_Tools.JSON.Field_Value (Report, "documents");
      Seen : Natural := 0;
      Present_Count : Natural := 0;
      Complete_Count : Natural := 0;
      Marker_1_Count : Natural := 0;
      Marker_2_Count : Natural := 0;
      Marker_3_Count : Natural := 0;
      Saw_Readme : Boolean := False;
      Saw_Architecture : Boolean := False;
      Saw_Quickstart : Boolean := False;
      Saw_Security : Boolean := False;
      Saw_Testing : Boolean := False;
      Saw_Conformance : Boolean := False;

      procedure Count_Path (Value : String) is
      begin
         Seen := Seen + 1;
         if Value = "README.md" then
            Saw_Readme := True;
         elsif Value = "docs/architecture.md" then
            Saw_Architecture := True;
         elsif Value = "docs/quickstart.md" then
            Saw_Quickstart := True;
         elsif Value = "docs/security.md" then
            Saw_Security := True;
         elsif Value = "docs/testing.md" then
            Saw_Testing := True;
         elsif Value = "docs/conformance.md" then
            Saw_Conformance := True;
         end if;
      end Count_Path;

      procedure Count_Marker_1 (Value : String) is
      begin
         if Value'Length > 0 then
            Marker_1_Count := Marker_1_Count + 1;
         end if;
      end Count_Marker_1;

      procedure Count_Marker_2 (Value : String) is
      begin
         if Value'Length > 0 then
            Marker_2_Count := Marker_2_Count + 1;
         end if;
      end Count_Marker_2;

      procedure Count_Marker_3 (Value : String) is
      begin
         if Value'Length > 0 then
            Marker_3_Count := Marker_3_Count + 1;
         end if;
      end Count_Marker_3;

      procedure Count_Present (Value : String) is
      begin
         if Value = "true" then
            Present_Count := Present_Count + 1;
         end if;
      end Count_Present;

      procedure Count_Complete (Value : String) is
      begin
         if Value = "true" then
            Complete_Count := Complete_Count + 1;
         end if;
      end Count_Complete;
   begin
      Check
        (Project_Tools.JSON.Field_Value (Report, "schema")
         = A11y_Documentation_Report.Schema,
         "documentation report has an unexpected schema");
      Check
        (not Has_Raw_Control_In_JSON_String (Report),
         "documentation JSON contains raw string control characters");
      Check
        (Document_Array'Length > 0,
         "documentation report lacks documents array");
      Check
        (Project_Tools.JSON.Field_Value (Report, "document_count")
         = Ada.Strings.Fixed.Trim
           (Natural'Image (A11y_Documentation_Report.Document_Count),
            Ada.Strings.Left),
         "documentation report top-level document count is stale");
      Check
        (Project_Tools.JSON.Field_Value (Report, "complete") = "true",
         "documentation report top-level complete marker is false");

      Project_Tools.JSON.For_Each_Array_Object_Field
        (Document_Array, "path", Count_Path'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Document_Array, "marker_1", Count_Marker_1'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Document_Array, "marker_2", Count_Marker_2'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Document_Array, "marker_3", Count_Marker_3'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Document_Array, "present", Count_Present'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Document_Array, "complete", Count_Complete'Access);

      Check
        (Seen = A11y_Documentation_Report.Document_Count,
         "documentation report document count is stale");
      Check
        (Marker_1_Count = Seen
         and then Marker_2_Count = Seen
         and then Marker_3_Count = Seen,
         "documentation report has missing marker fields");
      Check
        (Present_Count = Seen,
         "documentation report has missing required files");
      Check
        (Complete_Count = Seen,
         "documentation report has missing required markers");
      Check
        (A11y_Documentation_Report.All_Required_Content_Present,
         "documentation report package reports missing required content");
      Check
        (File_Contains
           ("tests/src/a11y_documentation_report.adb",
            "Repository_Path")
         and then File_Contains
           ("tests/src/a11y_documentation_report.adb",
            "../")
         and then File_Contains
           ("tests/src/a11y_documentation_report.adb",
            "Actual_Path"),
         "documentation report no longer resolves repository paths from the child crate");
      Check
        (Saw_Readme
         and then Saw_Architecture
         and then Saw_Quickstart
         and then Saw_Security
         and then Saw_Testing
         and then Saw_Conformance,
         "documentation report omits a required document");
   end Check_Documentation;

   procedure Check_Fixture_Report_JSON is
      Report : constant String := A11y_Fixture_Report.JSON;
      Node_Array : constant String :=
        Project_Tools.JSON.Field_Value (Report, "nodes");
      Script_Array : constant String :=
        Project_Tools.JSON.Field_Value (Report, "script");
      Node_Role_Count : Natural := 0;
      Command_Count : Natural := 0;
      Protected_Count : Natural := 0;
      Saw_Application : Boolean := False;
      Saw_Window : Boolean := False;
      Saw_Button : Boolean := False;
      Saw_Password : Boolean := False;
      Saw_Image : Boolean := False;
      Saw_Status : Boolean := False;
      Saw_Alert : Boolean := False;
      Saw_Document : Boolean := False;
      Saw_Modal_Surface : Boolean := False;
      Saw_Popup_Surface : Boolean := False;
      Saw_Shutdown : Boolean := False;
      Saw_Destroy : Boolean := False;
      Saw_Relation : Boolean := False;
      Saw_Announcement : Boolean := False;
      Saw_Set_Text : Boolean := False;

      procedure Count_Role (Value : String) is
      begin
         Node_Role_Count := Node_Role_Count + 1;
         if Value = "application" then
            Saw_Application := True;
         elsif Value = "window" then
            Saw_Window := True;
         elsif Value = "button" then
            Saw_Button := True;
         elsif Value = "password-field" then
            Saw_Password := True;
         elsif Value = "image" then
            Saw_Image := True;
         elsif Value = "status" then
            Saw_Status := True;
         elsif Value = "alert" then
            Saw_Alert := True;
         elsif Value = "document" then
            Saw_Document := True;
         end if;
      end Count_Role;

      procedure Count_Protected (Value : String) is
      begin
         if Value = "true" then
            Protected_Count := Protected_Count + 1;
         end if;
      end Count_Protected;

      procedure Count_Surface (Value : String) is
      begin
         if Value = "modal-dialog" then
            Saw_Modal_Surface := True;
         elsif Value = "popup" then
            Saw_Popup_Surface := True;
         end if;
      end Count_Surface;

      procedure Count_Command (Value : String) is
      begin
         Command_Count := Command_Count + 1;
         if Value = "SHUTDOWN" then
            Saw_Shutdown := True;
         elsif Value = "DESTROY_NODE" then
            Saw_Destroy := True;
         elsif Value = "CHANGE_RELATION" then
            Saw_Relation := True;
         elsif Value = "ANNOUNCE" then
            Saw_Announcement := True;
         elsif Value = "SET_TEXT" then
            Saw_Set_Text := True;
         end if;
      end Count_Command;
   begin
      Check
        (Project_Tools.JSON.Field_Value (Report, "schema")
         = A11y_Fixture_Report.Schema,
         "fixture JSON report has an unexpected schema");
      Check
        (not Has_Raw_Control_In_JSON_String (Report),
         "fixture JSON contains raw string control characters");
      Check
        (Project_Tools.JSON.Field_Value (Report, "complete") = "true",
         "fixture JSON report is not complete");
      Check (Node_Array'Length > 0, "fixture JSON report lacks nodes array");
      Check
        (Script_Array'Length > 0,
         "fixture JSON report lacks script array");

      Project_Tools.JSON.For_Each_Array_Object_Field
        (Node_Array, "role", Count_Role'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Node_Array, "protected_text", Count_Protected'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Node_Array, "surface_kind", Count_Surface'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Script_Array, "command", Count_Command'Access);

      Check
        (Node_Role_Count = A11y_Fixture_Report.Node_Count,
         "fixture JSON node count is stale");
      Check
        (Command_Count = A11y_Fixture_Report.Command_Count,
         "fixture JSON command count is stale");
      Check
        (Protected_Count = 1,
         "fixture JSON protected-text sentinel is missing or duplicated");
      Check
        (Saw_Application
         and then Saw_Window
         and then Saw_Button
         and then Saw_Password
         and then Saw_Image
         and then Saw_Status
         and then Saw_Alert
         and then Saw_Document,
         "fixture JSON omits required role coverage");
      Check
        (Saw_Modal_Surface and then Saw_Popup_Surface,
         "fixture JSON omits required surface coverage");
      Check
        (Saw_Shutdown
         and then Saw_Destroy
         and then Saw_Relation
         and then Saw_Announcement
         and then Saw_Set_Text,
         "fixture JSON omits required scripted commands");
      Check
        (A11y_Fixture_Report.Complete,
         "fixture report package reports incomplete fixture coverage");
   end Check_Fixture_Report_JSON;

   procedure Check_Fixture_Application_JSON is
      Report : constant String := A11y_Fixture_Application.JSON;
      ATSPI_Report : constant String :=
        A11y_Fixture_Application.ATSPi_Startup_JSON
          ("not-an-address", 1000);
      ATSPI_Unavailable_Report : constant String :=
        A11y_Fixture_Application.ATSPi_Startup_JSON
          ("unix:path=/tmp/a11y-nonexistent", 1000);
      ATSPI_Serve_Report : constant String :=
        A11y_Fixture_Application.ATSPi_Serve_JSON
          ("not-an-address", 1000, 2);
      ATSPI_Timed_Serve_Report : constant String :=
        A11y_Fixture_Application.ATSPi_Serve_JSON
          ("not-an-address", 1000, 2, 25);
      Result_Array : constant String :=
        Project_Tools.JSON.Field_Value (Report, "results");
      Seen : Natural := 0;
      Accepted_Count : Natural := 0;
      Saw_First_Command : Boolean := False;
      Saw_Shutdown : Boolean := False;

      procedure Count_Command (Value : String) is
      begin
         Seen := Seen + 1;
         if Seen = 1 and then Value = "MOVE_FOCUS" then
            Saw_First_Command := True;
         elsif Value = "SHUTDOWN" then
            Saw_Shutdown := True;
         end if;
      end Count_Command;

      procedure Count_Status (Value : String) is
      begin
         if Value = "accepted" then
            Accepted_Count := Accepted_Count + 1;
         end if;
      end Count_Status;
   begin
      Check
        (Project_Tools.JSON.Field_Value (Report, "schema")
         = A11y_Fixture_Application.Schema,
         "fixture application JSON has an unexpected schema");
      Check
        (not Has_Raw_Control_In_JSON_String (Report),
         "fixture application JSON contains raw string control characters");
      Check
        (Project_Tools.JSON.Field_Value (Report, "ready") = "true",
         "fixture application JSON is not ready");
      Check
        (Result_Array'Length > 0,
         "fixture application JSON lacks command results");
      Check
        (A11y_Fixture_Application.Readiness_Line'Length > 0,
         "fixture application lacks deterministic readiness output");

      Project_Tools.JSON.For_Each_Array_Object_Field
        (Result_Array, "command", Count_Command'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Result_Array, "status", Count_Status'Access);

      Check
        (Seen = A11y_Fixture_Application.Command_Result_Count,
         "fixture application command-result count is stale");
      Check
        (Accepted_Count = Seen,
         "fixture application has non-accepted deterministic command results");
      Check
        (Saw_First_Command and then Saw_Shutdown,
         "fixture application omits required first/shutdown commands");
      Check
        (Project_Tools.JSON.Field_Value (ATSPI_Report, "schema")
         = "org.a11y.fixture_atspi_startup.v1",
         "fixture AT-SPI startup JSON has an unexpected schema");
      Check
        (Project_Tools.JSON.Field_Value (ATSPI_Report, "fixture_schema")
         = A11y_Fixture_Application.Schema,
         "fixture AT-SPI startup JSON is not tied to the fixture schema");
      Check
        (Project_Tools.JSON.Field_Value (ATSPI_Report, "application_node")
         = "1001",
         "fixture AT-SPI startup JSON does not use the stable application node");
      Check
        (Project_Tools.JSON.Field_Value
           (ATSPI_Report, "application_exportable") = "false",
         "fixture AT-SPI startup JSON does not report application exportability");
      Check
        (Project_Tools.JSON.Field_Value
           (ATSPI_Report, "application_root_query") = "false"
         and then Project_Tools.JSON.Field_Value
           (ATSPI_Report, "application_root_query_status") =
             "BACKEND_UNAVAILABLE",
         "fixture AT-SPI startup JSON does not report root query dispatch status");
      Check
        (Project_Tools.JSON.Field_Value
           (ATSPI_Report, "application_root_child_count_query") = "false"
         and then Project_Tools.JSON.Field_Value
           (ATSPI_Report, "application_root_child_count_status") =
             "BACKEND_UNAVAILABLE"
         and then Project_Tools.JSON.Field_Value
           (ATSPI_Report, "application_root_child_count") = "0"
         and then Project_Tools.JSON.Field_Value
           (ATSPI_Report, "application_root_first_child_query") = "false"
         and then Project_Tools.JSON.Field_Value
           (ATSPI_Report, "application_root_first_child_status") =
             "BACKEND_UNAVAILABLE"
