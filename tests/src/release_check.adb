procedure Release_Check is
   use Ada.Strings.Unbounded;
   use type A11y.Conformance.Feature_Id;
   use type A11y.Conformance.Support_Level;
   use type A11y_Native_Observation_Report.Readiness_Status;

   Failures : Natural := 0;

   procedure Fail (Message : String) is
   begin
      Failures := Failures + 1;
      Ada.Text_IO.Put_Line ("FAIL " & Message);
   end Fail;

   procedure Check (Condition : Boolean; Message : String) is
   begin
      if not Condition then
         Fail (Message);
      end if;
   end Check;

   function Feature_Count return Natural is
     (A11y.Conformance.Feature_Id'Pos (A11y.Conformance.Feature_Id'Last) + 1);

   function Trimmed_Image (Value : Natural) return String is
     (Ada.Strings.Fixed.Trim (Natural'Image (Value), Ada.Strings.Left));

   function Has_Dot (Value : String) return Boolean is
   begin
      for Ch of Value loop
         if Ch = '.' then
            return True;
         end if;
      end loop;
      return False;
   end Has_Dot;

   function Has_Raw_Control_In_JSON_String (Value : String) return Boolean is
      In_String : Boolean := False;
      Escaped : Boolean := False;
   begin
      for Ch of Value loop
         if Escaped then
            Escaped := False;
         elsif In_String and then Ch = '\' then
            Escaped := True;
         elsif Ch = '"' then
            In_String := not In_String;
         elsif In_String and then Character'Pos (Ch) < 32 then
            return True;
         end if;
      end loop;

      return False;
   end Has_Raw_Control_In_JSON_String;

   function File_Contains (Path : String; Needle : String) return Boolean is
      File : Ada.Text_IO.File_Type;

      function Raw_File_Contains (Candidate : String) return Boolean is
      begin
         if not Ada.Directories.Exists (Candidate) then
            return False;
         end if;

         Ada.Text_IO.Open (File, Ada.Text_IO.In_File, Candidate);
         while not Ada.Text_IO.End_Of_File (File) loop
            declare
               Line : constant String := Ada.Text_IO.Get_Line (File);
            begin
               if Ada.Strings.Fixed.Index (Line, Needle) /= 0 then
                  Ada.Text_IO.Close (File);
                  return True;
               end if;
            end;
         end loop;
         Ada.Text_IO.Close (File);
         return False;
      exception
         when others =>
            if Ada.Text_IO.Is_Open (File) then
               Ada.Text_IO.Close (File);
            end if;
            return False;
      end Raw_File_Contains;
   begin
      return Raw_File_Contains (Path)
        or else
          (Path = "tests/src/nsax_router_tests.adb"
           and then Raw_File_Contains
             ("tests/src/nsax_router_test_suite.adb"));
   end File_Contains;

   procedure Ensure_Repository_Root is
      type Candidate_Index is range 1 .. 4;
      type Candidate_Array is array (Candidate_Index) of String (1 .. 8);

      Candidates : constant Candidate_Array :=
        [1 => ".       ",
         2 => "..      ",
         3 => "../..   ",
         4 => "../../.."];

      function Trimmed (Value : String) return String is
        (Ada.Strings.Fixed.Trim (Value, Ada.Strings.Right));

      function Manifest_Path (Candidate : String) return String is
        (if Candidate = "." then "alire.toml" else Candidate & "/alire.toml");
   begin
      for Candidate of Candidates loop
         declare
            Directory : constant String := Trimmed (Candidate);
         begin
            if File_Contains (Manifest_Path (Directory), "name = ""a11y""")
              and then File_Contains
               (Manifest_Path (Directory), "project-files = [""a11ykit.gpr""]")
            then
               Ada.Directories.Set_Directory (Directory);
               return;
            end if;
         end;
      end loop;

      Fail ("release_check could not locate the repository root");
   end Ensure_Repository_Root;

   function Ends_With (Value : String; Suffix : String) return Boolean is
     (Value'Length >= Suffix'Length
      and then Value (Value'Last - Suffix'Length + 1 .. Value'Last) = Suffix);

   function Is_Skipped_Tooling_Directory (Name : String) return Boolean is
     (Name = ".git"
      or else Name = ".alire"
      or else Name = "obj"
      or else Name = "lib"
      or else Name = "bin"
      or else Name = "vm");

   function Is_Prohibited_Tooling_File (Name : String) return Boolean is
     (Name = "Makefile"
      or else Ends_With (Name, ".sh")
      or else Ends_With (Name, ".py")
      or else Ends_With (Name, ".ps1")
      or else Ends_With (Name, ".js")
      or else Ends_With (Name, ".rb")
      or else Ends_With (Name, ".pl"));

   procedure Scan_For_Non_Ada_Tooling
     (Directory : String;
      Found     : in out Boolean) is
      Search : Ada.Directories.Search_Type;
      Dir_Entry : Ada.Directories.Directory_Entry_Type;
   begin
      if Found then
         return;
      end if;

      Ada.Directories.Start_Search (Search, Directory, "");
      while Ada.Directories.More_Entries (Search) loop
         Ada.Directories.Get_Next_Entry (Search, Dir_Entry);
         declare
            Name : constant String := Ada.Directories.Simple_Name (Dir_Entry);
            Full : constant String := Ada.Directories.Full_Name (Dir_Entry);
         begin
            if Name /= "." and then Name /= ".." then
               case Ada.Directories.Kind (Dir_Entry) is
                  when Ada.Directories.Directory =>
                     if not Is_Skipped_Tooling_Directory (Name) then
                        Scan_For_Non_Ada_Tooling (Full, Found);
                     end if;
                  when Ada.Directories.Ordinary_File =>
                     if Is_Prohibited_Tooling_File (Name) then
                        Found := True;
                     end if;
                  when others =>
                     null;
               end case;
            end if;
         end;
      end loop;
      Ada.Directories.End_Search (Search);
   exception
      when others =>
         Found := True;
   end Scan_For_Non_Ada_Tooling;

   procedure Check_No_Non_Ada_Tooling is
      Found : Boolean := False;
   begin
      Scan_For_Non_Ada_Tooling (".", Found);
      Check
        (not Found,
         "repository contains prohibited non-Ada build or release tooling");
   end Check_No_Non_Ada_Tooling;

   function Expected_Disabled_Support
     (Feature : A11y.Conformance.Feature_Id)
      return A11y.Conformance.Support_Level is
     (case Feature is
        when A11y.Conformance.Backend_Diagnostics_Bounded |
             A11y.Conformance.Diagnostics_Field_Bounds |
             A11y.Conformance.Diagnostics_Localization |
             A11y.Conformance.Events_Envelope =>
          A11y.Conformance.Internal_Only,
        when others =>
          A11y.Conformance.Unsupported);

