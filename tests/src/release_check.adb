   procedure Check_Public_Surface_Native_Leaks is
      Report : constant String := A11y_Public_Surface_Audit.JSON;
   begin
      Check
        (Project_Tools.JSON.Field_Value (Report, "schema")
         = A11y_Public_Surface_Audit.Schema,
         "public surface audit JSON has an unexpected schema");
      Check
        (not Has_Raw_Control_In_JSON_String (Report),
         "public surface audit JSON contains raw string control characters");
      Check
        (Project_Tools.JSON.Field_Value (Report, "complete") = "true",
         "public semantic specs leak native platform tokens");
      Check
        (Project_Tools.JSON.Field_Value (Report, "leak_count") = "0",
         "public surface audit leak count is nonzero");
      Check
        (Project_Tools.JSON.Field_Value (Report, "spec_count")
         = Ada.Strings.Fixed.Trim
           (Natural'Image (A11y_Public_Surface_Audit.Spec_Count),
            Ada.Strings.Left),
         "public surface audit JSON spec count is stale");
      Check
        (Project_Tools.JSON.Field_Value (Report, "forbidden_token_count")
         = Ada.Strings.Fixed.Trim
           (Natural'Image (A11y_Public_Surface_Audit.Forbidden_Token_Count),
            Ada.Strings.Left),
         "public surface audit JSON token count is stale");
      Check
        (A11y_Public_Surface_Audit.Spec_Count = 37,
         "public surface audit spec count is stale");
      Check
        (A11y_Public_Surface_Audit.Forbidden_Token_Count = 17,
         "public surface audit token count is stale");
      Check
        (A11y_Public_Surface_Audit.Complete,
         "public surface audit package reports native leaks");
      Check
        (File_Contains
           ("tests/src/a11y_public_surface_audit.adb",
            "else ""../"" & Path"),
         "public surface audit no longer works from the child test crate");
   end Check_Public_Surface_Native_Leaks;

   procedure Check_Declarations
     (Items          : A11y.Conformance.Declaration_Vectors.Vector;
      Backend        : String;
      Expect_All     : Boolean;
      Expected_Level : A11y.Conformance.Support_Level :=
        A11y.Conformance.Internal_Only)
   is
      Seen : array (A11y.Conformance.Feature_Id) of Boolean :=
        [others => False];
   begin
      for Item of Items loop
         declare
            Name : constant String :=
              A11y.Conformance.Dotted_Name (Item.Feature);
            Backend_Name : constant String := To_String (Item.Backend);
            Mapping : constant String := To_String (Item.Native_Mapping);
            Test_Id : constant String := To_String (Item.Test_Id);
         begin
            Check
              (Backend_Name = Backend,
               Backend & " declaration has unexpected backend name");
            Check
              (Name'Length > 0 and then Has_Dot (Name),
               Backend & " declaration has malformed feature id");
            Check
              (Mapping'Length > 0,
               Backend & " declaration lacks native mapping/evidence note");
            Check
              (Test_Id'Length > 0,
               Backend & " declaration lacks test identifier");

            if Seen (Item.Feature) then
               Fail (Backend & " declaration duplicates " & Name);
            end if;
            Seen (Item.Feature) := True;

            if Backend = "Disabled" then
               Check
                 (Item.Support = Expected_Disabled_Support (Item.Feature),
                  Backend & " declaration has unexpected support level for "
                  & Name);
            elsif Expect_All then
               Check
                 (Item.Support = Expected_Level,
                  Backend & " declaration has unexpected support level for "
                  & Name);
            else
               Check
                 (Item.Support /= A11y.Conformance.Unsupported,
                  Backend & " declaration explicitly advertises unsupported "
                  & Name);
            end if;
         end;
      end loop;

      if Expect_All then
         Check
           (Natural (Items.Length) = Feature_Count,
            Backend & " declarations do not cover every feature");
      end if;
   end Check_Declarations;

   procedure Check_All_Declarations is
