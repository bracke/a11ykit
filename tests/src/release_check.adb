         "native observation omits a platform client family");
      Check
        (Saw_ATSPI and then Saw_UIA and then Saw_NSAX,
         "native observation omits a native API client family");
      Check
        (Ada.Strings.Fixed.Index
           (Report,
            """platform"": ""Linux"", ""native_api"": ""AT-SPI2"", ""native_evidence_scope"": ""atspi"", ""row_scopes_atspi"": true, ""row_scopes_uia"": false, ""row_scopes_nsaccessibility"": false") /= 0,
         "native observation JSON does not scope Linux row evidence to AT-SPI");
      Check
        (Ada.Strings.Fixed.Index
           (Report,
            """platform"": ""Windows"", ""native_api"": ""UI Automation"", ""native_evidence_scope"": ""uia"", ""row_scopes_atspi"": false, ""row_scopes_uia"": true, ""row_scopes_nsaccessibility"": false") /= 0,
         "native observation JSON does not scope Windows row evidence to UIA");
      Check
        (Ada.Strings.Fixed.Index
           (Report,
            """platform"": ""macOS"", ""native_api"": ""NSAccessibility"", ""native_evidence_scope"": ""nsaccessibility"", ""row_scopes_atspi"": false, ""row_scopes_uia"": false, ""row_scopes_nsaccessibility"": true") /= 0,
         "native observation JSON does not scope macOS row evidence to NSAccessibility");
      Check
        (Linux_Row_Start /= 0
         and then Windows_Row_Start > Linux_Row_Start
         and then Ada.Strings.Fixed.Index
           (Client_Array (Linux_Row_Start .. Windows_Row_Start - 1),
            """has_windows_uia_com_live_export_observation"": false") /= 0
         and then Ada.Strings.Fixed.Index
           (Client_Array (Linux_Row_Start .. Windows_Row_Start - 1),
            """has_macos_nsax_external_client_element_chain_observation"": false") /= 0
         and then Ada.Strings.Fixed.Index
           (Client_Array (Linux_Row_Start .. Windows_Row_Start - 1),
            """has_linux_atspi_serving_packet_probe_observation"": true") /= 0,
         "native observation JSON leaks UIA or NSAccessibility export evidence into the AT-SPI row");
      Check
        (Windows_Row_Start /= 0
         and then MacOS_Row_Start > Windows_Row_Start
         and then Ada.Strings.Fixed.Index
           (Client_Array (Windows_Row_Start .. MacOS_Row_Start - 1),
            """has_windows_uia_com_live_export_observation"": true") /= 0
         and then Ada.Strings.Fixed.Index
           (Client_Array (Windows_Row_Start .. MacOS_Row_Start - 1),
            """has_macos_nsax_external_client_element_chain_observation"": false") /= 0,
         "native observation JSON does not keep UIA export evidence scoped to the UIA row");
      Check
        (MacOS_Row_Start /= 0
         and then Ada.Strings.Fixed.Index
           (Client_Array (MacOS_Row_Start .. Client_Array'Last),
            """has_windows_uia_com_live_export_observation"": false") /= 0
         and then Ada.Strings.Fixed.Index
           (Client_Array (MacOS_Row_Start .. Client_Array'Last),
            """has_macos_nsax_external_client_element_chain_observation"": true") /= 0,
         "native observation JSON does not keep NSAccessibility export evidence scoped to the NSAccessibility row");
      Check
        (Ada.Strings.Fixed.Index
           (Report,
            """platform"": ""Linux"", ""native_api"": ""AT-SPI2""") /= 0
         and then Ada.Strings.Fixed.Index
           (Report,
            """has_linux_atspi_serving_packet_malformed_packet_observation"": true") /= 0
         and then Ada.Strings.Fixed.Index
           (Report,
            """has_linux_atspi_serving_packet_text_payload_limit_observation"": true") /= 0,
         "native observation JSON lacks Linux AT-SPI hostile serving-packet evidence");
      Check
        (Ada.Strings.Fixed.Index
           (Report,
            """platform"": ""Windows"", ""native_api"": ""UI Automation""") /= 0
         and then Ada.Strings.Fixed.Index
           (Report,
            """has_linux_atspi_serving_packet_malformed_packet_observation"": false") /= 0
         and then Ada.Strings.Fixed.Index
           (Report,
            """has_linux_atspi_serving_packet_text_payload_limit_observation"": false") /= 0,
         "native observation JSON leaks Linux hostile serving-packet evidence into non-AT-SPI rows");
      Check
        (not A11y_Native_Observation_Report.All_Clients_Blocked
         and then A11y_Native_Observation_Report.Readiness
           = A11y_Native_Observation_Report.Incomplete_Native_Evidence,
         "native observation package does not report partial native evidence");
