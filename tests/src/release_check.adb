            procedure Count_Identity_Kind (Value : String) is
               Expected : constant String :=
                 (case Client is
                    when A11y_Native_Client_Reports.Linux_ATSPI =>
                       "dbus_object_path",
                    when A11y_Native_Client_Reports.Windows_UIA =>
                       "uia_runtime_id",
                    when A11y_Native_Client_Reports.MacOS_NSAccessibility =>
                       "nsaccessibility_element_id");
            begin
               if Value = Expected then
                  Identity_Kind_Count := Identity_Kind_Count + 1;
               end if;
            end Count_Identity_Kind;

            procedure Count_Identity (Value : String) is
            begin
               if Value'Length > 0 then
                  Identity_Count := Identity_Count + 1;
               end if;
               if Value /= "none" then
                  Non_Transport_Identity_Count :=
                    Non_Transport_Identity_Count + 1;
               end if;
            end Count_Identity;

            procedure Count_Privacy (Value : String) is
            begin
               Privacy_Count := Privacy_Count + 1;
               if Value = "public" then
                  Public_Privacy_Count := Public_Privacy_Count + 1;
               elsif Value = "protected_redacted" then
                  Protected_Privacy_Count := Protected_Privacy_Count + 1;
               elsif Value = "lifecycle_only" then
                  Lifecycle_Privacy_Count := Lifecycle_Privacy_Count + 1;
               elsif Value = "transport_only" then
                  Transport_Privacy_Count := Transport_Privacy_Count + 1;
               end if;
            end Count_Privacy;

            procedure Count_Resolution (Value : String) is
            begin
               Resolution_Count := Resolution_Count + 1;
               if Value = "available" then
                  Available_Resolution_Count :=
                    Available_Resolution_Count + 1;
               elsif Value = "node_unavailable" then
                  Node_Unavailable_Resolution_Count :=
                    Node_Unavailable_Resolution_Count + 1;
	               elsif Value = "transport_unavailable" then
	                  Transport_Unavailable_Resolution_Count :=
	                    Transport_Unavailable_Resolution_Count + 1;
	               elsif Value = "live_atspi_session_bus" then
	                  Live_ATSPI_Session_Bus_Resolution_Count :=
	                    Live_ATSPI_Session_Bus_Resolution_Count + 1;
	               end if;
            end Count_Resolution;
