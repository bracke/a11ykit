         elsif Value = "macos.nsaccessibility.native_status_map" then
            MacOS_Native_Status_Map_Count :=
              MacOS_Native_Status_Map_Count + 1;
         elsif Value = "macos.nsaccessibility.native_status_inverse_map" then
            MacOS_Native_Status_Inverse_Map_Count :=
              MacOS_Native_Status_Inverse_Map_Count + 1;
         elsif Value = "macos.nsaccessibility.native_status_diagnostic" then
            MacOS_Native_Status_Diagnostic_Count :=
              MacOS_Native_Status_Diagnostic_Count + 1;
         elsif Value = "macos.nsaccessibility.event_posting_admission" then
            MacOS_NSAX_Event_Posting_Admission_Count :=
              MacOS_NSAX_Event_Posting_Admission_Count + 1;
         elsif Value = "macos.nsaccessibility.event_posting_report" then
            MacOS_NSAX_Event_Posting_Report_Count :=
              MacOS_NSAX_Event_Posting_Report_Count + 1;
         elsif Value = "macos.nsaccessibility.event_posting_drain_bounded" then
            MacOS_NSAX_Event_Posting_Drain_Bounded_Count :=
              MacOS_NSAX_Event_Posting_Drain_Bounded_Count + 1;
         elsif Value = "macos.nsaccessibility.event.build_report" then
            MacOS_NSAX_Event_Build_Report_Count :=
              MacOS_NSAX_Event_Build_Report_Count + 1;
         elsif Value =
           "macos.nsaccessibility.native_callback.hostile_admission"
         then
            MacOS_NSAX_Hostile_Callback_Admission_Count :=
              MacOS_NSAX_Hostile_Callback_Admission_Count + 1;
         elsif Value =
           "macos.nsaccessibility.native_callback.missing_identity"
         then
            MacOS_NSAX_Missing_Identity_Count :=
              MacOS_NSAX_Missing_Identity_Count + 1;
         elsif Value =
           "macos.nsaccessibility.native_callback.mismatched_identity"
         then
            MacOS_NSAX_Mismatched_Identity_Count :=
              MacOS_NSAX_Mismatched_Identity_Count + 1;
         elsif Value =
           "macos.nsaccessibility.native_callback.malformed_identity"
         then
            MacOS_NSAX_Malformed_Identity_Count :=
              MacOS_NSAX_Malformed_Identity_Count + 1;
         elsif Value =
           "macos.nsaccessibility.native_callback.text_payload_limit"
         then
            MacOS_NSAX_Text_Payload_Limit_Count :=
              MacOS_NSAX_Text_Payload_Limit_Count + 1;
         elsif Value = "actions.activate" then
            Saw_Action_Activate := True;
         elsif Value = "actions.press" then
            Saw_Action_Press := True;
         elsif Value = "actions.toggle" then
            Saw_Action_Toggle := True;
         elsif Value = "actions.expand" then
            Saw_Action_Expand := True;
         elsif Value = "actions.collapse" then
            Saw_Action_Collapse := True;
         elsif Value = "actions.show_menu" then
            Saw_Action_Show_Menu := True;
         elsif Value = "actions.dismiss" then
            Saw_Action_Dismiss := True;
         elsif Value = "actions.open" then
            Saw_Action_Open := True;
         elsif Value = "actions.close" then
            Saw_Action_Close := True;
         elsif Value = "actions.scroll_into_view" then
            Saw_Action_Scroll := True;
         elsif Value = "actions.set_focus" then
            Saw_Action_Set_Focus := True;
         end if;
      end Count_Feature;

      Backend_Index : Natural := 0;
      procedure Capture_First_Backend (Value : String) is
      begin
         Backend_Count := Backend_Count + 1;
         Backend_Index := Backend_Index + 1;
         if Backend_Index = 1 then
            First_Backend := To_Unbounded_String (Value);
         end if;
         if Value = "Null" then
            Saw_Null := True;
         elsif Value = "Disabled" then
            Saw_Disabled := True;
         elsif Value = "AT-SPI" then
            Saw_ATSPI := True;
         elsif Value = "UIA" then
            Saw_UIA := True;
         elsif Value = "NSAccessibility" then
            Saw_NSAccessibility := True;
         end if;
      end Capture_First_Backend;

      Support_Index : Natural := 0;
      procedure Capture_First_Support (Value : String) is
      begin
         Support_Count := Support_Count + 1;
         Support_Index := Support_Index + 1;
         if Support_Index = 1 then
            First_Support := To_Unbounded_String (Value);
         end if;
         Check
           (Value = "EXACT"
            or else Value = "EQUIVALENT"
            or else Value = "APPROXIMATE"
            or else Value = "INTERNAL_ONLY"
            or else Value = "UNSUPPORTED",
            "capability JSON report has invalid support level " & Value);
         if Value = "UNSUPPORTED" then
            Saw_Disabled_Unsupported := True;
         end if;
      end Capture_First_Support;

      procedure Count_Mapping (Value : String) is
      begin
         if Value'Length > 0 then
            Mapping_Count := Mapping_Count + 1;
         end if;
      end Count_Mapping;

      procedure Count_Test (Value : String) is
      begin
         if Value'Length > 0 then
            Test_Count := Test_Count + 1;
         end if;
      end Count_Test;
   begin
      for Item of Declarations loop
         declare
            Backend : constant String := To_String (Item.Backend);
         begin
            if A11y.Conformance.Is_Production_Support (Item.Support) then
               Expected_Production_Claims := Expected_Production_Claims + 1;
               if A11y.Conformance.Is_Native_Backend (Backend) then
                  Expected_Native_Production_Claims :=
                    Expected_Native_Production_Claims + 1;
               end if;
               if Backend = "AT-SPI" then
                  Expected_Linux_ATSPI_Production_Claims :=
                    Expected_Linux_ATSPI_Production_Claims + 1;
               elsif Backend = "UIA" then
                  Expected_Windows_UIA_Production_Claims :=
                    Expected_Windows_UIA_Production_Claims + 1;
               elsif Backend = "NSAccessibility" then
                  Expected_MacOS_NSAccessibility_Production_Claims :=
                    Expected_MacOS_NSAccessibility_Production_Claims + 1;
               end if;
            elsif Item.Support = A11y.Conformance.Internal_Only then
               Expected_Internal_Only := Expected_Internal_Only + 1;
               if Backend = "Null" then
                  Expected_Null_Internal_Only :=
                    Expected_Null_Internal_Only + 1;
               end if;
            elsif Item.Support = A11y.Conformance.Unsupported then
               Expected_Unsupported := Expected_Unsupported + 1;
               if Backend = "Disabled" then
                  Expected_Disabled_Unsupported :=
                    Expected_Disabled_Unsupported + 1;
               end if;
            end if;
         end;
      end loop;

      Check
        (Project_Tools.JSON.Field_Value (Report, "schema")
         = A11y_Tool_Reports.Capability_Matrix_Schema,
         "capability JSON report has an unexpected schema");
      Check
        (not Has_Raw_Control_In_JSON_String (Report),
         "capability JSON contains raw string control characters");
      Check
        (Declaration_Array'Length > 0,
         "capability JSON report lacks declarations array");
      Check
        (Summary_Object'Length > 0,
         "capability JSON report lacks summary object");
      Check
        (Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "declaration_count")
         = Trimmed_Image (Natural (Declarations.Length))
         and then Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "production_claim_count")
         = Trimmed_Image (Expected_Production_Claims)
         and then Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "internal_only_count")
         = Trimmed_Image (Expected_Internal_Only)
         and then Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "unsupported_count")
         = Trimmed_Image (Expected_Unsupported)
         and then Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "native_production_claim_count")
         = Trimmed_Image (Expected_Native_Production_Claims)
         and then Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "linux_atspi_production_claim_count")
         = Trimmed_Image (Expected_Linux_ATSPI_Production_Claims)
         and then Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "windows_uia_production_claim_count")
         = Trimmed_Image (Expected_Windows_UIA_Production_Claims)
         and then Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "macos_nsaccessibility_production_claim_count")
         = Trimmed_Image (Expected_MacOS_NSAccessibility_Production_Claims)
         and then Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "null_internal_only_count")
         = Trimmed_Image (Expected_Null_Internal_Only)
         and then Project_Tools.JSON.Object_Field_Value
           (Summary_Object, "disabled_unsupported_count")
         = Trimmed_Image (Expected_Disabled_Unsupported),
         "capability JSON report summary counters are stale");
      Check
        (Expected_Windows_UIA_Production_Claims = 0
         and then Expected_MacOS_NSAccessibility_Production_Claims = 0,
         "capability JSON report claims Windows or macOS production support before public native-client traversal");

      Project_Tools.JSON.For_Each_Array_Object_Field
        (Declaration_Array, "feature", Count_Feature'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Declaration_Array, "backend", Capture_First_Backend'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Declaration_Array, "support", Capture_First_Support'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Declaration_Array, "native_mapping", Count_Mapping'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Declaration_Array, "test_id", Count_Test'Access);
      Check
        (Seen = Natural (Declarations.Length),
         "capability JSON report declaration count is stale");
      Check
        (Backend_Count = Seen,
         "capability JSON report has missing backend fields");
      Check
        (Support_Count = Seen,
         "capability JSON report has missing support fields");
      Check
        (Mapping_Count = Seen,
         "capability JSON report has missing or empty native mapping fields");
      Check
        (Test_Count = Seen,
         "capability JSON report has missing or empty test identifier fields");

      Check
        (To_String (First_Feature) = "core.role.button",
         "capability JSON report first feature is unstable");
      Check
        (To_String (First_Backend) = "Null",
         "capability JSON report first backend is unstable");
      Check
        (To_String (First_Support) = "INTERNAL_ONLY",
         "capability JSON report first support level is unstable");
      Check
        (Saw_Null
         and then Saw_Disabled
         and then Saw_ATSPI
         and then Saw_UIA
         and then Saw_NSAccessibility,
         "capability JSON report omits a backend declaration family");
      Check
        (Saw_Disabled_Unsupported,
         "capability JSON report lacks disabled-backend unsupported evidence");
      Check
        (Saw_Event_Source_Projection,
         "capability JSON report omits native event-source projection");
      Check
