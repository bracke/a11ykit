            """platform"": ""Linux"", ""native_api"": ""AT-SPI2"", ""readiness_evidence_id"": ""linux_atspi_automated_native_qualification"", ""qualification_gate_status"": ""automated_native_qualification_complete"", ""native_boundary_stage"": ""live_atspi_external_client_traversal_observed"", ""native_public_client_traversal_observed"": true, ""required_scenario_count"": 7, ""pending_scenario_count"": 0, ""captured_scenario_count"": 7") /= 0,
         "release qualification platform evidence summary has stale Linux counts");
      Check
        (Ada.Strings.Fixed.Index
           (Report,
            """platform"": ""Windows"", ""native_api"": ""UI Automation"", ""readiness_evidence_id"": ""windows_uia_automated_native_qualification"", ""qualification_gate_status"": ""automated_native_qualification_complete"", ""native_boundary_stage"": ""uia_external_client_traversal_observed"", ""native_public_client_traversal_observed"": true, ""required_scenario_count"": 7, ""pending_scenario_count"": 0, ""captured_scenario_count"": 7") /= 0,
         "release qualification platform evidence summary has stale Windows counts");
      Check
        (Ada.Strings.Fixed.Index
           (Report,
            """platform"": ""macOS"", ""native_api"": ""NSAccessibility"", ""readiness_evidence_id"": ""external_ax_client_traverses_appkit_element_tree"", ""qualification_gate_status"": ""pending_public_client_traversal"", ""native_boundary_stage"": ""nsaccessibility_public_root_export_path_ready"", ""native_public_client_traversal_observed"": false, ""required_scenario_count"": 9, ""pending_scenario_count"": 9, ""captured_scenario_count"": 0") /= 0,
         "release qualification platform evidence summary has stale macOS counts");
      Check
        (Ada.Strings.Fixed.Index
           (Platform_Evidence,
            """platform"": ""Linux""") /= 0
         and then Ada.Strings.Fixed.Index
           (Platform_Evidence,
            """readiness_evidence_id"": ""linux_atspi_automated_native_qualification""") /= 0,
         "release qualification Linux evidence id diverges from native observation readiness");
      Check
        (Ada.Strings.Fixed.Index
           (Platform_Evidence,
            """readiness_evidence_id"": ""windows_uia_automated_native_qualification""") /= 0
         and then Ada.Strings.Fixed.Index
           (Platform_Evidence,
            """native_public_client_traversal_observed"": true") /= 0,
         "release qualification Windows evidence summary does not reflect captured native UIA traversal");
      Check
        (Ada.Strings.Fixed.Index
           (Native_Observation_Summary,
            """platform"": ""Windows"", ""native_api"": ""UI Automation"", ""status"": ""native_conformance_ready""") = 0
         and then A11y_Release_Qualification
           .Windows_UIA_Public_Client_Traversal_Observed
         and then Ada.Strings.Fixed.Index
           (A11y_Native_Observation_Report.JSON,
            """platform"": ""Windows"", ""native_api"": ""UI Automation"", ""native_evidence_scope"": ""uia""") /= 0
         and then Ada.Strings.Fixed.Index
           (A11y_Native_Observation_Report.JSON,
            """status"": ""native_conformance_ready""") /= 0,
         "native observation Windows row does not reflect captured VM UIA traversal");
      Check
        (Ada.Strings.Fixed.Index
           (Native_Observation_Summary,
            """platform"": ""macOS"", ""native_api"": ""NSAccessibility"", ""status"": ""blocked_transport_unavailable""") /= 0
         and then not A11y_Release_Qualification
           .MacOS_NSAccessibility_Public_Client_Traversal_Observed
         and then Ada.Strings.Fixed.Index
           (Native_Observation_Summary,
            """next_required_evidence"": ""external_ax_client_traverses_appkit_element_tree""") /= 0
         and then Ada.Strings.Fixed.Index
           (Platform_Evidence,
            """readiness_evidence_id"": ""external_ax_client_traverses_appkit_element_tree""") /= 0,
         "release qualification macOS evidence id diverges from native observation readiness");

      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array, "platform", Capture_First_Platform'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array, "scenario", Count_Scenario'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array,
         "assistive_technology",
         Check_Assistive_Technology'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array, "os_version", Count_OS_Version'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array,
         "assistive_technology_version",
         Count_AT_Version'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array, "steps", Count_Steps'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array, "expected", Count_Expected'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array, "observed", Count_Observed'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array, "evidence", Count_Evidence'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array,
         "native_probe_command",
         Check_Native_Probe_Command'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array,
         "conformance_feature_id",
         Check_Conformance_Feature_Id'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array,
         "readiness_evidence_id",
         Check_Readiness_Evidence_Id'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array, "known_limitation", Count_Limitation'Access);
      Project_Tools.JSON.For_Each_Array_Object_Field
        (Scenario_Array,
         "qualification_status",
         Count_Qualification_Status'Access);

      Check
        (Seen = A11y_Release_Qualification.Scenario_Count,
         "release qualification JSON scenario count is stale");
      Check
        (Platform_Count = Seen,
         "release qualification JSON has missing platform fields");
      Check
        (Technology_Count = Seen,
         "release qualification JSON has missing assistive technology fields");
      Check
        (OS_Version_Count = Seen,
         "release qualification JSON has missing OS version fields");
      Check
        (AT_Version_Count = Seen,
