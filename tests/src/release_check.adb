      procedure Check_Platform_Evidence_Platform (Value : String) is
      begin
         Platform_Evidence_Count := Platform_Evidence_Count + 1;
         if Value = "Linux" then
            Saw_Linux_Platform_Evidence := True;
         elsif Value = "Windows" then
            Saw_Windows_Platform_Evidence := True;
         elsif Value = "macOS" then
            Saw_MacOS_Platform_Evidence := True;
         end if;
      end Check_Platform_Evidence_Platform;

      procedure Check_Platform_Evidence_Native_API (Value : String) is
      begin
         Platform_Evidence_Native_API_Count :=
           Platform_Evidence_Native_API_Count + 1;
         if Value = "AT-SPI2" then
            Saw_Linux_Platform_Evidence_API := True;
         elsif Value = "UI Automation" then
            Saw_Windows_Platform_Evidence_API := True;
         elsif Value = "NSAccessibility" then
            Saw_MacOS_Platform_Evidence_API := True;
         end if;
      end Check_Platform_Evidence_Native_API;

      procedure Check_Platform_Evidence_Readiness (Value : String) is
      begin
         Platform_Evidence_Readiness_Count :=
           Platform_Evidence_Readiness_Count + 1;
         if Value = "linux_atspi_automated_native_qualification"
           or else Value =
             "record_linux_atspi_assistive_technology_qualification"
