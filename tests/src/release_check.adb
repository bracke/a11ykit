            Saw_Windows_Platform_Evidence_Readiness := True;
         elsif Value = "external_ax_client_traverses_appkit_element_tree" then
            Saw_MacOS_Platform_Evidence_Readiness := True;
         end if;
      end Check_Platform_Evidence_Readiness;

      procedure Check_Platform_Evidence_Gate_Status (Value : String) is
