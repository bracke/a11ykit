           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI Application method layer configures native string limit");

         Reply := A11y.Linux.ATSPi_Application.Handle_Method
           (Session, To_String (Path), "GetToolkitName", Snapshot, Limits);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Application.Error_Reply
            and then Reply.Status = A11y.Results.Resource_Limit,
            "Linux AT-SPI Application method layer applies configured native string limits");

         Invalid_Limits.Limits
           (A11y.Resource_Limits.Native_String_Size) := 0;
         Reply := A11y.Linux.ATSPi_Application.Handle_Method
           (Session, To_String (Path), "GetID", Snapshot, Invalid_Limits);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Application.Error_Reply
            and then Reply.Status = A11y.Results.Invalid_Argument,
            "Linux AT-SPI Application method layer rejects invalid limit configs");
      end;

      Reply := A11y.Linux.ATSPi_Application.Handle_Method
        (Session, To_String (Path), "UnknownMethod", Snapshot);
