         Unix_FDs_Packet_Bytes : Unbounded_String :=
           To_Unbounded_String (Raw (1 .. 16));
         Unix_FDs_Header : A11y.Linux.DBus_Messages.Transport_Packet_Header;
         Unix_FDs_Header_Result : A11y.Results.Result;
         Unix_FDs_Packet : A11y.Linux.DBus_Messages.Transport_Packet;
         Unix_FDs_Envelope : A11y.Linux.DBus_Messages.Transport_Envelope;

         procedure Append_Byte
           (Item  : in out Unbounded_String;
            Value : Natural) is
         begin
            Append (Item, Character'Val (Value));
         end Append_Byte;

         procedure Append_U32
           (Item  : in out Unbounded_String;
            Value : Natural) is
            Remaining : Natural := Value;
         begin
            Append_Byte (Item, Remaining mod 256);
            Remaining := Remaining / 256;
            Append_Byte (Item, Remaining mod 256);
            Remaining := Remaining / 256;
            Append_Byte (Item, Remaining mod 256);
            Remaining := Remaining / 256;
            Append_Byte (Item, Remaining mod 256);
