        A11y.Dispatchers.Create_Cancellation_Token;
   begin
      A11y.Native_Runtimes.Start (Runtime, Runtime_Result);
      A11y.Native_Runtimes.Ensure_Object
        (Runtime, Source, Object, Runtime_Result);
      A11y.Native_Runtimes.Ensure_Object
        (Runtime, Empty_Source, Empty_Object, Runtime_Result);
      A11y.Relations.Add
        (Graph,
         Source,
         A11y.Relations.Active_Descendant,
         Target,
         Runtime_Result);

      A11y.Native_Relation_Calls.Query_Object_Active_Descendant
        (Gate,
         Runtime,
         Dispatcher,
         Object,
         Graph,
         Relation_Result);
      Gate_View := Gate.Snapshot;
      Check
        (Relation_Result.Status = A11y.Results.Success
         and then Relation_Result.Source = Source
         and then Relation_Result.Has_Target
         and then Relation_Result.Target = Target
         and then Gate_View.Outstanding = 0,
         "native relation boundary dispatches active-descendant queries");

      A11y.Native_Relation_Calls.Query_Node_Active_Descendant
        (Gate,
         Runtime,
         Dispatcher,
         Source,
         Graph,
         Relation_Result);
      Gate_View := Gate.Snapshot;
      Check
        (Relation_Result.Status = A11y.Results.Success
         and then Relation_Result.Source = Source
         and then Relation_Result.Has_Target
         and then Relation_Result.Target = Target
         and then Gate_View.Outstanding = 0,
