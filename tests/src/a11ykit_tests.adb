      end;

      declare
         Payload_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         Boundary_Reply :=
           (Kind        => A11y.Linux.ATSPi_DBus_Boundary.Method_Reply,
            Status      => A11y.Results.Success,
            Routed_Kind => A11y.Linux.ATSPi_Method_Router.Image_Size,
            Size        => (Width => 640, Height => 480),
            others      => <>);
         Outgoing := A11y.Linux.DBus_Messages.Build_Reply
           (Incoming, Boundary_Reply, 138, Result);
         A11y.Resource_Limits.Set_Limit
           (Payload_Limits,
            A11y.Resource_Limits.Native_String_Size,
            2,
            Result);
         Payload := A11y.Linux.DBus_Messages.Method_Return_Payload_Bytes
           (Outgoing, Payload_Limits, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Length (Payload) = 8,
            "Linux D-Bus message envelope ignores string limits for fixed-size payloads");
      end;

      Incoming.Header.Serial := 0;
      Check
        (A11y.Linux.DBus_Messages.Validate_Call (Incoming).Status =
           A11y.Results.Invalid_Argument,
         "Linux D-Bus message envelope rejects missing serials");
      Outgoing := A11y.Linux.DBus_Messages.Build_Reply
        (Incoming, Boundary_Reply, 140, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Outgoing.Kind = A11y.Linux.DBus_Messages.Error_Return
         and then To_String (Outgoing.Error_Name) =
           A11y.Linux.ATSPi_Objects.Error_Name
