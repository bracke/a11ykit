         Event.Kind := A11y.Events.Window_Opened;
         Event.Sequence := 74;
         Signal := A11y.Linux.ATSPi_Signals.Build_Signal
           (Session, Event, Payload);
         Check
           (Signal.Publishable
            and then To_String (Signal.Event_Name) = "window:create"
            and then Signal.Has_Window_Payload
            and then Signal.Window_Payload.Surface = Node
            and then Signal.Window_Payload.Kind = A11y.Windows.Modal_Dialog
            and then Signal.Window_Payload.Owner =
              A11y.Node_Ids.From_Natural (903)
            and then Signal.Window_Payload.Has_Owner,
            "Linux AT-SPI signal layer carries window payloads");

         Payload.Has_Owner := False;
         Payload.Owner := A11y.Node_Ids.From_Natural (903);
         Event.Sequence := 75;
         Signal := A11y.Linux.ATSPi_Signals.Build_Signal
           (Session, Event, Payload);
         Check
           (not Signal.Publishable
            and then Signal.Status = A11y.Results.Invalid_Argument,
            "Linux AT-SPI signal layer rejects contradictory absent window owner payloads");

         Event.Kind := A11y.Events.Focus_Changed;
         Event.Sequence := 76;
         Signal := A11y.Linux.ATSPi_Signals.Build_Signal
           (Session, Event, Payload);
         Check
           (not Signal.Publishable
            and then Signal.Status = A11y.Results.Invalid_Argument,
            "Linux AT-SPI signal layer rejects window payloads on other events");
      end;

      for Kind in A11y.Events.Event_Kind loop
         Event.Kind := Kind;
         Event.Sequence :=
           A11y.Event_Sequence (100 + A11y.Events.Event_Kind'Pos (Kind));
         Signal := A11y.Linux.ATSPi_Signals.Build_Signal (Session, Event);
         Check
           (Signal.Publishable
            and then Length (Signal.Event_Name) > 0
            and then Signal.Sequence = Event.Sequence,
            "Linux AT-SPI signal layer maps every semantic event kind");
      end loop;

      Event.Sequence := A11y.No_Event;
      Signal := A11y.Linux.ATSPi_Signals.Build_Signal (Session, Event);
      Check
        (not Signal.Publishable
         and then Signal.Status = A11y.Results.Invalid_Argument,
         "Linux AT-SPI signal layer rejects unsequenced events");
      A11y.Linux.ATSPi_Signals.Build_Signal_With_Report
        (Session, Event, Signal, Report);
      Check
        (not Report.Envelope_Valid
         and then not Report.Object_Path_Resolved
         and then not Report.Publishable
         and then Report.Status = A11y.Results.Invalid_Argument,
         "Linux AT-SPI signal layer reports invalid event envelopes");

      Event.Sequence := 43;
      Event.Source := A11y.Node_Ids.No_Node;
      Signal := A11y.Linux.ATSPi_Signals.Build_Signal (Session, Event);
      Check
        (not Signal.Publishable
         and then Signal.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI signal layer rejects invalid event sources");

      Event.Source := Node;
      Signal := A11y.Linux.ATSPi_Signals.Build_Signal
        (A11y.Native_Identity.No_Session, Event);
      Check
        (not Signal.Publishable
         and then Signal.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI signal layer rejects invalid backend sessions");
      A11y.Linux.ATSPi_Signals.Build_Signal_With_Report
        (A11y.Native_Identity.No_Session, Event, Signal, Report);
      Check
        (Report.Envelope_Valid
         and then not Report.Object_Path_Resolved
         and then not Report.Publishable
         and then Report.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI signal layer reports object-path resolution failures");
   end;

   declare
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (701);
      Result : A11y.Results.Result;
      Path : constant Unbounded_String :=
        A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Result);
      type Accessible_Snapshot_Access is access
        A11y.Linux.ATSPi_Accessible.Accessible_Snapshot;
      Snapshot_Ref : constant Accessible_Snapshot_Access :=
        new A11y.Linux.ATSPi_Accessible.Accessible_Snapshot;
      Snapshot : A11y.Linux.ATSPi_Accessible.Accessible_Snapshot
        renames Snapshot_Ref.all;
      Reply : A11y.Linux.ATSPi_Accessible.Accessible_Reply;
      Label : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (702);
      Description : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (703);
      Root : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (704);
      Flattened : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (705);
      Button : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (706);
      Hidden : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (707);
      Hidden_Button : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (708);
      Trailing : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (709);
      Invalid_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      Snapshot.Id := Node;
      Snapshot.Role := A11y.Roles.Button;
      Snapshot.Name := To_Unbounded_String ("Launch");
      Snapshot.Description := To_Unbounded_String ("Launch the operation");
      Snapshot.States := A11y.States.With_State
        (A11y.States.With_State
           (A11y.States.Empty_State_Set, A11y.States.Focusable),
         A11y.States.Focused);
      Snapshot.Child_Count := 2;
      Snapshot.Children.Append (Label);
      Snapshot.Children.Append (Description);
      A11y.Relations.Add
        (Snapshot.Relations,
         Node,
         A11y.Relations.Labelled_By,
         Label,
         Result);
      A11y.Relations.Add
        (Snapshot.Relations,
         Node,
         A11y.Relations.Described_By,
         Description,
         Result);

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetRole", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Role_Reply
         and then Reply.Role = A11y.Linux.ATSPi_Mappings.Push_Button,
         "Linux AT-SPI Accessible method layer returns mapped roles");

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetInterfaces", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.String_Array_Reply
         and then Natural (Reply.Strings.Length) = 2
         and then To_String (Reply.Strings.First_Element) =
           "org.a11y.atspi.Accessible"
         and then To_String (Reply.Strings.Last_Element) =
           "org.a11y.atspi.Component",
         "Linux AT-SPI Accessible method layer returns base interfaces");

      Snapshot.Role := A11y.Roles.Application;
      Snapshot.Capabilities :=
        A11y.Capabilities.With_Capability
          (A11y.Capabilities.With_Capability
             (A11y.Capabilities.Empty_Capability_Set,
              A11y.Capabilities.Action),
           A11y.Capabilities.Editable_Text);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetInterfaces", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.String_Array_Reply
         and then Natural (Reply.Strings.Length) = 5
         and then To_String (Reply.Strings.First_Element) =
           "org.a11y.atspi.Accessible"
         and then To_String (Reply.Strings (2)) =
           "org.a11y.atspi.Application"
         and then To_String (Reply.Strings (3)) =
           "org.a11y.atspi.Component"
         and then To_String (Reply.Strings (4)) =
           "org.a11y.atspi.Action"
         and then To_String (Reply.Strings.Last_Element) =
           "org.a11y.atspi.EditableText",
         "Linux AT-SPI Accessible method layer derives interfaces from semantic capabilities");
      Snapshot.Role := A11y.Roles.Button;
      Snapshot.Capabilities := A11y.Capabilities.Empty_Capability_Set;

      Snapshot.Root := Root;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetApplication", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Node_Reply
         and then Reply.Node = Root,
         "Linux AT-SPI Accessible method layer returns application roots");

      Snapshot.Root := A11y.Node_Ids.No_Node;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetApplication", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Accessible method layer rejects missing application roots");
      Snapshot.Root := Root;

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetRoleName", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.String_Reply
         and then To_String (Reply.Text) = "button",
         "Linux AT-SPI Accessible method layer returns semantic role names");

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetLocalizedRoleName", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.String_Reply
         and then To_String (Reply.Text) = "button",
         "Linux AT-SPI Accessible method layer returns localized role names");

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetState", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.State_Set_Reply
         and then Reply.States (A11y.Linux.ATSPi_Mappings.Focused),
         "Linux AT-SPI Accessible method layer returns mapped state sets");

      Snapshot.Role := A11y.Roles.Text_Field;
      Snapshot.States := A11y.States.Empty_State_Set;
      Snapshot.Capabilities :=
        A11y.Capabilities.With_Capability
          (A11y.Capabilities.Empty_Capability_Set, A11y.Capabilities.Text);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetState", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.State_Set_Reply
         and then Reply.States (A11y.Linux.ATSPi_Mappings.Focusable)
         and then Reply.States (A11y.Linux.ATSPi_Mappings.Read_Only)
         and then not Reply.States (A11y.Linux.ATSPi_Mappings.Editable),
         "Linux AT-SPI Accessible method layer maps derived state snapshots");

      Snapshot.Role := A11y.Roles.Custom;
      Snapshot.Capabilities := A11y.Capabilities.Empty_Capability_Set;
      Snapshot.States := A11y.States.With_State
        (A11y.States.Empty_State_Set, A11y.States.Focused);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetState", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_State,
         "Linux AT-SPI Accessible method layer rejects invalid state sets");
      Snapshot.States := A11y.States.With_State
        (A11y.States.With_State
           (A11y.States.Empty_State_Set, A11y.States.Focusable),
         A11y.States.Focused);
      Snapshot.Role := A11y.Roles.Button;

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetName", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.String_Reply
         and then To_String (Reply.Text) = "Launch",
         "Linux AT-SPI Accessible method layer returns bounded names");

      Invalid_Limits.Limits (A11y.Resource_Limits.Native_String_Size) := 0;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session,
         To_String (Path),
         "GetRole",
         0,
         Snapshot,
         Invalid_Limits);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_Argument,
         "Linux AT-SPI Accessible method layer rejects invalid limit configs");

      Snapshot.Description := To_Unbounded_String ("Submits the current dialog");
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetDescription", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.String_Reply
         and then To_String (Reply.Text) = "Submits the current dialog",
         "Linux AT-SPI Accessible method layer returns bounded descriptions");

      Snapshot.Placeholder := A11y.Properties.Present ("Search terms");
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetAttributes", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Attribute_Set_Reply
         and then Natural (Reply.Attributes.Length) = 1
         and then To_String (Reply.Attributes.First_Element.Key) =
           "placeholder-text"
         and then To_String (Reply.Attributes.First_Element.Value) =
           "Search terms",
         "Linux AT-SPI Accessible method layer exposes placeholder attributes");

      Snapshot.Help_Text := A11y.Properties.Present ("Type a query");
      Snapshot.Visible_Title := A11y.Properties.Present ("Search");
      Snapshot.Value_Text := A11y.Properties.Present ("Ready");
      Snapshot.Keyboard_Shortcut := A11y.Properties.Present ("Alt+S");
      Snapshot.Semantic_Identifier :=
        A11y.Properties.Present ("search-field");
      Snapshot.Locale := A11y.Properties.Present ("en-US");
      Snapshot.Orientation := A11y.Properties.Present ("vertical");
      Snapshot.Heading_Level := A11y.Properties.Present (2);
      Snapshot.Landmark := A11y.Properties.Present ("main");
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetAttributes", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Attribute_Set_Reply
         and then Natural (Reply.Attributes.Length) = 10
         and then To_String (Reply.Attributes.First_Element.Key) =
           "help-text"
         and then To_String (Reply.Attributes.First_Element.Value) =
           "Type a query"
         and then To_String (Reply.Attributes (2).Key) =
           "visible-title"
         and then To_String (Reply.Attributes (2).Value) =
           "Search"
         and then To_String (Reply.Attributes (3).Key) =
           "placeholder-text"
         and then To_String (Reply.Attributes (3).Value) =
           "Search terms"
         and then To_String (Reply.Attributes (4).Key) =
           "accessible-value"
         and then To_String (Reply.Attributes (4).Value) =
           "Ready"
         and then To_String (Reply.Attributes (5).Key) =
           "keyboard-shortcut"
         and then To_String (Reply.Attributes (5).Value) =
           "Alt+S"
         and then To_String (Reply.Attributes (6).Key) =
           "semantic-identifier"
         and then To_String (Reply.Attributes (6).Value) =
           "search-field"
         and then To_String (Reply.Attributes.Last_Element.Key) =
           "landmark"
         and then To_String (Reply.Attributes.Last_Element.Value) =
           "main"
         and then To_String (Reply.Attributes (7).Key) =
           "locale"
         and then To_String (Reply.Attributes (7).Value) =
           "en-US"
         and then To_String (Reply.Attributes (8).Key) =
           "orientation"
         and then To_String (Reply.Attributes (8).Value) =
           "vertical"
         and then To_String (Reply.Attributes (9).Key) =
           "heading-level"
         and then To_String (Reply.Attributes (9).Value) =
           "2",
         "Linux AT-SPI Accessible method layer exposes textual attributes");
      Snapshot.Help_Text :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);
      Snapshot.Value_Text :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);
      Snapshot.Visible_Title :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);
      Snapshot.Keyboard_Shortcut :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);
      Snapshot.Semantic_Identifier :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);
      Snapshot.Locale :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);
      Snapshot.Orientation :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);
      Snapshot.Heading_Level :=
        (Status => A11y.Properties.Unsupported,
         Value  => 0);
      Snapshot.Landmark :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);

      Snapshot.Heading_Level := A11y.Properties.Present (-1);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetAttributes", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_Range,
         "Linux AT-SPI Accessible method layer rejects negative heading levels");
      Snapshot.Heading_Level :=
        (Status => A11y.Properties.Unsupported,
         Value  => 0);

      Snapshot.Value_Text := A11y.Properties.Present ("secret");
      Snapshot.Protected_Value_Text := True;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetAttributes", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Attribute_Set_Reply
         and then Natural (Reply.Attributes.Length) = 1
         and then To_String (Reply.Attributes.First_Element.Key) =
           "placeholder-text",
         "Linux AT-SPI Accessible method layer suppresses protected value text");
      Snapshot.Protected_Value_Text := False;
      Snapshot.Role := A11y.Roles.Password_Field;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetAttributes", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Attribute_Set_Reply
         and then Natural (Reply.Attributes.Length) = 1
         and then To_String (Reply.Attributes.First_Element.Key) =
           "placeholder-text",
         "Linux AT-SPI Accessible method layer suppresses password value text");
      Snapshot.Role := A11y.Roles.Button;
      Snapshot.Value_Text :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);

      Snapshot.Placeholder := A11y.Properties.Empty;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetAttributes", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Attribute_Set_Reply
         and then Natural (Reply.Attributes.Length) = 1
         and then To_String (Reply.Attributes.First_Element.Key) =
           "placeholder-text"
         and then Length (Reply.Attributes.First_Element.Value) = 0,
         "Linux AT-SPI Accessible method layer preserves empty placeholders");

      Snapshot.Placeholder :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetAttributes", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Attribute_Set_Reply
         and then Reply.Attributes.Is_Empty,
         "Linux AT-SPI Accessible method layer omits unsupported attributes");

      Snapshot.Help_Text :=
        (Status => A11y.Properties.Temporarily_Unavailable,
         Value  => Null_Unbounded_String);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetAttributes", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Busy,
         "Linux AT-SPI Accessible method layer preserves unavailable attributes");
      Snapshot.Help_Text :=
        (Status => A11y.Properties.Unsupported,
         Value  => Null_Unbounded_String);

      Snapshot.Placeholder := A11y.Properties.Present ("Search terms");
      A11y.Resource_Limits.Set_Limit
        (Snapshot.Limits,
         A11y.Resource_Limits.Native_String_Size,
         4,
         Result);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetAttributes", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Resource_Limit,
         "Linux AT-SPI Accessible method layer bounds placeholder attributes");
      Snapshot.Limits := A11y.Resource_Limits.Default_Config;

      A11y.Resource_Limits.Set_Limit
        (Snapshot.Limits,
         A11y.Resource_Limits.Native_String_Size,
         4,
         Result);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetName", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Resource_Limit,
         "Linux AT-SPI Accessible method layer applies configured name limits");
      Snapshot.Limits := A11y.Resource_Limits.Default_Config;

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetChildCount", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.UInt32_Reply
         and then Reply.UInt32 = 2,
         "Linux AT-SPI Accessible method layer returns child counts");

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetChildAtIndex", 1, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Node_Reply
         and then Reply.Node = Description,
         "Linux AT-SPI Accessible method layer returns indexed children");

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetChildren", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Node_Array_Reply
         and then Natural (Reply.Nodes.Length) = 2
         and then Reply.Nodes.First_Element = Label
         and then Reply.Nodes.Last_Element = Description,
         "Linux AT-SPI Accessible method layer returns direct child arrays");

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetChildAtIndex", 2, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_Argument,
         "Linux AT-SPI Accessible method layer rejects out-of-range child indexes");

      Snapshot.Parent := Root;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetParent", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Node_Reply
         and then Reply.Node = Root,
         "Linux AT-SPI Accessible method layer returns direct parents");

      Snapshot.Parent := A11y.Node_Ids.No_Node;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetParent", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Accessible method layer rejects parentless nodes");

      Snapshot.Index_In_Parent := 1;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetIndexInParent", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Int32_Reply
         and then Reply.Int32 = 1,
         "Linux AT-SPI Accessible method layer returns direct indexes in parent");

      Snapshot.Index_In_Parent := -1;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetIndexInParent", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Int32_Reply
         and then Reply.Int32 = -1,
         "Linux AT-SPI Accessible method layer returns parentless index sentinels");

      Snapshot.Root := Root;
      Snapshot.Child_Count := 99;
      Snapshot.Use_Tree_Projection := True;
      A11y.Trees.Set_Root (Snapshot.Tree, Root, Result);
      A11y.Trees.Attach (Snapshot.Tree, Root, Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Node, Flattened, Result);
      A11y.Trees.Attach (Snapshot.Tree, Flattened, Button, Result);
      A11y.Trees.Attach (Snapshot.Tree, Node, Hidden, Result);
      A11y.Trees.Attach (Snapshot.Tree, Hidden, Hidden_Button, Result);
      A11y.Trees.Attach (Snapshot.Tree, Node, Trailing, Result);
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Flattened)) := A11y.Nodes.Flatten_Node;
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Hidden)) :=
           A11y.Nodes.Hide_Node_And_Subtree;

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetChildCount", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.UInt32_Reply
         and then Reply.UInt32 = 2,
         "Linux AT-SPI Accessible method layer counts exposed children");

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetChildAtIndex", 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Node_Reply
         and then Reply.Node = Button,
         "Linux AT-SPI Accessible method layer returns flattened projected children");

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetChildAtIndex", 1, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Node_Reply
         and then Reply.Node = Trailing,
         "Linux AT-SPI Accessible method layer skips hidden projected children");

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetChildren", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Node_Array_Reply
         and then Natural (Reply.Nodes.Length) = 2
         and then Reply.Nodes.First_Element = Button
         and then Reply.Nodes.Last_Element = Trailing,
         "Linux AT-SPI Accessible method layer returns projected child arrays");

      Snapshot.Id := Button;
      declare
         Button_Path : constant Unbounded_String :=
           A11y.Linux.ATSPi_Objects.Object_Path
             (Session, Button, Result);
      begin
         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Button_Path), "GetParent", Snapshot);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Accessible.Node_Reply
            and then Reply.Node = Node,
            "Linux AT-SPI Accessible method layer returns projected parents");

         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Button_Path), "GetIndexInParent", Snapshot);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Accessible.Int32_Reply
            and then Reply.Int32 = 0,
            "Linux AT-SPI Accessible method layer returns projected indexes in parent");
      end;
      Snapshot.Id := Node;

      declare
         Hidden_Path : constant Unbounded_String :=
           A11y.Linux.ATSPi_Objects.Object_Path
             (Session, Hidden_Button, Result);
      begin
         Snapshot.Id := Hidden_Button;
         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Hidden_Path), "GetChildCount", Snapshot);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
            and then Reply.Status = A11y.Results.Node_Unavailable,
            "Linux AT-SPI Accessible method layer rejects hidden children");
         Snapshot.Id := Node;
      end;

      A11y.Relations.Add
        (Snapshot.Relations,
         Node,
         A11y.Relations.Labelled_By,
         Button,
         Result);
      A11y.Relations.Add
        (Snapshot.Relations,
         Node,
         A11y.Relations.Described_By,
         Hidden_Button,
         Result);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetRelationSet", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Relation_Set_Reply
         and then Natural (Reply.Relations.Length) = 1
         and then Reply.Relations.First_Element.Kind =
           A11y.Linux.ATSPi_Mappings.Labelled_By
         and then Reply.Relations.First_Element.Targets.First_Element = Button,
         "Linux AT-SPI Accessible method layer filters hidden relations");

      declare
         Button_Path : constant Unbounded_String :=
           A11y.Linux.ATSPi_Objects.Object_Path
             (Session, Button, Result);
      begin
         A11y.Semantic_Snapshots.Set_Node
           (Snapshot.Nodes,
            Button,
            A11y.Roles.Button,
            "Projected Button",
            A11y.States.Empty_State_Set,
            A11y.Capabilities.With_Capability
              (A11y.Capabilities.Empty_Capability_Set,
               A11y.Capabilities.Action),
            A11y.Nodes.Expose_Node,
            Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI Accessible method layer prepares object-path relation metadata");
         A11y.Relations.Add
           (Snapshot.Relations,
            Button,
            A11y.Relations.Labelled_By,
            Node,
            Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI Accessible method layer prepares object-path relation edge");
         Snapshot.Use_Node_Metadata := True;
         Snapshot.Id := Node;
         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Button_Path), "GetRelationSet", Snapshot);
         declare
            Expected_Relation_Found : Boolean := False;
         begin
            if Reply.Kind =
              A11y.Linux.ATSPi_Accessible.Relation_Set_Reply
            then
               declare
                  Relations : constant
                    A11y.Linux.ATSPi_Accessible
                      .Relation_Entry_Vectors.Vector := Reply.Relations;
               begin
                  for Relation of Relations loop
                     if Relation.Kind =
                       A11y.Linux.ATSPi_Mappings.Labelled_By
                     then
                        for Target of Relation.Targets loop
                           if Target = Node then
                              Expected_Relation_Found := True;
                           end if;
                        end loop;
                     end if;
                  end loop;
               end;
            end if;

            Check
              (Expected_Relation_Found,
               "Linux AT-SPI Accessible method layer resolves relation source from object paths");
         end;
         A11y.Relations.Remove
           (Snapshot.Relations,
            Button,
            A11y.Relations.Labelled_By,
            Node,
            Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI Accessible method layer cleans up object-path relation fixture");
         Snapshot.Use_Node_Metadata := False;
      end;

      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Node)) :=
           A11y.Nodes.Hide_Node_And_Subtree;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetName", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Accessible method layer rejects hidden source nodes");
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Node)) := A11y.Nodes.Expose_Node;

      Snapshot.Child_Count := 2;
      Snapshot.Use_Tree_Projection := False;

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetRelationSet", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Relation_Set_Reply
         and then Natural (Reply.Relations.Length) = 2
         and then Reply.Relations.First_Element.Kind =
           A11y.Linux.ATSPi_Mappings.Labelled_By
         and then Reply.Relations.First_Element.Targets.First_Element = Label,
         "Linux AT-SPI Accessible method layer returns relation sets");

      A11y.Resource_Limits.Set_Limit
        (Snapshot.Limits,
         A11y.Resource_Limits.Relation_Targets_Returned,
         1,
         Result);
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetRelationSet", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Resource_Limit,
         "Linux AT-SPI Accessible method layer bounds relation sets");
      Snapshot.Limits.Limits
        (A11y.Resource_Limits.Relation_Targets_Returned) := 0;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetRelationSet", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_Argument,
         "Linux AT-SPI Accessible method layer rejects invalid relation limits");
      A11y.Resource_Limits.Set_Limit
        (Snapshot.Limits,
         A11y.Resource_Limits.Relation_Targets_Returned,
         4_096,
         Result);

      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "NoSuchMethod", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Unsupported_Capability,
         "Linux AT-SPI Accessible method layer rejects unknown methods");

      Snapshot.Defunct := True;
      Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
        (Session, To_String (Path), "GetName", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Accessible method layer rejects defunct snapshots");
   end;

   declare
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Root : constant A11y.Node_Ids.Node_Id :=
