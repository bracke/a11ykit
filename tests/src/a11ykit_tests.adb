   begin
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Native_Array_Size,
         2,
         Result);
      A11y.Linux.DBus_Messages.Configure_Queue
        (Queue, Limits, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Linux.DBus_Messages.Queue_Capacity (Queue) = 2,
         "Linux D-Bus outgoing queue applies configured native array limits");

      First := A11y.Linux.DBus_Messages.Build_Method_Call
        (Object_Path    => To_Unbounded_String ("/org/a11y/atspi/registry"),
         Interface_Name => To_Unbounded_String ("org.a11y.atspi.Registry"),
         Member_Name    => To_Unbounded_String ("RegisterEvent"),
         Serial         => 71,
         Result         => Result);
      A11y.Linux.DBus_Messages.Enqueue (Queue, First, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Linux.DBus_Messages.Queue_Length (Queue) = 1,
         "Linux D-Bus outgoing queue accepts first bounded message");

      Second := A11y.Linux.DBus_Messages.Build_Method_Call
        (Object_Path    => To_Unbounded_String ("/org/a11y/atspi/registry"),
         Interface_Name => To_Unbounded_String ("org.a11y.atspi.Registry"),
         Member_Name    => To_Unbounded_String ("RegisterEvent"),
         Serial         => 72,
         Result         => Result);
      A11y.Linux.DBus_Messages.Enqueue (Queue, Second, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Linux.DBus_Messages.Queue_Length (Queue) = 2,
         "Linux D-Bus outgoing queue accepts configured-capacity messages");

      A11y.Linux.DBus_Messages.Enqueue (Queue, Second, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then A11y.Linux.DBus_Messages.Queue_Length (Queue) = 2
         and then A11y.Linux.DBus_Messages.Queue_Overflowed (Queue),
         "Linux D-Bus outgoing queue rejects overflow without mutation");

      A11y.Linux.DBus_Messages.Peek (Queue, Message, Result);
