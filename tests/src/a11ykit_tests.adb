      Incoming.Header.Serial := 31;
      Incoming.Header.Reply_Serial := 30;
      Check
        (A11y.Linux.DBus_Messages.Validate_Call (Incoming).Status =
           A11y.Results.Invalid_Argument,
         "Linux D-Bus message envelope rejects method-call reply serials");

      Incoming.Header.Reply_Serial := 0;
      Incoming.Header.Error_Name := To_Unbounded_String
        ("org.a11y.atspi.Error.NotSupported");
      Check
        (A11y.Linux.DBus_Messages.Validate_Call (Incoming).Status =
           A11y.Results.Invalid_Argument,
         "Linux D-Bus message envelope rejects method-call error names");

      Incoming.Header.Error_Name := Null_Unbounded_String;
      Incoming.Call.Session := A11y.Native_Identity.No_Session;
      Check
        (A11y.Linux.DBus_Messages.Validate_Call (Incoming).Status =
           A11y.Results.Node_Unavailable,
         "Linux D-Bus message envelope rejects invalid backend sessions");
      Outgoing := A11y.Linux.DBus_Messages.Build_Reply
        (Incoming, Boundary_Reply, 141, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Outgoing.Kind = A11y.Linux.DBus_Messages.Error_Return
         and then To_String (Outgoing.Error_Name) =
           A11y.Linux.ATSPi_Objects.Error_Name
             (A11y.Results.Node_Unavailable),
         "Linux D-Bus message envelope names node-unavailable replies");

      Incoming.Call.Session := Session;
      Incoming.Header.Member_Name := To_Unbounded_String ("GetName");
      Check
        (A11y.Linux.DBus_Messages.Validate_Call (Incoming).Status =
           A11y.Results.Invalid_Argument,
         "Linux D-Bus message envelope rejects header/body mismatches");

      Incoming.Header.Member_Name := Call.Method_Name;
      Boundary_Reply :=
        (Kind       => A11y.Linux.ATSPi_DBus_Boundary.Error_Reply,
         Status     => A11y.Results.Unsupported_Capability,
         Error_Name => To_Unbounded_String
           (A11y.Linux.ATSPi_Objects.Error_Name
              (A11y.Results.Unsupported_Capability)));
      Outgoing := A11y.Linux.DBus_Messages.Build_Reply
        (Incoming, Boundary_Reply, 33, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Outgoing.Kind = A11y.Linux.DBus_Messages.Error_Return
         and then Outgoing.Serial = 33
         and then Outgoing.Reply_Serial = 31
         and then To_String (Outgoing.Error_Name) =
           A11y.Linux.ATSPi_Objects.Error_Name
             (A11y.Results.Unsupported_Capability),
         "Linux D-Bus message envelope builds structured error replies");

      declare
         Error_Envelope : A11y.Linux.DBus_Messages.Transport_Envelope;
         Error_Frame : A11y.Linux.DBus_Messages.Transport_Frame;
         Error_Packet : A11y.Linux.DBus_Messages.Transport_Packet;
         Decoded_Error : A11y.Linux.DBus_Messages.Transport_Envelope;
         Payload_Text : Unbounded_String;
         Diagnostic : A11y.Diagnostics.Diagnostic;
      begin
         Error_Envelope :=
           A11y.Linux.DBus_Messages.Build_Transport_Envelope
             (Outgoing, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Error_Envelope.Kind =
              A11y.Linux.DBus_Messages.Error_Return
            and then Error_Envelope.Reply_Serial = 31
            and then Length (Error_Envelope.Error_Name) /= 0
            and then Length (Error_Envelope.Body_Signature) = 0,
            "Linux D-Bus message envelope normalizes error returns");

         Error_Envelope.Body_Signature := To_Unbounded_String ("s");
         Error_Envelope.Body_Bytes := To_Unbounded_String
           (String'
              (1  => Character'Val (6),
               2  => Character'Val (0),
               3  => Character'Val (0),
               4  => Character'Val (0),
               5  => 'd',
               6  => 'e',
               7  => 'n',
               8  => 'i',
               9  => 'e',
               10 => 'd',
               11 => Character'Val (0)));
         Error_Frame := A11y.Linux.DBus_Messages.Build_Transport_Frame
           (Error_Envelope, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Error_Frame.Metadata.Header_Field_Count = 3
            and then Error_Frame.Metadata.Body_Field_Count = 1
            and then Length (Error_Frame.Body_Bytes) =
              Length (Error_Envelope.Body_Bytes),
            "Linux D-Bus message envelope serializes error-return payload bodies");
         Error_Packet := A11y.Linux.DBus_Messages.Build_Transport_Packet
           (Error_Envelope, Result);
         Decoded_Error := A11y.Linux.DBus_Messages.Decode_Transport_Envelope
           (Error_Packet.Bytes, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Decoded_Error.Kind =
              A11y.Linux.DBus_Messages.Error_Return
            and then Decoded_Error.Error_Name = Error_Envelope.Error_Name
            and then Decoded_Error.Body_Signature = To_Unbounded_String ("s")
            and then Decoded_Error.Body_Bytes = Error_Envelope.Body_Bytes,
            "Linux D-Bus message envelope decodes error-return frame bodies");
         Decoded_Error := A11y.Linux.DBus_Messages.Decode_Error_Return
           (Error_Packet.Bytes, Result);
         Payload_Text := A11y.Linux.DBus_Messages.Decode_String_Body
           (Decoded_Error.Body_Bytes, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Decoded_Error.Kind =
              A11y.Linux.DBus_Messages.Error_Return
            and then Decoded_Error.Reply_Serial = 31
            and then Decoded_Error.Error_Name = Error_Envelope.Error_Name
            and then Payload_Text = To_Unbounded_String ("denied"),
            "Linux D-Bus message envelope decodes typed error returns");
         Diagnostic :=
           A11y.Linux.DBus_Messages.Diagnostic_For_Error_Return
             (Decoded_Error, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then To_String (Diagnostic.Identifier) =
              "linux.dbus.error_return"
            and then Diagnostic.Class =
              A11y.Diagnostics.ABI_Boundary_Failure
            and then Diagnostic.Level = A11y.Diagnostics.Error
            and then To_String (Diagnostic.Feature) =
              "linux.dbus.error_return_decode"
            and then A11y.Diagnostics.Has_Field
              (Diagnostic, "reply_serial", "31")
            and then A11y.Diagnostics.Has_Field
              (Diagnostic,
               "error_name",
               A11y.Linux.ATSPi_Objects.Error_Name
                 (A11y.Results.Unsupported_Capability))
            and then A11y.Diagnostics.Has_Field
              (Diagnostic, "has_message", "true")
            and then A11y.Diagnostics.Has_Field
