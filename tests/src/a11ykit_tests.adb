      Metadata.Minimum := A11y.Values.Integer (0);

      Metadata.Maximum := A11y.Values.Exact_Decimal (10, 0);
      Check
        (A11y.Values.Validate (Metadata).Status
         = A11y.Results.Invalid_Argument,
         "value framework rejects mixed numeric range metadata");
      Metadata.Current := A11y.Values.Exact_Decimal (5, 0);
      Metadata.Minimum := A11y.Values.Exact_Decimal (0, 0);
      Metadata.Maximum := A11y.Values.Exact_Decimal (10, 0);
      Metadata.Small_Increment := A11y.Values.Exact_Decimal (1, 0);
      Metadata.Large_Increment := A11y.Values.Exact_Decimal (5, 0);
      Check
        (A11y.Results.Succeeded (A11y.Values.Validate (Metadata)),
         "value framework validates coherent exact-decimal metadata");
      Metadata.Current := A11y.Values.Exact_Decimal (50, 1);
      Metadata.Minimum := A11y.Values.Exact_Decimal (5, 0);
      Metadata.Maximum := A11y.Values.Exact_Decimal (500, 2);
      Metadata.Small_Increment := A11y.Values.Exact_Decimal (5, 2);
      Metadata.Large_Increment := A11y.Values.Exact_Decimal (1, 1);
      Check
        (A11y.Results.Succeeded (A11y.Values.Validate (Metadata)),
         "value framework compares cross-scale decimal ranges exactly");
      Metadata.Current := A11y.Values.Exact_Decimal (501, 2);
      Check
        (A11y.Values.Validate (Metadata).Status = A11y.Results.Invalid_Range,
         "value framework rejects cross-scale decimal values outside range");
      Metadata.Current :=
        A11y.Values.Exact_Decimal
          (Long_Long_Integer'Last / 10 + 1, 0);
      Metadata.Minimum := A11y.Values.Exact_Decimal (0, 0);
      Metadata.Maximum :=
        A11y.Values.Exact_Decimal
          (Long_Long_Integer'Last / 10 + 1, 1);
      Metadata.Small_Increment := A11y.Values.Exact_Decimal (1, 0);
      Metadata.Large_Increment := A11y.Values.Exact_Decimal (2, 0);
      Check
        (A11y.Values.Validate (Metadata).Status = A11y.Results.Invalid_Range,
         "value framework rejects overflow-prone decimal comparisons without floating fallback");
      Metadata.Current := A11y.Values.Exact_Decimal (101, 1);
      Metadata.Minimum := A11y.Values.Exact_Decimal (0, 0);
      Metadata.Maximum := A11y.Values.Exact_Decimal (10, 0);
      Metadata.Small_Increment := A11y.Values.Exact_Decimal (1, 0);
      Metadata.Large_Increment := A11y.Values.Exact_Decimal (5, 0);
      Check
        (A11y.Values.Validate (Metadata).Status = A11y.Results.Invalid_Range,
         "value framework compares same-scale decimal ranges exactly");
      Metadata.Current := A11y.Values.Exact_Decimal (5, 0);
      Metadata.Small_Increment := A11y.Values.Exact_Decimal (0, 0);
      Check
        (A11y.Values.Validate (Metadata).Status = A11y.Results.Invalid_Range,
         "value framework checks decimal increment positivity exactly");
      Metadata.Small_Increment := A11y.Values.Exact_Decimal (1, 0);
      Metadata.Large_Increment := A11y.Values.Integer (5);
      Check
        (A11y.Values.Validate (Metadata).Status
         = A11y.Results.Invalid_Argument,
         "value framework rejects mixed numeric increment metadata");
      Metadata.Current := A11y.Values.Integer (5);
      Metadata.Minimum := A11y.Values.Integer (0);
      Metadata.Maximum := A11y.Values.Integer (10);
      Metadata.Small_Increment := A11y.Values.Integer (1);
      Metadata.Large_Increment := A11y.Values.Integer (5);

      Metadata.Units := To_Unbounded_String
        ("1234567890123456789012345678901234567890");
      declare
         Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         A11y.Resource_Limits.Set_Limit
           (Limits, A11y.Resource_Limits.Text_Returned, 4, Result);
         Check
           (A11y.Results.Succeeded (Result),
            "value framework fixture sets unit text-return limit");
         Check
           (A11y.Values.Validate (Metadata, Limits).Status
            = A11y.Results.Resource_Limit,
            "value framework bounds unit metadata text");
      end;
      Metadata.Units := To_Unbounded_String ("px");
      Metadata.Presentation_Text := To_Unbounded_String ("5 px");
      Check
        (A11y.Results.Succeeded (A11y.Values.Validate (Metadata)),
         "value framework accepts formatted presentation text");
      declare
         Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         A11y.Resource_Limits.Set_Limit
           (Limits, A11y.Resource_Limits.Text_Returned, 4, Result);
         Check
           (A11y.Results.Succeeded (Result),
            "value framework fixture sets presentation text-return limit");
         Metadata.Presentation_Text := To_Unbounded_String ("5.00 px");
         Check
           (A11y.Values.Validate (Metadata, Limits).Status
            = A11y.Results.Resource_Limit,
            "value framework bounds formatted presentation text");
      end;
      Metadata.Presentation_Text := Null_Unbounded_String;

      Metadata.Small_Increment := A11y.Values.Integer (0);
      Check
        (A11y.Values.Validate (Metadata).Status = A11y.Results.Invalid_Range,
         "value framework rejects zero increments");

      Metadata.Small_Increment := A11y.Values.Integer (6);
      Metadata.Large_Increment := A11y.Values.Integer (5);
      Check
        (A11y.Values.Validate (Metadata).Status = A11y.Results.Invalid_Range,
         "value framework rejects large increments below small increments");

      Metadata.Small_Increment := A11y.Values.Integer (1);
      Metadata.Large_Increment := A11y.Values.Integer (5);

      Converted := A11y.Values.To_Long_Float (Decimal_Value, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Converted > 12.33
         and then Converted < 12.35,
         "value framework converts exact decimals to native float only on request");
      Converted := A11y.Values.To_Long_Float_Lossless
        (A11y.Values.Exact_Decimal (Units => 125, Scale => 1), Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Converted = 12.5,
         "value framework converts lossless binary decimals for native APIs");
      Converted := A11y.Values.To_Long_Float_Lossless
        (Decimal_Value, Result);
      Check
        (Result.Status = A11y.Results.Native_Failure
         and then Converted = 0.0,
         "value framework diagnoses inexact native floating conversion");

      Converted := A11y.Values.To_Long_Float
        (A11y.Values.Boolean (True), Result);
      Check
        (Result.Status = A11y.Results.Unsupported_Capability
         and then Converted = 0.0,
         "value framework does not fabricate numeric values for booleans");
   end;

   declare
      Set : A11y.Selection.Selection_Set;
      Empty_Set : A11y.Selection.Selection_Set;
      Result : A11y.Results.Result;
      First : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (201);
      Second : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (202);
      Third : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (203);
   begin
      Check
        (A11y.Selection.Stable_Name (A11y.Selection.Contiguous_Multiple)
         = "contiguous-multiple"
         and then A11y.Selection.Metadata
           (A11y.Selection.Contiguous_Multiple).Allows_Range
         and then not A11y.Selection.Metadata
           (A11y.Selection.Single).Allows_Multiple
         and then A11y.Selection.Stable_Name (A11y.Selection.Forward)
           = "forward"
         and then A11y.Selection.Stable_Name (A11y.Selection.Backward)
           = "backward",
         "selection framework exposes stable selection mode metadata");

      declare
         Provider : Test_Selection_Provider;
         Provider_Result : A11y.Results.Result;
         Snapshot : A11y.Selection.Selection_Set;
      begin
         A11y.Selection.Configure
           (Provider.Selection, A11y.Selection.Multiple);
         Provider_Result :=
           A11y.Selection.Select_Node_Safely (Provider, First);
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then Provider.Select_Calls = 1
            and then A11y.Selection.Contains (Provider.Selection, First),
            "selection provider safely applies select requests");

         Provider_Result :=
           A11y.Selection.Toggle_Node_Safely (Provider, First);
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then Provider.Toggle_Calls = 1
            and then not A11y.Selection.Contains (Provider.Selection, First),
            "selection provider safely applies toggle requests");

         A11y.Selection.Configure (Provider.Selection, A11y.Selection.None);
         Provider_Result :=
           A11y.Selection.Select_Node_Safely (Provider, Second);
         Check
           (Provider_Result.Status = A11y.Results.Unsupported_Capability
            and then Provider.Select_Calls = 1,
            "selection provider rejects unsupported selection before mutation");

         A11y.Selection.Configure
           (Provider.Selection, A11y.Selection.Single,
            Requires_Selection => True);
         A11y.Selection.Select_Item (Provider.Selection, Third, Result);
         Check
           (A11y.Results.Succeeded (Result),
            "selection provider fixture prepares required selection");
         Provider_Result := A11y.Selection.Clear_Selection_Safely (Provider);
         Check
           (Provider_Result.Status = A11y.Results.Invalid_State
            and then Provider.Clear_Calls = 0,
            "selection provider rejects required clear before mutation");

         Provider.Raise_On_Mutate := True;
         A11y.Selection.Configure
           (Provider.Selection, A11y.Selection.Multiple);
         Provider_Result :=
           A11y.Selection.Select_Node_Safely (Provider, First);
         Check
           (Provider_Result.Status = A11y.Results.Internal_Error,
            "selection provider contains mutation exceptions");

         Provider.Raise_On_Query := True;
         Snapshot := A11y.Selection.Current_Selection_Safely (Provider);
         Check
           (A11y.Selection.Mode (Snapshot) = A11y.Selection.None
            and then A11y.Selection.Count (Snapshot) = 0,
            "selection provider contains query exceptions as empty selections");
      end;

      A11y.Selection.Configure (Set, A11y.Selection.Single);
      A11y.Selection.Select_Item (Set, First, Result);
      A11y.Selection.Select_Item (Set, Second, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Selection.Count (Set) = 1
         and then A11y.Selection.Contains (Set, Second)
         and then not A11y.Selection.Contains (Set, First),
         "selection framework enforces single selection mode");

      A11y.Selection.Configure (Set, A11y.Selection.Multiple);
      A11y.Selection.Select_Item (Set, Third, Result);
      Check
        (A11y.Selection.Count (Set) = 2
         and then A11y.Selection.Selected_At (Set, 1) = Second
         and then A11y.Selection.Selected_At (Set, 2) = Third,
         "selection framework keeps deterministic selected-item order");

      A11y.Selection.Set_Current_Item (Set, First, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Selection.Current_Item (Set) = First
         and then not A11y.Selection.Contains (Set, First)
         and then A11y.Results.Succeeded (A11y.Selection.Validate (Set)),
         "selection framework keeps current item separate from selection");

      A11y.Selection.Clear_Current_Item (Set, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Selection.Current_Item (Set) = A11y.Node_Ids.No_Node
         and then A11y.Selection.Contains (Set, Second)
         and then A11y.Selection.Contains (Set, Third),
         "selection framework clears current item without changing selection");

      A11y.Selection.Set_Current_Item (Set, First, Result);
      A11y.Selection.Configure (Set, A11y.Selection.None);
      Check
        (A11y.Selection.Count (Set) = 0
         and then A11y.Selection.Anchor (Set) = A11y.Node_Ids.No_Node
         and then A11y.Selection.Current_Item (Set) = A11y.Node_Ids.No_Node
         and then A11y.Results.Succeeded (A11y.Selection.Validate (Set)),
         "selection framework clears current item for nonselectable mode");
      A11y.Selection.Configure (Set, A11y.Selection.Multiple);
      A11y.Selection.Select_Item (Set, Second, Result);
      A11y.Selection.Select_Item (Set, Third, Result);

      A11y.Selection.Toggle (Set, Third, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then not A11y.Selection.Contains (Set, Third),
         "selection framework toggles existing selected items off");

      A11y.Selection.Configure (Set, A11y.Selection.Single, Requires_Selection => True);
      A11y.Selection.Clear (Set, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then A11y.Selection.Count (Set) = 1,
         "selection framework rejects clearing required selection");

      A11y.Selection.Configure
        (Empty_Set, A11y.Selection.Multiple, Requires_Selection => True);
      A11y.Selection.Clear (Empty_Set, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then A11y.Selection.Count (Empty_Set) = 0,
         "selection framework rejects clearing empty required selection");

      A11y.Selection.Select_Item (Set, A11y.Node_Ids.No_Node, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable,
         "selection framework rejects invalid node identities");

      Check
        (A11y.Results.Succeeded (A11y.Selection.Validate (Set)),
         "selection framework validates coherent selection snapshots");

      A11y.Selection.Configure
        (Empty_Set, A11y.Selection.Multiple, Requires_Selection => True);
      Check
        (A11y.Selection.Validate (Empty_Set).Status = A11y.Results.Invalid_State,
         "selection framework rejects required empty selection snapshots");

      A11y.Selection.Configure
        (Empty_Set, A11y.Selection.None, Requires_Selection => True);
      Check
        (A11y.Selection.Validate (Empty_Set).Status = A11y.Results.Invalid_State,
         "selection framework rejects required nonselectable snapshots");

      declare
         Range_Nodes : A11y.Selection.Node_Vectors.Vector;
         Duplicate_Nodes : A11y.Selection.Node_Vectors.Vector;
         Invalid_Nodes : A11y.Selection.Node_Vectors.Vector;
      begin
         A11y.Selection.Configure (Set, A11y.Selection.Contiguous_Multiple);
         A11y.Selection.Clear (Set, Result);
         Range_Nodes.Append (First);
         Range_Nodes.Append (Second);
         Range_Nodes.Append (Third);
         A11y.Selection.Select_Range (Set, Range_Nodes, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then A11y.Selection.Count (Set) = 3
            and then A11y.Selection.Selected_At (Set, 1) = First
            and then A11y.Selection.Selected_At (Set, 2) = Second
            and then A11y.Selection.Selected_At (Set, 3) = Third
            and then A11y.Selection.Anchor (Set) = First
            and then A11y.Selection.Current_Item (Set) = Third,
            "selection framework selects stable identity ranges atomically");
         Check
           (A11y.Selection.Direction (Set) = A11y.Selection.Forward,
            "selection framework defaults range direction to forward");

         A11y.Selection.Clear (Set, Result);
         A11y.Selection.Select_Range
           (Set,
            Range_Nodes,
            Result,
            Direction => A11y.Selection.Backward);
         Check
           (A11y.Results.Succeeded (Result)
            and then A11y.Selection.Direction (Set) = A11y.Selection.Backward,
            "selection framework records explicit backward range direction");

         A11y.Selection.Select_Range
           (Set,
            Range_Nodes,
            Result,
            Direction => A11y.Selection.No_Direction);
         Check
           (Result.Status = A11y.Results.Invalid_Argument
            and then A11y.Selection.Direction (Set) = A11y.Selection.Backward,
            "selection framework rejects ambiguous multi-node range direction");

         A11y.Selection.Configure (Empty_Set, A11y.Selection.Multiple);
         A11y.Selection.Select_Range (Empty_Set, Range_Nodes, Result);
         Check
           (Result.Status = A11y.Results.Unsupported_Capability
            and then A11y.Selection.Count (Empty_Set) = 0,
            "selection framework rejects range requests for non-range modes");

         Duplicate_Nodes.Append (First);
         Duplicate_Nodes.Append (First);
         A11y.Selection.Select_Range (Set, Duplicate_Nodes, Result);
         Check
           (Result.Status = A11y.Results.Invalid_State
            and then A11y.Selection.Count (Set) = 3,
            "selection framework rejects duplicate range identities without mutation");

         Invalid_Nodes.Append (First);
         Invalid_Nodes.Append (A11y.Node_Ids.No_Node);
         A11y.Selection.Select_Range (Set, Invalid_Nodes, Result);
         Check
           (Result.Status = A11y.Results.Node_Unavailable
            and then A11y.Selection.Count (Set) = 3,
            "selection framework rejects invalid range identities without mutation");
      end;

      declare
         All_Nodes : A11y.Selection.Node_Vectors.Vector;
         Duplicate_Nodes : A11y.Selection.Node_Vectors.Vector;
         Invalid_Nodes : A11y.Selection.Node_Vectors.Vector;
      begin
         A11y.Selection.Configure (Set, A11y.Selection.Multiple);
         All_Nodes.Append (First);
         All_Nodes.Append (Second);
         All_Nodes.Append (Third);
         A11y.Selection.Select_All (Set, All_Nodes, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then A11y.Selection.Count (Set) = 3
            and then A11y.Selection.Selected_At (Set, 1) = First
            and then A11y.Selection.Selected_At (Set, 2) = Second
            and then A11y.Selection.Selected_At (Set, 3) = Third
            and then A11y.Selection.Anchor (Set) = First
            and then A11y.Selection.Current_Item (Set) = Third
            and then A11y.Selection.Direction (Set) = A11y.Selection.Forward,
            "selection framework selects all stable identities atomically");

         A11y.Selection.Configure (Empty_Set, A11y.Selection.Single);
         A11y.Selection.Select_All (Empty_Set, All_Nodes, Result);
         Check
           (Result.Status = A11y.Results.Unsupported_Capability
            and then A11y.Selection.Count (Empty_Set) = 0,
            "selection framework rejects multi-item select-all for single mode");

         Duplicate_Nodes.Append (First);
         Duplicate_Nodes.Append (First);
         A11y.Selection.Select_All (Set, Duplicate_Nodes, Result);
         Check
           (Result.Status = A11y.Results.Invalid_State
            and then A11y.Selection.Count (Set) = 3,
            "selection framework rejects duplicate select-all identities without mutation");

         Invalid_Nodes.Append (First);
         Invalid_Nodes.Append (A11y.Node_Ids.No_Node);
         A11y.Selection.Select_All (Set, Invalid_Nodes, Result);
         Check
           (Result.Status = A11y.Results.Node_Unavailable
            and then A11y.Selection.Count (Set) = 3,
            "selection framework rejects invalid select-all identities without mutation");
      end;
   end;

   declare
      Set : A11y.Selection.Selection_Set;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      Result : A11y.Results.Result;
      First : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (211);
      Second : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (212);
      Third : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (213);
   begin
      Check
        (A11y.Selection.Capacity (Set) = A11y.Selection.Max_Selected_Items,
         "selection framework defaults to the standard materialization capacity");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Selection_Items_Materialized,
         2,
         Result);
      Check
        (A11y.Results.Succeeded (Result),
         "selection framework fixture sets materialization capacity");
      A11y.Selection.Configure_Limits (Set, Limits, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Selection.Capacity (Set) = 2,
         "selection framework accepts resource-limit capacity");

      A11y.Selection.Configure (Set, A11y.Selection.Multiple);
      A11y.Selection.Select_Item (Set, First, Result);
      A11y.Selection.Select_Item (Set, Second, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Selection.Count (Set) = 2,
         "selection framework fills configured materialization capacity");
      A11y.Selection.Select_Item (Set, Third, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then A11y.Selection.Count (Set) = 2
         and then not A11y.Selection.Contains (Set, Third),
         "selection framework enforces configured materialization capacity");

      A11y.Selection.Configure (Set, A11y.Selection.Extended);
      A11y.Selection.Clear (Set, Result);
      declare
         Range_Nodes : A11y.Selection.Node_Vectors.Vector;
      begin
         Range_Nodes.Append (First);
         Range_Nodes.Append (Second);
         Range_Nodes.Append (Third);
         A11y.Selection.Select_Range (Set, Range_Nodes, Result);
         Check
           (Result.Status = A11y.Results.Resource_Limit
            and then A11y.Selection.Count (Set) = 0,
            "selection framework rejects oversized ranges without partial mutation");
      end;

      declare
         All_Nodes : A11y.Selection.Node_Vectors.Vector;
      begin
         A11y.Selection.Configure (Set, A11y.Selection.Multiple);
         A11y.Selection.Clear (Set, Result);
         All_Nodes.Append (First);
         All_Nodes.Append (Second);
         All_Nodes.Append (Third);
         A11y.Selection.Select_All (Set, All_Nodes, Result);
         Check
           (Result.Status = A11y.Results.Resource_Limit
            and then A11y.Selection.Count (Set) = 0,
            "selection framework rejects oversized select-all without partial mutation");
      end;

      A11y.Selection.Select_Item (Set, First, Result);
      A11y.Selection.Select_Item (Set, Second, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Selection.Count (Set) = 2,
         "selection framework restores selected items for shrink-limit checks");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Selection_Items_Materialized,
         1,
         Result);
      Check
        (A11y.Results.Succeeded (Result),
         "selection framework fixture sets smaller materialization capacity");
      A11y.Selection.Configure_Limits (Set, Limits, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then A11y.Selection.Capacity (Set) = 2,
         "selection framework rejects shrinking below selected items");

      Limits.Limits (A11y.Resource_Limits.Selection_Items_Materialized) := 0;
      A11y.Selection.Configure_Limits (Set, Limits, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument,
         "selection framework rejects invalid materialization limits");
   end;

   declare
      Set : A11y.Selection.Selection_Set;
      Result : A11y.Results.Result;
   begin
      A11y.Selection.Configure (Set, A11y.Selection.Multiple);
      for Index in 1 .. A11y.Selection.Max_Selected_Items loop
         A11y.Selection.Select_Item
           (Set, A11y.Node_Ids.From_Natural (Index), Result);
      end loop;

      A11y.Selection.Select_Item
        (Set,
         A11y.Node_Ids.From_Natural
           (A11y.Selection.Max_Selected_Items + 1),
         Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable,
         "selection framework rejects invalid identities before capacity checks");
   end;

   declare
      use Ada.Strings.Wide_Wide_Unbounded;
      Content : constant Wide_Wide_String := "A" & Wide_Wide_Character'Val (16#1F600#) & "B";
      Span : A11y.Text.Text_Range :=
        A11y.Text.Make_Range (A11y.Text.Code_Point_Position (0), 2);
      Empty : constant A11y.Text.Text_Range :=
        A11y.Text.Make_Range (A11y.Text.Code_Point_Position (1), 0);
      Invalid : constant A11y.Text.Text_Range :=
        A11y.Text.Make_Range
          (A11y.Text.Code_Point_Position (3),
           A11y.Text.Code_Point_Position (2));
      Result : A11y.Results.Result;
      Slice : Unbounded_Wide_Wide_String;
      Units : Natural;
      Request : A11y.Text.Text_Edit_Request;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      Check
        (A11y.Text.Is_Valid (Span)
         and then A11y.Text.Length (Span) = 2
         and then A11y.Text.Index (A11y.Text.Last (Span)) = 2,
         "text framework represents opaque code-point ranges");
      Check
        (A11y.Text.Is_Within
           (Content'Length,
            A11y.Text.Code_Point_Position (Content'Length))
         and then not A11y.Text.Is_Within
           (Content'Length,
            A11y.Text.Code_Point_Position (Content'Length + 1))
         and then A11y.Text.Is_Within (Content'Length, Span),
         "text framework validates positions and ranges against content length");

      Check
        (A11y.Text.Stable_Name (A11y.Text.Protected_Text)
         = "protected-text"
         and then not A11y.Text.Metadata
           (A11y.Text.Protected_Text).Exposes_Text
         and then A11y.Text.Metadata (A11y.Text.Plain_Text).Exposes_Text,
         "text framework exposes stable protected-text metadata");

      Check
        (A11y.Text.Classification.Exposes_Text (A11y.Text.Plain_Text)
         and then not A11y.Text.Classification.Exposes_Text
           (A11y.Text.Protected_Text)
         and then A11y.Text.Classification.Is_Protected
           (A11y.Text.Protected_Text),
         "text classification preserves protected-text exposure rules");

      Slice := A11y.Text.Slice
        (Content, Span, A11y.Text.Plain_Text, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then To_Wide_Wide_String (Slice)'Length = 2,
         "text framework returns bounded plain text slices");

      declare
         Provider : Test_Text_Provider :=
           (Content => To_Unbounded_Wide_Wide_String (Content),
            Policy => A11y.Text.Plain_Text,
            Read_Only => False,
            Edit_Calls => 0,
            Raise_On_Query => False,
            Raise_On_Count => False,
            Raise_On_Edit => False,
            Return_Oversized_Text => False);
         Provider_Node : constant A11y.Node_Ids.Node_Id :=
           A11y.Node_Ids.From_Natural (801);
         Provider_Text : Unbounded_Wide_Wide_String;
         Provider_Result : A11y.Results.Result;
      begin
         Provider_Text :=
           A11y.Text.Text_Range_Safely
             (Provider, Start => 0, Count => 2, Result => Provider_Result);
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then To_Wide_Wide_String (Provider_Text)'Length = 2,
            "text provider safely returns bounded plain text ranges");

         Provider.Return_Oversized_Text := True;
         Provider_Text :=
           A11y.Text.Text_Range_Safely
             (Provider, Start => 0, Count => 1, Result => Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Invalid_State
            and then To_Wide_Wide_String (Provider_Text)'Length = 0,
            "text provider rejects oversized range replies before native projection");
         Provider.Return_Oversized_Text := False;

         Provider.Policy := A11y.Text.Protected_Text;
         Provider.Raise_On_Count := True;
         Provider_Result :=
           A11y.Text.Apply_Edit_Safely
             (Provider,
              Provider_Node,
              A11y.Text.Insert_Text,
              Start => Natural'Last,
              Count => 1,
              Replacement => "Z");
         Check
           (Provider_Result.Status = A11y.Results.Permission_Denied
            and then Provider.Edit_Calls = 0,
            "editable text provider denies protected edits before length queries");
         Provider.Raise_On_Count := False;

         Provider_Text :=
           A11y.Text.Text_Range_Safely
             (Provider, Start => 0, Count => 1, Result => Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Permission_Denied
            and then To_Wide_Wide_String (Provider_Text)'Length = 0,
            "text provider denies protected range queries before provider text retrieval");

         Provider.Policy := A11y.Text.Plain_Text;
         Provider.Read_Only := True;
         Provider_Result :=
           A11y.Text.Apply_Edit_Safely
             (Provider,
              Provider_Node,
              A11y.Text.Insert_Text,
              Start => 1,
              Count => 0,
              Replacement => "Z");
         Check
           (Provider_Result.Status = A11y.Results.Read_Only
            and then Provider.Edit_Calls = 0,
            "editable text provider rejects read-only edits before mutation");

         Provider.Read_Only := False;
         Provider_Result :=
           A11y.Text.Apply_Edit_Safely
             (Provider,
              A11y.Node_Ids.No_Node,
              A11y.Text.Insert_Text,
              Start => 1,
              Count => 0,
              Replacement => "Z");
         Check
           (Provider_Result.Status = A11y.Results.Node_Unavailable
            and then Provider.Edit_Calls = 0,
            "editable text provider rejects invalid node identities before mutation");

         Provider_Result :=
           A11y.Text.Apply_Edit_Safely
             (Provider,
              Provider_Node,
              A11y.Text.Set_Text,
              Start => 0,
              Count => 0,
              Replacement => "Updated");
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then Provider.Edit_Calls = 1
            and then To_Wide_Wide_String (Provider.Content) = "Updated",
            "editable text provider safely applies validated edit requests");

         Provider.Raise_On_Edit := True;
         Provider_Result :=
           A11y.Text.Apply_Edit_Safely
             (Provider,
              Provider_Node,
              A11y.Text.Set_Text,
              Start => 0,
              Count => 0,
              Replacement => "Ignored");
         Check
           (Provider_Result.Status = A11y.Results.Internal_Error
            and then Provider.Edit_Calls = 1,
            "editable text provider contains mutation exceptions");

         Provider.Raise_On_Query := True;
         Provider_Text :=
           A11y.Text.Text_Range_Safely
             (Provider, Start => 0, Count => 1, Result => Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Internal_Error
            and then To_Wide_Wide_String (Provider_Text)'Length = 0,
            "text provider contains query exceptions as empty ranges");
      end;

      Slice := A11y.Text.Slice
        (Content, Span, A11y.Text.Protected_Text, Result);
      Check
        (Result.Status = A11y.Results.Permission_Denied
         and then Length (Slice) = 0,
         "text framework redacts protected text");

      Slice := A11y.Text.Slice
        (Content, Invalid, A11y.Text.Plain_Text, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range,
         "text framework rejects invalid ranges");

      Slice := A11y.Text.Slice
        (Content, Empty, A11y.Text.Plain_Text, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Length (Slice) = 0,
         "text framework accepts empty ranges");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Text_Returned,
         1,
         Result);
      Check
        (A11y.Results.Succeeded (Result),
         "text framework fixture sets configured text-return limit");
      Slice := A11y.Text.Slice
        (Content,
         A11y.Text.Make_Range (A11y.Text.Code_Point_Position (0), 1),
         A11y.Text.Plain_Text,
         Limits,
         Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then To_Wide_Wide_String (Slice) = "A",
         "text framework accepts configured-limit text slices");
      Slice := A11y.Text.Slice
        (Content, Span, A11y.Text.Plain_Text, Limits, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Length (Slice) = 0,
         "text framework enforces configured text-return limits");

      Span := A11y.Text.Bounded_Code_Point_Range
        (Content'Length, Start => 1, Count => 2, Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Text.Index (A11y.Text.First (Span)) = 1
         and then A11y.Text.Length (Span) = 2,
         "text framework builds bounded code-point ranges");

      declare
         Combining : constant Wide_Wide_String :=
           "e" & Wide_Wide_Character'Val (16#0301#) & "x";
         Skin_Tone : constant Wide_Wide_String :=
           Wide_Wide_Character'Val (16#1F44B#)
           & Wide_Wide_Character'Val (16#1F3FD#)
           & "!";
         Family : constant Wide_Wide_String :=
           Wide_Wide_Character'Val (16#1F469#)
           & Wide_Wide_Character'Val (16#200D#)
           & Wide_Wide_Character'Val (16#1F467#)
           & "!";
         Flag : constant Wide_Wide_String :=
           Wide_Wide_Character'Val (16#1F1E9#)
           & Wide_Wide_Character'Val (16#1F1F0#)
           & "!";
         Cluster_Slice : Unbounded_Wide_Wide_String;
         Grapheme_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         Check
           (A11y.Text.Grapheme_Cluster_Count (Combining) = 2
            and then A11y.Text.Grapheme_Cluster_Count (Skin_Tone) = 2
            and then A11y.Text.Grapheme_Cluster_Count (Family) = 2
            and then A11y.Text.Grapheme_Cluster_Count (Flag) = 2,
            "text framework counts common multi-code-point grapheme clusters");

         Span := A11y.Text.Grapheme_Cluster_Range
           (Combining, Start => 0, Count => 1, Result => Result);
         Cluster_Slice := A11y.Text.Slice
           (Combining, Span, A11y.Text.Plain_Text, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then A11y.Text.Index (A11y.Text.First (Span)) = 0
            and then A11y.Text.Length (Span) = 2
            and then To_Wide_Wide_String (Cluster_Slice) = Combining (1 .. 2),
            "text framework maps grapheme ranges to code-point-backed text ranges");

         Cluster_Slice := A11y.Text.Slice_Grapheme_Clusters
           (Combining, Start => 0, Count => 1,
            Policy => A11y.Text.Plain_Text, Result => Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then To_Wide_Wide_String (Cluster_Slice) = Combining (1 .. 2),
            "text framework slices text by grapheme cluster ranges");

         Span := A11y.Text.Grapheme_Cluster_Range
           (Family, Start => 1, Count => 1, Result => Result);
         Cluster_Slice := A11y.Text.Slice
           (Family, Span, A11y.Text.Plain_Text, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then A11y.Text.Index (A11y.Text.First (Span)) = 3
            and then A11y.Text.Length (Span) = 1
            and then To_Wide_Wide_String (Cluster_Slice) = "!",
            "text framework navigates after zero-width-joiner grapheme clusters");

         declare
            Shifted : constant Wide_Wide_String (20 .. 22) := Combining;
         begin
            Span := A11y.Text.Grapheme_Cluster_Range
              (Shifted, Start => 1, Count => 1, Result => Result);
            Check
              (A11y.Results.Succeeded (Result)
               and then A11y.Text.Index (A11y.Text.First (Span)) = 2
               and then A11y.Text.Length (Span) = 1,
               "text framework handles non-1 string lower bounds for grapheme ranges");
         end;

         Span := A11y.Text.Grapheme_Cluster_Range
           (Combining, Start => 2, Count => 1, Result => Result);
         Check
           (Result.Status = A11y.Results.Invalid_Range
            and then not A11y.Text.Is_Valid (Span),
            "text framework rejects out-of-range grapheme requests");

         Span := A11y.Text.Grapheme_Cluster_Range
           (Combining,
            Start => Natural'Last,
            Count => 1,
            Result => Result);
         Check
           (Result.Status = A11y.Results.Invalid_Range
            and then not A11y.Text.Is_Valid (Span),
            "text framework rejects overflowing grapheme ranges without exceptions");

         Cluster_Slice := A11y.Text.Slice_Grapheme_Clusters
           (Combining, Start => 0, Count => 1,
            Policy => A11y.Text.Protected_Text, Result => Result);
         Check
           (Result.Status = A11y.Results.Permission_Denied
            and then Length (Cluster_Slice) = 0,
            "text framework redacts grapheme cluster slices for protected text");

         Cluster_Slice := A11y.Text.Slice_Grapheme_Clusters
           (Combining, Start => Natural'Last, Count => 1,
            Policy => A11y.Text.Protected_Text, Result => Result);
         Check
           (Result.Status = A11y.Results.Permission_Denied
            and then Length (Cluster_Slice) = 0,
            "text framework denies protected grapheme cluster slices before range conversion");

         Request := A11y.Text.Validate_Grapheme_Edit_Request
           (Combining,
            A11y.Text.Replace_Text,
            Start => Natural'Last,
            Count => 1,
            Replacement => "!",
            Policy => A11y.Text.Protected_Text,
            Read_Only => False,
            Result => Result);
         Check
           (Result.Status = A11y.Results.Permission_Denied
            and then not A11y.Text.Is_Valid (Request.Span),
            "text framework denies protected grapheme edits before range conversion");

         Request := A11y.Text.Validate_Grapheme_Edit_Request
           (Combining,
            A11y.Text.Delete_Text,
            Start => 0,
            Count => 1,
            Replacement => "",
            Policy => A11y.Text.Plain_Text,
            Read_Only => False,
            Result => Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Request.Kind = A11y.Text.Delete_Text
            and then A11y.Text.Index (A11y.Text.First (Request.Span)) = 0
            and then A11y.Text.Length (Request.Span) = 2,
            "text framework validates grapheme-indexed edit requests");

         Request := A11y.Text.Validate_Grapheme_Edit_Request
           (Combining,
            A11y.Text.Insert_Text,
            Start => 1,
            Count => 0,
            Replacement => "!",
            Policy => A11y.Text.Plain_Text,
            Read_Only => False,
            Result => Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Request.Kind = A11y.Text.Insert_Text
            and then A11y.Text.Index (A11y.Text.First (Request.Span)) = 2
            and then A11y.Text.Length (Request.Span) = 0,
            "text framework validates grapheme-indexed insert positions");

         Request := A11y.Text.Validate_Grapheme_Edit_Request
           (Combining,
            A11y.Text.Replace_Text,
            Start => 2,
            Count => 1,
            Replacement => "!",
            Policy => A11y.Text.Plain_Text,
            Read_Only => False,
            Result => Result);
         Check
           (Result.Status = A11y.Results.Invalid_Range
            and then not A11y.Text.Is_Valid (Request.Span),
            "text framework rejects out-of-range grapheme edit requests");

         A11y.Resource_Limits.Set_Limit
           (Grapheme_Limits,
            A11y.Resource_Limits.Text_Returned,
            1,
            Result);
         Check
           (A11y.Results.Succeeded (Result),
            "text framework fixture sets configured grapheme-return limit");
         Span := A11y.Text.Grapheme_Cluster_Range
           (Combining,
            Start => 0,
            Count => 2,
            Limits => Grapheme_Limits,
            Result => Result);
         Check
           (Result.Status = A11y.Results.Resource_Limit
            and then not A11y.Text.Is_Valid (Span),
            "text framework enforces configured grapheme range limits");
      end;

      Span := A11y.Text.Bounded_Code_Point_Range
        (Content'Length, Start => Content'Length + 1, Count => 0,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range,
         "text framework rejects out-of-range code-point starts");

      Span := A11y.Text.Bounded_Code_Point_Range
        (Content'Length, Start => 0,
         Count => A11y.Text.Max_Text_Returned + 1, Result => Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit,
         "text framework rejects oversized external text ranges");

      Span := A11y.Text.Bounded_Code_Point_Range
        (Content'Length,
         Start => 0,
         Count => 2,
         Limits => Limits,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then not A11y.Text.Is_Valid (Span),
         "text framework enforces configured text-return range limits");

      Limits.Limits (A11y.Resource_Limits.Text_Returned) :=
        A11y.Resource_Limits.Limit_Value (A11y.Text.Max_Text_Returned + 1);
      Slice := A11y.Text.Slice
        (Content, Empty, A11y.Text.Plain_Text, Limits, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Length (Slice) = 0,
         "text framework rejects impossible configured text-return limits");
      Limits.Limits (A11y.Resource_Limits.Text_Returned) := 0;
      Span := A11y.Text.Bounded_Code_Point_Range
        (Content'Length,
         Start => 0,
         Count => 0,
         Limits => Limits,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then not A11y.Text.Is_Valid (Span),
         "text framework rejects invalid text-return limit configs");
      Limits := A11y.Resource_Limits.Default_Config;

      Span := A11y.Text.Make_Range
        (A11y.Text.Code_Point_Position (Natural'Last), 1);
      Check
        (not A11y.Text.Is_Valid (Span)
         and then not A11y.Text.Is_Valid (A11y.Text.Last (Span)),
         "text framework marks overflowing direct ranges invalid");
      Slice := A11y.Text.Slice
        (Content, Span, A11y.Text.Plain_Text, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range
         and then Length (Slice) = 0,
         "text framework rejects huge direct ranges without overflow");

      declare
         Shifted : constant Wide_Wide_String (10 .. 12) := Content;
      begin
         Span := A11y.Text.Make_Range
           (A11y.Text.Code_Point_Position (1), 2);
         Slice := A11y.Text.Slice
           (Shifted, Span, A11y.Text.Plain_Text, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then To_Wide_Wide_String (Slice)
              = Wide_Wide_Character'Val (16#1F600#) & "B",
            "text framework handles non-1 string lower bounds");
      end;

      Span := A11y.Text.Make_Range
        (A11y.Text.Code_Point_Position (1), 2);
      Units := A11y.Text.UTF_16_Units (Content, Span, Result);
      Check
        (A11y.Results.Succeeded (Result) and then Units = 3,
         "text framework counts UTF-16 units for supplementary-plane characters");

      Span := A11y.Text.Make_Range
        (A11y.Text.Code_Point_Position (Natural'Last), 1);
      Units := A11y.Text.UTF_16_Units (Content, Span, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range and then Units = 0,
         "text framework rejects huge UTF-16 ranges without overflow");

      Check
        (A11y.Text.Stable_Name (A11y.Text.Insert_Text) = "insert-text"
         and then A11y.Text.Metadata
           (A11y.Text.Set_Text).Requires_Range = False
         and then A11y.Text.Metadata
           (A11y.Text.Replace_Text).Requires_Text,
         "text framework exposes stable edit request metadata");

      Check
        (A11y.Text.Classification.Edit_Requires_Range
           (A11y.Text.Insert_Text)
         and then not A11y.Text.Classification.Edit_Requires_Range
           (A11y.Text.Set_Text)
         and then A11y.Text.Classification.Edit_Requires_Text
           (A11y.Text.Replace_Text)
         and then not A11y.Text.Classification.Edit_Requires_Text
           (A11y.Text.Delete_Text)
         and then A11y.Text.Classification.Edit_Requires_Nonempty_Range
           (A11y.Text.Delete_Text),
         "text classification preserves edit-kind preconditions");

      Check
        (A11y.Text.Classification.Edit_Span_Count_Allowed
           (A11y.Text.Insert_Text, 0)
         and then not A11y.Text.Classification.Edit_Span_Count_Allowed
           (A11y.Text.Replace_Text, 0)
         and then A11y.Text.Classification.Edit_Span_Count_Allowed
           (A11y.Text.Set_Text, 0)
         and then not A11y.Text.Classification.Edit_Span_Count_Allowed
           (A11y.Text.Set_Text, 1)
         and then A11y.Text.Classification.Edit_Allowed_By_Policy
           (A11y.Text.Plain_Text, False)
         and then not A11y.Text.Classification.Edit_Allowed_By_Policy
           (A11y.Text.Protected_Text, False)
         and then not A11y.Text.Classification.Edit_Allowed_By_Policy
           (A11y.Text.Plain_Text, True),
         "text classification validates edit span and policy gates");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Insert_Text,
         Start => 1,
         Count => 0,
         Replacement => "X",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Request.Kind = A11y.Text.Insert_Text
         and then A11y.Text.Index (A11y.Text.First (Request.Span)) = 1
         and then A11y.Text.Length (Request.Span) = 0
         and then To_Wide_Wide_String (Request.Text) = "X",
         "text framework validates insert edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Delete_Text,
         Start => 1,
         Count => 1,
         Replacement => "",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Request.Kind = A11y.Text.Delete_Text
         and then A11y.Text.Length (Request.Span) = 1,
         "text framework validates delete edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Replace_Text,
         Start => 1,
         Count => 2,
         Replacement => "YZ",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Request.Kind = A11y.Text.Replace_Text
         and then A11y.Text.Length (Request.Span) = 2
         and then To_Wide_Wide_String (Request.Text) = "YZ",
         "text framework validates replace edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Set_Text,
         Start => 0,
         Count => 0,
         Replacement => "reset",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Request.Kind = A11y.Text.Set_Text
         and then not A11y.Text.Is_Valid (Request.Span)
         and then To_Wide_Wide_String (Request.Text) = "reset",
         "text framework validates whole-text edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Set_Text,
         Start => 1,
         Count => 0,
         Replacement => "reset",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range
         and then not A11y.Text.Is_Valid (Request.Span),
         "text framework rejects ranged whole-text edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Delete_Text,
         Start => 1,
         Count => 0,
         Replacement => "",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range,
         "text framework rejects empty delete edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Insert_Text,
         Start => 1,
         Count => 0,
         Replacement => "",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then not A11y.Text.Is_Valid (Request.Span),
         "text framework rejects empty insert edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Replace_Text,
         Start => 1,
         Count => 1,
         Replacement => "",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then not A11y.Text.Is_Valid (Request.Span),
         "text framework rejects empty replace edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Insert_Text,
         Start => Content'Length + 1,
         Count => 0,
         Replacement => "X",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range,
         "text framework rejects out-of-range insert edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Insert_Text,
         Start => 0,
         Count => 0,
         Replacement => "X",
         Policy => A11y.Text.Protected_Text,
         Read_Only => False,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Permission_Denied,
         "text framework rejects protected text edit requests");

      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Insert_Text,
         Start => 0,
         Count => 0,
         Replacement => "X",
         Policy => A11y.Text.Plain_Text,
         Read_Only => True,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Read_Only,
         "text framework rejects read-only text edit requests");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Text_Returned,
         1,
         Result);
      Request := A11y.Text.Validate_Edit_Request
        (Content'Length,
         A11y.Text.Insert_Text,
         Start => 0,
         Count => 0,
         Replacement => "XY",
         Policy => A11y.Text.Plain_Text,
         Read_Only => False,
         Limits => Limits,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit,
         "text framework enforces configured edit replacement limits");
   end;

   declare
      Table : A11y.Tables.Table_Snapshot;
      Result : A11y.Results.Result;
      Cell_1 : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (301);
      Cell_2 : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (302);
      Found : A11y.Tables.Cell_Reference;
      Coords : A11y.Tables.Cell_Coordinates;
      Sort : A11y.Tables.Sort_State;
   begin
      Check
        (A11y.Tables.Stable_Name (A11y.Tables.Logical_Coordinates) = "logical"
         and then A11y.Tables.Metadata
           (A11y.Tables.Logical_Coordinates).Stable_Node_Based
         and then not A11y.Tables.Metadata
           (A11y.Tables.Logical_Coordinates).Presentation_Based
         and then A11y.Tables.Stable_Name
           (A11y.Tables.Display_Coordinates) = "display"
         and then A11y.Tables.Metadata
           (A11y.Tables.Display_Coordinates).Presentation_Based,
         "table framework exposes stable coordinate-space metadata");

      Check
        (not A11y.Tables.Classification.Is_Presentation_Space
           (A11y.Tables.Logical_Coordinates)
         and then A11y.Tables.Classification.Is_Presentation_Space
           (A11y.Tables.Display_Coordinates),
         "table classification distinguishes presentation coordinates");

      Check
        (A11y.Tables.Stable_Name (A11y.Tables.Row_And_Column_Header)
         = "row-and-column-header"
         and then A11y.Tables.Metadata
           (A11y.Tables.Row_And_Column_Header).Applies_To_Rows
         and then A11y.Tables.Metadata
           (A11y.Tables.Row_And_Column_Header).Applies_To_Cols
         and then not A11y.Tables.Metadata
           (A11y.Tables.Not_Header).Applies_To_Rows,
         "table framework exposes stable header-scope metadata");

      Check
        (not A11y.Tables.Classification.Is_Header (A11y.Tables.Not_Header)
         and then A11y.Tables.Classification.Header_Applies_To_Rows
           (A11y.Tables.Row_And_Column_Header)
         and then A11y.Tables.Classification.Header_Applies_To_Columns
           (A11y.Tables.Corner_Header),
         "table classification preserves header applicability");

      Check
        (A11y.Tables.Stable_Name (A11y.Tables.Ascending) = "ascending"
         and then A11y.Tables.Metadata (A11y.Tables.Ascending).Is_Sorted
         and then A11y.Tables.Metadata (A11y.Tables.Ascending).Directional
         and then A11y.Tables.Stable_Name
           (A11y.Tables.Other_Sort_Order) = "other"
         and then A11y.Tables.Metadata
           (A11y.Tables.Other_Sort_Order).Is_Sorted
         and then not A11y.Tables.Metadata
           (A11y.Tables.Other_Sort_Order).Directional
         and then not A11y.Tables.Metadata
           (A11y.Tables.Not_Sorted).Is_Sorted,
         "table framework exposes stable sort-order metadata");

      Check
        (not A11y.Tables.Classification.Is_Sorted (A11y.Tables.Not_Sorted)
         and then A11y.Tables.Classification.Is_Directional_Sort
           (A11y.Tables.Descending)
         and then A11y.Tables.Classification.Sort_Key_Required
           (A11y.Tables.Ascending),
         "table classification preserves sort-key requirements");

      Check
        (A11y.Tables.Classification.Range_Fits
           ((First => 2, Count => 3), 5)
         and then not A11y.Tables.Classification.Range_Fits
           ((First => 4, Count => 2), 5)
         and then A11y.Tables.Classification.Span_Fits (2, 5, 3)
         and then not A11y.Tables.Classification.Span_Fits (2, 5, 4)
         and then A11y.Tables.Classification.Covers
           ((Row => 2, Column => 3), 3, 4, 2, 2)
         and then not A11y.Tables.Classification.Covers
           ((Row => 2, Column => 3), 4, 4, 2, 2),
         "table classification validates range span and coverage rules");

      A11y.Tables.Configure (Table, Rows => 1_000_000_000, Columns => 10);
      Check
        (A11y.Tables.Row_Count (Table) = 1_000_000_000
         and then A11y.Tables.Displayed_Row_Count (Table) = 1_000_000_000
         and then A11y.Tables.Displayed_Column_Count (Table) = 10
         and then A11y.Tables.Materialized_Cell_Count (Table) = 0,
         "table framework separates logical size from materialized cells");
      A11y.Tables.Configure_Displayed
        (Table, Rows => 25, Columns => 4, Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Tables.Row_Count (Table) = 1_000_000_000
         and then A11y.Tables.Displayed_Row_Count (Table) = 25
         and then A11y.Tables.Displayed_Column_Count (Table) = 4,
         "table framework records displayed dimensions separately from logical dimensions");
      A11y.Tables.Configure_Visible
        (Table,
         Rows => (First => 10, Count => 5),
         Columns => (First => 1, Count => 2),
         Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Tables.Visible_Rows (Table).First = 10
         and then A11y.Tables.Visible_Rows (Table).Count = 5
         and then A11y.Tables.Visible_Columns (Table).First = 1
         and then A11y.Tables.Visible_Columns (Table).Count = 2,
         "table framework records bounded visible row and column ranges");
      A11y.Tables.Configure_Visible
        (Table,
         Rows => (First => 24, Count => 2),
         Columns => (First => 1, Count => 2),
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range
         and then A11y.Tables.Visible_Rows (Table).First = 10
         and then A11y.Tables.Visible_Rows (Table).Count = 5,
         "table framework rejects visible ranges beyond displayed dimensions without mutation");
      A11y.Tables.Configure_Displayed
        (Table, Rows => 1_000_000_001, Columns => 4, Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range
         and then A11y.Tables.Displayed_Row_Count (Table) = 25
         and then A11y.Tables.Displayed_Column_Count (Table) = 4,
         "table framework rejects displayed dimensions beyond logical dimensions without mutation");
      A11y.Tables.Configure_Displayed
        (Table, Rows => 1_000_000_000, Columns => 10, Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Tables.Visible_Rows (Table).First = 0
         and then A11y.Tables.Visible_Rows (Table).Count = 1_000_000_000,
         "table framework restores displayed and visible dimensions for sparse lookup fixture");

      A11y.Tables.Add_Cell (Table, Cell_1, Row => 0, Column => 0, Result => Result);
      A11y.Tables.Add_Cell
        (Table,
         Cell_2,
         Row => 10,
         Column => 2,
         Row_Span => 2,
         Column_Span => 3,
         Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Tables.Materialized_Cell_Count (Table) = 2,
         "table framework records stable cell identities");

      A11y.Tables.Set_Current_Cell (Table, Cell_2, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Tables.Current_Cell (Table) = Cell_2,
         "table framework records current cells by stable Node_Id");

      A11y.Tables.Set_Current_Cell
        (Table, A11y.Node_Ids.From_Natural (399), Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then A11y.Tables.Current_Cell (Table) = Cell_2,
         "table framework rejects missing current-cell identities without mutation");

      A11y.Tables.Set_Current_Cell
        (Table, A11y.Node_Ids.No_Node, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then A11y.Tables.Current_Cell (Table) = Cell_2,
         "table framework rejects invalid current-cell identities without mutation");

      A11y.Tables.Clear_Current_Cell (Table, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Tables.Current_Cell (Table) = A11y.Node_Ids.No_Node,
         "table framework clears optional current-cell metadata");

      A11y.Tables.Set_Current_Cell (Table, Cell_2, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "table framework restores current-cell metadata for provider snapshots");

      A11y.Tables.Set_Sort (Table, Cell_1, A11y.Tables.Ascending, Result);
      Sort := A11y.Tables.Current_Sort (Table);
      Check
        (A11y.Results.Succeeded (Result)
         and then Sort.Order = A11y.Tables.Ascending
         and then Sort.Key_Node = Cell_1,
         "table framework records stable sort-key metadata");

      A11y.Tables.Set_Sort
        (Table, A11y.Node_Ids.No_Node, A11y.Tables.Descending, Result);
      Sort := A11y.Tables.Current_Sort (Table);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Sort.Order = A11y.Tables.Ascending
         and then Sort.Key_Node = Cell_1,
         "table framework rejects sorted states without a stable key");

      A11y.Tables.Set_Sort (Table, Cell_2, A11y.Tables.Not_Sorted, Result);
      Sort := A11y.Tables.Current_Sort (Table);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Sort.Order = A11y.Tables.Ascending
         and then Sort.Key_Node = Cell_1,
         "table framework rejects not-sorted states with stale sort keys");

      A11y.Tables.Clear_Sort (Table, Result);
      Sort := A11y.Tables.Current_Sort (Table);
      Check
        (A11y.Results.Succeeded (Result)
         and then Sort.Order = A11y.Tables.Not_Sorted
         and then Sort.Key_Node = A11y.Node_Ids.No_Node,
         "table framework clears optional sort metadata");

      A11y.Tables.Set_Sort (Table, Cell_1, A11y.Tables.Descending, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "table framework restores sort metadata for provider snapshots");
      Check
        (A11y.Results.Succeeded (A11y.Tables.Validate (Table)),
         "table framework validates coherent provider snapshots");

      declare
         Provider : Test_Table_Provider :=
           (Snapshot => Table,
            Raise_On_Query => False,
            Return_Invalid_Cell => False);
         Provider_Result : A11y.Results.Result;
         Provider_Cell : A11y.Tables.Cell_Reference;
         Provider_Coords : A11y.Tables.Cell_Coordinates;
      begin
         Table := A11y.Tables.Current_Table_Safely
           (Provider, Provider_Result);
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then A11y.Tables.Materialized_Cell_Count
              (Table) = 2
            and then A11y.Tables.Current_Cell
              (Table) = Cell_2,
            "table provider safely returns validated table snapshots");

         Provider_Cell :=
           A11y.Tables.Resolve_Cell_Safely
             (Provider, Row => 10, Column => 2, Result => Provider_Result);
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then Provider_Cell.Node = Cell_2,
            "table provider safely resolves cells through provider snapshots");

         Provider_Coords :=
           A11y.Tables.Resolve_Coordinates_Safely
             (Provider, Cell_1, Provider_Result);
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then Provider_Coords.Row = 0
            and then Provider_Coords.Column = 0,
            "table provider safely resolves reverse coordinates by Node_Id");

         Provider_Cell :=
           A11y.Tables.Resolve_Cell_Safely
             (Provider, Row => 999, Column => 9, Result => Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Node_Unavailable
            and then Provider_Cell.Node = A11y.Node_Ids.No_Node,
            "table provider preserves sparse missing-cell results");

         Provider.Return_Invalid_Cell := True;
         Provider_Cell :=
           A11y.Tables.Resolve_Cell_Safely
             (Provider, Row => 10, Column => 2, Result => Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Node_Unavailable
            and then Provider_Cell.Node = A11y.Node_Ids.No_Node,
            "table provider safe helpers reject invalid resolved cell identities");
         Provider.Return_Invalid_Cell := False;

         Provider_Coords :=
           A11y.Tables.Resolve_Coordinates_Safely
             (Provider, A11y.Node_Ids.No_Node, Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Node_Unavailable
            and then Provider_Coords.Row = 0
            and then Provider_Coords.Column = 0,
            "table provider safe helpers reject invalid reverse-lookup identities");

         Provider.Raise_On_Query := True;
         Provider_Cell :=
           A11y.Tables.Resolve_Cell_Safely
             (Provider, Row => 0, Column => 0, Result => Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Internal_Error
            and then Provider_Cell.Node = A11y.Node_Ids.No_Node,
            "table provider contains query exceptions as empty cell references");
      end;

      Found := A11y.Tables.Cell_At (Table, Row => 11, Column => 4);
      Check
        (Found.Node = Cell_2
         and then Found.Row_Span = 2
         and then Found.Column_Span = 3,
         "table framework resolves merged cells by span");

      Found := A11y.Tables.Resolve_Cell
        (Table, Row => 11, Column => 4, Result => Result);
      Check
        (A11y.Results.Succeeded (Result) and then Found.Node = Cell_2,
         "table framework centralizes valid cell resolution");

      Found := A11y.Tables.Resolve_Cell
        (Table, Row => 9, Column => 4, Result => Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then not A11y.Node_Ids.Is_Valid (Found.Node),
         "table framework centralizes sparse missing-cell results");

      Coords := A11y.Tables.Coordinates_Of (Table, Cell_2);
      Check
        (Coords.Row = 10 and then Coords.Column = 2,
         "table framework supports reverse coordinate lookup by Node_Id");

      Coords := A11y.Tables.Resolve_Coordinates
        (Table, Cell_1, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Coords.Row = 0
         and then Coords.Column = 0,
         "table framework resolves top-left cell coordinates explicitly");

      Coords := A11y.Tables.Resolve_Coordinates
        (Table, A11y.Node_Ids.From_Natural (399), Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Coords.Row = 0
         and then Coords.Column = 0,
         "table framework distinguishes missing reverse coordinate lookups");

      Coords := A11y.Tables.Resolve_Coordinates
        (Table, A11y.Node_Ids.No_Node, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable,
         "table framework rejects invalid reverse coordinate identities");

      A11y.Tables.Add_Cell
        (Table, Cell_2, Row => 20, Column => 1, Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_State,
         "table framework rejects duplicate cell identities");

      A11y.Tables.Add_Cell
        (Table,
         A11y.Node_Ids.From_Natural (305),
         Row => 9,
         Column => 3,
         Row_Span => 3,
         Column_Span => 1,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then A11y.Tables.Materialized_Cell_Count (Table) = 2,
         "table framework rejects overlapping merged-cell spans");

      A11y.Tables.Add_Cell
        (Table,
         A11y.Node_Ids.From_Natural (303),
         Row => 1_000_000_000,
         Column => 0,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range,
         "table framework rejects out-of-range coordinates");

      A11y.Tables.Configure
        (Table, Rows => A11y.Tables.Logical_Index'Last, Columns => 1);
      A11y.Tables.Add_Cell
        (Table,
         A11y.Node_Ids.From_Natural (304),
         Row => A11y.Tables.Logical_Index'Last - 1,
         Column => 0,
         Row_Span => 2,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_Range,
         "table framework rejects overflowing spans without arithmetic failure");
   end;

   declare
      Table : A11y.Tables.Table_Snapshot;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      Result : A11y.Results.Result;
   begin
      Check
        (A11y.Tables.Capacity (Table) = A11y.Tables.Max_Materialized_Cells,
         "table framework defaults to its hard materialized-cell capacity");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Virtual_Node_Realization,
         2,
         Result);
      Check
        (A11y.Results.Succeeded (Result),
         "resource-limit framework accepts small table realization limits");

      A11y.Tables.Configure_Limits (Table, Limits, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Tables.Capacity (Table) = 2,
         "table framework applies configured virtual-node realization limit");

      A11y.Tables.Configure (Table, Rows => 4, Columns => 4);
      A11y.Tables.Add_Cell
        (Table, A11y.Node_Ids.From_Natural (311), 0, 0, Result => Result);
      A11y.Tables.Add_Cell
        (Table, A11y.Node_Ids.From_Natural (312), 0, 1, Result => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Tables.Materialized_Cell_Count (Table) = 2,
         "table framework fills configured materialized-cell capacity");

      A11y.Tables.Add_Cell
        (Table, A11y.Node_Ids.From_Natural (313), 0, 2, Result => Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then A11y.Tables.Materialized_Cell_Count (Table) = 2,
         "table framework rejects materialization past configured capacity");

      A11y.Tables.Set_Capacity (Table, 1, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then A11y.Tables.Capacity (Table) = 2,
         "table framework rejects shrinking capacity below live cells");

      Limits.Limits (A11y.Resource_Limits.Virtual_Node_Realization) := 0;
      A11y.Tables.Configure_Limits (Table, Limits, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then A11y.Tables.Capacity (Table) = 2,
         "table framework rejects invalid zero realization limits");

      Limits := A11y.Resource_Limits.Default_Config;
      Limits.Limits (A11y.Resource_Limits.Virtual_Node_Realization) :=
        A11y.Resource_Limits.Limit_Value
          (A11y.Tables.Max_Materialized_Cells + 1);
      A11y.Tables.Configure_Limits (Table, Limits, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then A11y.Tables.Capacity (Table) = 2,
         "table framework rejects impossible realization limits");
   end;

   A11y_Diagnostic_Tests.Run;

   declare
      Doc : A11y.Documents.Document_Metadata;
      Img : A11y.Images.Image_Metadata;
      Surface : A11y.Windows.Surface_Metadata;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      Result : A11y.Results.Result;
   begin
      Doc.Role := A11y.Documents.Heading;
      Doc.Heading_Level := 2;
      Check
        (A11y.Documents.Stable_Name (A11y.Documents.Heading) = "heading"
         and then not A11y.Documents.Metadata
           (A11y.Documents.Heading).Landmark_By_Role
         and then A11y.Documents.Valid_Heading_Level (Doc.Heading_Level)
         and then A11y.Documents.Heading_Level_Applies (Doc)
         and then not A11y.Documents.Valid_Heading_Level (10),
         "document metadata exposes stable role metadata and validates heading levels");

      Doc.Role := A11y.Documents.Navigation;
      Check
        (A11y.Documents.Metadata
           (A11y.Documents.Navigation).Landmark_By_Role
         and then A11y.Documents.Is_Landmark (Doc),
         "document metadata identifies semantic landmarks");

      Check
        (A11y.Documents.Validate (Doc).Status = A11y.Results.Invalid_State
         and then not A11y.Documents.Heading_Level_Applies (Doc),
         "document metadata rejects heading levels on non-heading roles");

      Doc.Heading_Level := 0;
      Doc.Author := To_Unbounded_String ("author");
      Doc.Subject := To_Unbounded_String ("subject");
      Doc.Version := To_Unbounded_String ("v1");
      Doc.Revision := To_Unbounded_String ("r1");
      Doc.Creation_Metadata := To_Unbounded_String ("created");
      Doc.Modification_Metadata := To_Unbounded_String ("modified");
      Doc.Page_Count := 8;
      Doc.Current_Page := 3;
      Check
        (A11y.Documents.Has_Pagination (Doc)
         and then A11y.Documents.Pagination_Applies (Doc)
         and then A11y.Results.Succeeded (A11y.Documents.Validate (Doc)),
         "document metadata validates complete bounded metadata and pagination");
      declare
         Provider : Test_Document_Provider :=
           (Metadata => Doc,
            Raise_On_Query => False);
         Provider_Result : A11y.Results.Result;
         Provider_Metadata : A11y.Documents.Document_Metadata;
      begin
         Provider_Metadata :=
           A11y.Documents.Current_Metadata_Safely
             (Provider, Provider_Result);
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then Provider_Metadata.Role = A11y.Documents.Navigation
            and then Provider_Metadata.Current_Page = 3,
            "document provider safely returns validated document metadata");

         Provider.Metadata.Heading_Level := 3;
         Provider_Metadata :=
           A11y.Documents.Current_Metadata_Safely
             (Provider, Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Invalid_State
            and then Provider_Metadata.Role = A11y.Documents.Document
            and then Provider_Metadata.Heading_Level = 0,
            "document provider normalizes invalid metadata before native projection");

         Provider.Raise_On_Query := True;
         Provider_Metadata :=
           A11y.Documents.Current_Metadata_Safely
             (Provider, Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Internal_Error
            and then Provider_Metadata.Role = A11y.Documents.Document
            and then Provider_Metadata.Heading_Level = 0,
            "document provider contains query exceptions as empty document metadata");
      end;

      Doc.Current_Page := 9;
      Check
        (A11y.Documents.Validate (Doc).Status = A11y.Results.Invalid_Range
         and then not A11y.Documents.Pagination_Applies (Doc),
         "document metadata rejects current pages outside the declared page count");

      Doc.Page_Count := 0;
      Doc.Current_Page := 1;
      Check
        (A11y.Documents.Validate (Doc).Status = A11y.Results.Invalid_Range
         and then not A11y.Documents.Pagination_Applies (Doc),
         "document metadata rejects current pages without pagination metadata");

      Doc.Role := A11y.Documents.Annotation;
      Doc.Page_Count := 2;
      Doc.Current_Page := 1;
      Check
        (A11y.Documents.Validate (Doc).Status = A11y.Results.Invalid_Range
         and then not A11y.Documents.Pagination_Applies (Doc),
         "document metadata rejects pagination on nonstructural roles");

      Doc.Role := A11y.Documents.Navigation;
      Doc.Page_Count := 0;
      Doc.Current_Page := 0;

      A11y.Resource_Limits.Set_Limit
        (Limits, A11y.Resource_Limits.Text_Returned, 4, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "document metadata fixture sets text-return limit");

      Doc.Subject := To_Unbounded_String ("subj");
      Doc.Version := To_Unbounded_String ("v1");
      Doc.Revision := To_Unbounded_String ("r1");
      Doc.Creation_Metadata := To_Unbounded_String ("made");
      Doc.Modification_Metadata := To_Unbounded_String ("mod");
      Doc.Author := To_Unbounded_String ("12345");
      Check
        (A11y.Documents.Validate (Doc, Limits).Status
         = A11y.Results.Resource_Limit,
         "document metadata rejects extended text fields past returned-text limit");

      Doc.Author := To_Unbounded_String ("1234");
      Check
        (A11y.Results.Succeeded (A11y.Documents.Validate (Doc, Limits)),
         "document metadata accepts extended text fields at returned-text limit");

      Limits.Limits (A11y.Resource_Limits.Text_Returned) := 0;
      Check
        (A11y.Documents.Validate (Doc, Limits).Status
         = A11y.Results.Invalid_Argument,
         "document metadata rejects invalid resource-limit configs");

      Limits := A11y.Resource_Limits.Default_Config;
      A11y.Resource_Limits.Set_Limit
        (Limits, A11y.Resource_Limits.Text_Returned, 4, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "image metadata fixture sets text-return limit");

      Img.Kind := A11y.Images.Decorative;
      Check
        (A11y.Images.Stable_Name (A11y.Images.Decorative) = "decorative"
         and then not A11y.Images.Metadata
           (A11y.Images.Decorative).Exposed_By_Default
         and then not A11y.Images.Should_Expose (Img),
         "image metadata exposes stable kind metadata and hides decorative images");
      Img.Alternative_Text := To_Unbounded_String ("hidden label");
      Check
        (A11y.Images.Validate (Img, Limits).Status =
           A11y.Results.Invalid_State,
         "image metadata rejects decorative alternative text");
      Img.Alternative_Text := Null_Unbounded_String;
      Img.Long_Description := To_Unbounded_String ("hidden details");
      Check
        (A11y.Images.Validate (Img, Limits).Status =
           A11y.Results.Invalid_State,
         "image metadata rejects decorative long descriptions");
      Img.Long_Description := Null_Unbounded_String;
      Img.Caption := To_Unbounded_String ("hidden caption");
      Check
        (A11y.Images.Validate (Img, Limits).Status =
           A11y.Results.Invalid_State,
         "image metadata rejects decorative captions");
      Img.Caption := Null_Unbounded_String;
      Img.Kind := A11y.Images.Informative;
      Img.Alternative_Text := To_Unbounded_String ("Chart summary");
      Img.Caption := To_Unbounded_String ("Q1 revenue");
      Check
        (A11y.Images.Should_Expose (Img)
         and then A11y.Images.Has_Text_Alternative (Img)
         and then A11y.Images.Has_Caption (Img)
         and then not A11y.Images.Is_Structured (Img),
         "image metadata distinguishes informative alternatives and captions");
      Check
        (A11y.Images.Validate (Img, Limits).Status
         = A11y.Results.Resource_Limit,
         "image metadata rejects text alternatives past returned-text limit");

      Img.Alternative_Text := To_Unbounded_String ("1234");
      Img.Caption := To_Unbounded_String ("1234");
      Check
        (A11y.Results.Succeeded (A11y.Images.Validate (Img, Limits)),
         "image metadata accepts text alternatives at returned-text limit");

      declare
         Provider : Test_Image_Provider :=
           (Metadata => Img,
            Raise_On_Query => False);
         Provider_Result : A11y.Results.Result;
         Provider_Metadata : A11y.Images.Image_Metadata;
      begin
         Provider_Metadata :=
           A11y.Images.Current_Metadata_Safely
             (Provider, Provider_Result);
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then Provider_Metadata.Kind = A11y.Images.Informative
            and then To_String (Provider_Metadata.Alternative_Text) = "1234",
            "image provider safely returns validated informative metadata");

         Provider.Metadata.Kind := A11y.Images.Decorative;
         Provider.Metadata.Alternative_Text := To_Unbounded_String ("leak");
         Provider_Metadata :=
           A11y.Images.Current_Metadata_Safely
             (Provider, Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Invalid_State
            and then Provider_Metadata.Kind = A11y.Images.Decorative
            and then To_String (Provider_Metadata.Alternative_Text) = ""
            and then not A11y.Images.Should_Expose (Provider_Metadata),
            "image provider normalizes invalid decorative metadata before native projection");

         Provider.Raise_On_Query := True;
         Provider_Metadata :=
           A11y.Images.Current_Metadata_Safely
             (Provider, Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Internal_Error
            and then Provider_Metadata.Kind = A11y.Images.Decorative
            and then not A11y.Images.Should_Expose (Provider_Metadata),
            "image provider contains query exceptions as decorative metadata");
      end;

      Img.Kind := A11y.Images.Chart;
      Check
        (A11y.Images.Is_Structured (Img)
         and then A11y.Images.Stable_Name (Img.Kind) = "chart",
         "image metadata identifies structured image categories");
      Img.Kind := A11y.Images.Informative;

      Img.Has_Intrinsic_Size := True;
      Img.Intrinsic_Dimensions := (Width => 0, Height => 10);
      Check
        (A11y.Images.Validate (Img, Limits).Status
         = A11y.Results.Invalid_Range,
         "image metadata rejects zero intrinsic dimensions");

      Img.Intrinsic_Dimensions := (Width => 20, Height => 10);
      Check
        (A11y.Results.Succeeded (A11y.Images.Validate (Img, Limits)),
         "image metadata accepts positive intrinsic dimensions");

      Limits.Limits (A11y.Resource_Limits.Text_Returned) := 0;
      Check
        (A11y.Images.Validate (Img, Limits).Status
         = A11y.Results.Invalid_Argument,
         "image metadata rejects invalid resource-limit configs");

      Surface.Kind := A11y.Windows.Modal_Dialog;
      Surface.State.Visible := True;
      Check
        (A11y.Windows.Stable_Name (A11y.Windows.Modal_Dialog)
         = "modal-dialog"
         and then A11y.Windows.Metadata
           (A11y.Windows.Modal_Dialog).Modal_By_Kind
         and then A11y.Windows.Is_Top_Level (Surface.Kind)
         and then A11y.Windows.Is_Modal (Surface),
         "surface metadata exposes stable kind metadata for modal dialogs");
      declare
         Provider : Test_Surface_Provider :=
           (Metadata => Surface,
            Raise_On_Query => False);
         Provider_Result : A11y.Results.Result;
         Provider_Surface : A11y.Windows.Surface_Metadata;
      begin
         Provider_Surface :=
           A11y.Windows.Current_Surface_Safely
             (Provider, Provider_Result);
         Check
           (A11y.Results.Succeeded (Provider_Result)
            and then Provider_Surface.Kind = A11y.Windows.Modal_Dialog
            and then Provider_Surface.State.Visible,
            "surface provider safely returns validated surface metadata");

         Provider.Metadata.State.Visible := False;
         Provider.Metadata.State.Active := True;
         Provider_Surface :=
           A11y.Windows.Current_Surface_Safely
             (Provider, Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Invalid_State
            and then Provider_Surface.Kind = A11y.Windows.Embedded_Surface
            and then not Provider_Surface.State.Active
            and then not Provider_Surface.State.Visible,
            "surface provider normalizes invalid state before native projection");

         Provider.Metadata.State.Active := False;
         Provider.Metadata.State.Visible := True;
         Provider.Metadata.State.Maximized := True;
         Provider.Metadata.State.Fullscreen := True;
         Provider_Surface :=
           A11y.Windows.Current_Surface_Safely
             (Provider, Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Invalid_State
            and then Provider_Surface.Kind = A11y.Windows.Embedded_Surface
            and then not Provider_Surface.State.Maximized
            and then not Provider_Surface.State.Fullscreen,
            "surface provider rejects mutually exclusive presentation states");

         Provider.Metadata.State.Maximized := False;
         Provider.Metadata.State.Fullscreen := False;
         Provider.Raise_On_Query := True;
         Provider_Surface :=
           A11y.Windows.Current_Surface_Safely
             (Provider, Provider_Result);
         Check
           (Provider_Result.Status = A11y.Results.Internal_Error
            and then Provider_Surface.Kind = A11y.Windows.Embedded_Surface
            and then not Provider_Surface.State.Visible,
            "surface provider contains query exceptions as hidden embedded surfaces");
      end;
      Check
        (A11y.Windows.Stable_Name (A11y.Windows.Resizable) = "resizable"
         and then A11y.Windows.Metadata
           (A11y.Windows.Resizable).Operation_Capability
         and then not A11y.Windows.Metadata
           (A11y.Windows.Active).Operation_Capability,
         "surface metadata exposes stable state-flag metadata");
      A11y.Windows.Set_State
        (Surface.State, A11y.Windows.Resizable, True);
      Check
        (A11y.Windows.Has_State (Surface.State, A11y.Windows.Resizable),
         "surface metadata reads and writes state flags centrally");
      Surface.Kind := A11y.Windows.Tooltip;
      Surface.State.Modal := False;
      Check
        (not A11y.Windows.Is_Top_Level (Surface.Kind)
         and then not A11y.Windows.Is_Modal (Surface),
         "surface metadata distinguishes transient nonmodal surfaces");

      Check
        (A11y.Results.Succeeded (A11y.Windows.Validate (Surface)),
         "surface metadata validates coherent state");

      Surface.State.Visible := False;
      Surface.State.Active := True;
      Check
        (A11y.Windows.Validate (Surface).Status
         = A11y.Results.Invalid_State,
         "surface metadata rejects active hidden surfaces");

      Surface.State.Visible := True;
      Surface.State.Minimized := True;
      Check
        (A11y.Windows.Validate (Surface).Status
         = A11y.Results.Invalid_State,
         "surface metadata rejects active minimized surfaces");

      Surface.State.Active := False;
      Surface.State.Minimized := True;
      Surface.State.Fullscreen := True;
      Check
        (A11y.Windows.Validate (Surface).Status
         = A11y.Results.Invalid_State,
         "surface metadata rejects minimized fullscreen surfaces");

      Surface.State.Minimized := False;
      Surface.State.Fullscreen := False;
      declare
         Root_Node : constant A11y.Node_Ids.Node_Id :=
           A11y.Node_Ids.From_Natural (589);
         Surface_Node : constant A11y.Node_Ids.Node_Id :=
           A11y.Node_Ids.From_Natural (590);
         Result : A11y.Results.Result;
         Snapshot : A11y.Linux.ATSPi_Surfaces.Surface_Snapshot;
         Reply : A11y.Linux.ATSPi_Surfaces.Surface_Reply;
      begin
         Snapshot.Id := Surface_Node;
         Snapshot.Metadata := Surface;
         Snapshot.Metadata.Kind := A11y.Windows.Modal_Dialog;
         Snapshot.Metadata.State.Visible := True;
         Snapshot.Metadata.State.Active := True;
         Snapshot.Metadata.State.Modal := True;
         Snapshot.Metadata.State.Closable := True;
         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Kind_Name);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.String_Reply
            and then To_String (Reply.Text) = "modal-dialog",
            "Linux AT-SPI surface mapper reports stable surface kind names");

         declare
            Surface_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
              A11y.Resource_Limits.Default_Config;
         begin
            A11y.Resource_Limits.Set_Limit
              (Surface_Limits,
               A11y.Resource_Limits.Native_String_Size,
               4,
               Result);
            Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
              (Snapshot,
               A11y.Linux.ATSPi_Surfaces.Kind_Name,
               Surface_Limits);
            Check
              (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Error_Reply
               and then Reply.Status = A11y.Results.Resource_Limit,
               "Linux AT-SPI surface mapper bounds surface kind names");
         end;

         declare
            Invalid_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
              A11y.Resource_Limits.Default_Config;
         begin
            Invalid_Limits.Limits
              (A11y.Resource_Limits.Native_String_Size) := 0;
            Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
              (Snapshot,
               A11y.Linux.ATSPi_Surfaces.Surface_Role,
               Invalid_Limits);
            Check
              (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Error_Reply
               and then Reply.Status = A11y.Results.Invalid_Argument,
               "Linux AT-SPI surface mapper rejects invalid limit configs");
         end;

         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Surface_Role);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Role_Reply
            and then Reply.Role = A11y.Linux.ATSPi_Mappings.Dialog,
            "Linux AT-SPI surface mapper projects modal dialogs to dialog roles");

         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Surface_States);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.State_Set_Reply
            and then Reply.States (A11y.Linux.ATSPi_Mappings.Visible)
            and then Reply.States (A11y.Linux.ATSPi_Mappings.Showing)
            and then Reply.States (A11y.Linux.ATSPi_Mappings.Modal)
            and then Reply.States (A11y.Linux.ATSPi_Mappings.Active),
            "Linux AT-SPI surface mapper derives committed surface states");

         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Is_Top_Level);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Boolean_Reply
            and then Reply.Boolean_Item,
            "Linux AT-SPI surface mapper reports top-level surfaces");

         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Is_Modal);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Boolean_Reply
            and then Reply.Boolean_Item,
            "Linux AT-SPI surface mapper reports modal surfaces");

         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Is_Visible);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Boolean_Reply
            and then Reply.Boolean_Item,
            "Linux AT-SPI surface mapper reports visible surfaces");

         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Is_Active);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Boolean_Reply
            and then Reply.Boolean_Item,
            "Linux AT-SPI surface mapper reports active surfaces");

         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Can_Close);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Boolean_Reply
            and then Reply.Boolean_Item,
            "Linux AT-SPI surface mapper reports operation capabilities");

         Snapshot.Metadata.State.Visible := False;
         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Is_Active);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Error_Reply
            and then Reply.Status = A11y.Results.Invalid_State,
            "Linux AT-SPI surface mapper validates surface state");

         Snapshot.Metadata.State.Visible := True;
         A11y.Trees.Set_Root (Snapshot.Tree, Root_Node, Result);
         A11y.Trees.Attach (Snapshot.Tree, Root_Node, Surface_Node, Result);
         Snapshot.Root := Root_Node;
         Snapshot.Use_Tree_Projection := True;
         Snapshot.Exposure
           (A11y.Node_Ids.To_Natural (Surface_Node)) :=
             A11y.Nodes.Hide_Node_And_Subtree;
         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Is_Modal);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Error_Reply
            and then Reply.Status = A11y.Results.Node_Unavailable,
            "Linux AT-SPI surface mapper rejects hidden surface nodes");

         Snapshot.Exposure
           (A11y.Node_Ids.To_Natural (Surface_Node)) :=
             A11y.Nodes.Expose_Node;
         Snapshot.Use_Tree_Projection := False;
         Snapshot.Defunct := True;
         Reply := A11y.Linux.ATSPi_Surfaces.Query_Surface
           (Snapshot, A11y.Linux.ATSPi_Surfaces.Is_Modal);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Surfaces.Error_Reply
            and then Reply.Status = A11y.Results.Node_Unavailable,
            "Linux AT-SPI surface mapper rejects defunct surface snapshots");
      end;
   end;

   Check
     (A11y.Platforms.Native_Backend_Name'Length > 0,
      "platform policy delegates native backend naming through hostkit");

   declare
      Fixture_Nodes : constant A11y_Test_Fixtures.Node_Vectors.Vector :=
        A11y_Test_Fixtures.Nodes;
      Script : constant A11y_Test_Fixtures.Command_Vectors.Vector :=
        A11y_Test_Fixtures.Script;
      Saw_Password : Boolean := False;
      Saw_Decorative_Image : Boolean := False;
      Saw_Table : Boolean := False;
      Saw_Table_Cell : Boolean := False;
      Saw_Link : Boolean := False;
      Saw_Popup : Boolean := False;
      Saw_Shutdown : Boolean := False;
      Saw_Selection_Command : Boolean := False;
      Saw_Menu_Command : Boolean := False;
      Saw_Text_Edit_Command : Boolean := False;
      Saw_Window_Command : Boolean := False;
   begin
      for Item of Fixture_Nodes loop
         if Item.Id = A11y_Test_Fixtures.Password_Field_Id then
            Saw_Password := Item.Protected_Text
              and then Item.Role = A11y.Roles.Password_Field;
         elsif Item.Id = A11y_Test_Fixtures.Decorative_Image_Id then
            Saw_Decorative_Image :=
              Item.Image.Kind = A11y.Images.Decorative
              and then not A11y.Images.Should_Expose (Item.Image);
         elsif Item.Role = A11y.Roles.Table then
            Saw_Table := True;
         elsif Item.Id = A11y_Test_Fixtures.Table_Cell_Id then
            Saw_Table_Cell := Item.Role = A11y.Roles.Cell;
         elsif Item.Id = A11y_Test_Fixtures.Link_Id then
            Saw_Link := Item.Role = A11y.Roles.Link;
         elsif Item.Id = A11y_Test_Fixtures.Popup_Id then
            Saw_Popup := Item.Surface.Kind = A11y.Windows.Popup
              and then Item.Surface.State.Visible;
         end if;
      end loop;

      for Command of Script loop
         if Command.Kind = A11y_Test_Fixtures.Shutdown
           and then Command.Target = A11y_Test_Fixtures.Application_Id
         then
            Saw_Shutdown := True;
         elsif Command.Kind = A11y_Test_Fixtures.Select_Item
           or else Command.Kind = A11y_Test_Fixtures.Deselect
           or else Command.Kind = A11y_Test_Fixtures.Clear_Selection
         then
            Saw_Selection_Command := True;
         elsif Command.Kind = A11y_Test_Fixtures.Show_Menu
           or else Command.Kind = A11y_Test_Fixtures.Dismiss
         then
            Saw_Menu_Command := True;
        elsif Command.Kind = A11y_Test_Fixtures.Insert_Text
           or else Command.Kind = A11y_Test_Fixtures.Remove_Text
           or else Command.Kind = A11y_Test_Fixtures.Replace_Text
           or else Command.Kind = A11y_Test_Fixtures.Set_Text
           or else Command.Kind = A11y_Test_Fixtures.Move_Caret
         then
            Saw_Text_Edit_Command := True;
         elsif Command.Kind = A11y_Test_Fixtures.Open_Window
           or else Command.Kind = A11y_Test_Fixtures.Close_Window
         then
            Saw_Window_Command := True;
         end if;
      end loop;

      Check
        (Natural (Fixture_Nodes.Length) >= 35,
         "fixture provides a broad deterministic semantic node set");
      Check
        (A11y_Test_Fixtures.Application_Id = A11y.Node_Ids.From_Natural (1_001)
         and then A11y_Test_Fixtures.Main_Window_Id = A11y.Node_Ids.From_Natural (1_002),
         "fixture uses stable predefined Node_Id values");
      Check
        (Saw_Password,
         "fixture marks password fields as protected text");
      Check
        (Saw_Decorative_Image,
         "fixture includes decorative image semantics");
      Check
        (Saw_Table,
         "fixture includes table semantics");
      Check
        (Saw_Table_Cell and then Saw_Link and then Saw_Popup,
         "fixture includes cell, link, and popup semantics");
      Check
        (Natural (Script.Length) >= 20
         and then Saw_Selection_Command
         and then Saw_Menu_Command
         and then Saw_Text_Edit_Command
         and then Saw_Window_Command
         and then Saw_Shutdown,
         "fixture provides deterministic scripted commands");
      declare
         Startup_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Startup_JSON
             ("not-an-address", 1000);
         Environment_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Environment_Startup_JSON
             ("not-an-address", 1000);
         Host_Environment_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Host_Environment_Startup_JSON
             (1000);
         Serve_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Serve_JSON
             ("not-an-address", 1000, 2);
         Timed_Serve_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Serve_JSON
             ("not-an-address", 1000, 2, 25);
         Host_Serve_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Host_Environment_Serve_JSON
             (1000, 2, 25);
      begin
         Check
           (Ada.Strings.Fixed.Index
              (Startup_JSON, "org.a11y.fixture_atspi_startup.v1") /= 0
            and then Ada.Strings.Fixed.Index
              (Startup_JSON, """fixture_schema"": ""org.a11y.fixture_application.v1""") /= 0
            and then Ada.Strings.Fixed.Index
         (Startup_JSON, """application_node"": ""1001""") /= 0
            and then Ada.Strings.Fixed.Index
              (Startup_JSON, """application_exportable"": false") /= 0
            and then Ada.Strings.Fixed.Index
              (Startup_JSON, "application_root_child_count_query") /= 0
            and then Ada.Strings.Fixed.Index
              (Startup_JSON, """application_root_first_child"": ""none""") /= 0
            and then Ada.Strings.Fixed.Index
              (Startup_JSON, """startup_source"": ""direct_address""") /= 0
            and then Ada.Strings.Fixed.Index
              (Startup_JSON, """status"": ""INVALID_ARGUMENT""") /= 0,
            "fixture exposes explicit Linux AT-SPI startup JSON without changing semantic readiness");
         Check
           (Ada.Strings.Fixed.Index
              (Environment_JSON, "org.a11y.fixture_atspi_startup.v1") /= 0
            and then Ada.Strings.Fixed.Index
              (Environment_JSON, """startup_source"": ""environment_value""") /= 0
            and then Ada.Strings.Fixed.Index
              (Environment_JSON, """status"": ""INVALID_ARGUMENT""") /= 0,
            "fixture exposes deterministic Linux AT-SPI environment-value startup JSON");
         Check
           (Ada.Strings.Fixed.Index
              (Host_Environment_JSON,
               "org.a11y.fixture_atspi_startup.v1") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Environment_JSON,
               """address_supplied"": false") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Environment_JSON,
               """host_environment_used"": true") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Environment_JSON,
               "host_at_spi_bus_address_present") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Environment_JSON,
               "host_session_bus_address_present") /= 0,
            "fixture exposes deterministic Linux AT-SPI host-environment startup JSON");
         Check
           (Ada.Strings.Fixed.Index
              (Serve_JSON, "org.a11y.fixture_atspi_serve.v1") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "org.a11y.fixture_application.v1") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "max_iterations") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, """read_timeout_ms"":  0") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "application_root_child_count_query") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, """application_root_first_child"": ""none""") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_wait_attempts") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_can_read") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_can_write") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_can_dispatch") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_has_outgoing_work") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_after_next_operation") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_after_can_read") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_after_can_write") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_after_can_dispatch") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "event_loop_after_has_outgoing_work") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "iterations_completed") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "READINESS_FAILED") /= 0
            and then Ada.Strings.Fixed.Index
              (Serve_JSON, "BACKEND_UNAVAILABLE") /= 0,
            "fixture exposes bounded Linux AT-SPI serve JSON without faking registered transport");
         Check
           (Ada.Strings.Fixed.Index
              (Timed_Serve_JSON, "org.a11y.fixture_atspi_serve.v1") /= 0
            and then Ada.Strings.Fixed.Index
              (Timed_Serve_JSON, """read_timeout_ms"":  25") /= 0
            and then Ada.Strings.Fixed.Index
              (Timed_Serve_JSON, "event_loop_wait_timeouts") /= 0
            and then Ada.Strings.Fixed.Index
              (Timed_Serve_JSON, "BACKEND_UNAVAILABLE") /= 0,
            "fixture exposes wait-capable Linux AT-SPI serve JSON for external client probes");
         Check
           (Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "org.a11y.fixture_atspi_serve.v1") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, """address_supplied"": false") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, """host_environment_used"": true") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "host_at_spi_bus_address_present") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "host_session_bus_address_present") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "event_loop_step_status") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "event_loop_can_read") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "event_loop_can_write") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "event_loop_can_dispatch") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "event_loop_has_outgoing_work") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "event_loop_after_next_operation") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "event_loop_after_can_dispatch") /= 0
            and then Ada.Strings.Fixed.Index
              (Host_Serve_JSON, "event_loop_after_has_outgoing_work") /= 0,
            "fixture exposes Linux AT-SPI host-environment serve JSON for external client probes");
      end;
   end;

   declare
      type Context_Access is access all
        A11y.Linux.ATSPi_Bus.Connection_Context;
      type Registry_Access is access all
        A11y.Linux.ATSPi_Object_Registry.Object_Registry;
      type Snapshot_Access is access all
        A11y.Linux.ATSPi_Method_Router.Snapshot_Bundle;

      Context : constant Context_Access :=
        new A11y.Linux.ATSPi_Bus.Connection_Context;
      Registry : constant Registry_Access :=
        new A11y.Linux.ATSPi_Object_Registry.Object_Registry;
      Registered :
        A11y.Linux.ATSPi_Object_Registry.Object_Record_Snapshot;
      Registry_View :
        A11y.Linux.ATSPi_Object_Registry.Registry_Snapshot;
      Snapshots : constant Snapshot_Access :=
        new A11y.Linux.ATSPi_Method_Router.Snapshot_Bundle;
      Request_Message : A11y.Linux.DBus_Messages.Outgoing_Message;
      Request_Envelope : A11y.Linux.DBus_Messages.Transport_Envelope;
      Request_Packet : A11y.Linux.DBus_Messages.Transport_Packet;
      Reply_Packet : A11y.Linux.DBus_Messages.Transport_Packet;
      Reply_Envelope : A11y.Linux.DBus_Messages.Transport_Envelope;
      Reply_Text : Unbounded_String;
      Application_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (1_777);
      Object_Path : Unbounded_String;
      Result : A11y.Results.Result;
   begin
      A11y.Linux.ATSPi_Bus.Prepare_Connection
        (Context.all, "unix:path=/tmp/a11y-test-bus", Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI serving path prepares a bounded D-Bus context");
      A11y.Linux.ATSPi_Bus.Mark_Transport_Connected (Context.all, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI serving path admits a prepared D-Bus context");
      A11y.Linux.ATSPi_Bus.Register_Application (Context.all, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI serving path enters registered provider state");

      Object_Path := A11y.Linux.ATSPi_Objects.Object_Path
        (Context.all.Session, Application_Node, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI serving path builds stable object paths from Node_Id");
      A11y.Linux.ATSPi_Object_Registry.Ensure_Object
        (Registry.all, Context.all.Session, Application_Node, Registered,
         Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Registered.Node = Application_Node
         and then Registered.Path = Object_Path,
         "Linux AT-SPI serving path registers native object identity");

      Snapshots.all.Accessible.Id := Application_Node;
      Snapshots.all.Accessible.Role := A11y.Roles.Application;
      Snapshots.all.Accessible.Name :=
        To_Unbounded_String ("Packet Routed App");

      Request_Message := A11y.Linux.DBus_Messages.Build_Method_Call
        (Object_Path    => Object_Path,
         Interface_Name => To_Unbounded_String
           (A11y.Linux.ATSPi_Objects.Interface_Name
              (A11y.Linux.ATSPi_Objects.Accessible)),
         Member_Name    => To_Unbounded_String ("GetName"),
         Serial         => 91,
         Result         => Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI serving path encodes an incoming D-Bus method envelope");
      Request_Envelope :=
        A11y.Linux.DBus_Messages.Build_Transport_Envelope
          (Request_Message, Result);
      Request_Packet := A11y.Linux.DBus_Messages.Build_Transport_Packet
        (Request_Envelope, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Request_Packet.Metadata.Kind =
           A11y.Linux.DBus_Messages.Method_Call,
         "Linux AT-SPI serving path encodes an incoming D-Bus method call");

      A11y.Linux.ATSPi_Bus.Handle_Incoming_Registered_Packet
        (Context.all, Registry.all, Request_Packet.Bytes, Snapshots.all,
         Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then
           A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context.all) = 1,
         "Linux AT-SPI serving path dispatches registered D-Bus packets into queued replies");
      Registry_View :=
        A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry.all);
      Check
        (Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI serving path releases registry pins after packet dispatch");

      A11y.Linux.ATSPi_Bus.Send_Next_Transport_Packet
        (Context.all, Reply_Packet, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Reply_Packet.Metadata.Kind =
           A11y.Linux.DBus_Messages.Method_Return
         and then
           A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context.all) = 0
         and then
           A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count (Context.all) = 0,
         "Linux AT-SPI serving path serializes queued replies for transport");
      Reply_Envelope := A11y.Linux.DBus_Messages.Decode_Method_Return
        (Reply_Packet.Bytes, Result);
      Reply_Text := A11y.Linux.DBus_Messages.Decode_String_Body
        (Reply_Envelope.Body_Bytes, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Reply_Envelope.Reply_Serial = 91
         and then Reply_Envelope.Body_Signature = To_Unbounded_String ("s")
         and then Reply_Text = To_Unbounded_String ("Packet Routed App"),
         "Linux AT-SPI serving path round-trips semantic data through D-Bus packets");

      declare
         Object_Reference_Body : constant Unbounded_String :=
           To_Unbounded_String
             (Character'Val (5) & Character'Val (0) & Character'Val (0)
              & Character'Val (0) & ":1.88" & Character'Val (0)
              & Character'Val (0) & Character'Val (0)
              & Character'Val (2) & Character'Val (0) & Character'Val (0)
              & Character'Val (0) & "/a" & Character'Val (0));
         Object_Reference_Envelope : constant
           A11y.Linux.DBus_Messages.Transport_Envelope :=
             (Kind                      =>
                A11y.Linux.DBus_Messages.Method_Return,
              Serial                    => 92,
              Reply_Serial              => 91,
              Status                    => A11y.Results.Success,
              Object_Path               => Null_Unbounded_String,
              Interface_Name            => Null_Unbounded_String,
              Member_Name               => Null_Unbounded_String,
              Error_Name                => Null_Unbounded_String,
              Sender_Name               => Null_Unbounded_String,
              Body_Signature            => To_Unbounded_String ("(so)"),
              Body_Bytes                => Object_Reference_Body,
              Body_Object_Path_Argument => Null_Unbounded_String,
              Body_String_Argument      => Null_Unbounded_String,
              Body_String_Argument_2    => Null_Unbounded_String,
              Body_UInt32_Argument      => 0,
              Body_UInt32_Argument_2    => 0,
              Body_Point_Argument       => (X => 0, Y => 0),
              Body_Float_Argument       => 0.0);
         Object_Reference_Packet :
           A11y.Linux.DBus_Messages.Transport_Packet;
         Decoded_Object_Reference :
           A11y.Linux.DBus_Messages.Transport_Envelope;
      begin
         Object_Reference_Packet :=
           A11y.Linux.DBus_Messages.Build_Transport_Packet
             (Object_Reference_Envelope, Result);
         Decoded_Object_Reference :=
           A11y.Linux.DBus_Messages.Decode_Method_Return
             (Object_Reference_Packet.Bytes, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Decoded_Object_Reference.Reply_Serial = 91
            and then Decoded_Object_Reference.Body_Signature =
              To_Unbounded_String ("(so)")
            and then Decoded_Object_Reference.Body_String_Argument =
              To_Unbounded_String (":1.88")
            and then Decoded_Object_Reference.Body_Object_Path_Argument =
              To_Unbounded_String ("/a"),
            "Linux D-Bus method-return decoder exposes object-reference payloads");
      end;

      A11y.Linux.ATSPi_Bus.Complete_Outgoing
        (Context.all, Reply_Packet.Metadata.Serial, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then
           A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count (Context.all) = 0,
         "Linux AT-SPI serving path leaves terminal replies outside send tracking");
   end;

   declare
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (501);
      Result : A11y.Results.Result;
      Path_Result : A11y.Results.Result;
      Path_1 : Unbounded_String;
      Path_2 : Unbounded_String;
      Runtime_Id : Natural;
      Resolved_Node : A11y.Node_Ids.Node_Id;
      Parsed_Node : A11y.Node_Ids.Node_Id;
      Other_Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
   begin
      Check
        (A11y.Native_Identity.Classification.Valid_Session_Value
           (A11y.Native_Identity.To_Natural (Session))
         and then not A11y.Native_Identity.Classification.Valid_Session_Value
           (A11y.Native_Identity.To_Natural
              (A11y.Native_Identity.No_Session)),
         "native identity classification validates backend session components");
      Check
        (A11y.Native_Identity.Classification.Valid_Runtime_Node_Component
           (A11y.Node_Ids.To_Natural (Node))
         and then not
           A11y.Native_Identity.Classification.Valid_Runtime_Node_Component
             (A11y.Node_Ids.To_Natural (A11y.Node_Ids.No_Node))
         and then not
           A11y.Native_Identity.Classification.Valid_Runtime_Node_Component
             (A11y.Node_Ids.Max_Node_Ids + 1),
         "native identity classification validates runtime node components");
      Check
        (A11y.Native_Identity.Classification.Can_Encode_Runtime_Component
           (A11y.Native_Identity.To_Natural (Session),
            A11y.Node_Ids.To_Natural (Node))
         and then not
           A11y.Native_Identity.Classification.Can_Encode_Runtime_Component
             (A11y.Native_Identity.To_Natural
                (A11y.Native_Identity.No_Session),
              A11y.Node_Ids.To_Natural (Node))
         and then not
           A11y.Native_Identity.Classification.Can_Encode_Runtime_Component
             (A11y.Native_Identity.To_Natural (Session),
              A11y.Node_Ids.Max_Node_Ids + 1),
         "native identity classification exposes runtime-id encode admission");
      Check
        (A11y.Native_Identity.Classification.Component_Matches_Session
           (A11y.Native_Identity.To_Natural (Session),
            A11y.Native_Identity.Classification.Runtime_Component
              (A11y.Native_Identity.To_Natural (Session),
               A11y.Node_Ids.To_Natural (Node)))
         and then not
           A11y.Native_Identity.Classification.Component_Matches_Session
             (A11y.Native_Identity.To_Natural (Other_Session),
              A11y.Native_Identity.Classification.Runtime_Component
                (A11y.Native_Identity.To_Natural (Session),
                 A11y.Node_Ids.To_Natural (Node)))
         and then
           A11y.Native_Identity.Classification.Component_Node_Value
             (A11y.Native_Identity.Classification.Runtime_Component
                (A11y.Native_Identity.To_Natural (Session),
                 A11y.Node_Ids.To_Natural (Node)))
           = A11y.Node_Ids.To_Natural (Node),
         "native identity classification decodes runtime-id components by session");
      Path_1 := A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Path_Result);
      Path_2 := A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Result);
      Check
        (A11y.Native_Identity.Image (A11y.Native_Identity.No_Session) = "none"
         and then A11y.Native_Identity.Image (Session)'Length > 0
         and then A11y.Native_Identity.Image (Session)
           (A11y.Native_Identity.Image (Session)'First) /= ' ',
         "native identity session images are stable trimmed strings");
      Check
        (A11y.Results.Succeeded (Path_Result)
         and then A11y.Results.Succeeded (Result)
         and then Path_1 = Path_2
         and then To_String (Path_1)'Length > 0
         and then To_String (Path_1) (To_String (Path_1)'Last - 8 .. To_String (Path_1)'Last)
           = "/node/501",
         "native identity derives stable Linux object paths from Node_Id");

      Parsed_Node :=
        A11y.Linux.ATSPi_Objects.Node_From_Object_Path
          (Session, To_String (Path_1), Result);
      Check
        (A11y.Results.Succeeded (Result) and then Parsed_Node = Node,
         "native identity resolves Linux object paths by session");

      Parsed_Node :=
        A11y.Linux.ATSPi_Objects.Node_From_Object_Path
          (Other_Session, To_String (Path_1), Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Parsed_Node = A11y.Node_Ids.No_Node,
         "native identity rejects Linux object paths from other sessions");

      Parsed_Node :=
        A11y.Linux.ATSPi_Objects.Node_From_Object_Path
          (Session, "/org/a11y/ada/session/not-a-number/node/501", Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Parsed_Node = A11y.Node_Ids.No_Node,
         "native identity rejects malformed Linux object path sessions");

      Parsed_Node :=
        A11y.Linux.ATSPi_Objects.Node_From_Object_Path
          (Session,
           "/org/a11y/ada/session/"
           & A11y.Native_Identity.Image (Session)
           & "/node/0",
           Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Parsed_Node = A11y.Node_Ids.No_Node,
         "native identity rejects Linux object paths without node identities");

      Parsed_Node :=
        A11y.Linux.ATSPi_Objects.Node_From_Object_Path
          (Session,
           "/org/a11y/ada/session/"
           & A11y.Native_Identity.Image (Session)
           & "/node/65537",
           Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Parsed_Node = A11y.Node_Ids.No_Node,
         "native identity rejects out-of-range Linux object path nodes");

      Runtime_Id := A11y.Native_Identity.Runtime_Identifier_Component
        (Session, Node, Result);
      Check
        (A11y.Results.Succeeded (Result) and then Runtime_Id > 501,
         "native identity derives stable runtime identifier components");

      Resolved_Node :=
        A11y.Native_Identity.Node_From_Runtime_Identifier_Component
          (Session, Runtime_Id, Result);
      Check
        (A11y.Results.Succeeded (Result) and then Resolved_Node = Node,
         "native identity resolves runtime identifier components by session");

      Resolved_Node :=
        A11y.Native_Identity.Node_From_Runtime_Identifier_Component
          (Other_Session, Runtime_Id, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Resolved_Node = A11y.Node_Ids.No_Node,
         "native identity rejects runtime identifiers from other sessions");

      Resolved_Node :=
        A11y.Native_Identity.Node_From_Runtime_Identifier_Component
          (Session,
           A11y.Native_Identity.To_Natural (Session)
           * A11y.Native_Identity.Classification.Runtime_Node_Factor,
           Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Resolved_Node = A11y.Node_Ids.No_Node,
         "native identity rejects runtime identifiers without node components");

      Runtime_Id := A11y.Native_Identity.Runtime_Identifier_Component
        (Session, A11y.Node_Ids.From_Natural (1_000_000), Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable and then Runtime_Id = 0,
         "native identity rejects out-of-range node identifiers");

      Path_1 := A11y.Linux.ATSPi_Objects.Object_Path
        (A11y.Native_Identity.No_Session, Node, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable and then Length (Path_1) = 0,
         "native identity rejects invalid backend sessions");
   end;

   declare
      Cache : A11y.Native_Object_Caches.Native_Object_Cache;
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Other_Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (550);
      Object_1 : A11y.Native_Object_Caches.Native_Object_Id;
      Object_2 : A11y.Native_Object_Caches.Native_Object_Id;
      Snapshot : A11y.Native_Object_Caches.Object_Snapshot;
      Report : A11y.Native_Object_Caches.Cache_Mutation_Report;
      Generation_Before : Natural := 0;
      Result : A11y.Results.Result;
   begin
      Cache.Find_Object (Session, Node, Snapshot, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Snapshot.Object = A11y.Native_Object_Caches.No_Object
         and then Cache.Live_Count = 0
         and then Cache.Generation = 0,
         "native object cache misses by Node_Id without materializing objects");

      Cache.Ensure_Object_With_Report (Session, Node, Object_1, Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Native_Object_Caches.Is_Valid (Object_1)
         and then Cache.Generation = 1,
         "native object cache creates stable backend object identities");
      Check
        (Report.Operation =
           A11y.Native_Object_Caches.Cache_Ensure_Object
         and then Report.Generation_Before = 0
         and then Report.Generation_After = 1
         and then Report.Live_Before = 0
         and then Report.Live_After = 1
         and then Report.Tombstones_Before = 0
         and then Report.Tombstones_After = 0
         and then Report.Node = Node
         and then Report.Object = Object_1
         and then Report.Status = A11y.Results.Success
         and then Report.Generation_Advanced
         and then Report.Live_Changed
         and then not Report.Tombstone_Changed
         and then Report.Object_Returned,
         "native object cache reports creation mutation details");
      Check
        (A11y.Native_Object_Caches.Image
           (A11y.Native_Object_Caches.No_Object) = "none"
         and then A11y.Native_Object_Caches.Image (Object_1)'Length > 0
         and then A11y.Native_Object_Caches.Image (Object_1)
         (A11y.Native_Object_Caches.Image (Object_1)'First) /= ' ',
         "native object cache images are stable trimmed strings");

      Cache.Ensure_Object_With_Report (Session, Node, Object_2, Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Object_1 = Object_2
         and then Cache.Live_Count = 1
         and then Cache.Generation = 1,
         "native object cache reuses live object identities for one node");
      Check
        (Report.Operation =
           A11y.Native_Object_Caches.Cache_Ensure_Object
         and then Report.Generation_Before = 1
         and then Report.Generation_After = 1
         and then Report.Live_Before = 1
         and then Report.Live_After = 1
         and then Report.Tombstones_Before = 0
         and then Report.Tombstones_After = 0
         and then Report.Node = Node
         and then Report.Object = Object_1
         and then Report.Status = A11y.Results.Success
         and then not Report.Generation_Advanced
         and then not Report.Live_Changed
         and then not Report.Tombstone_Changed
         and then Report.Object_Returned,
         "native object cache reports live identity reuse without mutation");

      Cache.Resolve (Session, Object_1, Snapshot, Result);
      Check
         (A11y.Results.Succeeded (Result)
         and then Snapshot.Node = Node
         and then Snapshot.Cache_Generation = Cache.Generation
         and then not Snapshot.Defunct,
         "native object cache resolves live objects to Node_Id");
      Cache.Find_Object (Session, Node, Snapshot, Result);
      Check
         (A11y.Results.Succeeded (Result)
         and then Snapshot.Object = Object_1
         and then Snapshot.Node = Node
         and then Snapshot.Cache_Generation = Cache.Generation
         and then not Snapshot.Defunct,
         "native object cache finds live objects by Node_Id without allocation");

      Cache.Resolve (Other_Session, Object_1, Snapshot, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable,
         "native object cache rejects objects from another backend session");

      Cache.Mark_Defunct_With_Report (Node, Report, Result);
      Check
         (A11y.Results.Succeeded (Result)
         and then Cache.Live_Count = 0
         and then Cache.Tombstone_Count = 1
         and then Cache.Generation = 2,
         "native object cache marks stale objects defunct");
      Check
         (Report.Operation =
            A11y.Native_Object_Caches.Cache_Mark_Defunct
          and then Report.Generation_Before = 1
          and then Report.Generation_After = 2
          and then Report.Live_Before = 1
          and then Report.Live_After = 0
          and then Report.Tombstones_Before = 0
          and then Report.Tombstones_After = 1
          and then Report.Node = Node
          and then Report.Object = Object_1
          and then Report.Status = A11y.Results.Success
          and then Report.Generation_Advanced
          and then Report.Live_Changed
          and then Report.Tombstone_Changed
          and then Report.Object_Returned,
          "native object cache reports defunct mutation details");

      Cache.Resolve (Session, Object_1, Snapshot, Result);
      Check
         (Result.Status = A11y.Results.Node_Unavailable
         and then Snapshot.Cache_Generation = Cache.Generation
         and then Snapshot.Defunct,
         "native object cache exposes tombstone metadata without live access");
      Cache.Find_Object (Session, Node, Snapshot, Result);
      Check
         (Result.Status = A11y.Results.Node_Unavailable
         and then Snapshot.Object = Object_1
         and then Snapshot.Cache_Generation = Cache.Generation
         and then Snapshot.Defunct,
         "native object cache finds stale Node_Id mappings without live access");

      Cache.Ensure_Object (Session, Node, Object_2, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then not A11y.Native_Object_Caches.Is_Valid (Object_2),
         "native object cache does not resurrect defunct node mappings");

      Cache.Release_With_Report (Object_1, Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Cache.Tombstone_Count = 1
         and then Cache.Generation = 3,
         "native object cache releases native object identities deterministically");
      Check
        (Report.Operation =
           A11y.Native_Object_Caches.Cache_Release_Object
         and then Report.Generation_Before = 2
         and then Report.Generation_After = 3
         and then Report.Live_Before = 0
         and then Report.Live_After = 0
         and then Report.Tombstones_Before = 1
         and then Report.Tombstones_After = 1
         and then Report.Node = Node
         and then Report.Object = Object_1
         and then Report.Status = A11y.Results.Success
         and then Report.Generation_Advanced
         and then not Report.Live_Changed
         and then not Report.Tombstone_Changed
         and then Report.Object_Returned,
         "native object cache reports released-object mutation details");

      Generation_Before := Cache.Generation;
      Cache.Ensure_Object_With_Report
        (A11y.Native_Identity.No_Session, Node, Object_2, Report, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then not A11y.Native_Object_Caches.Is_Valid (Object_2)
         and then Cache.Generation = Generation_Before,
         "native object cache rejects invalid backend sessions");
      Check
        (Report.Operation =
           A11y.Native_Object_Caches.Cache_Ensure_Object
         and then Report.Generation_Before = Generation_Before
         and then Report.Generation_After = Generation_Before
         and then Report.Node = Node
         and then Report.Object = A11y.Native_Object_Caches.No_Object
         and then Report.Status = A11y.Results.Node_Unavailable
         and then not Report.Generation_Advanced
         and then not Report.Live_Changed
         and then not Report.Tombstone_Changed
         and then not Report.Object_Returned,
         "native object cache reports rejected creation without mutation");

      Cache.Reset_With_Report (Report);
      Check
        (Report.Operation = A11y.Native_Object_Caches.Cache_Reset
         and then Report.Generation_Before = Generation_Before
         and then Report.Generation_After = Generation_Before + 1
         and then Report.Live_Before = 0
         and then Report.Live_After = 0
         and then Report.Tombstones_Before = 1
         and then Report.Tombstones_After = 0
         and then Report.Status = A11y.Results.Success
         and then Report.Generation_Advanced
         and then not Report.Live_Changed
         and then Report.Tombstone_Changed
         and then not Report.Object_Returned,
         "native object cache reports reset mutation details");
   end;

   declare
      Cache : A11y.Native_Object_Caches.Native_Object_Cache;
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Object : A11y.Native_Object_Caches.Native_Object_Id;
      Object_1 : A11y.Native_Object_Caches.Native_Object_Id;
      Object_2 : A11y.Native_Object_Caches.Native_Object_Id;
      Object_3 : A11y.Native_Object_Caches.Native_Object_Id;
      Snapshot : A11y.Native_Object_Caches.Object_Snapshot;
      Report : A11y.Native_Object_Caches.Cache_Mutation_Report;
      Result : A11y.Results.Result;
      Generation_Before : Natural := 0;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      Check
        (A11y.Native_Object_Caches.Classification.Valid_Capacity (3)
         and then
           A11y.Native_Object_Caches.Classification.Valid_Capacity (1)
         and then
           A11y.Native_Object_Caches.Classification.Can_Set_Limits
             (1,
              0,
              3,
              1),
         "native object cache classifier accepts initial resource limits");
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Native_Object_Cache_Size,
         3,
         Result);
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Tombstone_Retention,
         1,
         Result);
      Cache.Configure (Limits, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Cache.Object_Capacity = 3
         and then Cache.Tombstone_Capacity = 1
         and then Cache.Generation = 1,
         "native object cache accepts resource-limit configuration");

      Cache.Ensure_Object
        (Session, A11y.Node_Ids.From_Natural (10_001), Object_1, Result);
      Cache.Ensure_Object
        (Session, A11y.Node_Ids.From_Natural (10_002), Object_2, Result);
      Cache.Ensure_Object
        (Session, A11y.Node_Ids.From_Natural (10_003), Object_3, Result);

      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Native_Object_Caches.Is_Valid (Object_1)
         and then A11y.Native_Object_Caches.Is_Valid (Object_2)
         and then A11y.Native_Object_Caches.Is_Valid (Object_3)
         and then Cache.Live_Count = 3
         and then Cache.Generation = 4,
         "native object cache fills to its configured live-object bound");

      Generation_Before := Cache.Generation;
      Cache.Ensure_Object_With_Report
        (Session,
         A11y.Node_Ids.From_Natural (10_004),
         Object,
         Report,
         Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then not A11y.Native_Object_Caches.Is_Valid (Object)
         and then Cache.Live_Count = 3
         and then Cache.Generation = Generation_Before,
         "native object cache rejects overflow without creating an object");
      Check
        (Report.Operation =
           A11y.Native_Object_Caches.Cache_Ensure_Object
         and then Report.Generation_Before = Generation_Before
         and then Report.Generation_After = Generation_Before
         and then Report.Live_Before = 3
         and then Report.Live_After = 3
         and then Report.Tombstones_Before = 0
         and then Report.Tombstones_After = 0
         and then Report.Node = A11y.Node_Ids.From_Natural (10_004)
         and then Report.Object = A11y.Native_Object_Caches.No_Object
         and then Report.Status = A11y.Results.Resource_Limit
         and then not Report.Generation_Advanced
         and then not Report.Live_Changed
         and then not Report.Tombstone_Changed
         and then not Report.Object_Returned,
         "native object cache reports resource-limit rejection without mutation");

      Generation_Before := Cache.Generation;
      Cache.Mark_Defunct
        (A11y.Node_Ids.From_Natural (10_001), Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Cache.Tombstone_Count = 1
         and then Cache.Live_Count = 2
         and then Cache.Generation > Generation_Before,
         "native object cache records configured tombstone retention");

      Generation_Before := Cache.Generation;
      Cache.Mark_Defunct
        (A11y.Node_Ids.From_Natural (10_002), Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Cache.Tombstone_Count = 1
         and then Cache.Live_Count = 1
         and then Cache.Generation > Generation_Before,
         "native object cache evicts older tombstones under retention pressure");

      Cache.Resolve (Session, Object_1, Snapshot, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable,
         "native object cache evicted tombstones remain stale");

      Cache.Resolve (Session, Object_2, Snapshot, Result);
      Check
         (Result.Status = A11y.Results.Node_Unavailable
         and then Snapshot.Cache_Generation = Cache.Generation
         and then Snapshot.Defunct,
         "native object cache retains newest defunct tombstone metadata");

      Generation_Before := Cache.Generation;
      Cache.Release (Object_3, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Cache.Tombstone_Count = 1
         and then Cache.Live_Count = 0
         and then Cache.Generation > Generation_Before,
         "native object cache release evicts older tombstones under pressure");

      Cache.Resolve (Session, Object_3, Snapshot, Result);
      Check
         (Result.Status = A11y.Results.Node_Unavailable
         and then Snapshot.Cache_Generation = Cache.Generation
         and then Snapshot.Defunct
         and then Snapshot.Released,
         "native object cache retains newest released tombstone metadata");

      Generation_Before := Cache.Generation;
      Check
        (not A11y.Native_Object_Caches.Classification.Can_Set_Limits
           (4,
            Cache.Tombstone_Count,
            2,
            1),
         "native object cache classifier rejects shrinking below allocated identities");
      Cache.Set_Limits
        (Object_Capacity => 2,
         Tombstone_Capacity => 1,
         Result => Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then Cache.Generation = Generation_Before,
         "native object cache rejects shrinking below allocated objects");

      Check
        (not A11y.Native_Object_Caches.Classification.Valid_Capacity (0)
         and then
           not A11y.Native_Object_Caches.Classification.Can_Set_Limits
             (4,
              Cache.Tombstone_Count,
              0,
              1),
         "native object cache classifier rejects invalid capacity");
      Limits.Limits (A11y.Resource_Limits.Native_Object_Cache_Size) := 0;
      Cache.Configure (Limits, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument,
         "native object cache rejects invalid resource-limit configuration");
   end;

   declare
      Cache : A11y.Native_Object_Caches.Native_Object_Cache;
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      First_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (10_101);
      Second_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (10_102);
      Object_1 : A11y.Native_Object_Caches.Native_Object_Id;
      Object_2 : A11y.Native_Object_Caches.Native_Object_Id;
      Object_3 : A11y.Native_Object_Caches.Native_Object_Id;
      Result : A11y.Results.Result;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Native_Object_Cache_Size,
         4,
         Result);
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Tombstone_Retention,
         1,
         Result);
      Cache.Configure (Limits, Result);
      Cache.Ensure_Object (Session, First_Node, Object_1, Result);
      Cache.Ensure_Object (Session, Second_Node, Object_2, Result);
      Cache.Mark_Defunct (First_Node, Result);
      Cache.Mark_Defunct (Second_Node, Result);
      Cache.Ensure_Object (Session, First_Node, Object_3, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then A11y.Native_Object_Caches.Is_Valid (Object_1)
         and then A11y.Native_Object_Caches.Is_Valid (Object_2)
         and then not A11y.Native_Object_Caches.Is_Valid (Object_3),
         "native object cache rejects rematerialization after tombstone eviction");
   end;

   declare
      Runtime : A11y.Native_Runtimes.Native_Runtime;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (560);
      Object : A11y.Native_Object_Caches.Native_Object_Id;
      Snapshot : A11y.Native_Object_Caches.Object_Snapshot;
      Runtime_View : A11y.Native_Runtimes.Runtime_Snapshot;
      Generation_After_Config : Natural := 0;
      Generation_After_Start : Natural := 0;
      Cache_Generation_After_Start : Natural := 0;
      Generation_Before_Destroy : Natural := 0;
      Generation_Before_Stop : Natural := 0;
      Event : A11y.Events.Event;
      Committed_Timestamp : A11y.Timestamp;
      Prepared : A11y.Native_Runtimes.Prepared_Event;
      Preparation_Report : A11y.Native_Runtimes.Event_Preparation_Report;
      Lifecycle_Report : A11y.Native_Runtimes.Runtime_Lifecycle_Report;
      Result : A11y.Results.Result;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      Check
        (A11y.Native_Runtimes.Classification.Can_Initialize
           (A11y.Backends.Created)
         and then A11y.Native_Runtimes.Classification.Can_Initialize
           (A11y.Backends.Stopped)
         and then not A11y.Native_Runtimes.Classification.Can_Initialize
           (A11y.Backends.Running),
         "native runtime classification exposes initialize admission");
      Check
        (A11y.Native_Runtimes.Classification.Needs_Initialize_Before_Start
           (A11y.Backends.Created)
         and then A11y.Native_Runtimes.Classification
           .Needs_Initialize_Before_Start (A11y.Backends.Stopped)
         and then not A11y.Native_Runtimes.Classification
           .Needs_Initialize_Before_Start (A11y.Backends.Initialized),
         "native runtime classification exposes start initialization policy");
      Check
        (A11y.Native_Runtimes.Classification.Can_Enter_Running
           (A11y.Backends.Initialized)
         and then not A11y.Native_Runtimes.Classification.Can_Enter_Running
           (A11y.Backends.Created),
         "native runtime classification exposes running transition admission");
      Check
        (A11y.Native_Runtimes.Classification.Accepts_Object_Work
           (A11y.Backends.Running)
         and then not A11y.Native_Runtimes.Classification.Accepts_Object_Work
           (A11y.Backends.Stopping)
         and then A11y.Native_Runtimes.Classification.Accepts_Event_Work
           (A11y.Backends.Running)
         and then not A11y.Native_Runtimes.Classification.Accepts_Event_Work
           (A11y.Backends.Stopped),
         "native runtime classification exposes native work admission");
      Check
        (A11y.Native_Runtimes.Classification.Accepts_Defunct_Mark
           (A11y.Backends.Running)
         and then A11y.Native_Runtimes.Classification.Accepts_Defunct_Mark
           (A11y.Backends.Stopping)
         and then not A11y.Native_Runtimes.Classification.Accepts_Defunct_Mark
           (A11y.Backends.Stopped),
         "native runtime classification exposes defunct-mark admission");
      Check
        (A11y.Native_Runtimes.Classification.Stop_Is_Idempotent
           (A11y.Backends.Stopped)
         and then not A11y.Native_Runtimes.Classification.Stop_Is_Idempotent
           (A11y.Backends.Running)
         and then A11y.Native_Runtimes.Classification.Can_Advance_Generation
           (0)
         and then not A11y.Native_Runtimes.Classification
           .Can_Advance_Generation (Natural'Last)
         and then A11y.Native_Runtimes.Classification.Drained (0, 0, 0)
         and then not A11y.Native_Runtimes.Classification.Drained (0, 1, 0),
         "native runtime classification exposes shutdown and drain policy");
      A11y.Native_Runtimes.Ensure_Object
        (Runtime, Node, Object, Result);
      Check
        (Result.Status = A11y.Results.Shutting_Down
         and then not A11y.Native_Object_Caches.Is_Valid (Object),
         "native runtime rejects object exposure before start");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Native_Object_Cache_Size,
         1,
         Result);
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Tombstone_Retention,
         1,
         Result);
      A11y.Native_Runtimes.Configure_Limits (Runtime, Limits, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (A11y.Results.Succeeded (Result)
         and then Runtime_View.Object_Capacity = 1
         and then Runtime_View.Tombstone_Capacity = 1
         and then Runtime_View.Generation = 0,
         "native runtime accepts object-cache resource limits");
      Generation_After_Config := Runtime_View.Generation;

      A11y.Native_Runtimes.Start_With_Report
        (Runtime, Lifecycle_Report, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Generation_After_Start := Runtime_View.Generation;
      Cache_Generation_After_Start := Runtime_View.Object_Cache_Generation;
      Check
        (A11y.Results.Succeeded (Result)
         and then Lifecycle_Report.Operation =
           A11y.Native_Runtimes.Runtime_Start
         and then Lifecycle_Report.Before.State = A11y.Backends.Created
         and then Lifecycle_Report.After.State = A11y.Backends.Running
         and then Lifecycle_Report.Status = A11y.Results.Success
         and then Lifecycle_Report.Generation_Advanced
         and then Lifecycle_Report.State_Changed
         and then Lifecycle_Report.Session_Changed
         and then not Lifecycle_Report.Cache_Reset
         and then not Lifecycle_Report.Event_Order_Reset
         and then Runtime_View.State = A11y.Backends.Running
         and then A11y.Native_Identity.Is_Valid (Runtime_View.Session)
         and then A11y.Native_Runtimes.Drained (Runtime)
         and then Runtime_View.Object_Capacity = 1
         and then Runtime_View.Object_Cache_Generation > 0
         and then Runtime_View.Generation > Generation_After_Config,
         "native runtime lifecycle report starts with configured resource limits");

      A11y.Native_Runtimes.Ensure_Object
        (Runtime, Node, Object, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Native_Object_Caches.Is_Valid (Object)
         and then Runtime_View.Object_Cache_Generation >
           Cache_Generation_After_Start,
         "native runtime exposes nodes through its object cache");
      A11y.Native_Runtimes.Find_Object (Runtime, Node, Snapshot, Result);
      Check
         (A11y.Results.Succeeded (Result)
         and then Snapshot.Object = Object
         and then Snapshot.Node = Node,
         "native runtime finds existing native objects without materialization");

      declare
         Extra_Object : A11y.Native_Object_Caches.Native_Object_Id;
      begin
         A11y.Native_Runtimes.Ensure_Object
           (Runtime,
            A11y.Node_Ids.From_Natural (561),
            Extra_Object,
            Result);
         Check
           (Result.Status = A11y.Results.Resource_Limit
            and then not A11y.Native_Object_Caches.Is_Valid (Extra_Object),
            "native runtime applies configured object-cache limit");
      end;

      A11y.Native_Runtimes.Resolve_Object
        (Runtime, Object, Snapshot, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Snapshot.Node = Node
         and then Snapshot.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Snapshot.Session = Runtime_View.Session,
         "native runtime resolves live native objects through its session");
      Check
        (not A11y.Native_Runtimes.Drained (Runtime),
         "native runtime reports non-drained state while objects are live");

      Event :=
        (Sequence  => 101,
         Timestamp => Ada.Calendar.Clock,
         Source    => Node,
         Kind      => A11y.Events.Bounds_Changed,
         Revision  => 2);
      Committed_Timestamp := Event.Timestamp;
      A11y.Native_Runtimes.Apply_Event (Runtime, Event, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (A11y.Results.Succeeded (Result)
         and then Runtime_View.Last_Event = 101
         and then Runtime_View.Generation = Generation_After_Start,
         "native runtime applies ordered semantic events");

      A11y.Native_Runtimes.Apply_Event (Runtime, Event, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument,
         "native runtime rejects duplicate semantic events");

      Event.Sequence := A11y.No_Event;
      A11y.Native_Runtimes.Apply_Event (Runtime, Event, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument,
         "native runtime rejects unsequenced semantic events");

      Event :=
        (Sequence  => 102,
         Timestamp => Ada.Calendar.Clock,
         Source    => A11y.Node_Ids.No_Node,
         Kind      => A11y.Events.Focus_Changed,
         Revision  => 3);
      A11y.Native_Runtimes.Apply_Event (Runtime, Event, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Runtime_View.Last_Event = 101,
         "native runtime rejects invalid event sources before committing order");

      Event :=
        (Sequence  => 102,
         Timestamp => Ada.Calendar."-" (Committed_Timestamp, 1.0),
         Source    => Node,
         Kind      => A11y.Events.Focus_Changed,
         Revision  => 3);
      A11y.Native_Runtimes.Prepare_Event_With_Report
        (Runtime, Event, Prepared, Preparation_Report, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then Prepared.Status = A11y.Results.Invalid_State
         and then not Prepared.Has_Object
         and then not Preparation_Report.Admitted
         and then not Preparation_Report.Committed
         and then Preparation_Report.Status = A11y.Results.Invalid_State
         and then Preparation_Report.Last_Event_Before = 101
         and then Preparation_Report.Last_Event_After = 101
         and then Runtime_View.Last_Event = 101,
         "native runtime preparation report rejects stale timestamps before object preparation");

      Event :=
        (Sequence  => 103,
         Timestamp => Ada.Calendar.Clock,
         Source    => Node,
         Kind      => A11y.Events.Focus_Changed,
         Revision  => 3);
      A11y.Native_Runtimes.Prepare_Event_With_Report
        (Runtime, Event, Prepared, Preparation_Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Prepared.Status = A11y.Results.Success
         and then Prepared.Has_Object
         and then Prepared.Object = Object
         and then not Prepared.Destroys_Node
         and then Preparation_Report.Admitted
         and then Preparation_Report.Committed
         and then Preparation_Report.Has_Object
         and then Preparation_Report.Object = Object
         and then Preparation_Report.Last_Event_Before = 101
         and then Preparation_Report.Last_Event_After = 103
         and then not Preparation_Report.Was_Defunct
         and then not Preparation_Report.Is_Defunct,
         "native runtime preparation report records stable native object handoff");

      Event :=
        (Sequence  => 104,
         Timestamp => Ada.Calendar.Clock,
         Source    => Node,
         Kind      => A11y.Events.Bounds_Changed,
         Revision  => 4);
      A11y.Native_Runtimes.Prepare_Event
        (Runtime, Event, Prepared, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Prepared.Status = A11y.Results.Success
         and then Prepared.Has_Object
         and then Prepared.Object = Object,
         "native runtime reuses native objects during event preparation");

      Event :=
        (Sequence  => 105,
         Timestamp => Ada.Calendar.Clock,
         Source    => A11y.Node_Ids.From_Natural (561),
         Kind      => A11y.Events.Focus_Changed,
         Revision  => 5);
      A11y.Native_Runtimes.Prepare_Event_With_Report
        (Runtime, Event, Prepared, Preparation_Report, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Prepared.Status = A11y.Results.Resource_Limit
         and then Preparation_Report.Admitted
         and then not Preparation_Report.Committed
         and then not Preparation_Report.Has_Object
         and then Preparation_Report.Status = A11y.Results.Resource_Limit
         and then Preparation_Report.Last_Event_Before = 104
         and then Preparation_Report.Last_Event_After = 104
         and then Runtime_View.Last_Event = 104
         and then Runtime_View.Live_Objects = 1,
         "native runtime preparation report records object realization overflow before order commit");

      Event :=
        (Sequence  => 105,
         Timestamp => Ada.Calendar.Clock,
         Source    => A11y.Node_Ids.No_Node,
         Kind      => A11y.Events.Node_Destroyed,
         Revision  => 5);
      A11y.Native_Runtimes.Apply_Event (Runtime, Event, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable,
         "native runtime rejects destruction events without stable identity");

      Event :=
        (Sequence  => 106,
         Timestamp => Ada.Calendar.Clock,
         Source    => Node,
         Kind      => A11y.Events.Node_Destroyed,
         Revision  => 6);
      Generation_Before_Destroy := A11y.Native_Runtimes.Snapshot
        (Runtime).Generation;
      A11y.Native_Runtimes.Prepare_Event_With_Report
        (Runtime, Event, Prepared, Preparation_Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Prepared.Status = A11y.Results.Success
         and then Prepared.Destroys_Node
         and then not Prepared.Has_Object
         and then Preparation_Report.Admitted
         and then Preparation_Report.Committed
         and then Preparation_Report.Destroys_Node
         and then not Preparation_Report.Has_Object
         and then not Preparation_Report.Was_Defunct
         and then Preparation_Report.Is_Defunct
         and then Preparation_Report.Last_Event_After = 106,
         "native runtime preparation report records destruction without live native objects");
      A11y.Native_Runtimes.Resolve_Object
        (Runtime, Object, Snapshot, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Snapshot.Defunct,
         "native runtime marks native objects defunct from destruction events");
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (Runtime_View.Last_Event = 106
         and then Runtime_View.Live_Objects = 0
         and then Runtime_View.Tombstones = 1
         and then Runtime_View.Destroyed_Nodes = 1
         and then Runtime_View.Generation > Generation_Before_Destroy,
         "native runtime preserves safe stale-object tombstones");
      Check
        (not A11y.Native_Runtimes.Drained (Runtime),
         "native runtime reports non-drained state while tombstones remain");

      Event :=
        (Sequence  => 107,
         Timestamp => Ada.Calendar.Clock,
         Source    => Node,
         Kind      => A11y.Events.Bounds_Changed,
         Revision  => 7);
      A11y.Native_Runtimes.Apply_Event (Runtime, Event, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Runtime_View.Last_Event = 106
         and then Runtime_View.Live_Objects = 0,
         "native runtime rejects events after node destruction");

      Generation_Before_Stop := A11y.Native_Runtimes.Snapshot
        (Runtime).Generation;
      A11y.Native_Runtimes.Stop_With_Report
        (Runtime, Lifecycle_Report, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (A11y.Results.Succeeded (Result)
         and then Lifecycle_Report.Operation =
           A11y.Native_Runtimes.Runtime_Stop
         and then Lifecycle_Report.Before.State = A11y.Backends.Running
         and then Lifecycle_Report.After.State = A11y.Backends.Stopped
         and then Lifecycle_Report.Status = A11y.Results.Success
         and then Lifecycle_Report.Generation_Advanced
         and then Lifecycle_Report.State_Changed
         and then Lifecycle_Report.Session_Changed
         and then Lifecycle_Report.Cache_Reset
         and then Lifecycle_Report.Event_Order_Reset
         and then Runtime_View.State = A11y.Backends.Stopped
         and then Runtime_View.Live_Objects = 0
         and then Runtime_View.Tombstones = 0
         and then Runtime_View.Destroyed_Nodes = 0
         and then A11y.Native_Runtimes.Drained (Runtime)
         and then not A11y.Native_Identity.Is_Valid (Runtime_View.Session)
         and then Runtime_View.Generation > Generation_Before_Stop,
         "native runtime lifecycle report stops deterministically and resets native cache state");

      A11y.Native_Runtimes.Resolve_Object
        (Runtime, Object, Snapshot, Result);
      Check
        (Result.Status = A11y.Results.Shutting_Down,
         "native runtime rejects stale native calls after shutdown");

      A11y.Native_Runtimes.Apply_Event (Runtime, Event, Result);
      Check
        (Result.Status = A11y.Results.Shutting_Down,
         "native runtime rejects semantic events after shutdown");
   end;

   declare
      Runtime : A11y.Native_Runtimes.Native_Runtime;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (562);
      Runtime_View : A11y.Native_Runtimes.Runtime_Snapshot;
      Event : A11y.Events.Event;
      Prepared : A11y.Native_Runtimes.Prepared_Event;
      Preparation_Report : A11y.Native_Runtimes.Event_Preparation_Report;
      Object : A11y.Native_Object_Caches.Native_Object_Id;
      Result : A11y.Results.Result;
   begin
      A11y.Native_Runtimes.Start (Runtime, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "native runtime stale-ledger fixture starts");

      Event :=
        (Sequence  => 1,
         Timestamp => Ada.Calendar.Clock,
         Source    => Node,
         Kind      => A11y.Events.Node_Destroyed,
         Revision  => 1);
      A11y.Native_Runtimes.Prepare_Event_With_Report
        (Runtime, Event, Prepared, Preparation_Report, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (A11y.Results.Succeeded (Result)
         and then Prepared.Status = A11y.Results.Success
         and then Prepared.Destroys_Node
         and then not Prepared.Has_Object
         and then Preparation_Report.Admitted
         and then Preparation_Report.Committed
         and then Preparation_Report.Is_Defunct
         and then Runtime_View.Destroyed_Nodes = 1
         and then Runtime_View.Last_Event = 1,
         "native runtime preparation report records destroyed nodes without native objects");

      Event :=
        (Sequence  => 2,
         Timestamp => Ada.Calendar.Clock,
         Source    => Node,
         Kind      => A11y.Events.Focus_Changed,
         Revision  => 2);
      A11y.Native_Runtimes.Prepare_Event_With_Report
        (Runtime, Event, Prepared, Preparation_Report, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Prepared.Status = A11y.Results.Node_Unavailable
         and then not Prepared.Has_Object
         and then not Preparation_Report.Admitted
         and then Preparation_Report.Was_Defunct
         and then Preparation_Report.Is_Defunct
         and then Runtime_View.Last_Event = 1
         and then Runtime_View.Live_Objects = 0,
         "native runtime preparation report blocks object creation after node destruction");

      Event :=
        (Sequence  => 3,
         Timestamp => Ada.Calendar.Clock,
         Source    => Node,
         Kind      => A11y.Events.Node_Destroyed,
         Revision  => 3);
      A11y.Native_Runtimes.Prepare_Event
        (Runtime, Event, Prepared, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then Prepared.Status = A11y.Results.Invalid_State
         and then not Prepared.Has_Object
         and then Runtime_View.Last_Event = 1
         and then Runtime_View.Destroyed_Nodes = 1,
         "native runtime rejects duplicate node-destroyed preparation");

      A11y.Native_Runtimes.Ensure_Object (Runtime, Node, Object, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then not A11y.Native_Object_Caches.Is_Valid (Object)
         and then Runtime_View.Live_Objects = 0
         and then Runtime_View.Destroyed_Nodes = 1,
         "native runtime rejects direct native-object creation after destruction");
   end;

   declare
      Runtime : A11y.Native_Runtimes.Native_Runtime;
      Cached_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (563);
      Uncached_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (564);
      Object : A11y.Native_Object_Caches.Native_Object_Id;
      Snapshot : A11y.Native_Object_Caches.Object_Snapshot;
      Runtime_View : A11y.Native_Runtimes.Runtime_Snapshot;
      Result : A11y.Results.Result;
   begin
      A11y.Native_Runtimes.Start (Runtime, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "native runtime direct-defunct fixture starts");

      A11y.Native_Runtimes.Ensure_Object (Runtime, Cached_Node, Object, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Native_Object_Caches.Is_Valid (Object),
         "native runtime direct-defunct fixture creates cached object");

      A11y.Native_Runtimes.Mark_Node_Defunct
        (Runtime, Cached_Node, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (A11y.Results.Succeeded (Result)
         and then Runtime_View.Live_Objects = 0
         and then Runtime_View.Tombstones = 1
         and then Runtime_View.Destroyed_Nodes = 1,
         "native runtime direct defunct marks cached nodes in the lifecycle ledger");

      A11y.Native_Runtimes.Resolve_Object
        (Runtime, Object, Snapshot, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Snapshot.Defunct,
         "native runtime direct defunct preserves cached stale-object tombstones");

      A11y.Native_Runtimes.Ensure_Object (Runtime, Cached_Node, Object, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then not A11y.Native_Object_Caches.Is_Valid (Object),
         "native runtime direct defunct prevents cached node resurrection");

      A11y.Native_Runtimes.Mark_Node_Defunct
        (Runtime, Uncached_Node, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (A11y.Results.Succeeded (Result)
         and then Runtime_View.Live_Objects = 0
         and then Runtime_View.Tombstones = 1
         and then Runtime_View.Destroyed_Nodes = 2,
         "native runtime direct defunct records uncached destroyed nodes");

      A11y.Native_Runtimes.Ensure_Object
        (Runtime, Uncached_Node, Object, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then not A11y.Native_Object_Caches.Is_Valid (Object),
         "native runtime direct defunct prevents uncached node realization");

      A11y.Native_Runtimes.Mark_Node_Defunct
        (Runtime, Uncached_Node, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State,
         "native runtime direct defunct rejects duplicate lifecycle destruction");
   end;

   declare
      Runtime : A11y.Native_Runtimes.Native_Runtime;
      First_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (569);
      Second_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (570);
      First_Object : A11y.Native_Object_Caches.Native_Object_Id;
      Second_Object : A11y.Native_Object_Caches.Native_Object_Id;
      Snapshot : A11y.Native_Object_Caches.Object_Snapshot;
      Runtime_View : A11y.Native_Runtimes.Runtime_Snapshot;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      Result : A11y.Results.Result;
   begin
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Native_Object_Cache_Size,
         2,
         Result);
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Tombstone_Retention,
         1,
         Result);
      A11y.Native_Runtimes.Configure_Limits (Runtime, Limits, Result);
      A11y.Native_Runtimes.Start (Runtime, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "native runtime tombstone-pressure fixture starts");

      A11y.Native_Runtimes.Ensure_Object
        (Runtime, First_Node, First_Object, Result);
      A11y.Native_Runtimes.Ensure_Object
        (Runtime, Second_Node, Second_Object, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Native_Object_Caches.Is_Valid (First_Object)
         and then A11y.Native_Object_Caches.Is_Valid (Second_Object),
         "native runtime tombstone-pressure fixture creates native objects");

      A11y.Native_Runtimes.Mark_Node_Defunct
        (Runtime, First_Node, Result);
      A11y.Native_Runtimes.Mark_Node_Defunct
        (Runtime, Second_Node, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      Check
        (A11y.Results.Succeeded (Result)
         and then Runtime_View.Live_Objects = 0
         and then Runtime_View.Tombstones = 1
         and then Runtime_View.Destroyed_Nodes = 2,
         "native runtime preserves destruction under tombstone pressure");

      A11y.Native_Runtimes.Resolve_Object
        (Runtime, First_Object, Snapshot, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable,
         "native runtime evicted tombstones still reject stale native objects");

      A11y.Native_Runtimes.Resolve_Object
        (Runtime, Second_Object, Snapshot, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Snapshot.Defunct,
         "native runtime retains newest tombstone metadata under pressure");

      A11y.Native_Runtimes.Ensure_Object
        (Runtime, First_Node, First_Object, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then not A11y.Native_Object_Caches.Is_Valid (First_Object),
         "native runtime destroyed ledger prevents evicted-node resurrection");
   end;

   declare
      Runtime : A11y.Native_Runtimes.Native_Runtime;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      Result : A11y.Results.Result;
   begin
      Limits.Limits (A11y.Resource_Limits.Native_Object_Cache_Size) := 0;
      A11y.Native_Runtimes.Configure_Limits (Runtime, Limits, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument,
         "native runtime rejects invalid resource-limit configurations");
   end;

   declare
      Gate : A11y.Native_Callbacks.Callback_Gate;
      Runtime : A11y.Native_Runtimes.Native_Runtime;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (565);
      Object : A11y.Native_Object_Caches.Native_Object_Id;
      Context : A11y.Native_Boundary_Calls.Boundary_Call_Context;
      Call_View : A11y.Native_Boundary_Calls.Boundary_Call_Snapshot;
      Outcome : A11y.Native_Boundary_Calls.Boundary_Call_Outcome;
      Admission : A11y.Native_Boundary_Calls.Boundary_Call_Admission_Report;
      Completion : A11y.Native_Boundary_Calls.Boundary_Call_Completion_Report;
      Release : A11y.Native_Boundary_Calls.Boundary_Call_Release_Report;
      Gate_View : A11y.Native_Callbacks.Callback_Gate_Snapshot;
      Runtime_View : A11y.Native_Runtimes.Runtime_Snapshot;
      Result : A11y.Results.Result;
      Record_Result : A11y.Results.Result;
   begin
      A11y.Native_Runtimes.Start (Runtime, Result);
      A11y.Native_Runtimes.Ensure_Object (Runtime, Node, Object, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);

      A11y.Native_Boundary_Calls.Begin_Object_Call_With_Report
        (Gate,
         Runtime,
         Object,
         Context,
         Admission,
         Result,
         Kind => A11y.Dispatchers.Geometry_Query);
      Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
      Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
      Gate_View := Gate.Snapshot;
      Check
        (A11y.Results.Succeeded (Result)
         and then Call_View.Active
         and then Call_View.Object = Object
         and then Call_View.Runtime_Generation = Runtime_View.Generation
         and then Call_View.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Call_View.Node = Node
         and then Call_View.Kind = A11y.Dispatchers.Geometry_Query
         and then Call_View.Timeout_Limit
           = A11y.Resource_Limits.Callback_Duration_MS
         and then Call_View.Last_Status = A11y.Results.Success
         and then Outcome.Active
         and then Outcome.Object = Object
         and then Outcome.Runtime_Generation = Runtime_View.Generation
         and then Outcome.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Outcome.Node = Node
         and then Outcome.Status = A11y.Results.Success
         and then Outcome.Class =
           A11y.Native_Boundary_Calls.Return_Success
         and then Admission.Requested_Object = Object
         and then Admission.Object = Object
         and then Admission.Node = Node
         and then Admission.Runtime_Generation = Runtime_View.Generation
         and then Admission.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Admission.Kind = A11y.Dispatchers.Geometry_Query
         and then Admission.Callback_Admitted
         and then Admission.Object_Resolved
         and then Admission.Active
         and then not Admission.Defunct
         and then Admission.Status = A11y.Results.Success
         and then Admission.Class =
           A11y.Native_Boundary_Calls.Return_Success
         and then Gate_View.Outstanding = 1,
         "native boundary call admission report admits and resolves live native objects");

      A11y.Native_Boundary_Calls.Record_Status
        (Context, A11y.Results.Busy, Record_Result);
      Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
      Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
      Gate_View := Gate.Snapshot;
      Check
        (A11y.Results.Succeeded (Record_Result)
         and then Call_View.Active
         and then Call_View.Last_Status = A11y.Results.Busy
         and then Call_View.Runtime_Generation = Runtime_View.Generation
         and then Call_View.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Outcome.Status = A11y.Results.Busy
         and then Outcome.Runtime_Generation = Runtime_View.Generation
         and then Outcome.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Outcome.Class = A11y.Native_Boundary_Calls.Return_Busy
         and then Gate_View.Outstanding = 1,
         "native boundary call context records provider status before native return mapping");

      A11y.Native_Boundary_Calls.End_Call_With_Report
        (Gate, Context, Release, Result);
      Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
      Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
      Gate_View := Gate.Snapshot;
      Check
        (A11y.Results.Succeeded (Result)
         and then not Call_View.Active
         and then Call_View.Last_Status = A11y.Results.Busy
         and then Call_View.Runtime_Generation = Runtime_View.Generation
         and then Call_View.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then not Outcome.Active
         and then Outcome.Status = A11y.Results.Busy
         and then Outcome.Runtime_Generation = Runtime_View.Generation
         and then Outcome.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Outcome.Class = A11y.Native_Boundary_Calls.Return_Busy
         and then Release.Before.Active
         and then Release.Before.Object = Object
         and then Release.Before.Node = Node
         and then Release.Before.Last_Status = A11y.Results.Busy
         and then not Release.After.Active
         and then Release.After.Object = Object
         and then Release.After.Node = Node
         and then Release.After.Last_Status = A11y.Results.Busy
         and then Release.Preserved_Status = A11y.Results.Busy
         and then Release.End_Result_Status = A11y.Results.Success
         and then Release.Released
         and then Release.Status = A11y.Results.Success
         and then Release.Class = A11y.Native_Boundary_Calls.Return_Busy
         and then Gate_View.Outstanding = 0,
         "native boundary release report preserves provider status after release");

      A11y.Native_Boundary_Calls.Begin_Node_Call_With_Report
        (Gate,
         Runtime,
         Node,
         Context,
         Admission,
         Result,
         Kind => A11y.Dispatchers.Tree_Navigation_Query);
      Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
      Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
      Gate_View := Gate.Snapshot;
      Check
        (A11y.Results.Succeeded (Result)
         and then Call_View.Active
         and then Call_View.Object = Object
         and then Call_View.Runtime_Generation = Runtime_View.Generation
         and then Call_View.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Call_View.Node = Node
         and then Call_View.Kind = A11y.Dispatchers.Tree_Navigation_Query
         and then Outcome.Active
         and then Outcome.Object = Object
         and then Outcome.Runtime_Generation = Runtime_View.Generation
         and then Outcome.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Outcome.Node = Node
         and then Admission.Requested_Node = Node
         and then Admission.Object = Object
         and then Admission.Node = Node
         and then Admission.Runtime_Generation = Runtime_View.Generation
         and then Admission.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Admission.Kind = A11y.Dispatchers.Tree_Navigation_Query
         and then Admission.Callback_Admitted
         and then Admission.Object_Resolved
         and then Admission.Active
         and then Admission.Status = A11y.Results.Success
         and then Gate_View.Outstanding = 1,
         "native boundary call admission report admits existing nodes without materialization");

      declare
         Final_Status : A11y.Results.Status_Code := A11y.Results.Timed_Out;
      begin
         A11y.Native_Boundary_Calls.Complete_Call_With_Report
           (Gate, Context, Final_Status, Completion, Result);
         Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
         Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
         Gate_View := Gate.Snapshot;
         Check
           (A11y.Results.Succeeded (Result)
            and then Final_Status = A11y.Results.Timed_Out
            and then not Call_View.Active
            and then Call_View.Last_Status = A11y.Results.Timed_Out
            and then Completion.Before.Active
            and then Completion.Before.Object = Object
            and then Completion.Before.Node = Node
            and then Completion.Before.Last_Status = A11y.Results.Success
            and then Completion.Before.Kind =
              A11y.Dispatchers.Tree_Navigation_Query
            and then not Completion.After.Active
            and then Completion.After.Object = Object
            and then Completion.After.Node = Node
            and then Completion.After.Last_Status = A11y.Results.Timed_Out
            and then Completion.Requested_Status =
              A11y.Results.Timed_Out
            and then Completion.Final_Status = A11y.Results.Timed_Out
            and then Completion.Record_Result_Status =
              A11y.Results.Success
            and then Completion.End_Result_Status = A11y.Results.Success
            and then Completion.Recorded
            and then Completion.Released
            and then Completion.Status = A11y.Results.Success
            and then Completion.Class =
              A11y.Native_Boundary_Calls.Return_Timed_Out
            and then Outcome.Status = A11y.Results.Timed_Out
            and then Outcome.Class =
              A11y.Native_Boundary_Calls.Return_Timed_Out
            and then Gate_View.Outstanding = 0,
            "native boundary completion report records provider status and releases tokens");
      end;

      Gate_View := Gate.Snapshot;
      Check
        (A11y.Results.Succeeded (Result)
         and then Gate_View.Outstanding = 0,
         "native boundary node-call context releases callback admission tokens");

      A11y.Native_Boundary_Calls.Record_Status
        (Context, A11y.Results.Disabled, Record_Result);
      Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
      Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
      Check
        (Record_Result.Status = A11y.Results.Invalid_State
         and then not Call_View.Active
         and then Call_View.Last_Status = A11y.Results.Invalid_State
         and then Outcome.Class =
           A11y.Native_Boundary_Calls.Return_Invalid_State,
         "native boundary rejects status recording outside an active native call");

      A11y.Native_Boundary_Calls.End_Call (Gate, Context, Result);
      Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
      Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then not Call_View.Active
         and then Call_View.Last_Status = A11y.Results.Invalid_State
         and then Outcome.Status = A11y.Results.Invalid_State
         and then Outcome.Class =
           A11y.Native_Boundary_Calls.Return_Invalid_State,
         "native boundary call context records invalid completion status");

      A11y.Native_Runtimes.Mark_Node_Defunct (Runtime, Node, Result);
      Runtime_View := A11y.Native_Runtimes.Snapshot (Runtime);
      A11y.Native_Boundary_Calls.Begin_Object_Call_With_Report
        (Gate,
         Runtime,
         Object,
         Context,
         Admission,
         Result,
         Kind => A11y.Dispatchers.Window_Operation);
      Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
      Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
      Gate_View := Gate.Snapshot;
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Call_View.Last_Status = A11y.Results.Node_Unavailable
         and then Call_View.Object = Object
         and then Call_View.Runtime_Generation = Runtime_View.Generation
         and then Call_View.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Call_View.Defunct
         and then Call_View.Kind = A11y.Dispatchers.Window_Operation
         and then Outcome.Status = A11y.Results.Node_Unavailable
         and then Outcome.Runtime_Generation = Runtime_View.Generation
         and then Outcome.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Outcome.Defunct
         and then Outcome.Class =
           A11y.Native_Boundary_Calls.Return_Unavailable
         and then Admission.Requested_Object = Object
         and then Admission.Object = Object
         and then Admission.Node = Node
         and then Admission.Runtime_Generation = Runtime_View.Generation
         and then Admission.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Admission.Callback_Admitted
         and then not Admission.Object_Resolved
         and then not Admission.Active
         and then Admission.Defunct
         and then Admission.Status = A11y.Results.Node_Unavailable
         and then Admission.Class =
           A11y.Native_Boundary_Calls.Return_Unavailable
         and then Gate_View.Outstanding = 0,
         "native boundary call admission report records stale object failure context");

      A11y.Native_Boundary_Calls.Begin_Node_Call_With_Report
        (Gate,
         Runtime,
         Node,
         Context,
         Admission,
         Result,
         Kind => A11y.Dispatchers.Simple_Property_Query);
      Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
      Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
      Gate_View := Gate.Snapshot;
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Call_View.Last_Status = A11y.Results.Node_Unavailable
         and then Call_View.Object = Object
         and then Call_View.Runtime_Generation = Runtime_View.Generation
         and then Call_View.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Call_View.Node = Node
         and then Call_View.Defunct
         and then Call_View.Kind = A11y.Dispatchers.Simple_Property_Query
         and then Outcome.Status = A11y.Results.Node_Unavailable
         and then Outcome.Runtime_Generation = Runtime_View.Generation
         and then Outcome.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Outcome.Defunct
         and then Outcome.Class =
           A11y.Native_Boundary_Calls.Return_Unavailable
         and then Admission.Requested_Node = Node
         and then Admission.Object = Object
         and then Admission.Node = Node
         and then Admission.Runtime_Generation = Runtime_View.Generation
         and then Admission.Cache_Generation =
           Runtime_View.Object_Cache_Generation
         and then Admission.Callback_Admitted
         and then not Admission.Object_Resolved
         and then not Admission.Active
         and then Admission.Defunct
         and then Admission.Status = A11y.Results.Node_Unavailable
         and then Admission.Class =
           A11y.Native_Boundary_Calls.Return_Unavailable
         and then Gate_View.Outstanding = 0,
         "native boundary node-call admission report rejects stale nodes without materialization");

      Gate.Begin_Shutdown;
      A11y.Native_Boundary_Calls.Begin_Object_Call_With_Report
        (Gate,
         Runtime,
         Object,
         Context,
         Admission,
         Result,
         Kind => A11y.Dispatchers.Text_Query);
      Call_View := A11y.Native_Boundary_Calls.Snapshot (Context);
      Outcome := A11y.Native_Boundary_Calls.Outcome (Context);
      Check
         (Result.Status = A11y.Results.Shutting_Down
         and then Call_View.Last_Status = A11y.Results.Shutting_Down
         and then Call_View.Object = Object
         and then Call_View.Runtime_Generation = Runtime_View.Generation
         and then Call_View.Cache_Generation = 0
         and then Call_View.Kind = A11y.Dispatchers.Text_Query
         and then Outcome.Status = A11y.Results.Shutting_Down
         and then Outcome.Runtime_Generation = Runtime_View.Generation
         and then Outcome.Cache_Generation = 0
         and then Outcome.Class =
           A11y.Native_Boundary_Calls.Return_Shutting_Down
         and then Admission.Requested_Object = Object
         and then Admission.Object = Object
         and then Admission.Runtime_Generation = Runtime_View.Generation
         and then Admission.Cache_Generation = 0
         and then not Admission.Callback_Admitted
         and then not Admission.Object_Resolved
         and then not Admission.Active
         and then Admission.Status = A11y.Results.Shutting_Down
         and then Admission.Class =
           A11y.Native_Boundary_Calls.Return_Shutting_Down,
         "native boundary call admission report records shutdown failure context");

      for Status in A11y.Results.Status_Code loop
         declare
            Class : constant
              A11y.Native_Boundary_Calls.Boundary_Return_Class :=
                A11y.Native_Boundary_Calls.Return_Class (Status);
            Classified : constant
              A11y.Native_Boundary_Calls.Boundary_Return_Class :=
                A11y.Native_Boundary_Calls.Classification.Return_Class
                  (Status);
         begin
            Check
              (Class = Classified
               and then
                (case Status is
                  when A11y.Results.Success |
                       A11y.Results.Accepted_Asynchronous =>
                    Class = A11y.Native_Boundary_Calls.Return_Success,
                  when A11y.Results.Unsupported_Property |
                       A11y.Results.Unsupported_Capability |
                       A11y.Results.Unsupported_Action =>
                    Class = A11y.Native_Boundary_Calls.Return_Unsupported,
                  when A11y.Results.Backend_Unavailable |
                       A11y.Results.Accessibility_Service_Unavailable |
                       A11y.Results.Node_Unavailable =>
                    Class = A11y.Native_Boundary_Calls.Return_Unavailable,
                  when A11y.Results.Invalid_Argument |
                       A11y.Results.Invalid_Range =>
                    Class =
                      A11y.Native_Boundary_Calls.Return_Invalid_Argument,
                  when A11y.Results.Invalid_State =>
                    Class =
                      A11y.Native_Boundary_Calls.Return_Invalid_State,
                  when A11y.Results.Read_Only =>
                    Class = A11y.Native_Boundary_Calls.Return_Read_Only,
                  when A11y.Results.Disabled =>
                    Class = A11y.Native_Boundary_Calls.Return_Disabled,
                  when A11y.Results.Busy =>
                    Class = A11y.Native_Boundary_Calls.Return_Busy,
                  when A11y.Results.Timed_Out =>
                    Class = A11y.Native_Boundary_Calls.Return_Timed_Out,
                  when A11y.Results.Cancelled =>
                    Class = A11y.Native_Boundary_Calls.Return_Cancelled,
                  when A11y.Results.Shutting_Down =>
                    Class =
                      A11y.Native_Boundary_Calls.Return_Shutting_Down,
                  when A11y.Results.Permission_Denied =>
                    Class =
                      A11y.Native_Boundary_Calls.Return_Permission_Denied,
                  when A11y.Results.Protocol_Failure =>
                    Class =
                      A11y.Native_Boundary_Calls.Return_Protocol_Failure,
                  when A11y.Results.Native_Failure =>
                    Class =
                      A11y.Native_Boundary_Calls.Return_Native_Failure,
                  when A11y.Results.Resource_Limit |
                       A11y.Results.Out_Of_Resources =>
                    Class =
                      A11y.Native_Boundary_Calls.Return_Resource_Limit,
                  when A11y.Results.Internal_Error =>
                    Class =
                      A11y.Native_Boundary_Calls.Return_Internal_Error),
               "native boundary return classifier covers "
               & A11y.Results.Stable_Name (Status));
         end;
      end loop;
   end;

   declare
      Gate : A11y.Native_Callbacks.Callback_Gate;
      Runtime : A11y.Native_Runtimes.Native_Runtime;
      Dispatcher : A11y.Dispatchers.Immediate_Dispatcher;
      Provider : Test_Action_Provider;
      Actions : A11y.Actions.Action_Set := A11y.Actions.Empty_Action_Set;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (566);
      Object : A11y.Native_Object_Caches.Native_Object_Id;
      Gate_View : A11y.Native_Callbacks.Callback_Gate_Snapshot;
      Runtime_Result : A11y.Results.Result;
      Action_Result : A11y.Actions.Action_Result;
      States : A11y.States.State_Set := A11y.States.Empty_State_Set;
      Cancellation : A11y.Dispatchers.Cancellation_Token :=
        A11y.Dispatchers.Create_Cancellation_Token;
   begin
      Actions := A11y.Actions.With_Action (Actions, A11y.Actions.Press);
      Provider.Supported := Actions;
      A11y.Native_Runtimes.Start (Runtime, Runtime_Result);
      A11y.Native_Runtimes.Ensure_Object
        (Runtime, Node, Object, Runtime_Result);

