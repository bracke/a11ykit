              Length (Header_Data)
            and then A11y.Results.Succeeded (Result)
            and then Unix_FDs_Envelope.Kind = Envelope.Kind
            and then Unix_FDs_Envelope.Serial = Envelope.Serial
            and then Unix_FDs_Envelope.Object_Path = Envelope.Object_Path
            and then Unix_FDs_Envelope.Interface_Name =
              Envelope.Interface_Name
            and then Unix_FDs_Envelope.Member_Name = Envelope.Member_Name
            and then Unix_FDs_Envelope.Body_Signature =
              Envelope.Body_Signature
            and then Unix_FDs_Envelope.Body_Object_Path_Argument =
              Envelope.Body_Object_Path_Argument,
