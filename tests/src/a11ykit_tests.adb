         procedure Align_Header_Data is
         begin
            while Length (Header_Data) mod 8 /= 0 loop
               Append_Byte (Header_Data, 0);
            end loop;
         end Align_Header_Data;

         procedure Store_U32
           (Item   : in out Unbounded_String;
            Offset : Positive;
            Value  : Natural) is
            Remaining : Natural := Value;
         begin
            Replace_Element (Item, Offset, Character'Val (Remaining mod 256));
            Remaining := Remaining / 256;
            Replace_Element (Item, Offset + 1, Character'Val (Remaining mod 256));
            Remaining := Remaining / 256;
            Replace_Element (Item, Offset + 2, Character'Val (Remaining mod 256));
            Remaining := Remaining / 256;
            Replace_Element (Item, Offset + 3, Character'Val (Remaining mod 256));
         end Store_U32;
      begin
         Align_Header_Data;
         Append_Byte (Header_Data, 9);
         Append_Byte (Header_Data, 1);
         Append (Header_Data, 'u');
         Append_Byte (Header_Data, 0);
         Append_U32 (Header_Data, 0);
         Store_U32 (Unix_FDs_Packet_Bytes, 13, Length (Header_Data));
         Append (Unix_FDs_Packet_Bytes, Header_Data);
         while Length (Unix_FDs_Packet_Bytes) mod 8 /= 0 loop
            Append_Byte (Unix_FDs_Packet_Bytes, 0);
         end loop;
         Append (Unix_FDs_Packet_Bytes, Body_Text);

         Unix_FDs_Packet :=
           (Metadata => Packet.Metadata,
            Bytes    => Unix_FDs_Packet_Bytes);
         Unix_FDs_Header :=
           A11y.Linux.DBus_Messages.Decode_Transport_Packet_Header
             (Unix_FDs_Packet.Bytes, Unix_FDs_Header_Result);
         Unix_FDs_Envelope :=
           A11y.Linux.DBus_Messages.Decode_Transport_Envelope
