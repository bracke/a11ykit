           (A11y.Results.Succeeded (Result)
            and then Fixed_Header.Kind =
              A11y.Linux.DBus_Messages.Method_Call
            and then Fixed_Header.Serial = 34
            and then Fixed_Header.Packet_Length = Length (Packet.Bytes),
            "Linux D-Bus message envelope accepts standard fixed-header flags");
      end;

      Decoded_Envelope := A11y.Linux.DBus_Messages.Decode_Transport_Envelope
        (Packet.Bytes, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Decoded_Envelope.Kind = Envelope.Kind
         and then Decoded_Envelope.Serial = Envelope.Serial
         and then Decoded_Envelope.Object_Path = Envelope.Object_Path
         and then Decoded_Envelope.Interface_Name = Envelope.Interface_Name
         and then Decoded_Envelope.Member_Name = Envelope.Member_Name
         and then Decoded_Envelope.Body_Signature = Envelope.Body_Signature
         and then Decoded_Envelope.Body_Object_Path_Argument =
           Envelope.Body_Object_Path_Argument,
         "Linux D-Bus message envelope decodes transport envelopes");

      declare
         Raw : String := To_String (Packet.Bytes);
         Corrupt_Envelope : A11y.Linux.DBus_Messages.Transport_Envelope;
      begin
