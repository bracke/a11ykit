               "Linux D-Bus message envelope validates attributes through bounded string arrays");
         end;
      end;

      declare
         Target : constant A11y.Node_Ids.Node_Id :=
           A11y.Node_Ids.From_Natural (903);
         Target_Path : constant Unbounded_String :=
           A11y.Linux.ATSPi_Objects.Object_Path (Session, Target, Result);
         Relations :
           A11y.Linux.ATSPi_Accessible.Relation_Entry_Vectors.Vector;
         Relation : A11y.Linux.ATSPi_Accessible.Relation_Entry;
      begin
         Relation.Kind := A11y.Linux.ATSPi_Mappings.Labelled_By;
         Relation.Targets.Append (Target);
         Relations.Append (Relation);
         Boundary_Reply :=
           (Kind        => A11y.Linux.ATSPi_DBus_Boundary.Method_Reply,
            Status      => A11y.Results.Success,
            Routed_Kind =>
              A11y.Linux.ATSPi_Method_Router.Accessible_Relation_Set,
            Relations   => Relations,
            others      => <>);
         Outgoing := A11y.Linux.DBus_Messages.Build_Reply
           (Incoming, Boundary_Reply, 139, Result);
         Payload := A11y.Linux.DBus_Messages.Method_Return_Payload_Bytes
           (Outgoing, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Length (Payload) = Length (Target_Path) + 21
            and then Character'Pos (To_String (Payload) (1)) =
              Length (Target_Path) + 13
            and then Character'Pos (To_String (Payload) (9)) =
              A11y.Linux.ATSPi_Mappings.ATSPI_Relation'Pos
                (A11y.Linux.ATSPi_Mappings.Labelled_By)
            and then Character'Pos (To_String (Payload) (13)) =
              Length (Target_Path) + 5
            and then To_String (Payload) (21) = '/',
            "Linux D-Bus message envelope encodes relation-set method-return payloads");

         declare
            Tight_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
              A11y.Resource_Limits.Default_Config;
            Tight_Relations :
              A11y.Linux.ATSPi_Accessible.Relation_Entry_Vectors.Vector;
            Tight_Relation : A11y.Linux.ATSPi_Accessible.Relation_Entry;
         begin
            Tight_Relation.Kind := A11y.Linux.ATSPi_Mappings.Labelled_By;
            Tight_Relation.Targets.Append (Target);
            Tight_Relation.Targets.Append (A11y.Node_Ids.From_Natural (904));
            Tight_Relations.Append (Tight_Relation);
            Boundary_Reply :=
              (Kind        => A11y.Linux.ATSPi_DBus_Boundary.Method_Reply,
               Status      => A11y.Results.Success,
               Routed_Kind =>
                 A11y.Linux.ATSPi_Method_Router.Accessible_Relation_Set,
               Relations   => Tight_Relations,
               others      => <>);
            Outgoing := A11y.Linux.DBus_Messages.Build_Reply
              (Incoming, Boundary_Reply, 140, Result);

