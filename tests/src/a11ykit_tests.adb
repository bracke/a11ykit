   declare
      Queue : A11y.Linux.DBus_Messages.Outgoing_Queue;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      Result : A11y.Results.Result;
      First : A11y.Linux.DBus_Messages.Outgoing_Message;
      Second : A11y.Linux.DBus_Messages.Outgoing_Message;
