      Path_Result : A11y.Results.Result;

      function Has_Name (Text : String) return Boolean is
      begin
         for Item of Names loop
            if To_String (Item) = Text then
               return True;
            end if;
         end loop;

         return False;
      end Has_Name;
   begin
      Snapshot.Id := A11y.Node_Ids.From_Natural (901);
      Snapshot.Parent := A11y.Node_Ids.From_Natural (900);
      Snapshot.Role := A11y.Roles.Button;
      Snapshot.Name := To_Unbounded_String ("cached button");
      Snapshot.Description := To_Unbounded_String ("cached description");
      Snapshot.Child_Count := 3;
      Snapshot.Capabilities (A11y.Capabilities.Action) := True;
      Snapshot.Capabilities (A11y.Capabilities.Text) := True;

      Interfaces := A11y.Linux.ATSPi_Cache.Interfaces_For
        (Snapshot.Capabilities);
      Check
        (Interfaces (A11y.Linux.ATSPi_Objects.Accessible)
         and then Interfaces (A11y.Linux.ATSPi_Objects.Component)
         and then Interfaces (A11y.Linux.ATSPi_Objects.Action)
         and then Interfaces (A11y.Linux.ATSPi_Objects.Text)
         and then not Interfaces (A11y.Linux.ATSPi_Objects.Value),
         "Linux AT-SPI cache exposes only capability-backed interfaces");

      Names := A11y.Linux.ATSPi_Cache.Interface_Names (Interfaces);
      Check
        (Natural (Names.Length) = 4
         and then Has_Name ("org.a11y.atspi.Accessible")
         and then Has_Name ("org.a11y.atspi.Component")
         and then Has_Name ("org.a11y.atspi.Action")
         and then Has_Name ("org.a11y.atspi.Text"),
         "Linux AT-SPI cache projects interface sets as D-Bus names");

      Snapshot.Role := A11y.Roles.Application;
      Names := A11y.Linux.ATSPi_Cache.Interface_Names
        (A11y.Linux.ATSPi_Cache.Interfaces_For (Snapshot));
      Check
        (Natural (Names.Length) = 5
         and then Has_Name ("org.a11y.atspi.Application"),
         "Linux AT-SPI cache includes role-derived Application interfaces");
      Snapshot.Role := A11y.Roles.Button;

      Cached := A11y.Linux.ATSPi_Cache.Build_Node
        (Session, Snapshot, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then To_String (Cached.Path) =
           To_String
             (A11y.Linux.ATSPi_Objects.Object_Path
                (Session, Snapshot.Id, Path_Result))
         and then To_String (Cached.Parent_Path) =
           To_String
             (A11y.Linux.ATSPi_Objects.Object_Path
                (Session, Snapshot.Parent, Path_Result))
         and then Cached.Role = A11y.Linux.ATSPi_Mappings.Push_Button
         and then Cached.Child_Count = 3,
         "Linux AT-SPI cache builds bounded semantic node projections");

      declare
         Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
         Invalid_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         A11y.Resource_Limits.Set_Limit
           (Limits,
            A11y.Resource_Limits.Native_String_Size,
            6,
            Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI cache configures native string limits");

         Cached := A11y.Linux.ATSPi_Cache.Build_Node
           (Session, Snapshot, Limits, Result);
         Check
           (Result.Status = A11y.Results.Resource_Limit,
            "Linux AT-SPI cache rejects oversized cached names");

         Invalid_Limits.Limits
           (A11y.Resource_Limits.Native_String_Size) := 0;
         Cached := A11y.Linux.ATSPi_Cache.Build_Node
           (Session, Snapshot, Invalid_Limits, Result);
         Check
           (Result.Status = A11y.Results.Invalid_Argument,
            "Linux AT-SPI cache rejects invalid limit configs before projection");
      end;

      declare
         Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
