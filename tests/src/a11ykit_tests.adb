      Gate_View := Gate.Snapshot;
      Check
        (Targets_Result.Status = A11y.Results.Node_Unavailable
         and then Gate_View.Outstanding = 0,
         "native relation target boundary rejects stale objects");

      A11y.Native_Relation_Calls.Query_Node_Relation_Targets
        (Gate,
         Runtime,
         Dispatcher,
         Source,
         Graph,
         A11y.Relations.Labelled_By,
         Limits,
         Targets_Result);
      Gate_View := Gate.Snapshot;
      Check
        (Targets_Result.Status = A11y.Results.Node_Unavailable
         and then Gate_View.Outstanding = 0,
         "native relation target boundary rejects stale nodes before dispatch");

      A11y.Dispatchers.Begin_Shutdown (Dispatcher);
      A11y.Native_Relation_Calls.Query_Object_Active_Descendant
        (Gate,
         Runtime,
         Dispatcher,
         Empty_Object,
         Graph,
         Relation_Result);
      Gate_View := Gate.Snapshot;
      Check
        (Relation_Result.Status = A11y.Results.Shutting_Down
         and then Gate_View.Outstanding = 0,
         "native relation boundary unwinds when dispatcher rejects shutdown");

      A11y.Native_Relation_Calls.Query_Object_Relation_Targets
        (Gate,
         Runtime,
         Dispatcher,
         Empty_Object,
         Graph,
         A11y.Relations.Labelled_By,
         Limits,
         Targets_Result);
      Gate_View := Gate.Snapshot;
      Check
        (Targets_Result.Status = A11y.Results.Shutting_Down
         and then Gate_View.Outstanding = 0,
         "native relation target boundary unwinds during shutdown");
