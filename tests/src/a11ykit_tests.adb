      Target_2 : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (578);
      Stale_Target : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (579);
      Object : A11y.Native_Object_Caches.Native_Object_Id;
      Empty_Object : A11y.Native_Object_Caches.Native_Object_Id;
      Gate_View : A11y.Native_Callbacks.Callback_Gate_Snapshot;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      Runtime_Result : A11y.Results.Result;
      Relation_Result :
