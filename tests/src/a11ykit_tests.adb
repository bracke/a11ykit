   declare
   begin
      declare
            Session : constant A11y.Native_Identity.Backend_Session_Id :=
              A11y.Native_Identity.Create_Session;
            Node : constant A11y.Node_Ids.Node_Id :=
              A11y.Node_Ids.From_Natural (577);
            Path_Result : A11y.Results.Result;
            Path : constant Unbounded_String :=
              A11y.Linux.ATSPi_Objects.Object_Path
                (Session, Node, Path_Result);
            Snapshot : A11y.Linux.ATSPi_Live_Regions.Live_Snapshot;
            Reply : A11y.Linux.ATSPi_Live_Regions.Live_Reply;
            Live_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
              A11y.Resource_Limits.Default_Config;
            Result : A11y.Results.Result;
         begin
            Snapshot.Id := Node;
            Snapshot.Metadata.Setting := A11y.Live_Regions.Assertive;
            Snapshot.Metadata.Atomic := True;
            Snapshot.Metadata.Relevant :=
              A11y.Live_Regions.With_Change
                (A11y.Live_Regions.With_Change
                   (A11y.Live_Regions.Empty_Relevant_Change_Set,
                    A11y.Live_Regions.Additions),
                 A11y.Live_Regions.Text);

            Reply := A11y.Linux.ATSPi_Live_Regions.Handle_Method
              (Session, To_String (Path), "GetLiveSetting", Snapshot);
            Check
              (Path_Result.Status = A11y.Results.Success
               and then Reply.Kind =
                 A11y.Linux.ATSPi_Live_Regions.String_Reply
               and then To_String (Reply.Text) = "assertive",
               "Linux AT-SPI live-region method layer returns settings");

            Reply := A11y.Linux.ATSPi_Live_Regions.Handle_Method
              (Session, To_String (Path), "GetLiveRelevant", Snapshot);
            Check
              (Reply.Kind = A11y.Linux.ATSPi_Live_Regions.String_Reply
               and then To_String (Reply.Text) = "additions text",
               "Linux AT-SPI live-region method layer returns relevance names");

            Reply := A11y.Linux.ATSPi_Live_Regions.Handle_Method
              (Session, To_String (Path), "IsLiveAtomic", Snapshot);
            Check
              (Reply.Kind = A11y.Linux.ATSPi_Live_Regions.Boolean_Reply
               and then Reply.Boolean_Item,
               "Linux AT-SPI live-region method layer returns atomicity");

            Reply := A11y.Linux.ATSPi_Live_Regions.Handle_Method
              (Session, To_String (Path), "IsLiveAssertive", Snapshot);
            Check
              (Reply.Kind = A11y.Linux.ATSPi_Live_Regions.Boolean_Reply
               and then Reply.Boolean_Item,
               "Linux AT-SPI live-region method layer returns assertive policy");

            A11y.Resource_Limits.Set_Limit
              (Live_Limits,
               A11y.Resource_Limits.Native_String_Size,
               4,
               Result);
            Reply := A11y.Linux.ATSPi_Live_Regions.Handle_Method
              (Session, To_String (Path), "GetLiveSetting", Snapshot,
               Live_Limits);
            Check
              (Reply.Kind = A11y.Linux.ATSPi_Live_Regions.Error_Reply
               and then Reply.Status = A11y.Results.Resource_Limit,
               "Linux AT-SPI live-region method layer bounds setting names");

            declare
               Invalid_Limits :
                 A11y.Resource_Limits.Resource_Limit_Config :=
                   A11y.Resource_Limits.Default_Config;
            begin
               Invalid_Limits.Limits
                 (A11y.Resource_Limits.Native_String_Size) := 0;
               Reply := A11y.Linux.ATSPi_Live_Regions.Handle_Method
                 (Session, To_String (Path), "IsLiveAtomic", Snapshot,
                  Invalid_Limits);
               Check
                 (Reply.Kind = A11y.Linux.ATSPi_Live_Regions.Error_Reply
                  and then Reply.Status = A11y.Results.Invalid_Argument,
                  "Linux AT-SPI live-region method layer rejects invalid limit configs");
            end;

            Snapshot.Metadata.Setting := A11y.Live_Regions.Off;
            Reply := A11y.Linux.ATSPi_Live_Regions.Handle_Method
              (Session, To_String (Path), "IsLiveAtomic", Snapshot);
            Check
              (Reply.Kind = A11y.Linux.ATSPi_Live_Regions.Error_Reply
               and then Reply.Status = A11y.Results.Invalid_State,
               "Linux AT-SPI live-region method layer validates metadata");

            Snapshot.Metadata.Setting := A11y.Live_Regions.Assertive;
            Snapshot.Defunct := True;
            Reply := A11y.Linux.ATSPi_Live_Regions.Handle_Method
              (Session, To_String (Path), "IsLiveAtomic", Snapshot);
            Check
              (Reply.Kind = A11y.Linux.ATSPi_Live_Regions.Error_Reply
               and then Reply.Status = A11y.Results.Node_Unavailable,
               "Linux AT-SPI live-region method layer rejects defunct snapshots");
         end;
   end;

