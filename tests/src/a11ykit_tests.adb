              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Error_Context) = 0,
            "Linux AT-SPI bus layer completes Hello error replies through in-flight tracking");
      end;

      declare
         Registration_Error_Context :
           A11y.Linux.ATSPi_Bus.Connection_Context;
         Request : A11y.Linux.DBus_Messages.Transport_Envelope;
         Hello_Return : constant
           A11y.Linux.DBus_Messages.Transport_Envelope :=
             (Kind                      =>
                A11y.Linux.DBus_Messages.Method_Return,
              Serial                    => 2,
              Reply_Serial              => 1,
              Status                    => A11y.Results.Success,
              Object_Path               => Null_Unbounded_String,
              Interface_Name            => Null_Unbounded_String,
              Member_Name               => Null_Unbounded_String,
              Error_Name                => Null_Unbounded_String,
                Sender_Name               => Null_Unbounded_String,
              Body_Signature            => To_Unbounded_String ("s"),
              Body_Bytes                =>
                To_Unbounded_String
                  (Character'Val (5) & Character'Val (0)
                   & Character'Val (0) & Character'Val (0)
                   & ":1.77" & Character'Val (0)),
              Body_Object_Path_Argument => Null_Unbounded_String,
                Body_String_Argument      => Null_Unbounded_String,
                Body_String_Argument_2    => Null_Unbounded_String,
                Body_UInt32_Argument      => 0,
            Body_UInt32_Argument_2    => 0,
                Body_Point_Argument       => (X => 0, Y => 0),
            Body_Float_Argument       => 0.0);
         Registration_Error : constant
           A11y.Linux.DBus_Messages.Transport_Envelope :=
             (Kind                      =>
                A11y.Linux.DBus_Messages.Error_Return,
              Serial                    => 3,
              Reply_Serial              => 2,
              Status                    => A11y.Results.Success,
              Object_Path               => Null_Unbounded_String,
              Interface_Name            => Null_Unbounded_String,
              Member_Name               => Null_Unbounded_String,
              Error_Name                =>
                To_Unbounded_String
                  (A11y.Linux.ATSPi_Objects.Error_Name
                     (A11y.Results.Unsupported_Capability)),
              Sender_Name               => Null_Unbounded_String,
              Body_Signature            => Null_Unbounded_String,
              Body_Bytes                => Null_Unbounded_String,
              Body_Object_Path_Argument => Null_Unbounded_String,
                Body_String_Argument      => Null_Unbounded_String,
                Body_String_Argument_2    => Null_Unbounded_String,
                Body_UInt32_Argument      => 0,
            Body_UInt32_Argument_2    => 0,
                Body_Point_Argument       => (X => 0, Y => 0),
            Body_Float_Argument       => 0.0);
      begin
         A11y.Linux.ATSPi_Bus.Prepare_Connection
           (Registration_Error_Context,
            "unix:path=/run/user/1000/at-spi/bus",
            Result);
         A11y.Linux.ATSPi_Bus.Mark_Transport_Connected
           (Registration_Error_Context, Result);
         A11y.Linux.ATSPi_Bus.Queue_Bus_Hello
           (Registration_Error_Context, Result);
         A11y.Linux.ATSPi_Bus.Send_Next_Transport_Envelope
           (Registration_Error_Context, Request, Result);
         A11y.Linux.ATSPi_Bus.Complete_Bus_Hello
           (Registration_Error_Context, Hello_Return, Result);
         A11y.Linux.ATSPi_Bus.Queue_Application_Registration
           (Registration_Error_Context, Application_Node, Result);
         A11y.Linux.ATSPi_Bus.Send_Next_Transport_Envelope
           (Registration_Error_Context, Request, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Request.Serial = 2
            and then Registration_Error_Context.State =
              A11y.Linux.ATSPi_Bus.Connected
            and then
              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Registration_Error_Context) = 1,
            "Linux AT-SPI bus layer prepares tracked registration error fixtures");

         A11y.Linux.ATSPi_Bus.Complete_Application_Registration
           (Registration_Error_Context,
            (Kind                      =>
               A11y.Linux.DBus_Messages.Error_Return,
             Serial                    => 4,
             Reply_Serial              => 999,
             Status                    => A11y.Results.Success,
             Object_Path               => Null_Unbounded_String,
             Interface_Name            => Null_Unbounded_String,
             Member_Name               => Null_Unbounded_String,
             Error_Name                =>
               To_Unbounded_String
                 (A11y.Linux.ATSPi_Objects.Error_Name
                    (A11y.Results.Timed_Out)),
             Sender_Name               => Null_Unbounded_String,
             Body_Signature            => Null_Unbounded_String,
             Body_Bytes                => Null_Unbounded_String,
             Body_Object_Path_Argument => Null_Unbounded_String,
                Body_String_Argument      => Null_Unbounded_String,
                Body_String_Argument_2    => Null_Unbounded_String,
                Body_UInt32_Argument      => 0,
            Body_UInt32_Argument_2    => 0,
                Body_Point_Argument       => (X => 0, Y => 0),
            Body_Float_Argument       => 0.0),
            Result);
         Check
           (Result.Status = A11y.Results.Node_Unavailable
            and then Registration_Error_Context.State =
              A11y.Linux.ATSPi_Bus.Connected
            and then
              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Registration_Error_Context) = 1,
            "Linux AT-SPI bus layer rejects unknown registration error replies before completing tracked calls");

         A11y.Linux.ATSPi_Bus.Complete_Application_Registration
           (Registration_Error_Context, Registration_Error, Result);
         Check
           (Result.Status = A11y.Results.Unsupported_Capability
            and then Registration_Error_Context.State =
              A11y.Linux.ATSPi_Bus.Connected
            and then
              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Registration_Error_Context) = 0,
            "Linux AT-SPI bus layer completes registration error replies through in-flight tracking");
      end;

      declare
         Session_Context : A11y.Linux.ATSPi_Bus.Connection_Context;
         Request_Envelope : A11y.Linux.DBus_Messages.Transport_Envelope;
         Address : A11y.Linux.ATSPi_Bus.Bus_Address;

         function String_Body (Text : String) return Unbounded_String is
           (To_Unbounded_String
              (Character'Val (Text'Length)
               & Character'Val (0)
               & Character'Val (0)
               & Character'Val (0)
               & Text
               & Character'Val (0)));
      begin
         A11y.Linux.ATSPi_Address_Discovery
           .Queue_Accessibility_Bus_Address_Request
             (Session_Context, Result);
         Check
           (Result.Status = A11y.Results.Backend_Unavailable,
            "Linux AT-SPI a11y bus address request rejects unconnected session contexts");

         A11y.Linux.ATSPi_Bus.Prepare_Connection
           (Session_Context, "unix:path=/run/user/1000/bus", Result);
         A11y.Linux.ATSPi_Bus.Mark_Transport_Connected
           (Session_Context, Result);
         A11y.Linux.ATSPi_Address_Discovery
           .Queue_Accessibility_Bus_Address_Request
             (Session_Context, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then
              A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count
                (Session_Context) = 1,
            "Linux AT-SPI a11y bus address request queues GetAddress");

         A11y.Linux.ATSPi_Bus.Send_Next_Transport_Envelope
           (Session_Context, Request_Envelope, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Request_Envelope.Kind =
              A11y.Linux.DBus_Messages.Method_Call
            and then To_String (Request_Envelope.Object_Path) =
              "/org/a11y/bus"
            and then To_String (Request_Envelope.Interface_Name) =
              "org.a11y.Bus"
            and then To_String (Request_Envelope.Member_Name) =
              "GetAddress"
            and then Request_Envelope.Serial = 1
            and then
              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Session_Context) = 1,
            "Linux AT-SPI a11y bus address request builds GetAddress method calls");

         declare
            Huge_Body : constant String (1 .. 20_000) := [others => 'x'];
         begin
            Address :=
              A11y.Linux.ATSPi_Address_Discovery
                .Complete_Accessibility_Bus_Address_Request
                  (Session_Context,
                   (Kind                      =>
                      A11y.Linux.DBus_Messages.Method_Return,
                    Serial                    => 50,
                    Reply_Serial              => 999,
                    Status                    => A11y.Results.Success,
                    Object_Path               => Null_Unbounded_String,
                    Interface_Name            => Null_Unbounded_String,
                    Member_Name               => Null_Unbounded_String,
                    Error_Name                => Null_Unbounded_String,
                Sender_Name               => Null_Unbounded_String,
                    Body_Signature            => To_Unbounded_String ("s"),
                    Body_Bytes                => To_Unbounded_String (Huge_Body),
                    Body_Object_Path_Argument => Null_Unbounded_String,
                Body_String_Argument      => Null_Unbounded_String,
                Body_String_Argument_2    => Null_Unbounded_String,
                Body_UInt32_Argument      => 0,
            Body_UInt32_Argument_2    => 0,
                Body_Point_Argument       => (X => 0, Y => 0),
            Body_Float_Argument       => 0.0),
                   Result);
         end;
         Check
           (Result.Status = A11y.Results.Node_Unavailable
            and then Address.State = A11y.Linux.ATSPi_Bus.Address_Invalid
            and then
              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Session_Context) = 1,
            "Linux AT-SPI a11y bus address request rejects unknown replies before body decode");

         Address :=
           A11y.Linux.ATSPi_Address_Discovery
             .Complete_Accessibility_Bus_Address_Request
               (Session_Context,
                (Kind                      =>
                   A11y.Linux.DBus_Messages.Method_Return,
                 Serial                    => 2,
                 Reply_Serial              => 1,
                 Status                    => A11y.Results.Success,
                 Object_Path               => Null_Unbounded_String,
                 Interface_Name            => Null_Unbounded_String,
                 Member_Name               => Null_Unbounded_String,
                 Error_Name                => Null_Unbounded_String,
                Sender_Name               => Null_Unbounded_String,
                 Body_Signature            => To_Unbounded_String ("s"),
                 Body_Bytes                =>
                   String_Body ("unix:path=/tmp/a11ykit-atspi-bus"),
                 Body_Object_Path_Argument => Null_Unbounded_String,
                Body_String_Argument      => Null_Unbounded_String,
                Body_String_Argument_2    => Null_Unbounded_String,
                Body_UInt32_Argument      => 0,
            Body_UInt32_Argument_2    => 0,
                Body_Point_Argument       => (X => 0, Y => 0),
            Body_Float_Argument       => 0.0),
                Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Address.State = A11y.Linux.ATSPi_Bus.Address_Valid
            and then Address.Transport = A11y.Linux.ATSPi_Bus.Unix_Transport
            and then To_String (Address.Text) =
              "unix:path=/tmp/a11ykit-atspi-bus"
            and then
              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Session_Context) = 0,
            "Linux AT-SPI a11y bus address request completes valid address replies");

         A11y.Linux.ATSPi_Address_Discovery
           .Queue_Accessibility_Bus_Address_Request
             (Session_Context, Result);
         A11y.Linux.ATSPi_Bus.Send_Next_Transport_Envelope
           (Session_Context, Request_Envelope, Result);
         Address :=
           A11y.Linux.ATSPi_Address_Discovery
             .Complete_Accessibility_Bus_Address_Request
               (Session_Context,
                (Kind                      =>
                   A11y.Linux.DBus_Messages.Method_Return,
                 Serial                    => 3,
                 Reply_Serial              => Request_Envelope.Serial,
                 Status                    => A11y.Results.Success,
                 Object_Path               => Null_Unbounded_String,
                 Interface_Name            => Null_Unbounded_String,
                 Member_Name               => Null_Unbounded_String,
                 Error_Name                => Null_Unbounded_String,
                Sender_Name               => Null_Unbounded_String,
                 Body_Signature            => To_Unbounded_String ("s"),
                 Body_Bytes                => String_Body ("not-an-address"),
                 Body_Object_Path_Argument => Null_Unbounded_String,
                Body_String_Argument      => Null_Unbounded_String,
                Body_String_Argument_2    => Null_Unbounded_String,
                Body_UInt32_Argument      => 0,
            Body_UInt32_Argument_2    => 0,
                Body_Point_Argument       => (X => 0, Y => 0),
            Body_Float_Argument       => 0.0),
                Result);
         Check
           (Result.Status = A11y.Results.Invalid_Argument
            and then Address.State = A11y.Linux.ATSPi_Bus.Address_Invalid
            and then
              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Session_Context) = 0,
            "Linux AT-SPI a11y bus address request completes malformed address replies safely");

         A11y.Linux.ATSPi_Address_Discovery
           .Queue_Accessibility_Bus_Address_Request
             (Session_Context, Result);
         A11y.Linux.ATSPi_Bus.Send_Next_Transport_Envelope
           (Session_Context, Request_Envelope, Result);
         Address :=
           A11y.Linux.ATSPi_Address_Discovery
             .Complete_Accessibility_Bus_Address_Request
               (Session_Context,
                (Kind                      =>
                   A11y.Linux.DBus_Messages.Error_Return,
                 Serial                    => 4,
                 Reply_Serial              => Request_Envelope.Serial,
                 Status                    => A11y.Results.Success,
                 Object_Path               => Null_Unbounded_String,
                 Interface_Name            => Null_Unbounded_String,
                 Member_Name               => Null_Unbounded_String,
                 Error_Name                =>
                   To_Unbounded_String
                     (A11y.Linux.ATSPi_Objects.Error_Name
                        (A11y.Results.Timed_Out)),
                 Sender_Name               => Null_Unbounded_String,
                 Body_Signature            => Null_Unbounded_String,
                 Body_Bytes                => Null_Unbounded_String,
                 Body_Object_Path_Argument => Null_Unbounded_String,
                Body_String_Argument      => Null_Unbounded_String,
                Body_String_Argument_2    => Null_Unbounded_String,
                Body_UInt32_Argument      => 0,
            Body_UInt32_Argument_2    => 0,
                Body_Point_Argument       => (X => 0, Y => 0),
            Body_Float_Argument       => 0.0),
                Result);
         Check
           (Result.Status = A11y.Results.Timed_Out
            and then Address.State = A11y.Linux.ATSPi_Bus.Address_Invalid
            and then
              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Session_Context) = 0,
            "Linux AT-SPI a11y bus address request completes GetAddress error replies through in-flight tracking");

         A11y.Linux.ATSPi_Address_Discovery
           .Queue_Accessibility_Bus_Address_Request
             (Session_Context, Result);
         A11y.Linux.ATSPi_Bus.Send_Next_Transport_Envelope
           (Session_Context, Request_Envelope, Result);
         Address :=
           A11y.Linux.ATSPi_Address_Discovery
             .Complete_Accessibility_Bus_Address_Request
               (Session_Context,
                (Kind                      =>
                   A11y.Linux.DBus_Messages.Error_Return,
                 Serial                    => 5,
                 Reply_Serial              => 999,
                 Status                    => A11y.Results.Success,
                 Object_Path               => Null_Unbounded_String,
                 Interface_Name            => Null_Unbounded_String,
                 Member_Name               => Null_Unbounded_String,
                 Error_Name                =>
                   To_Unbounded_String
                     (A11y.Linux.ATSPi_Objects.Error_Name
                        (A11y.Results.Timed_Out)),
                 Sender_Name               => Null_Unbounded_String,
                 Body_Signature            => Null_Unbounded_String,
                 Body_Bytes                => Null_Unbounded_String,
                 Body_Object_Path_Argument => Null_Unbounded_String,
                Body_String_Argument      => Null_Unbounded_String,
                Body_String_Argument_2    => Null_Unbounded_String,
                Body_UInt32_Argument      => 0,
            Body_UInt32_Argument_2    => 0,
                Body_Point_Argument       => (X => 0, Y => 0),
            Body_Float_Argument       => 0.0),
                Result);
         Check
           (Result.Status = A11y.Results.Node_Unavailable
            and then Address.State = A11y.Linux.ATSPi_Bus.Address_Invalid
            and then
              A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count
                (Session_Context) = 1,
            "Linux AT-SPI a11y bus address request rejects unknown GetAddress error replies before completing tracked calls");
      end;

      Serial_1 := A11y.Linux.ATSPi_Bus.Next_Outgoing_Serial
        (Context, Result);
      Serial_2 := A11y.Linux.ATSPi_Bus.Next_Outgoing_Serial
        (Context, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Serial_1 = 1
         and then Serial_2 = 2
         and then Context.Last_Serial = 2,
         "Linux AT-SPI bus layer allocates monotonic outgoing serials");

      Registration := A11y.Linux.ATSPi_Bus.Build_Application_Registration
        (Context, Application_Node, 60, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then Registration.Kind = A11y.Linux.DBus_Messages.Error_Return
         and then Registration.Serial = 60
         and then Context.Last_Serial = 2,
         "Linux AT-SPI bus layer rejects registration calls before D-Bus Hello unique names");

      A11y.Linux.ATSPi_Bus.Queue_Application_Registration
        (Context, Application_Node, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context) = 0
         and then Context.Last_Serial = 2,
         "Linux AT-SPI bus layer rejects queued registration before D-Bus Hello unique names");

      Context.Unique_Name := To_Unbounded_String (":1.77");

      A11y.Linux.ATSPi_Bus.Register_Application (Context, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Context.State = A11y.Linux.ATSPi_Bus.Registered
         and then Context.Session = First_Session,
         "Linux AT-SPI bus layer registers applications after transport admission");

      Application_Path := A11y.Linux.ATSPi_Objects.Object_Path
        (Context.Session, Application_Node, Result);
      Registration := A11y.Linux.ATSPi_Bus.Build_Application_Registration
        (Context, Application_Node, 61, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Registration.Kind = A11y.Linux.DBus_Messages.Method_Call
         and then Registration.Serial = 61
         and then To_String (Registration.Object_Path)
           = "/org/a11y/atspi/accessible/root"
         and then To_String (Registration.Interface_Name)
           = "org.a11y.atspi.Socket"
         and then To_String (Registration.Member_Name)
           = "Embed"
         and then Registration.Has_Object_Reference_Argument
         and then Registration.String_Argument = Context.Unique_Name
         and then Registration.Object_Path_Argument = Application_Path,
         "Linux AT-SPI bus layer builds application registration calls");

      A11y.Linux.ATSPi_Bus.Register_Application (Context, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Context.State = A11y.Linux.ATSPi_Bus.Registered,
         "Linux AT-SPI bus layer treats application registration as idempotent");

      Registration := A11y.Linux.ATSPi_Bus.Build_Application_Registration
        (Context, Application_Node, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Registration.Kind = A11y.Linux.DBus_Messages.Method_Call
         and then Registration.Serial = 3
         and then Context.Last_Serial = 3
         and then Registration.Has_Object_Reference_Argument
         and then Registration.String_Argument = Context.Unique_Name
         and then Registration.Object_Path_Argument = Application_Path,
         "Linux AT-SPI bus layer allocates serials for registration calls");

      Previous_Serial := Context.Last_Serial;
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Native_String_Size,
         4,
         Result);
      Registration := A11y.Linux.ATSPi_Bus.Build_Application_Registration
        (Context, Application_Node, Limits, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Registration.Kind = A11y.Linux.DBus_Messages.Error_Return
         and then Context.Last_Serial = Previous_Serial,
         "Linux AT-SPI bus layer preserves serials after registration envelope failure");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Native_Array_Size,
         1,
         Result);
      A11y.Linux.ATSPi_Bus.Configure_Outgoing_Queue
        (Context, Limits, Result);
      Queue_Interest := A11y.Linux.ATSPi_Bus.Posting_Interest (Context);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Linux.ATSPi_Bus.Pending_Outgoing_Capacity (Context) = 1
         and then
           A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Capacity (Context) = 1
         and then not
           A11y.Linux.ATSPi_Bus.Pending_Outgoing_Overflowed (Context),
         "Linux AT-SPI bus layer configures outgoing transport queue");
      Check
        (not Queue_Interest.Can_Send
         and then not Queue_Interest.Has_Pending
         and then not Queue_Interest.Overflowed
         and then Queue_Interest.Length = 0
         and then Queue_Interest.Capacity = 1
         and then Queue_Interest.Next_Operation =
           A11y.Linux.DBus_Messages.No_Posting_Operation,
         "Linux AT-SPI D-Bus outgoing queue interest reports empty queues");

      A11y.Linux.ATSPi_Bus.Queue_Application_Registration
        (Context, Application_Node, Result);
      Queue_Interest := A11y.Linux.ATSPi_Bus.Posting_Interest (Context);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context) = 1
         and then Context.Last_Serial = 4,
         "Linux AT-SPI bus layer stages registration calls for transport");
      Check
        (Queue_Interest.Can_Send
         and then Queue_Interest.Has_Pending
         and then not Queue_Interest.Overflowed
         and then Queue_Interest.Length = 1
         and then Queue_Interest.Capacity = 1
         and then Queue_Interest.Next_Operation =
           A11y.Linux.DBus_Messages.Send_Next_Message,
         "Linux AT-SPI D-Bus outgoing queue interest admits pending sends");

      A11y.Linux.ATSPi_Bus.Queue_Application_Registration
        (Context, Application_Node, Result);
      Queue_Interest := A11y.Linux.ATSPi_Bus.Posting_Interest (Context);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context) = 1
         and then A11y.Linux.ATSPi_Bus.Pending_Outgoing_Overflowed (Context)
         and then Context.Last_Serial = 5,
         "Linux AT-SPI bus layer reports full outgoing transport queues");
      Check
        (not Queue_Interest.Can_Send
         and then Queue_Interest.Has_Pending
         and then Queue_Interest.Overflowed
         and then Queue_Interest.Length = 1
         and then Queue_Interest.Capacity = 1
         and then Queue_Interest.Next_Operation =
           A11y.Linux.DBus_Messages.Back_Pressure,
         "Linux AT-SPI D-Bus outgoing queue interest reports back pressure");

      A11y.Linux.ATSPi_Bus.Dequeue_Outgoing
        (Context, Queued, Result);
      Queue_Interest := A11y.Linux.ATSPi_Bus.Posting_Interest (Context);
      Check
        (A11y.Results.Succeeded (Result)
         and then Queued.Kind = A11y.Linux.DBus_Messages.Method_Call
         and then Queued.Serial = 4
         and then A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context) = 0,
         "Linux AT-SPI bus layer drains queued transport messages in order");
      Check
        (not Queue_Interest.Can_Send
         and then not Queue_Interest.Has_Pending
         and then Queue_Interest.Overflowed
         and then Queue_Interest.Length = 0
         and then Queue_Interest.Next_Operation =
           A11y.Linux.DBus_Messages.Back_Pressure,
         "Linux AT-SPI D-Bus outgoing queue interest preserves overflow until reset");

      A11y.Linux.ATSPi_Bus.Queue_Application_Registration
        (Context, Application_Node, Result);
      A11y.Linux.ATSPi_Bus.Send_Next_Outgoing
        (Context, Queued, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Queued.Kind = A11y.Linux.DBus_Messages.Error_Return
         and then A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context) = 1
         and then
           A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count (Context) = 0,
         "Linux AT-SPI bus layer rejects sends while outgoing overflow is pending");

      A11y.Linux.ATSPi_Bus.Send_Next_Transport_Envelope
        (Context, Envelope, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Envelope.Serial = 0
         and then A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context) = 1
         and then
           A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count (Context) = 0,
         "Linux AT-SPI bus layer rejects envelope sends while outgoing overflow is pending");

      A11y.Linux.ATSPi_Bus.Send_Next_Transport_Frame
        (Context, Transport_Frame, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Transport_Frame.Metadata.Serial = 0
         and then A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context) = 1
         and then
           A11y.Linux.ATSPi_Bus.In_Flight_Outgoing_Count (Context) = 0,
         "Linux AT-SPI bus layer rejects frame sends while outgoing overflow is pending");

      A11y.Linux.ATSPi_Bus.Clear_Outgoing_Queue (Context);
      Queue_Interest := A11y.Linux.ATSPi_Bus.Posting_Interest (Context);
      Check
        (A11y.Linux.ATSPi_Bus.Pending_Outgoing_Count (Context) = 0
         and then not A11y.Linux.ATSPi_Bus.Pending_Outgoing_Overflowed (Context)
         and then not Queue_Interest.Can_Send
