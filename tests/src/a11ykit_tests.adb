   declare
      Session : A11y.Sessions.Semantic_Session;
      Root : A11y.Node_Ids.Node_Id;
      First : A11y.Node_Ids.Node_Id;
      Second : A11y.Node_Ids.Node_Id;
      Detached : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Event : A11y.Events.Event;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      A11y.Sessions.Create_Node (Session, null, Root, Result);
      A11y.Sessions.Create_Node (Session, null, First, Result);
      A11y.Sessions.Create_Node (Session, null, Second, Result);
      A11y.Sessions.Create_Node (Session, null, Detached, Result);
      A11y.Sessions.Attach_Root (Session, Root, Result);
      A11y.Sessions.Attach (Session, Root, First, Result);
      A11y.Sessions.Attach (Session, Root, Second, Result);

      while A11y.Sessions.Pending_Event_Count (Session) > 0 loop
         A11y.Sessions.Dequeue_Event (Session, Event, Result);
      end loop;

      A11y.Sessions.Set_Focus (Session, Detached, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then A11y.Sessions.Focused_Node (Session)
           = A11y.Node_Ids.No_Node,
         "session rejects focus on detached nodes");

      A11y.Sessions.Set_Focus (Session, First, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Sessions.Focused_Node (Session) = First,
         "session commits focused node before focus events are consumed");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Focus_Changed
         and then Event.Source = First,
         "session emits focus-changed after focus commit");

      A11y.Sessions.Set_Focus (Session, First, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Sessions.Pending_Event_Count (Session) = 0,
         "session does not emit focus events for unchanged focus");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         0,
         Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument,
         "session focus fixture rejects impossible event limits");
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         1,
         Result);
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      A11y.Sessions.Set_Focus (Session, Second, Result);
      A11y.Sessions.Set_Focus (Session, First, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then A11y.Sessions.Focused_Node (Session) = Second
         and then A11y.Sessions.Pending_Event_Count (Session) = 1,
         "session rejects focus changes before queue overflow mutation");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         4,
         Result);
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      A11y.Sessions.Destroy (Session, Second, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Sessions.Focused_Node (Session)
           = A11y.Node_Ids.No_Node,
         "session clears focus before destroying focused nodes");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Focus_Changed
         and then Event.Source = Second,
         "session emits focus clear before focused-node destruction events");
   end;

   declare
      Session : A11y.Sessions.Semantic_Session;
      Root : A11y.Node_Ids.Node_Id;
      Child : A11y.Node_Ids.Node_Id;
      Grandchild : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Event : A11y.Events.Event;
      Snapshot : A11y.Registry.Entry_Snapshot;
   begin
      A11y.Sessions.Create_Node (Session, null, Root, Result);
      A11y.Sessions.Create_Node (Session, null, Child, Result);
      A11y.Sessions.Create_Node (Session, null, Grandchild, Result);
      A11y.Sessions.Attach_Root (Session, Root, Result);
      A11y.Sessions.Attach (Session, Root, Child, Result);
      A11y.Sessions.Attach (Session, Child, Grandchild, Result);

      while A11y.Sessions.Pending_Event_Count (Session) > 0 loop
         A11y.Sessions.Dequeue_Event (Session, Event, Result);
      end loop;

      A11y.Sessions.Destroy (Session, Child, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then not A11y.Sessions.Is_Attached (Session, Child)
         and then not A11y.Sessions.Is_Attached (Session, Grandchild),
         "session destroys an attached subtree without exposing descendants");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Child_Removed
         and then Event.Source = Root,
         "session emits parent removal for destroyed subtrees first");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Node_Detached
         and then Event.Source = Child,
         "session detaches destroyed subtree roots before destruction");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Node_Detached
         and then Event.Source = Grandchild,
         "session detaches surviving descendants during subtree destruction");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Node_Destroyed
         and then Event.Source = Child,
         "session destroys subtree roots only after detach events");

      A11y.Sessions.Registry_Snapshot
        (Session, Grandchild, Snapshot, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Snapshot.Lifecycle = A11y.Nodes.Attached
         and then Snapshot.Parent = A11y.Node_Ids.No_Node
         and then not Snapshot.Tombstone,
         "session preserves detached descendants as live non-exposed nodes");

      A11y.Sessions.Destroy (Session, Root, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then not A11y.Sessions.Is_Attached (Session, Root),
         "session destroys the root without leaving it exposed");
   end;

   declare
      Session : A11y.Sessions.Semantic_Session;
      Node : A11y.Node_Ids.Node_Id;
      Overflow_Node : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Initial_Pending : Natural;
      Snapshot : A11y.Registry.Entry_Snapshot;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         2,
         Result);
      Check
        (A11y.Results.Succeeded (Result),
         "session fixture sets event queue capacity limit");
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Sessions.Event_Capacity (Session) = 2,
         "session accepts event queue resource limits");
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Outstanding_Callbacks,
         7,
         Result);
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "session applies registry callback resource limits");

      for Index in 1 .. 2 loop
         A11y.Sessions.Create_Node (Session, null, Node, Result);
         exit when A11y.Results.Failed (Result);
      end loop;
      A11y.Sessions.Registry_Snapshot (Session, Node, Snapshot, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Snapshot.Pin_Limit = 7,
         "session exposes configured registry callback limits");

      Initial_Pending := A11y.Sessions.Pending_Event_Count (Session);
      A11y.Sessions.Create_Node (Session, null, Overflow_Node, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Overflow_Node = A11y.Node_Ids.No_Node
         and then Initial_Pending = 2
         and then A11y.Sessions.Pending_Event_Count (Session) = Initial_Pending,
         "session rejects event-producing mutations before queue overflow");

      Limits.Limits (A11y.Resource_Limits.Event_Queue_Size) := 0;
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument,
         "session rejects invalid event queue resource limits");
   end;

   declare
      Session : A11y.Sessions.Semantic_Session;
      Root : A11y.Node_Ids.Node_Id;
      Field : A11y.Node_Ids.Node_Id;
      Label : A11y.Node_Ids.Node_Id;
      Help : A11y.Node_Ids.Node_Id;
      Targets : A11y.Relations.Target_Vectors.Vector;
      Result : A11y.Results.Result;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         32,
         Result);
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Sessions.Event_Capacity (Session) = 32,
         "session limit-atomicity fixture configures initial queue capacity");

      A11y.Sessions.Create_Node (Session, null, Root, Result);
      A11y.Sessions.Create_Node (Session, null, Field, Result);
      A11y.Sessions.Create_Node (Session, null, Label, Result);
      A11y.Sessions.Create_Node (Session, null, Help, Result);
      A11y.Sessions.Attach_Root (Session, Root, Result);
      A11y.Sessions.Attach (Session, Root, Field, Result);
      A11y.Sessions.Attach (Session, Root, Label, Result);
      A11y.Sessions.Attach (Session, Root, Help, Result);
      A11y.Sessions.Add_Relation
        (Session, Field, A11y.Relations.Described_By, Label, Result);
      A11y.Sessions.Add_Relation
        (Session, Field, A11y.Relations.Described_By, Help, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Field, A11y.Relations.Described_By);
      Check
        (A11y.Results.Succeeded (Result)
         and then Natural (Targets.Length) = 2,
         "session limit-atomicity fixture creates a multi-target relation");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         64,
         Result);
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Relation_Targets_Returned,
         1,
         Result);
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then A11y.Sessions.Event_Capacity (Session) = 32,
         "session rejects non-atomic limit changes without queue mutation");
   end;

   declare
      Session : A11y.Sessions.Semantic_Session;
      Root : A11y.Node_Ids.Node_Id;
      Child : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         4,
         Result);
      Check
        (A11y.Results.Succeeded (Result),
         "session multi-event fixture sets queue capacity limit");
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      A11y.Sessions.Create_Node (Session, null, Root, Result);
      A11y.Sessions.Create_Node (Session, null, Child, Result);
      A11y.Sessions.Attach_Root (Session, Root, Result);

      Check
        (A11y.Sessions.Pending_Event_Count (Session)
         = 3,
         "session fixture leaves one event slot available");

      A11y.Sessions.Attach (Session, Root, Child, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then not A11y.Sessions.Is_Attached (Session, Child)
         and then A11y.Sessions.Pending_Event_Count (Session)
           = 3,
         "session rejects multi-event mutations before partial attach");
   end;

   declare
      Session : A11y.Sessions.Semantic_Session;
      Root : A11y.Node_Ids.Node_Id;
      Child : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Destroy_Result : A11y.Results.Result;
      Event : A11y.Events.Event;
      Snapshot : A11y.Registry.Entry_Snapshot;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      A11y.Sessions.Create_Node (Session, null, Root, Result);
      A11y.Sessions.Create_Node (Session, null, Child, Result);
      A11y.Sessions.Attach_Root (Session, Root, Result);
      A11y.Sessions.Attach (Session, Root, Child, Result);

      while A11y.Sessions.Pending_Event_Count (Session) > 0 loop
         A11y.Sessions.Dequeue_Event (Session, Event, Result);
      end loop;

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         2,
         Result);
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      A11y.Sessions.Destroy (Session, Child, Destroy_Result);
      A11y.Sessions.Registry_Snapshot (Session, Child, Snapshot, Result);
      Check
        (Destroy_Result.Status = A11y.Results.Resource_Limit
         and then A11y.Sessions.Is_Attached (Session, Child)
         and then A11y.Results.Succeeded (Result)
         and then not Snapshot.Tombstone
         and then A11y.Sessions.Pending_Event_Count (Session) = 0,
         "session rejects destroy before partial lifecycle event emission");
   end;

   declare
      Session : A11y.Sessions.Semantic_Session;
      Null_Backend : A11y.Backends.Null_Backends.Null_Backend;
      Disabled_Backend : A11y.Backends.Disabled_Backends.Disabled_Backend;
      Root : A11y.Node_Ids.Node_Id;
      Child : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Event : A11y.Events.Event;
      Initial_Pending : Natural;
      Delivered : Natural;
      Recorded : A11y.Events.Event_Vectors.Vector;
      One_Report : A11y.Backends.Event_Pumps.Pump_One_Report;
      All_Report : A11y.Backends.Event_Pumps.Pump_All_Report;
   begin
      A11y.Sessions.Create_Node (Session, null, Root, Result);
      A11y.Sessions.Create_Node (Session, null, Child, Result);
      A11y.Sessions.Attach_Root (Session, Root, Result);
      A11y.Sessions.Attach (Session, Root, Child, Result);
      Result := Null_Backend.Start;
      Check
        (A11y.Results.Succeeded (Result),
         "backend event pump starts accepting backend");

      Initial_Pending := A11y.Sessions.Pending_Event_Count (Session);
      A11y.Backends.Event_Pumps.Pump_One_With_Report
        (Session, Null_Backend, Event, One_Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Sequence = 1
         and then Initial_Pending > 1
         and then A11y.Sessions.Pending_Event_Count (Session)
           = Initial_Pending - 1
         and then One_Report.Before_Pending = Initial_Pending
         and then One_Report.After_Pending = Initial_Pending - 1
         and then One_Report.Capacity = A11y.Sessions.Event_Capacity (Session)
         and then One_Report.Has_Event
         and then One_Report.Event_Sequence = Event.Sequence
         and then One_Report.Event_Source = Event.Source
         and then One_Report.Event_Kind = Event.Kind
         and then One_Report.Event_Validated
         and then One_Report.Published
         and then One_Report.Acknowledged
         and then One_Report.Delivered = 1
         and then One_Report.Peek_Status = A11y.Results.Success
         and then One_Report.Validation_Status = A11y.Results.Success
         and then One_Report.Publish_Status = A11y.Results.Success
         and then One_Report.Acknowledge_Status = A11y.Results.Success
         and then One_Report.Status = A11y.Results.Success,
         "backend event pump report publishes and acknowledges one committed event");

      A11y.Backends.Event_Pumps.Pump_All_With_Report
        (Session, Null_Backend, All_Report, Result);
      Delivered := All_Report.Delivered;
      Recorded := Null_Backend.Recorded_Events;
      Check
        (A11y.Results.Succeeded (Result)
         and then Delivered = Initial_Pending - 1
         and then A11y.Sessions.Pending_Event_Count (Session) = 0
         and then All_Report.Before_Pending = Initial_Pending - 1
         and then All_Report.After_Pending = 0
         and then All_Report.Capacity = A11y.Sessions.Event_Capacity (Session)
         and then All_Report.Attempted = Initial_Pending - 1
         and then All_Report.Delivered = Initial_Pending - 1
         and then All_Report.Last_Event_Sequence =
           A11y.Event_Sequence (Initial_Pending)
         and then All_Report.Stop_Reason =
           A11y.Backends.Event_Pumps.Pump_Drained
         and then All_Report.Status = A11y.Results.Success
         and then Natural (Recorded.Length) = Initial_Pending
         and then Recorded.First_Element.Sequence = 1
         and then Recorded.Last_Element.Sequence =
           A11y.Event_Sequence (Initial_Pending),
         "backend event pump drains committed events in order");

      A11y.Sessions.Create_Node (Session, null, Root, Result);
      Result := Disabled_Backend.Start;
      Check
        (A11y.Results.Succeeded (Result),
         "backend event pump starts rejecting backend");
      A11y.Backends.Event_Pumps.Pump_One_With_Report
        (Session, Disabled_Backend, Event, One_Report, Result);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable
         and then A11y.Sessions.Pending_Event_Count (Session) = 1
         and then One_Report.Before_Pending = 1
         and then One_Report.After_Pending = 1
         and then One_Report.Has_Event
         and then One_Report.Event_Validated
         and then not One_Report.Published
         and then not One_Report.Acknowledged
         and then One_Report.Delivered = 0
         and then One_Report.Publish_Status =
           A11y.Results.Backend_Unavailable
         and then One_Report.Status = A11y.Results.Backend_Unavailable,
         "backend event pump report preserves events rejected by a backend");
   end;

   declare
      Session : A11y.Sessions.Semantic_Session;
      Backend : A11y.Backends.Null_Backends.Null_Backend;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      First : A11y.Node_Ids.Node_Id;
      Second : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Delivered : Natural;
      Report : A11y.Backends.Event_Pumps.Pump_All_Report;
   begin
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         2,
         Result);
      Check
        (A11y.Results.Succeeded (Result),
         "backend event pump fixture sets configured queue capacity");
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "backend event pump fixture applies configured queue capacity");
      A11y.Sessions.Create_Node (Session, null, First, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "backend event pump fixture queues first event");
      A11y.Sessions.Create_Node (Session, null, Second, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "backend event pump fixture queues second event");
      Result := Backend.Start;
      Check
        (A11y.Results.Succeeded (Result),
         "backend event pump fixture starts backend");
      A11y.Backends.Event_Pumps.Pump_All_With_Report
        (Session, Backend, Report, Result);
      Delivered := Report.Delivered;
      Check
        (A11y.Results.Succeeded (Result)
         and then Delivered = 2
         and then A11y.Sessions.Pending_Event_Count (Session) = 0
         and then Report.Before_Pending = 2
         and then Report.After_Pending = 0
         and then Report.Attempted = 2
         and then Report.Delivered = 2
         and then Report.Stop_Reason =
           A11y.Backends.Event_Pumps.Pump_Drained
         and then Natural (Backend.Recorded_Events.Length) = 2,
         "backend event pump report drains configured-capacity sessions");
   end;

