      A11y.Trees.Set_Root (Snapshot.Tree, Root, Result);
      A11y.Trees.Attach (Snapshot.Tree, Root, Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Node, Flattened, Result);
      A11y.Trees.Attach (Snapshot.Tree, Flattened, Button, Result);
      A11y.Trees.Attach (Snapshot.Tree, Node, Hidden, Result);
      A11y.Trees.Attach (Snapshot.Tree, Hidden, Hidden_Button, Result);
      A11y.Trees.Attach (Snapshot.Tree, Node, Trailing, Result);
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Flattened)) := A11y.Nodes.Flatten_Node;
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Hidden)) :=
           A11y.Nodes.Hide_Node_And_Subtree;

      Reply := A11y.Windows_Backend.UIA_Fragments.Navigate
        (Snapshot, A11y.Windows_Backend.UIA_Fragments.First_Child);
      Check
        (Reply.Found
         and then Reply.Status = A11y.Results.Success
         and then Reply.Node = Button,
         "Windows UIA fragment navigation returns flattened first children");

      Reply := A11y.Windows_Backend.UIA_Fragments.Navigate
        (Snapshot, A11y.Windows_Backend.UIA_Fragments.Last_Child);
      Check
        (Reply.Found
         and then Reply.Status = A11y.Results.Success
         and then Reply.Node = Trailing,
         "Windows UIA fragment navigation skips hidden last children");

      Snapshot.Node := Button;
      Reply := A11y.Windows_Backend.UIA_Fragments.Navigate
        (Snapshot, A11y.Windows_Backend.UIA_Fragments.Parent);
      Check
        (Reply.Found
         and then Reply.Status = A11y.Results.Success
         and then Reply.Node = Node,
         "Windows UIA fragment navigation returns projected parents");

      Reply := A11y.Windows_Backend.UIA_Fragments.Navigate
        (Snapshot, A11y.Windows_Backend.UIA_Fragments.Next_Sibling);
      Check
        (Reply.Found
         and then Reply.Status = A11y.Results.Success
         and then Reply.Node = Trailing,
         "Windows UIA fragment navigation returns projected next siblings");

      Snapshot.Node := Trailing;
      Reply := A11y.Windows_Backend.UIA_Fragments.Navigate
        (Snapshot, A11y.Windows_Backend.UIA_Fragments.Previous_Sibling);
      Check
        (Reply.Found
         and then Reply.Status = A11y.Results.Success
         and then Reply.Node = Button,
         "Windows UIA fragment navigation returns projected previous siblings");

      Snapshot.Node := Hidden_Button;
      Reply := A11y.Windows_Backend.UIA_Fragments.Navigate
        (Snapshot, A11y.Windows_Backend.UIA_Fragments.First_Child);
      Check
        ((not Reply.Found)
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Windows UIA fragment navigation rejects hidden subtree nodes");
   end;

   declare
      type Registry_Access is access all
        A11y.Linux.ATSPi_Object_Registry.Object_Registry;
      type Snapshot_Access is access all
        A11y.Linux.ATSPi_Method_Router.Snapshot_Bundle;

      Root : constant A11y.Node_Ids.Node_Id :=
        A11y_Test_Fixtures.Application_Id;
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Registry : constant Registry_Access :=
        new A11y.Linux.ATSPi_Object_Registry.Object_Registry;
      Registered :
        A11y.Linux.ATSPi_Object_Registry.Object_Record_Snapshot;
      Registry_View :
        A11y.Linux.ATSPi_Object_Registry.Registry_Snapshot;
      Snapshots : constant Snapshot_Access :=
        new A11y.Linux.ATSPi_Method_Router.Snapshot_Bundle;
      Call : A11y.Linux.ATSPi_DBus_Boundary.DBus_Method_Call;
      Boundary_Reply : A11y.Linux.ATSPi_DBus_Boundary.DBus_Method_Reply;
      Result : A11y.Results.Result;
   begin
      Call.Session := Session;
      Call.Object_Path :=
        A11y.Linux.ATSPi_Objects.Object_Path (Session, Root, Result);
      Call.Interface_Name := To_Unbounded_String
        (A11y.Linux.ATSPi_Objects.Interface_Name
           (A11y.Linux.ATSPi_Objects.Accessible));
      Call.Method_Name := To_Unbounded_String ("GetName");

      A11y.Linux.ATSPi_Object_Registry.Ensure_Object
        (Registry.all, Session, Root, Registered, Result);

      Snapshots.all.Accessible.Id := Root;
      Snapshots.all.Accessible.Role := A11y.Roles.Application;
      Snapshots.all.Accessible.Name :=
        To_Unbounded_String ("Fixture Application");
      Snapshots.all.Application.Id := Root;
      Snapshots.all.Application.Application_Id :=
        A11y.Node_Ids.To_Natural (Root);
      Snapshots.all.Application.Toolkit_Name :=
        To_Unbounded_String ("a11y_tests");
      Snapshots.all.Application.Version := To_Unbounded_String ("0.1.0-dev");

      Boundary_Reply :=
        A11y.Linux.ATSPi_DBus_Boundary.Dispatch_Registered_Call
          (Registry.all, Call, Snapshots.all);
      Registry_View :=
        A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry.all);
      Check
        (A11y.Results.Succeeded (Result)
         and then Registered.Node = Root
         and then Length (Registered.Path) /= 0
         and then Boundary_Reply.Kind =
           A11y.Linux.ATSPi_DBus_Boundary.Method_Reply
         and then Boundary_Reply.Routed_Kind =
           A11y.Linux.ATSPi_Method_Router.Accessible_String
         and then Boundary_Reply.Status = A11y.Results.Success
         and then To_String (Boundary_Reply.Text) = "Fixture Application"
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI native fixture-root probe dispatches the semantic application name through the registered boundary");
   end;

   declare
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (720);
      Child : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (721);
      Root : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (722);
      Hidden : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (723);
      Hidden_Child : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (724);
      Result : A11y.Results.Result;
      Path : constant Unbounded_String :=
        A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Result);
      type Component_Snapshot_Access is access
        A11y.Linux.ATSPi_Component.Component_Snapshot;
      Snapshot : constant Component_Snapshot_Access :=
        new A11y.Linux.ATSPi_Component.Component_Snapshot;
      Reply : A11y.Linux.ATSPi_Component.Component_Reply;
   begin
      Snapshot.Id := Node;
      Snapshot.Bounds :=
        (Origin => (X => 10, Y => 20), Extent => (Width => 100, Height => 40));
      Snapshot.Hit_Test_Node := Child;

      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "GetExtents",
         (X => 0, Y => 0), Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Rectangle_Reply
         and then Reply.Bounds.Origin.X = 10
         and then Reply.Bounds.Origin.Y = 20
         and then Reply.Bounds.Extent.Width = 100
         and then Reply.Bounds.Extent.Height = 40,
         "Linux AT-SPI Component method layer returns neutral extents");

      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "Contains",
         (X => 25, Y => 30), Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Boolean_Reply
         and then Reply.Boolean_Item,
         "Linux AT-SPI Component method layer tests contained points");

      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "Contains",
         (X => 250, Y => 30), Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Boolean_Reply
         and then not Reply.Boolean_Item,
         "Linux AT-SPI Component method layer rejects outside points");

      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "GetAccessibleAtPoint",
         (X => 25, Y => 30), Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Node_Reply
         and then Reply.Node = Child,
         "Linux AT-SPI Component method layer returns semantic hit-test nodes");

      declare
         Invalid_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         Invalid_Limits.Limits
           (A11y.Resource_Limits.Native_String_Size) := 0;
         Reply := A11y.Linux.ATSPi_Component.Handle_Method
           (Session, To_String (Path), "GetExtents",
            (X => 0, Y => 0), Snapshot.all, Invalid_Limits);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Component.Error_Reply
            and then Reply.Status = A11y.Results.Invalid_Argument,
            "Linux AT-SPI Component method layer rejects invalid limit configs");
      end;

      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "GrabFocus",
         (X => 25, Y => 30), Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Error_Reply
         and then Reply.Status = A11y.Results.Unsupported_Action,
         "Linux AT-SPI Component method layer rejects unsupported focus requests");

      Snapshot.Focus_Request_Supported := True;
      Snapshot.Focus_Request_Status := A11y.Results.Success;
      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "GrabFocus",
         (X => 25, Y => 30), Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Boolean_Reply
         and then Reply.Boolean_Item,
         "Linux AT-SPI Component method layer returns focus request success");

      Snapshot.Focus_Request_Status := A11y.Results.Disabled;
      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "GrabFocus",
         (X => 25, Y => 30), Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Error_Reply
         and then Reply.Status = A11y.Results.Disabled,
         "Linux AT-SPI Component method layer returns focus request failures");

      Snapshot.Focus_Request_Supported := False;
      Snapshot.Focus_Request_Status := A11y.Results.Unsupported_Action;
      Snapshot.Root := Root;
      Snapshot.Use_Tree_Projection := True;
      A11y.Trees.Set_Root (Snapshot.Tree, Root, Result);
      A11y.Trees.Attach (Snapshot.Tree, Root, Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Node, Child, Result);
      A11y.Trees.Attach (Snapshot.Tree, Node, Hidden, Result);
      A11y.Trees.Attach (Snapshot.Tree, Hidden, Hidden_Child, Result);
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Hidden)) :=
           A11y.Nodes.Hide_Node_And_Subtree;
      Snapshot.Hit_Test_Node := Hidden_Child;
      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "GetAccessibleAtPoint",
         (X => 25, Y => 30), Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Node_Reply
         and then Reply.Node = A11y.Node_Ids.No_Node,
         "Linux AT-SPI Component method layer hides hit-test nodes");

      declare
         Hidden_Path : constant Unbounded_String :=
           A11y.Linux.ATSPi_Objects.Object_Path
             (Session, Hidden_Child, Result);
      begin
         Snapshot.Id := Hidden_Child;
         Reply := A11y.Linux.ATSPi_Component.Handle_Method
           (Session, To_String (Hidden_Path), "GetAccessibleAtPoint",
            (X => 25, Y => 30), Snapshot.all);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Component.Error_Reply
            and then Reply.Status = A11y.Results.Node_Unavailable,
            "Linux AT-SPI Component method layer rejects hidden hit containers");
         Snapshot.Id := Node;
      end;
      Snapshot.Hit_Test_Node := Child;
      Snapshot.Use_Tree_Projection := False;

      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "NoSuchMethod", (X => 25, Y => 30),
         Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Error_Reply
         and then Reply.Status = A11y.Results.Unsupported_Capability,
         "Linux AT-SPI Component method layer rejects unknown methods");

      Snapshot.Defunct := True;
      Reply := A11y.Linux.ATSPi_Component.Handle_Method
        (Session, To_String (Path), "GetExtents", (X => 25, Y => 30),
         Snapshot.all);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Component.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Component method layer rejects defunct snapshots");
   end;

   declare
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (730);
      Root : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (731);
      Result : A11y.Results.Result;
      Path : constant Unbounded_String :=
        A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Result);
      Actions : A11y.Actions.Action_Set := A11y.Actions.Empty_Action_Set;
      type Action_Snapshot_Access is access
        A11y.Linux.ATSPi_Action.Action_Snapshot;
      Snapshot_Ref : constant Action_Snapshot_Access :=
        new A11y.Linux.ATSPi_Action.Action_Snapshot;
      Snapshot : A11y.Linux.ATSPi_Action.Action_Snapshot
        renames Snapshot_Ref.all;
      Reply : A11y.Linux.ATSPi_Action.Action_Reply;
      Resolved : A11y.Actions.Action_Id;
   begin
      Actions := A11y.Actions.With_Action (Actions, A11y.Actions.Press);
      Actions := A11y.Actions.With_Action (Actions, A11y.Actions.Toggle);
      Actions :=
        A11y.Actions.With_Action (Actions, A11y.Actions.Scroll_Into_View);
      Actions := A11y.Actions.With_Action (Actions, A11y.Actions.Open);
      Actions := A11y.Actions.With_Action (Actions, A11y.Actions.Close);
      Snapshot.Id := Node;
      Snapshot.Root := Root;
      A11y.Trees.Set_Root (Snapshot.Tree, Root, Result);
      A11y.Trees.Attach (Snapshot.Tree, Root, Node, Result);
      Snapshot.Supported := Actions;

      Check
        (A11y.Linux.ATSPi_Action.Action_Count (Actions) = 5,
         "Linux AT-SPI Action method layer counts supported actions");

      Resolved := A11y.Linux.ATSPi_Action.Action_At (Actions, 1, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Resolved = A11y.Actions.Toggle,
         "Linux AT-SPI Action method layer resolves stable action indexes");

      Reply := A11y.Linux.ATSPi_Action.Handle_Method
        (Session, To_String (Path), "GetNActions", 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Action.UInt32_Reply
         and then Reply.UInt32 = 5,
         "Linux AT-SPI Action method layer returns action counts");

      Reply := A11y.Linux.ATSPi_Action.Handle_Method
        (Session, To_String (Path), "GetName", 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Action.String_Reply
         and then To_String (Reply.Text) = "press",
         "Linux AT-SPI Action method layer returns stable action names");

      Reply := A11y.Linux.ATSPi_Action.Handle_Method
        (Session, To_String (Path), "GetName", 2, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Action.String_Reply
         and then To_String (Reply.Text) = "scroll-into-view",
