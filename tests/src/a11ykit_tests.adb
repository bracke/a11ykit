      declare
         Object_Reference : A11y.Linux.DBus_Messages.Outgoing_Message;
         Object_Reference_Packet :
           A11y.Linux.DBus_Messages.Transport_Packet;
         Object_Reference_Header :
           A11y.Linux.DBus_Messages.Transport_Packet_Header;
         Object_Reference_Envelope :
           A11y.Linux.DBus_Messages.Transport_Envelope;
      begin
         Object_Reference :=
           A11y.Linux.DBus_Messages.Build_Method_Call_Object_Reference
             (Object_Path     => To_Unbounded_String
                ("/org/a11y/atspi/root"),
              Interface_Name  => To_Unbounded_String
                ("org.a11y.atspi.Socket"),
              Member_Name     => To_Unbounded_String ("Embed"),
              Bus_Name        => To_Unbounded_String (":1.88"),
              Reference_Path  => Path,
              Serial          => 36,
              Result          => Result);
         Object_Reference_Envelope :=
           A11y.Linux.DBus_Messages.Build_Transport_Envelope
             (Object_Reference, Result);
         Object_Reference_Packet :=
           A11y.Linux.DBus_Messages.Build_Transport_Packet
             (Object_Reference_Envelope, Result);
         Object_Reference_Header :=
           A11y.Linux.DBus_Messages.Decode_Transport_Packet_Header
             (Object_Reference_Packet.Bytes, Result);

