--  Exercises the platform-agnostic core: the flat-to-hierarchy inference and the
--  provider's availability contract. The per-OS providers are unimplemented, so
--  there is nothing host-specific to test here yet.
procedure A11ykit_Tests is
   procedure Run is
   use Ada.Strings.Unbounded;
   use type A11y.Event_Sequence;
   use type A11y.Semantic_Revision;
   use type A11y.Actions.Action_Id;
   use type A11y.Backends.Backend_State;
   use type A11y.Backends.Event_Pumps.Pump_Stop_Reason;
   use type A11y.Backends.Native_Backends.Native_Target;
   use type A11y.Backends.Native_Backends.Native_Transport_State;
   use type A11y.Conformance.Support_Level;
   use type A11y.Diagnostics.Category;
   use type A11y.Diagnostics.Severity;
   use type A11y.Dispatchers.Call_Kind;
   use type A11y.Documents.Document_Role;
   use type A11y.Events.Event_Kind;
   use type A11y.Geometry.Coordinate;
   use type A11y.Geometry.Length;
   use type A11y.Geometry.Rectangle;
   use type A11y.Linux.ATSPi_Action.Reply_Kind;
   use type A11y.Linux.ATSPi_Accessible.Reply_Kind;
   use type A11y.Linux.ATSPi_Application.Reply_Kind;
   use type A11y.Linux.ATSPi_Bus.Address_State;
   use type A11y.Linux.ATSPi_Bus.Connection_State;
   use type A11y.Linux.ATSPi_Bus.Transport_Kind;
   use type A11y.Linux.ATSPi_Component.Reply_Kind;
   use type A11y.Linux.ATSPi_DBus_Boundary.DBus_Reply_Kind;
   use type A11y.Linux.ATSPi_Document.Reply_Kind;
   use type A11y.Linux.ATSPi_Image.Reply_Kind;
   use type A11y.Linux.ATSPi_Live_Regions.Reply_Kind;
   use type A11y.Linux.DBus_Auth.Auth_Response_Kind;
   use type A11y.Linux.ATSPi_Method_Router.Routed_Reply_Kind;
   use type A11y.Linux.ATSPi_Object_Registry.Native_Call_Mutation_Kind;
   use type A11y.Linux.ATSPi_Object_Registry.Registry_Mutation_Kind;
   use type A11y.Linux.ATSPi_Selection.Reply_Kind;
   use type A11y.Linux.ATSPi_Selection.Selection_Request_Kind;
   use type A11y.Linux.ATSPi_Backend_Sessions.Startup_Source;
   use type A11y.Linux.ATSPi_Startup.Event_Loop_Operation;
   use type A11y.Linux.ATSPi_Surfaces.Reply_Kind;
   use type A11y.Linux.ATSPi_Table.Reply_Kind;
   use type A11y.Linux.ATSPi_Text.Reply_Kind;
   use type A11y.Linux.ATSPi_Value.Reply_Kind;
   use type A11y.Linux.ATSPi_Mappings.ATSPI_Role;
   use type A11y.Images.Image_Kind;
   use type A11y.Capabilities.Capability;
   use type A11y.Live_Regions.Live_Setting;
   use type A11y.Linux.DBus_Codec.Value_Kind;
   use type A11y.Linux.DBus_Messages.Message_Kind;
   use type A11y.Linux.DBus_Messages.Queue_Posting_Operation;
   use type A11y.Linux.ATSPi_Mappings.ATSPI_Relation;
   use type A11y.Linux.ATSPi_Objects.ATSPI_Interface;
   use type A11y.Native_Identity.Backend_Session_Id;
   use type A11y.Native_Runtimes.Runtime_Transition_Kind;
   use type A11y.Node_Ids.Node_Id;
   use type A11y.Native_Boundary_Calls.Boundary_Return_Class;
   use type A11y.Native_Object_Caches.Cache_Mutation_Kind;
   use type A11y.Native_Object_Caches.Native_Object_Id;
   use type A11y.Nodes.Lifecycle_State;
   use type A11y.Properties.Property_Id;
   use type A11y.Windows_Backend.UIA_Provider_Boundary.HRESULT_Status;
   use type A11y.Properties.Property_Value_Kind;
   use type A11y.Properties.Property_Status;
   use type A11y.Relations.Relation_Kind;
   use type A11y.Resource_Limits.Limit_Kind;
   use type A11y.Results.Status_Code;
   use type A11y.Selection.Selection_Direction;
   use type A11y.Selection.Selection_Mode;
   use type A11y.Roles.Role;
   use type A11y.States.State_Flag;
   use type A11y.States.State_Set;
   use type A11y.States.State_Source;
   use type A11y.Tables.Logical_Index;
   use type A11y.Tables.Sort_Order;
   use type A11y.Text.Text_Edit_Kind;
   use type A11y_Test_Fixtures.Command_Kind;
   use type A11y.Values.Access_Mode;
   use type A11y.Values.Value_Kind;
   use type A11y.Windows.Surface_Kind;

   procedure Check (Condition : Boolean; Message : String)
      renames A11ykit_Test_Support.Check;

   type Test_Action_Provider is new A11y.Actions.Action_Provider with record
      Supported : A11y.Actions.Action_Set := A11y.Actions.Empty_Action_Set;
      Calls     : Natural := 0;
      Raise_On_Invoke : Boolean := False;
   end record;

   overriding function Supports
     (Self   : Test_Action_Provider;
      Action : A11y.Actions.Action_Id)
      return Boolean is
     (A11y.Actions.Supports (Self.Supported, Action));

   overriding function Invoke
     (Self   : in out Test_Action_Provider;
      Node   : A11y.Node_Ids.Node_Id;
      Action : A11y.Actions.Action_Id)
      return A11y.Actions.Action_Result
   is
      pragma Unreferenced (Node, Action);
   begin
      if Self.Raise_On_Invoke then
         raise Program_Error;
      end if;
      Self.Calls := Self.Calls + 1;
      return (Status => A11y.Results.Success);
   end Invoke;

   type Test_Value_Provider is new A11y.Values.Value_Provider with record
      Metadata : A11y.Values.Value_Metadata;
      Set_Calls : Natural := 0;
      Last_Node : A11y.Node_Ids.Node_Id := A11y.Node_Ids.No_Node;
      Last_Value : A11y.Values.Semantic_Value :=
        (Kind => A11y.Values.Unknown);
      Raise_On_Metadata : Boolean := False;
      Raise_On_Set : Boolean := False;
   end record;

   overriding function Current_Metadata
     (Self : Test_Value_Provider)
      return A11y.Values.Value_Metadata;

   overriding function Set_Current
     (Self            : in out Test_Value_Provider;
      Node            : A11y.Node_Ids.Node_Id;
      Requested_Value : A11y.Values.Semantic_Value)
      return A11y.Results.Result;

   overriding function Current_Metadata
     (Self : Test_Value_Provider)
      return A11y.Values.Value_Metadata
   is
   begin
      if Self.Raise_On_Metadata then
         raise Program_Error;
      end if;
      return Self.Metadata;
   end Current_Metadata;

   overriding function Set_Current
     (Self            : in out Test_Value_Provider;
      Node            : A11y.Node_Ids.Node_Id;
      Requested_Value : A11y.Values.Semantic_Value)
      return A11y.Results.Result
   is
   begin
      if Self.Raise_On_Set then
         raise Program_Error;
      end if;
      Self.Set_Calls := Self.Set_Calls + 1;
      Self.Last_Node := Node;
      Self.Last_Value := Requested_Value;
      Self.Metadata.Current := Requested_Value;
      return A11y.Results.Ok;
   end Set_Current;

   type Test_Selection_Provider is new A11y.Selection.Selection_Provider
   with record
      Selection : A11y.Selection.Selection_Set;
      Select_Calls : Natural := 0;
      Deselect_Calls : Natural := 0;
      Toggle_Calls : Natural := 0;
      Clear_Calls : Natural := 0;
      Raise_On_Query : Boolean := False;
      Raise_On_Mutate : Boolean := False;
   end record;

   overriding function Current_Selection
     (Self : Test_Selection_Provider)
      return A11y.Selection.Selection_Set;

   overriding function Select_Node
     (Self : in out Test_Selection_Provider;
      Node : A11y.Node_Ids.Node_Id)
      return A11y.Results.Result;

   overriding function Deselect_Node
     (Self : in out Test_Selection_Provider;
      Node : A11y.Node_Ids.Node_Id)
      return A11y.Results.Result;

   overriding function Toggle_Node
     (Self : in out Test_Selection_Provider;
      Node : A11y.Node_Ids.Node_Id)
      return A11y.Results.Result;

   overriding function Clear_Selection
     (Self : in out Test_Selection_Provider)
      return A11y.Results.Result;

   overriding function Current_Selection
     (Self : Test_Selection_Provider)
      return A11y.Selection.Selection_Set
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      end if;
      return Self.Selection;
   end Current_Selection;

   overriding function Select_Node
     (Self : in out Test_Selection_Provider;
      Node : A11y.Node_Ids.Node_Id)
      return A11y.Results.Result
   is
      Result : A11y.Results.Result;
   begin
      if Self.Raise_On_Mutate then
         raise Program_Error;
      end if;
      A11y.Selection.Select_Item (Self.Selection, Node, Result);
      if A11y.Results.Succeeded (Result) then
         Self.Select_Calls := Self.Select_Calls + 1;
      end if;
      return Result;
   end Select_Node;

   overriding function Deselect_Node
     (Self : in out Test_Selection_Provider;
      Node : A11y.Node_Ids.Node_Id)
      return A11y.Results.Result
   is
      Result : A11y.Results.Result;
   begin
      if Self.Raise_On_Mutate then
         raise Program_Error;
      end if;
      A11y.Selection.Deselect (Self.Selection, Node, Result);
      if A11y.Results.Succeeded (Result) then
         Self.Deselect_Calls := Self.Deselect_Calls + 1;
      end if;
      return Result;
   end Deselect_Node;

   overriding function Toggle_Node
     (Self : in out Test_Selection_Provider;
      Node : A11y.Node_Ids.Node_Id)
      return A11y.Results.Result
   is
      Result : A11y.Results.Result;
   begin
      if Self.Raise_On_Mutate then
         raise Program_Error;
      end if;
      A11y.Selection.Toggle (Self.Selection, Node, Result);
      if A11y.Results.Succeeded (Result) then
         Self.Toggle_Calls := Self.Toggle_Calls + 1;
      end if;
      return Result;
   end Toggle_Node;

   overriding function Clear_Selection
     (Self : in out Test_Selection_Provider)
      return A11y.Results.Result
   is
      Result : A11y.Results.Result;
   begin
      if Self.Raise_On_Mutate then
         raise Program_Error;
      end if;
      A11y.Selection.Clear (Self.Selection, Result);
      if A11y.Results.Succeeded (Result) then
         Self.Clear_Calls := Self.Clear_Calls + 1;
      end if;
      return Result;
   end Clear_Selection;

   type Test_Image_Provider is new A11y.Images.Image_Provider with record
      Metadata : A11y.Images.Image_Metadata;
      Raise_On_Query : Boolean := False;
   end record;

   overriding function Current_Metadata
     (Self : Test_Image_Provider)
      return A11y.Images.Image_Metadata;

   overriding function Current_Metadata
     (Self : Test_Image_Provider)
      return A11y.Images.Image_Metadata
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      end if;
      return Self.Metadata;
   end Current_Metadata;

   type Test_Document_Provider is new A11y.Documents.Document_Provider
   with record
      Metadata : A11y.Documents.Document_Metadata;
      Raise_On_Query : Boolean := False;
   end record;

   overriding function Current_Metadata
     (Self : Test_Document_Provider)
      return A11y.Documents.Document_Metadata;

   overriding function Current_Metadata
     (Self : Test_Document_Provider)
      return A11y.Documents.Document_Metadata
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      end if;
      return Self.Metadata;
   end Current_Metadata;

   type Test_Table_Provider is new A11y.Tables.Table_Provider with record
      Snapshot : A11y.Tables.Table_Snapshot;
      Raise_On_Query : Boolean := False;
      Return_Invalid_Cell : Boolean := False;
   end record;

   overriding function Current_Table
     (Self : Test_Table_Provider)
      return A11y.Tables.Table_Snapshot;

   overriding function Resolve_Cell
     (Self   : Test_Table_Provider;
      Row    : A11y.Tables.Logical_Index;
      Column : A11y.Tables.Logical_Index;
      Result : out A11y.Results.Result)
      return A11y.Tables.Cell_Reference;

   overriding function Resolve_Coordinates
     (Self   : Test_Table_Provider;
      Node   : A11y.Node_Ids.Node_Id;
      Result : out A11y.Results.Result)
      return A11y.Tables.Cell_Coordinates;

   overriding function Current_Table
     (Self : Test_Table_Provider)
      return A11y.Tables.Table_Snapshot
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      end if;
      return Self.Snapshot;
   end Current_Table;

   overriding function Resolve_Cell
     (Self   : Test_Table_Provider;
      Row    : A11y.Tables.Logical_Index;
      Column : A11y.Tables.Logical_Index;
      Result : out A11y.Results.Result)
      return A11y.Tables.Cell_Reference
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      elsif Self.Return_Invalid_Cell then
         Result := A11y.Results.Ok;
         return (Node => A11y.Node_Ids.No_Node,
                 Coords => (Row => Row, Column => Column),
                 Row_Span => 1,
                 Column_Span => 1);
      end if;
      return A11y.Tables.Resolve_Cell (Self.Snapshot, Row, Column, Result);
   end Resolve_Cell;

   overriding function Resolve_Coordinates
     (Self   : Test_Table_Provider;
      Node   : A11y.Node_Ids.Node_Id;
      Result : out A11y.Results.Result)
      return A11y.Tables.Cell_Coordinates
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      end if;
      return A11y.Tables.Resolve_Coordinates (Self.Snapshot, Node, Result);
   end Resolve_Coordinates;

   type Test_Surface_Provider is new A11y.Windows.Surface_Provider with record
      Metadata : A11y.Windows.Surface_Metadata;
      Raise_On_Query : Boolean := False;
   end record;

   overriding function Current_Surface
     (Self : Test_Surface_Provider)
      return A11y.Windows.Surface_Metadata;

   overriding function Current_Surface
     (Self : Test_Surface_Provider)
      return A11y.Windows.Surface_Metadata
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      end if;
      return Self.Metadata;
   end Current_Surface;

   type Test_Text_Provider is new A11y.Text.Editable_Text_Provider with record
      Content : Ada.Strings.Wide_Wide_Unbounded.Unbounded_Wide_Wide_String;
      Policy : A11y.Text.Protected_Text_Policy := A11y.Text.Plain_Text;
      Read_Only : Boolean := False;
      Edit_Calls : Natural := 0;
      Raise_On_Query : Boolean := False;
      Raise_On_Count : Boolean := False;
      Raise_On_Edit : Boolean := False;
      Return_Oversized_Text : Boolean := False;
   end record;

   overriding function Character_Count
     (Self : Test_Text_Provider)
      return Natural;

   overriding function Protection
     (Self : Test_Text_Provider)
      return A11y.Text.Protected_Text_Policy;

   overriding function Range_Text
     (Self   : Test_Text_Provider;
      Span   : A11y.Text.Text_Range;
      Result : out A11y.Results.Result)
      return Ada.Strings.Wide_Wide_Unbounded.Unbounded_Wide_Wide_String;

   overriding function Is_Read_Only
     (Self : Test_Text_Provider)
      return Boolean;

   overriding function Apply_Edit
     (Self    : in out Test_Text_Provider;
      Node    : A11y.Node_Ids.Node_Id;
      Request : A11y.Text.Text_Edit_Request)
      return A11y.Results.Result;

   overriding function Character_Count
     (Self : Test_Text_Provider)
      return Natural
   is
   begin
      if Self.Raise_On_Query or else Self.Raise_On_Count then
         raise Program_Error;
      end if;
      return Ada.Strings.Wide_Wide_Unbounded.Length (Self.Content);
   end Character_Count;

   overriding function Protection
     (Self : Test_Text_Provider)
      return A11y.Text.Protected_Text_Policy
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      end if;
      return Self.Policy;
   end Protection;

   overriding function Range_Text
     (Self   : Test_Text_Provider;
      Span   : A11y.Text.Text_Range;
      Result : out A11y.Results.Result)
      return Ada.Strings.Wide_Wide_Unbounded.Unbounded_Wide_Wide_String
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      elsif Self.Return_Oversized_Text then
         Result := A11y.Results.Ok;
         return Ada.Strings.Wide_Wide_Unbounded.To_Unbounded_Wide_Wide_String
           (Ada.Strings.Wide_Wide_Unbounded.To_Wide_Wide_String
              (Self.Content));
      end if;
      return A11y.Text.Slice
        (Ada.Strings.Wide_Wide_Unbounded.To_Wide_Wide_String (Self.Content),
         Span,
         Self.Policy,
         Result);
   end Range_Text;

   overriding function Is_Read_Only
     (Self : Test_Text_Provider)
      return Boolean
   is
   begin
      if Self.Raise_On_Query then
         raise Program_Error;
      end if;
      return Self.Read_Only;
   end Is_Read_Only;

   overriding function Apply_Edit
     (Self    : in out Test_Text_Provider;
      Node    : A11y.Node_Ids.Node_Id;
      Request : A11y.Text.Text_Edit_Request)
      return A11y.Results.Result
   is
      pragma Unreferenced (Node);
   begin
      if Self.Raise_On_Edit then
         raise Program_Error;
      end if;

      Self.Edit_Calls := Self.Edit_Calls + 1;
      Self.Content := Request.Text;
      return A11y.Results.Ok;
   end Apply_Edit;

begin
   A11ykit_Compatibility_Tests.Run;
   A11ykit_Legacy_Provider_Tests.Run;
   A11y_Localization_Tests.Run;
   A11y_Selection_Classification_Tests.Run;
   A11y_Registry_Tests.Run;
   A11y_Null_Backend_Tests.Run;
   A11y_Backend_Limit_Tests.Run;
   A11y_Backend_Selection_Tests.Run;
   A11y_Native_Backend_Tests.Run;
   A11y_Tree_Tests.Run;

   declare
      use type A11y.Linux.ATSPi_Startup.Pump_Bounded_Stop_Reason;
      use type A11y.Linux.ATSPi_Scheduler.Scheduler_State;

      Session : A11y.Linux.ATSPi_Backend_Sessions.Backend_Session;
      Result : A11y.Results.Result;
      Transport_View : A11y.Backends.Native_Backends.Transport_Snapshot;
      Interest : A11y.Linux.ATSPi_Startup.Event_Loop_Interest;
      Registry_View : A11y.Linux.ATSPi_Object_Registry.Registry_Snapshot;
      Session_View :
        A11y.Linux.ATSPi_Backend_Sessions.Session_Report;
      Stop_Report :
        A11y.Linux.ATSPi_Backend_Sessions.Session_Stop_Report;
      Startup_Report :
        A11y.Linux.ATSPi_Backend_Sessions.Session_Startup_Report;
      Report : A11y.Linux.ATSPi_Startup.Pump_Bounded_Report;
      Step_Report :
        A11y.Linux.ATSPi_Backend_Sessions.Event_Loop_Step_Report;
      Loop_Report :
        A11y.Linux.ATSPi_Backend_Sessions.Event_Loop_Bounded_Report;
      Serve_Cycle_Report :
        A11y.Linux.ATSPi_Backend_Sessions.Transport_Serve_Cycle_Report;
      Scheduler : A11y.Linux.ATSPi_Scheduler.Scheduler;
      Scheduler_Config : A11y.Linux.ATSPi_Scheduler.Scheduler_Config;
      Scheduler_Report : A11y.Linux.ATSPi_Scheduler.Scheduler_Run_Report;
      Scheduler_Cycle_Report :
        A11y.Linux.ATSPi_Scheduler.Transport_Cycle_Run_Report;
      Flushed : Natural := 99;
      Descriptor :
        A11y.Linux.ATSPi_Object_Registry.Object_Export_Descriptor;
      Root_Reply : A11y.Linux.ATSPi_DBus_Boundary.DBus_Method_Reply;
      type Snapshot_Bundle_Access is access
        A11y.Linux.ATSPi_Method_Router.Snapshot_Bundle;
      Snapshots_Ref : constant Snapshot_Bundle_Access :=
        new A11y.Linux.ATSPi_Method_Router.Snapshot_Bundle;
      Snapshots : A11y.Linux.ATSPi_Method_Router.Snapshot_Bundle
      renames Snapshots_Ref.all;
      Application_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (1001);
   begin
      Transport_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Backend_Status (Session);
      Interest := A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
        (Session);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Transport_View.State =
           A11y.Backends.Native_Backends.Transport_Not_Admitted
         and then Interest.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI backend session starts with backend, startup, and registry owned together");
      A11y.Linux.ATSPi_Backend_Sessions.Capture_Report
        (Session, Session_View);
      Check
        (Session_View.Status = A11y.Results.Success
         and then Session_View.Transport.State =
           A11y.Backends.Native_Backends.Transport_Not_Admitted
         and then Session_View.Interest.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Session_View.Startup_State =
           A11y.Linux.ATSPi_Bus.Disconnected
         and then not Session_View.Registered
         and then not Session_View.Has_Application_Node
         and then not Session_View.Application.Exportable
         and then Session_View.Application.Status =
           A11y.Results.Node_Unavailable
         and then not Session_View.Application_Exportable
         and then Session_View.Application_Status =
           A11y.Results.Node_Unavailable
         and then Session_View.Registry.Live_Count = 0
         and then Session_View.Registry.Outstanding_Calls = 0
         and then not Session_View.Has_Event_Loop_Report,
         "Linux AT-SPI backend session report captures initial transport, startup, registry, and application state");

      A11y.Linux.ATSPi_Backend_Sessions.Start_From_Address
        (Session, "not-an-address", 1000, Application_Node, Result);
      Transport_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Backend_Status (Session);
      Check
        (A11y.Results.Succeeded (Result)
         and then Transport_View.State =
           A11y.Backends.Native_Backends.Transport_Failed
         and then Transport_View.Last_Status =
           A11y.Results.Invalid_Argument,
         "Linux AT-SPI backend session records direct-address startup failures");
      A11y.Linux.ATSPi_Backend_Sessions.Capture_Report
        (Session, Session_View);
      Check
        (Session_View.Status = A11y.Results.Success
         and then Session_View.Transport.State =
           A11y.Backends.Native_Backends.Transport_Failed
         and then Session_View.Transport.Last_Status =
           A11y.Results.Invalid_Argument
         and then Session_View.Startup_State = A11y.Linux.ATSPi_Bus.Failed
         and then not Session_View.Registered
         and then not Session_View.Has_Application_Node
         and then Session_View.Application_Node = A11y.Node_Ids.No_Node
         and then not Session_View.Application_Exportable
         and then Session_View.Application_Status =
           A11y.Results.Node_Unavailable
         and then Session_View.Registry.Outstanding_Calls = 0,
         "Linux AT-SPI backend session report captures failed direct-address startup coherently");

      A11y.Linux.ATSPi_Backend_Sessions.Start_From_Address_With_Report
        (Session,
         "unix:path=/tmp/a11ykit-definitely-missing-atspi-bus",
         1000,
         Application_Node,
         Startup_Report,
         Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Startup_Report.Prepared
         and then Startup_Report.Status =
           A11y.Results.Backend_Unavailable
         and then Startup_Report.Registration.Status =
           A11y.Results.Backend_Unavailable
         and then Startup_Report.Registration.Address_Resolved
         and then Startup_Report.Registration.Raw_Connect_Attempted
         and then Startup_Report.Registration.Raw_Connect_Status =
           A11y.Results.Backend_Unavailable
         and then not Startup_Report.Registration.Raw_Connected
         and then not Startup_Report.Registration.Transport_Admitted
         and then not Startup_Report.Registration.Hello_Queued
         and then not Startup_Report.Registration.Registration_Queued
         and then not Startup_Report.Backend_Synchronized
         and then not Startup_Report.Application_Root_Ensured
         and then not A11y.Linux.ATSPi_Backend_Sessions.Registered
           (Session)
         and then A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot
           (Session).Live_Count = 0,
         "Linux AT-SPI backend session startup report propagates missing live transport without root export");
      A11y.Linux.ATSPi_Backend_Sessions.Application_Descriptor
        (Session, Descriptor);
      Check
        (not Descriptor.Exportable
         and then Descriptor.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI backend session does not expose an application object before registered startup");

      A11y.Linux.ATSPi_Backend_Sessions.Node_Descriptor
        (Session, Application_Node, Descriptor);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (not Descriptor.Exportable
         and then Descriptor.Status = A11y.Results.Backend_Unavailable
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI backend session rejects node export before registered startup without creating native objects");

      A11y.Linux.ATSPi_Backend_Sessions.Node_Descriptor
        (Session, A11y.Node_Ids.No_Node, Descriptor);
      Check
        (not Descriptor.Exportable
         and then Descriptor.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI backend session rejects invalid node export before transport checks");

      Snapshots.Accessible.Id := Application_Node;
      Snapshots.Accessible.Role := A11y.Roles.Application;
      Root_Reply :=
        A11y.Linux.ATSPi_Backend_Sessions.Dispatch_Application_Root_Method
          (Session,
           A11y.Linux.ATSPi_Objects.Accessible,
           "GetRole",
           Snapshots);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Root_Reply.Kind = A11y.Linux.ATSPi_DBus_Boundary.Error_Reply
         and then Root_Reply.Status = A11y.Results.Backend_Unavailable
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI backend session rejects application root dispatch before registered startup");

      Root_Reply :=
        A11y.Linux.ATSPi_Backend_Sessions.Dispatch_Node_Method
          (Session,
           Application_Node,
           A11y.Linux.ATSPi_Objects.Accessible,
           "GetRole",
           Snapshots);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Root_Reply.Kind = A11y.Linux.ATSPi_DBus_Boundary.Error_Reply
         and then Root_Reply.Status = A11y.Results.Backend_Unavailable
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI backend session rejects generic node dispatch before registered startup without creating native objects");

      declare
         Boundary_Call :
           A11y.Linux.ATSPi_DBus_Boundary.DBus_Method_Call;
         Boundary_Report :
           A11y.Linux.ATSPi_DBus_Boundary
             .Registered_Call_Boundary_Report;
      begin
         Boundary_Call.Session := A11y.Native_Identity.Create_Session;
         Boundary_Call.Object_Path :=
           A11y.Linux.ATSPi_Objects.Object_Path
             (Boundary_Call.Session, Application_Node, Result);
         Boundary_Call.Interface_Name := To_Unbounded_String
           (A11y.Linux.ATSPi_Objects.Interface_Name
              (A11y.Linux.ATSPi_Objects.Accessible));
         Boundary_Call.Method_Name := To_Unbounded_String ("GetRole");

         Root_Reply :=
           A11y.Linux.ATSPi_Backend_Sessions
             .Dispatch_Registered_Call_With_Report
               (Session, Boundary_Call, Snapshots, Boundary_Report);
         Registry_View :=
           A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
         Check
           (Root_Reply.Kind = A11y.Linux.ATSPi_DBus_Boundary.Error_Reply
            and then Root_Reply.Status = A11y.Results.Backend_Unavailable
            and then Registry_View.Live_Count = 0
            and then Registry_View.Outstanding_Calls = 0,
            "Linux AT-SPI backend session rejects decoded registered calls before transport registration without registry mutation");
         Check
           (not Boundary_Report.Resolved
            and then not Boundary_Report.Native_Admitted
            and then not Boundary_Report.Native_Completed
            and then Boundary_Report.Final_Status =
              A11y.Results.Backend_Unavailable,
            "Linux AT-SPI backend session reports pre-registration registered-call rejection");

         declare
            Request_Message : A11y.Linux.DBus_Messages.Outgoing_Message;
            Request_Envelope :
              A11y.Linux.DBus_Messages.Transport_Envelope;
            Request_Packet : A11y.Linux.DBus_Messages.Transport_Packet;
            Reply_Packet : A11y.Linux.DBus_Messages.Transport_Packet;
            Serve_Report :
              A11y.Linux.ATSPi_Bus.Registered_Packet_Serve_Report;
         begin
            Request_Message := A11y.Linux.DBus_Messages.Build_Method_Call
              (Object_Path    => Boundary_Call.Object_Path,
               Interface_Name => Boundary_Call.Interface_Name,
               Member_Name    => Boundary_Call.Method_Name,
               Serial         => 401,
               Result         => Result);
            Request_Envelope :=
              A11y.Linux.DBus_Messages.Build_Transport_Envelope
                (Request_Message, Result);
            Request_Packet :=
              A11y.Linux.DBus_Messages.Build_Transport_Packet
                (Request_Envelope, Result);

            A11y.Linux.ATSPi_Backend_Sessions.Serve_Registered_Packet
              (Session, Request_Packet.Bytes, Snapshots, Reply_Packet,
               Serve_Report, Result);
            Registry_View :=
              A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot
                (Session);
            Check
              (Result.Status = A11y.Results.Backend_Unavailable
               and then Serve_Report.Status =
                 A11y.Results.Backend_Unavailable
               and then not Serve_Report.Packet_Classified
               and then not Serve_Report.Incoming_Method_Call
               and then not Serve_Report.Reply_Queued
               and then not Serve_Report.Reply_Serialized
               and then not Serve_Report.Reply_In_Flight
               and then not Serve_Report.Boundary_Resolved
               and then Reply_Packet.Metadata.Serial = 0
               and then Registry_View.Live_Count = 0
               and then Registry_View.Outstanding_Calls = 0,
               "Linux AT-SPI backend session rejects encoded registered packets before startup registration without registry mutation");
         end;
      end;

      A11y.Linux.ATSPi_Backend_Sessions.Pump_Registered_Bounded
        (Session, Snapshots, 1, Report, Result);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable
         and then Report.Stop_Reason =
           A11y.Linux.ATSPi_Startup.Readiness_Failed
         and then Report.Iterations_Attempted = 1
         and then Report.Iterations_Completed = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI backend session bounds registered pumping before transport admission");

      A11y.Linux.ATSPi_Backend_Sessions.Serve_One_Transport_Cycle
        (Session, Snapshots, Serve_Cycle_Report, Result);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable
         and then Serve_Cycle_Report.Status =
           A11y.Results.Backend_Unavailable
         and then Serve_Cycle_Report.Interest_Before.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Serve_Cycle_Report.Interest_After.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Serve_Cycle_Report.Ready_Checked
         and then not Serve_Cycle_Report.Read_Attempted
         and then not Serve_Cycle_Report.Packet_Received
         and then Serve_Cycle_Report.Incoming_Packet_Kind =
           A11y.Linux.DBus_Messages.Error_Return
         and then Serve_Cycle_Report.Incoming_Serial = 0
         and then Serve_Cycle_Report.Incoming_Reply_Serial = 0
         and then Serve_Cycle_Report.Incoming_Estimated_Bytes = 0
         and then not Serve_Cycle_Report.Serve_Attempted
         and then not Serve_Cycle_Report.Reply_Serialized
         and then Serve_Cycle_Report.Reply_Packet_Kind =
           A11y.Linux.DBus_Messages.Error_Return
         and then Serve_Cycle_Report.Reply_Serial = 0
         and then Serve_Cycle_Report.Reply_Reply_Serial = 0
         and then Serve_Cycle_Report.Reply_Estimated_Bytes = 0
         and then not Serve_Cycle_Report.Write_Attempted
         and then not Serve_Cycle_Report.Reply_Written
         and then not Serve_Cycle_Report.Registered.Packet_Classified
         and then Serve_Cycle_Report.Registered.Status =
           A11y.Results.Backend_Unavailable
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI transport serve cycle reports pre-registration readiness failure without read, write, or registry mutation");

      A11y.Linux.ATSPi_Backend_Sessions.Drive_One_Event_Loop_Step
        (Session, Snapshots, Step_Report, Result);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable
         and then Step_Report.Status = A11y.Results.Backend_Unavailable
         and then Step_Report.Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Step_Report.Interest_Before.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Step_Report.Interest_After.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then not Step_Report.Wait_Attempted
         and then not Step_Report.Wait_Timed_Out
         and then not Step_Report.Wait_Readable
         and then not Step_Report.Write_Wait_Attempted
         and then not Step_Report.Pump_Attempted
         and then not Step_Report.Flush_Attempted
         and then not Step_Report.Write_Ready
         and then not Step_Report.Write_Timed_Out
         and then Step_Report.Write_Wait_Status =
           A11y.Results.Backend_Unavailable
         and then Step_Report.Flushed = 0
         and then Step_Report.Stop_Reason =
           A11y.Linux.ATSPi_Startup.Readiness_Failed
         and then Step_Report.Pump.Iterations_Attempted = 0
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI backend session event-loop step reports wait-for-transport without private mutation");

      A11y.Linux.ATSPi_Backend_Sessions.Drive_Bounded_Event_Loop
        (Session, Snapshots, 0, Loop_Report, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Loop_Report.Status = A11y.Results.Invalid_Argument
         and then Loop_Report.Last_Step_Status =
           A11y.Results.Backend_Unavailable
         and then Loop_Report.Stop_Reason =
           A11y.Linux.ATSPi_Startup.Invalid_Limit
         and then Loop_Report.Last_Step_Stop_Reason =
           A11y.Linux.ATSPi_Startup.Not_Stopped
         and then Loop_Report.Steps_Attempted = 0
         and then Loop_Report.Steps_Completed = 0
         and then Loop_Report.Pump.Stop_Reason =
           A11y.Linux.ATSPi_Startup.Invalid_Limit,
         "Linux AT-SPI backend session bounded event-loop driver rejects invalid iteration limits");
      A11y.Linux.ATSPi_Backend_Sessions.Capture_Report
        (Session, Session_View);
      Check
        (Session_View.Has_Event_Loop_Report
         and then Session_View.Last_Event_Loop.Status =
           A11y.Results.Invalid_Argument
         and then Session_View.Last_Event_Loop.Stop_Reason =
           A11y.Linux.ATSPi_Startup.Invalid_Limit
         and then Session_View.Last_Event_Loop.Steps_Attempted = 0
         and then Session_View.Last_Event_Loop.Steps_Completed = 0,
         "Linux AT-SPI backend session report captures invalid bounded event-loop attempts");

      A11y.Linux.ATSPi_Backend_Sessions.Drive_Bounded_Event_Loop
        (Session, Snapshots, 2, Loop_Report, Result);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable
         and then Loop_Report.Status = A11y.Results.Backend_Unavailable
         and then Loop_Report.Last_Step_Status =
           A11y.Results.Backend_Unavailable
         and then Loop_Report.Stop_Reason =
           A11y.Linux.ATSPi_Startup.Readiness_Failed
         and then Loop_Report.Last_Step_Stop_Reason =
           A11y.Linux.ATSPi_Startup.Readiness_Failed
         and then Loop_Report.Last_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Loop_Report.Last_Interest_Before.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Loop_Report.Last_Interest_After.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then not Loop_Report.Last_Interest_After.Can_Dispatch
         and then not Loop_Report.Last_Interest_After.Has_Outgoing_Work
         and then Loop_Report.Steps_Attempted = 1
         and then Loop_Report.Steps_Completed = 0
         and then Loop_Report.Wait_Attempts = 0
         and then Loop_Report.Wait_Timeouts = 0
         and then Loop_Report.Wait_Readable = 0
         and then Loop_Report.Write_Wait_Attempts = 0
         and then Loop_Report.Write_Attempts = 0
         and then Loop_Report.Write_Ready = 0
         and then Loop_Report.Write_Timeouts = 0
         and then Loop_Report.Last_Write_Wait_Status =
           A11y.Results.Backend_Unavailable
         and then Loop_Report.Flushed = 0
         and then Loop_Report.Pump.Iterations_Attempted = 0
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI backend session bounded event-loop driver stops on readiness failure without registry mutation");
      A11y.Linux.ATSPi_Backend_Sessions.Capture_Report
        (Session, Session_View);
      Check
        (Session_View.Has_Event_Loop_Report
         and then Session_View.Last_Event_Loop.Status =
           A11y.Results.Backend_Unavailable
         and then Session_View.Last_Event_Loop.Stop_Reason =
           A11y.Linux.ATSPi_Startup.Readiness_Failed
         and then Session_View.Last_Event_Loop.Last_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Session_View.Last_Event_Loop.Steps_Attempted = 1
         and then Session_View.Last_Event_Loop.Steps_Completed = 0
         and then Session_View.Last_Event_Loop.Last_Interest_After
           .Next_Operation =
             A11y.Linux.ATSPi_Startup.Wait_For_Transport,
         "Linux AT-SPI backend session report captures last bounded event-loop readiness failure");

      A11y.Linux.ATSPi_Scheduler.Run_Once
        (Scheduler, Session, Snapshots, Scheduler_Report, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then not Scheduler_Report.Configured
         and then not Scheduler_Report.Run_Attempted
         and then Scheduler_Report.State_Before =
           A11y.Linux.ATSPi_Scheduler.Created
         and then Scheduler_Report.State_After =
           A11y.Linux.ATSPi_Scheduler.Created
         and then A11y.Linux.ATSPi_Scheduler.State (Scheduler) =
           A11y.Linux.ATSPi_Scheduler.Created,
         "Linux AT-SPI scheduler rejects unconfigured event-loop runs");

      Scheduler_Config := (Max_Iterations_Per_Run => 0,
                           Read_Timeout_MS => 0);
      A11y.Linux.ATSPi_Scheduler.Configure
        (Scheduler, Scheduler_Config, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then A11y.Linux.ATSPi_Scheduler.State (Scheduler) =
           A11y.Linux.ATSPi_Scheduler.Created,
         "Linux AT-SPI scheduler rejects invalid bounded run limits");

      Scheduler_Config := (Max_Iterations_Per_Run => 2,
                           Read_Timeout_MS => 0);
      A11y.Linux.ATSPi_Scheduler.Configure
        (Scheduler, Scheduler_Config, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Linux.ATSPi_Scheduler.State (Scheduler) =
           A11y.Linux.ATSPi_Scheduler.Configured
         and then A11y.Linux.ATSPi_Scheduler.Configuration
           (Scheduler).Max_Iterations_Per_Run = 2,
         "Linux AT-SPI scheduler accepts explicit bounded run policy");

      A11y.Linux.ATSPi_Scheduler.Run_One_Transport_Cycle
        (Scheduler, Session, Snapshots, Scheduler_Cycle_Report, Result);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable
         and then Scheduler_Cycle_Report.Configured
         and then Scheduler_Cycle_Report.Run_Attempted
         and then Scheduler_Cycle_Report.State_Before =
           A11y.Linux.ATSPi_Scheduler.Configured
         and then Scheduler_Cycle_Report.State_After =
           A11y.Linux.ATSPi_Scheduler.Configured
         and then Scheduler_Cycle_Report.Interest_Before.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then Scheduler_Cycle_Report.Interest_After.Next_Operation =
           A11y.Linux.ATSPi_Startup.Wait_For_Transport
         and then not Scheduler_Cycle_Report.Interest_After.Can_Dispatch
         and then not Scheduler_Cycle_Report.Interest_After.Has_Outgoing_Work
         and then Scheduler_Cycle_Report.Wait_Status =
           A11y.Results.Backend_Unavailable
         and then not Scheduler_Cycle_Report.Wait_Attempted
         and then not Scheduler_Cycle_Report.Wait_Timed_Out
         and then not Scheduler_Cycle_Report.Wait_Readable
         and then not Scheduler_Cycle_Report.Write_Wait_Attempted
         and then not Scheduler_Cycle_Report.Write_Wait_Timed_Out
         and then not Scheduler_Cycle_Report.Write_Wait_Ready
         and then Scheduler_Cycle_Report.Write_Wait_Status =
           A11y.Results.Backend_Unavailable
         and then Scheduler_Cycle_Report.Flushed = 0
         and then not Scheduler_Cycle_Report.Cycle.Ready_Checked
         and then not Scheduler_Cycle_Report.Cycle.Read_Attempted
         and then not Scheduler_Cycle_Report.Cycle.Serve_Attempted
         and then not Scheduler_Cycle_Report.Cycle.Write_Attempted
         and then Scheduler_Cycle_Report.Cycle.Status =
           A11y.Results.Backend_Unavailable
         and then A11y.Linux.ATSPi_Scheduler.State (Scheduler) =
           A11y.Linux.ATSPi_Scheduler.Configured
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI scheduler drives one transport serve cycle without pre-registration registry mutation");

      A11y.Linux.ATSPi_Scheduler.Run_Once
        (Scheduler, Session, Snapshots, Scheduler_Report, Result);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable
         and then Scheduler_Report.Configured
         and then Scheduler_Report.Run_Attempted
         and then Scheduler_Report.State_Before =
           A11y.Linux.ATSPi_Scheduler.Configured
         and then Scheduler_Report.State_After =
           A11y.Linux.ATSPi_Scheduler.Configured
         and then Scheduler_Report.Bounded_Loop.Status =
           A11y.Results.Backend_Unavailable
         and then Scheduler_Report.Bounded_Loop.Stop_Reason =
           A11y.Linux.ATSPi_Startup.Readiness_Failed
         and then Scheduler_Report.Bounded_Loop.Steps_Attempted = 1
         and then Scheduler_Report.Bounded_Loop.Steps_Completed = 0
         and then Scheduler_Report.Session_Had_Cached_Report
         and then Scheduler_Report.Session_Cached_Status =
           A11y.Results.Backend_Unavailable
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI scheduler owns bounded event-loop policy without registry mutation");

      A11y.Linux.ATSPi_Scheduler.Stop (Scheduler, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Linux.ATSPi_Scheduler.State (Scheduler) =
           A11y.Linux.ATSPi_Scheduler.Stopped,
         "Linux AT-SPI scheduler stops deterministically after bounded runs");

      A11y.Linux.ATSPi_Backend_Sessions.Flush_One_Outgoing
        (Session, Result);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable,
         "Linux AT-SPI backend session rejects one-shot outgoing flush before transport admission");

      A11y.Linux.ATSPi_Backend_Sessions.Wait_Writable
        (Session, 0, Result);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable,
         "Linux AT-SPI backend session rejects writable waits before transport admission");

      A11y.Linux.ATSPi_Backend_Sessions.Flush_Bounded_Outgoing
        (Session, 0, Flushed, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Flushed = 0,
         "Linux AT-SPI backend session rejects zero bounded outgoing flush iterations");

      Flushed := 99;
      A11y.Linux.ATSPi_Backend_Sessions.Flush_Bounded_Outgoing
        (Session, 3, Flushed, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Flushed = 0
         and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
           (Session).Pending_Outgoing = 0
         and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
           (Session).In_Flight_Outgoing = 0,
         "Linux AT-SPI backend session exposes bounded outgoing flush for empty queues");

      A11y.Linux.ATSPi_Backend_Sessions.Complete_Outgoing
        (Session, 401, Result);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable
         and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
           (Session).In_Flight_Outgoing = 0
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI backend session rejects outgoing completion before transport admission without registry mutation");

      declare
         Invalid_Event : constant A11y.Events.Event :=
           (Sequence  => A11y.No_Event,
            Timestamp => Ada.Calendar.Clock,
            Source    => Application_Node,
            Kind      => A11y.Events.Focus_Changed,
            Revision  => 1);
         Invalid_Report :
           A11y.Linux.ATSPi_Backend_Sessions.Event_Signal_Queue_Report;
         Event : constant A11y.Events.Event :=
           (Sequence  => 804,
            Timestamp => Ada.Calendar.Clock,
            Source    => Application_Node,
            Kind      => A11y.Events.Focus_Changed,
            Revision  => 1);
         Queue_Report :
           A11y.Linux.ATSPi_Backend_Sessions.Event_Signal_Queue_Report;
      begin
         A11y.Linux.ATSPi_Backend_Sessions.Queue_Event_Signal_With_Report
           (Session, Invalid_Event, Invalid_Report, Result);
         Check
           (Result.Status = A11y.Results.Invalid_Argument
            and then not Invalid_Report.Event_Valid
            and then Invalid_Report.Source = Invalid_Event.Source
            and then Invalid_Report.Sequence = Invalid_Event.Sequence
            and then Invalid_Report.Revision = Invalid_Event.Revision
            and then Invalid_Report.Prepared_Publication_Status =
              A11y.Results.Invalid_Argument
            and then not Invalid_Report.Prepared_Available
            and then Invalid_Report.Prepared_Status =
              A11y.Results.Invalid_Argument
            and then not Invalid_Report.Prepared_Queue.Signal_Built
            and then not Invalid_Report.Prepared_Queue.Enqueued
            and then Invalid_Report.Status = A11y.Results.Invalid_Argument
            and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
              (Session).Pending_Outgoing = 0
            and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
              (Session).In_Flight_Outgoing = 0
            and then A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot
              (Session).Outstanding_Calls = 0,
            "Linux AT-SPI backend session rejects invalid event signal envelopes before native preparation");

         A11y.Linux.ATSPi_Backend_Sessions.Queue_Event_Signal_With_Report
           (Session, Event, Queue_Report, Result);
         Check
           (Result.Status = A11y.Results.Backend_Unavailable
            and then Queue_Report.Event_Valid
            and then Queue_Report.Source = Event.Source
            and then Queue_Report.Sequence = Event.Sequence
            and then Queue_Report.Revision = Event.Revision
            and then Queue_Report.Prepared_Publication_Status =
              A11y.Results.Backend_Unavailable
            and then not Queue_Report.Prepared_Available
            and then Queue_Report.Prepared_Status =
              A11y.Results.Backend_Unavailable
            and then not Queue_Report.Prepared_Queue.Signal_Built
            and then not Queue_Report.Prepared_Queue.Enqueued
            and then Queue_Report.Status = A11y.Results.Backend_Unavailable
            and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
              (Session).Pending_Outgoing = 0
            and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
              (Session).In_Flight_Outgoing = 0
            and then A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot
              (Session).Outstanding_Calls = 0,
            "Linux AT-SPI backend session reports semantic event signal queueing rejection before transport admission without outgoing work");
      end;

      declare
         Invalid_Event : constant A11y.Events.Event :=
           (Sequence  => A11y.No_Event,
            Timestamp => Ada.Calendar.Clock,
            Source    => Application_Node,
            Kind      => A11y.Events.Focus_Changed,
            Revision  => 2);
         Invalid_Prepared : constant A11y.Native_Runtimes.Prepared_Event :=
           (Status        => A11y.Results.Success,
            Event         => Invalid_Event,
            Has_Focus_Payload => True,
            Focus_Payload =>
              (Old_Focus => A11y.Node_Ids.From_Natural (72),
               New_Focus => Application_Node),
            others       => <>);
         Invalid_Report :
           A11y.Linux.ATSPi_Backend_Sessions.Prepared_Signal_Queue_Report;
         Event : constant A11y.Events.Event :=
           (Sequence  => 805,
            Timestamp => Ada.Calendar.Clock,
            Source    => Application_Node,
            Kind      => A11y.Events.Focus_Changed,
            Revision  => 2);
         Prepared : constant A11y.Native_Runtimes.Prepared_Event :=
           (Status        => A11y.Results.Success,
            Event         => Event,
            Has_Focus_Payload => True,
            Focus_Payload =>
              (Old_Focus => A11y.Node_Ids.From_Natural (72),
               New_Focus => Application_Node),
            others       => <>);
         Queue_Report :
           A11y.Linux.ATSPi_Backend_Sessions.Prepared_Signal_Queue_Report;
      begin
         A11y.Linux.ATSPi_Backend_Sessions
           .Queue_Prepared_Event_Signal_With_Report
             (Session, Invalid_Prepared, Invalid_Report, Result);
         Check
           (Result.Status = A11y.Results.Invalid_Argument
            and then not Invalid_Report.Registered
            and then Invalid_Report.Pending_Outgoing_Before = 0
            and then Invalid_Report.Pending_Outgoing_After = 0
            and then Invalid_Report.Source = Invalid_Event.Source
            and then Invalid_Report.Sequence = Invalid_Event.Sequence
            and then Invalid_Report.Revision = Invalid_Event.Revision
            and then not Invalid_Report.Event_Valid
            and then Invalid_Report.Prepared_Status = A11y.Results.Success
            and then Invalid_Report.Prepared_Validation_Status =
              A11y.Results.Invalid_Argument
            and then not Invalid_Report.Signal_Built
            and then not Invalid_Report.Signal_Publishable
            and then not Invalid_Report.Enqueued
            and then Invalid_Report.Status = A11y.Results.Invalid_Argument
            and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
              (Session).Pending_Outgoing = 0
            and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
              (Session).In_Flight_Outgoing = 0
            and then A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot
              (Session).Outstanding_Calls = 0,
            "Linux AT-SPI backend session rejects invalid prepared signal envelopes before registration checks");

         A11y.Linux.ATSPi_Backend_Sessions
           .Queue_Prepared_Event_Signal_With_Report
             (Session, Prepared, Queue_Report, Result);
         Check
           (Result.Status = A11y.Results.Backend_Unavailable
            and then not Queue_Report.Registered
            and then Queue_Report.Pending_Outgoing_Before = 0
            and then Queue_Report.Pending_Outgoing_After = 0
            and then Queue_Report.Source = Event.Source
            and then Queue_Report.Sequence = Event.Sequence
            and then Queue_Report.Revision = Event.Revision
            and then Queue_Report.Event_Valid
            and then Queue_Report.Prepared_Status = A11y.Results.Success
            and then Queue_Report.Prepared_Validation_Status =
              A11y.Results.Node_Unavailable
            and then not Queue_Report.Prepared_Has_Object
            and then not Queue_Report.Prepared_Destroys_Node
            and then not Queue_Report.Signal_Built
            and then not Queue_Report.Signal_Publishable
            and then not Queue_Report.Enqueued
            and then Queue_Report.Status = A11y.Results.Backend_Unavailable
            and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
              (Session).Pending_Outgoing = 0
            and then A11y.Linux.ATSPi_Backend_Sessions.Startup_Interest
              (Session).In_Flight_Outgoing = 0
            and then A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot
              (Session).Outstanding_Calls = 0,
            "Linux AT-SPI backend session reports prepared event signal queueing rejection before transport admission without outgoing work");
      end;

      A11y.Linux.ATSPi_Backend_Sessions.Stop_With_Report
        (Session, Stop_Report, Result);
      Transport_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Backend_Status (Session);
      Registry_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Registry_Snapshot (Session);
      Check
        (A11y.Results.Succeeded (Result)
         and then Transport_View.State =
           A11y.Backends.Native_Backends.Transport_Not_Admitted
         and then Registry_View.Live_Count = 0
         and then Registry_View.Outstanding_Calls = 0,
         "Linux AT-SPI backend session stops startup, backend, and registry deterministically");
      Check
        (Stop_Report.Status = A11y.Results.Success
         and then Stop_Report.Startup_Stop_Attempted
         and then Stop_Report.Startup_Stopped
         and then Stop_Report.Startup_Status = A11y.Results.Success
         and then Stop_Report.Registry_Reset_Attempted
         and then Stop_Report.Registry_Reset
         and then Stop_Report.Registry_Status = A11y.Results.Success
         and then Stop_Report.Backend_Stop_Attempted
         and then Stop_Report.Backend_Stopped
         and then Stop_Report.Backend_Status = A11y.Results.Success
         and then Stop_Report.Startup_Interest_Before.Pending_Outgoing = 0
         and then Stop_Report.Startup_Interest_Before.In_Flight_Outgoing = 0
         and then Stop_Report.Startup_Interest_After.Pending_Outgoing = 0
         and then Stop_Report.Startup_Interest_After.In_Flight_Outgoing = 0
         and then Stop_Report.Registry_Before.Live_Count = 0
         and then Stop_Report.Registry_Before.Outstanding_Calls = 0
         and then Stop_Report.Registry_After.Live_Count = 0
         and then Stop_Report.Registry_After.Outstanding_Calls = 0
         and then Stop_Report.Backend_After.State =
           A11y.Backends.Native_Backends.Transport_Not_Admitted
         and then Stop_Report.Application_Node_Before =
           A11y.Node_Ids.No_Node
         and then Stop_Report.Application_Node_After =
           A11y.Node_Ids.No_Node
         and then not Stop_Report.Application_Node_Cleared,
         "Linux AT-SPI backend session stop report records deterministic shutdown ordering");
      A11y.Linux.ATSPi_Backend_Sessions.Capture_Report
        (Session, Session_View);
      Check
        (Session_View.Status = A11y.Results.Success
         and then Session_View.Transport.State =
           A11y.Backends.Native_Backends.Transport_Not_Admitted
         and then Session_View.Startup_State =
           A11y.Linux.ATSPi_Bus.Disconnected
         and then not Session_View.Registered
         and then not Session_View.Application_Exportable
         and then Session_View.Application_Status =
           A11y.Results.Node_Unavailable
         and then Session_View.Registry.Live_Count = 0
         and then Session_View.Registry.Outstanding_Calls = 0,
         "Linux AT-SPI backend session report captures stopped state coherently");

      A11y.Linux.ATSPi_Backend_Sessions.Start_From_Session_Bus_Address
        (Session, "not-an-address", 1000, Application_Node, Result);
      Transport_View :=
        A11y.Linux.ATSPi_Backend_Sessions.Backend_Status (Session);
      Check
        (A11y.Results.Succeeded (Result)
         and then Transport_View.State =
           A11y.Backends.Native_Backends.Transport_Failed
         and then Transport_View.Last_Status =
           A11y.Results.Invalid_Argument,
         "Linux AT-SPI backend session records session-bus discovery startup failures");
      A11y.Linux.ATSPi_Backend_Sessions.Capture_Report
        (Session, Session_View);
      Check
        (Session_View.Status = A11y.Results.Success
         and then Session_View.Transport.State =
           A11y.Backends.Native_Backends.Transport_Failed
         and then Session_View.Transport.Last_Status =
           A11y.Results.Invalid_Argument
         and then Session_View.Startup_State =
           A11y.Linux.ATSPi_Bus.Disconnected
         and then not Session_View.Registered
         and then not Session_View.Application_Exportable
         and then Session_View.Application_Status =
           A11y.Results.Node_Unavailable
         and then Session_View.Registry.Outstanding_Calls = 0,
         "Linux AT-SPI backend session report captures failed session-bus discovery coherently");

      A11y.Linux.ATSPi_Backend_Sessions.Start_From_Session_Bus_Address_With_Report
        (Session,
         "not-an-address",
         1000,
         Application_Node,
         Startup_Report,
         Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then not Startup_Report.Prepared
         and then Startup_Report.Status = A11y.Results.Invalid_Argument
         and then Startup_Report.Registration.Status =
           A11y.Results.Backend_Unavailable
         and then not Startup_Report.Backend_Synchronized
         and then not Startup_Report.Application_Root_Ensured
         and then not A11y.Linux.ATSPi_Backend_Sessions.Registered
           (Session),
         "Linux AT-SPI backend session-bus startup report preserves discovery failures without root export");
   end;

   declare
      Session : A11y.Linux.ATSPi_Backend_Sessions.Backend_Session;
      Result : A11y.Results.Result;
      Session_View :
        A11y.Linux.ATSPi_Backend_Sessions.Session_Report;
      Startup_Report :
        A11y.Linux.ATSPi_Backend_Sessions.Session_Startup_Report;
      Application_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (1002);
   begin
      A11y.Linux.ATSPi_Backend_Sessions.Start_From_Environment_Value
        (Session, "not-an-address", 1000, Application_Node, Result);
      A11y.Linux.ATSPi_Backend_Sessions.Capture_Report
        (Session, Session_View);
      Check
        (A11y.Results.Succeeded (Result)
         and then Session_View.Transport.State =
           A11y.Backends.Native_Backends.Transport_Failed
         and then Session_View.Transport.Last_Status =
           A11y.Results.Invalid_Argument
         and then Session_View.Startup_State = A11y.Linux.ATSPi_Bus.Failed
         and then not Session_View.Registered
         and then not Session_View.Application_Exportable,
         "Linux AT-SPI backend session reports malformed environment-value startup");

      A11y.Linux.ATSPi_Backend_Sessions.Start_From_Environment_Value_With_Report
        (Session,
         "not-an-address",
         1000,
         Application_Node,
         Startup_Report,
         Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then not Startup_Report.Prepared
         and then Startup_Report.Status = A11y.Results.Invalid_Argument
         and then Startup_Report.Registration.Status =
           A11y.Results.Backend_Unavailable
         and then not Startup_Report.Backend_Synchronized
         and then not Startup_Report.Application_Root_Ensured
         and then not A11y.Linux.ATSPi_Backend_Sessions.Registered
           (Session),
         "Linux AT-SPI environment startup report preserves malformed environment failures without root export");

      A11y.Linux.ATSPi_Backend_Sessions.Stop (Session, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI backend session stops after environment-value failure");
   end;

   declare
      AT_SPI_Env_Name : constant String :=
        A11y.Linux.ATSPi_Address_Discovery.AT_SPI_Bus_Address_Variable;
      Session_Env_Name : constant String :=
        A11y.Linux.ATSPi_Address_Discovery
          .DBus_Session_Bus_Address_Variable;
      Had_AT_SPI_Environment_Value : constant Boolean :=
        Ada.Environment_Variables.Exists (AT_SPI_Env_Name);
      Had_Session_Environment_Value : constant Boolean :=
        Ada.Environment_Variables.Exists (Session_Env_Name);
      Saved_AT_SPI_Environment_Value : constant Unbounded_String :=
        (if Had_AT_SPI_Environment_Value
         then To_Unbounded_String
           (Ada.Environment_Variables.Value (AT_SPI_Env_Name))
         else Null_Unbounded_String);
      Saved_Session_Environment_Value : constant Unbounded_String :=
        (if Had_Session_Environment_Value
         then To_Unbounded_String
           (Ada.Environment_Variables.Value (Session_Env_Name))
         else Null_Unbounded_String);

      procedure Restore_Environment is
      begin
         if Had_AT_SPI_Environment_Value then
            Ada.Environment_Variables.Set
              (AT_SPI_Env_Name, To_String (Saved_AT_SPI_Environment_Value));
         elsif Ada.Environment_Variables.Exists (AT_SPI_Env_Name) then
            Ada.Environment_Variables.Clear (AT_SPI_Env_Name);
         end if;

         if Had_Session_Environment_Value then
            Ada.Environment_Variables.Set
              (Session_Env_Name,
               To_String (Saved_Session_Environment_Value));
         elsif Ada.Environment_Variables.Exists (Session_Env_Name) then
            Ada.Environment_Variables.Clear (Session_Env_Name);
         end if;
      end Restore_Environment;

      Session : A11y.Linux.ATSPi_Backend_Sessions.Backend_Session;
      Result : A11y.Results.Result;
      Startup_Report :
        A11y.Linux.ATSPi_Backend_Sessions.Session_Startup_Report;
      Application_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (1003);
   begin
      if Ada.Environment_Variables.Exists (AT_SPI_Env_Name) then
         Ada.Environment_Variables.Clear (AT_SPI_Env_Name);
      end if;
      if Ada.Environment_Variables.Exists (Session_Env_Name) then
         Ada.Environment_Variables.Clear (Session_Env_Name);
      end if;

      A11y.Linux.ATSPi_Backend_Sessions
        .Start_From_Host_Environment_With_Report
          (Session, 1000, Application_Node, Startup_Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Startup_Report.Source =
           A11y.Linux.ATSPi_Backend_Sessions.Host_Environment_Missing
         and then not Startup_Report.Host_AT_SPI_Address_Present
         and then not Startup_Report.Host_Session_Bus_Address_Present
         and then not Startup_Report.Prepared
         and then Startup_Report.Status = A11y.Results.Backend_Unavailable
         and then Startup_Report.Registration.Status =
           A11y.Results.Backend_Unavailable
         and then not Startup_Report.Backend_Synchronized
         and then not Startup_Report.Application_Root_Ensured
         and then not A11y.Linux.ATSPi_Backend_Sessions.Registered
           (Session),
         "Linux AT-SPI host-environment startup reports missing AT_SPI_BUS_ADDRESS without root export");
      declare
         Missing_Startup_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Host_Environment_Startup_JSON
             (1000);
         Missing_Serve_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Host_Environment_Serve_JSON
             (1000, 2, 25);
      begin
         Check
           (Ada.Strings.Fixed.Index
              (Missing_Startup_JSON,
               """startup_source"": ""missing_host_environment""") /= 0
            and then Ada.Strings.Fixed.Index
              (Missing_Startup_JSON,
               """host_at_spi_bus_address_present"": false") /= 0
            and then Ada.Strings.Fixed.Index
              (Missing_Startup_JSON,
               """host_session_bus_address_present"": false") /= 0
            and then Ada.Strings.Fixed.Index
              (Missing_Serve_JSON,
               """startup_source"": ""missing_host_environment""") /= 0
            and then Ada.Strings.Fixed.Index
              (Missing_Serve_JSON,
               """host_environment_used"": true") /= 0,
            "fixture host-environment JSON reports missing AT-SPI and session bus sources exactly");
      end;

      A11y.Linux.ATSPi_Backend_Sessions.Stop (Session, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI backend session stops after missing host-environment startup");

      Ada.Environment_Variables.Set
        (Session_Env_Name,
         "unix:path=/tmp/a11ykit-definitely-missing-session-host-env-bus");
      A11y.Linux.ATSPi_Backend_Sessions
        .Start_From_Host_Environment_With_Report
          (Session, 1000, Application_Node, Startup_Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Startup_Report.Source =
           A11y.Linux.ATSPi_Backend_Sessions.Host_Session_Bus_Address
         and then not Startup_Report.Host_AT_SPI_Address_Present
         and then Startup_Report.Host_Session_Bus_Address_Present
         and then not Startup_Report.Prepared
         and then Startup_Report.Status = A11y.Results.Backend_Unavailable
         and then Startup_Report.Registration.Status =
           A11y.Results.Backend_Unavailable
         and then not Startup_Report.Backend_Synchronized
         and then not Startup_Report.Application_Root_Ensured
         and then not A11y.Linux.ATSPi_Backend_Sessions.Registered
           (Session),
         "Linux AT-SPI host-environment startup falls back to DBUS_SESSION_BUS_ADDRESS discovery");
      declare
         Session_Startup_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Host_Environment_Startup_JSON
             (1000);
         Session_Serve_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Host_Environment_Serve_JSON
             (1000, 2, 25);
      begin
         Check
           (Ada.Strings.Fixed.Index
              (Session_Startup_JSON,
               """startup_source"": ""dbus_session_bus_address""") /= 0
            and then Ada.Strings.Fixed.Index
              (Session_Startup_JSON,
               """host_at_spi_bus_address_present"": false") /= 0
            and then Ada.Strings.Fixed.Index
              (Session_Startup_JSON,
               """host_session_bus_address_present"": true") /= 0
            and then Ada.Strings.Fixed.Index
              (Session_Serve_JSON,
               """startup_source"": ""dbus_session_bus_address""") /= 0
            and then Ada.Strings.Fixed.Index
              (Session_Serve_JSON,
               """host_environment_used"": true") /= 0,
            "fixture host-environment JSON reports DBUS_SESSION_BUS_ADDRESS fallback exactly");
      end;

      Ada.Environment_Variables.Clear (Session_Env_Name);
      Ada.Environment_Variables.Set
        (AT_SPI_Env_Name,
         "unix:path=/tmp/a11ykit-definitely-missing-host-env-bus");
      A11y.Linux.ATSPi_Backend_Sessions
        .Start_From_Host_Environment_With_Report
          (Session, 1000, Application_Node, Startup_Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Startup_Report.Source =
           A11y.Linux.ATSPi_Backend_Sessions.Host_AT_SPI_Bus_Address
         and then Startup_Report.Host_AT_SPI_Address_Present
         and then not Startup_Report.Host_Session_Bus_Address_Present
         and then Startup_Report.Prepared
         and then Startup_Report.Status = A11y.Results.Backend_Unavailable
         and then Startup_Report.Registration.Address_Resolved
         and then Startup_Report.Registration.Raw_Connect_Attempted
         and then Startup_Report.Registration.Raw_Connect_Status =
           A11y.Results.Backend_Unavailable
         and then not Startup_Report.Registration.Raw_Connected
         and then Startup_Report.Backend_Synchronization.Status =
           A11y.Results.Backend_Unavailable
         and then not Startup_Report.Backend_Synchronization
           .Transport_Admission_Attempted
         and then not Startup_Report.Backend_Synchronization
           .Backend_Start_Attempted
         and then not Startup_Report.Backend_Synchronized
         and then not Startup_Report.Application_Root_Ensured
         and then not A11y.Linux.ATSPi_Backend_Sessions.Registered
           (Session),
         "Linux AT-SPI host-environment startup uses hostkit environment values before live transport");
      declare
         AT_SPI_Startup_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Host_Environment_Startup_JSON
             (1000);
         AT_SPI_Serve_JSON : constant String :=
           A11y_Fixture_Application.ATSPi_Host_Environment_Serve_JSON
             (1000, 2, 25);
      begin
         Check
           (Ada.Strings.Fixed.Index
              (AT_SPI_Startup_JSON,
               """startup_source"": ""at_spi_bus_address""") /= 0
            and then Ada.Strings.Fixed.Index
              (AT_SPI_Startup_JSON,
               """host_at_spi_bus_address_present"": true") /= 0
            and then Ada.Strings.Fixed.Index
              (AT_SPI_Startup_JSON,
               """host_session_bus_address_present"": false") /= 0
            and then Ada.Strings.Fixed.Index
              (AT_SPI_Serve_JSON,
               """startup_source"": ""at_spi_bus_address""") /= 0
            and then Ada.Strings.Fixed.Index
              (AT_SPI_Serve_JSON,
               """host_environment_used"": true") /= 0,
            "fixture host-environment JSON reports AT_SPI_BUS_ADDRESS precedence exactly");
      end;

      Restore_Environment;
   exception
      when others =>
         Restore_Environment;
         raise;
   end;

   declare
      Backend : A11y.Backends.Native_Backends.Native_Backend
        (A11y.Backends.Native_Backends.Linux_ATSPI);
      Result : A11y.Results.Result;
