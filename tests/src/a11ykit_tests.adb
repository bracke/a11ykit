   declare
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Call : A11y.Linux.ATSPi_DBus_Boundary.DBus_Method_Call;
      Incoming : A11y.Linux.DBus_Messages.Incoming_Call;
      Long_Text : constant String (1 .. 65) := [others => 'x'];
      Boundary_Reply : constant A11y.Linux.ATSPi_DBus_Boundary.DBus_Method_Reply :=
        (Kind       => A11y.Linux.ATSPi_DBus_Boundary.Error_Reply,
         Status     => A11y.Results.Unsupported_Capability,
