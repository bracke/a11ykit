      declare
         Raw : String := To_String (Packet.Bytes);
         Sender_Field_Offset : Natural := 0;
         Sender_Packet : A11y.Linux.DBus_Messages.Transport_Packet;
         Sender_Envelope : A11y.Linux.DBus_Messages.Transport_Envelope;
      begin
         for Index in 17 .. Packet_Header.Header_Length - 3 loop
            if Character'Pos (Raw (Index)) = 6
              and then Character'Pos (Raw (Index + 1)) = 1
              and then Raw (Index + 2) = 's'
