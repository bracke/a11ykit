            Invalid_Envelope.Error_Name :=
              To_Unbounded_String ("org.invalid-name");
            Invalid_Frame :=
              A11y.Linux.DBus_Messages.Build_Transport_Frame_Metadata
                (Invalid_Envelope, Result);
