      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (760);
      Result : A11y.Results.Result;
      Path : constant Unbounded_String :=
        A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Result);
      Content : constant Wide_Wide_String :=
        "A" & Wide_Wide_Character'Val (16#1F600#) & "B";
      type Text_Snapshot_Access is access
        A11y.Linux.ATSPi_Text.Text_Snapshot;
      Snapshot_Ref : constant Text_Snapshot_Access :=
        new A11y.Linux.ATSPi_Text.Text_Snapshot;
      Snapshot : A11y.Linux.ATSPi_Text.Text_Snapshot
        renames Snapshot_Ref.all;
      Reply : A11y.Linux.ATSPi_Text.Text_Reply;
      Root : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (761);
      Invalid_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      Snapshot.Id := Node;
      Snapshot.Content := To_Unbounded_Wide_Wide_String (Content);
      Snapshot.Caret := A11y.Text.Code_Point_Position (2);

      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetCharacterCount", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.UInt32_Reply
         and then Reply.UInt32 = 3,
         "Linux AT-SPI Text method layer counts code-point positions");

      Invalid_Limits.Limits (A11y.Resource_Limits.Native_String_Size) := 0;
      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session,
         To_String (Path),
         "GetCharacterCount",
         0,
         0,
         Snapshot,
         Invalid_Limits);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_Argument,
         "Linux AT-SPI Text method layer rejects invalid limit configs");

      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetText", 1, 2, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Wide_Text_Reply
         and then To_Wide_Wide_String (Reply.Wide_Text)
           = Wide_Wide_Character'Val (16#1F600#) & "B",
         "Linux AT-SPI Text method layer returns neutral text ranges");

      Snapshot.Content :=
        To_Unbounded_Wide_Wide_String
          ("Ae" & Wide_Wide_Character'Val (16#0301#) & "B");
      Reply := A11y.Linux.ATSPi_Text.Handle_Grapheme_Text_Range
        (Session, To_String (Path), Start => 1, Count => 1,
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Wide_Text_Reply
         and then To_Wide_Wide_String (Reply.Wide_Text)
           = "e" & Wide_Wide_Character'Val (16#0301#),
         "Linux AT-SPI Text method layer exposes backend-private grapheme text ranges");
      Reply := A11y.Linux.ATSPi_Text.Handle_Grapheme_Edit_Method
        (Session,
         To_String (Path),
         "DeleteText",
         Start => 1,
         Count => 1,
         Replacement => "",
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Edit_Request_Reply
         and then Reply.Requested_Edit.Kind = A11y.Text.Delete_Text
         and then A11y.Text.Index
           (A11y.Text.First (Reply.Requested_Edit.Span)) = 1
         and then A11y.Text.Length (Reply.Requested_Edit.Span) = 2,
         "Linux AT-SPI Text method layer validates backend-private grapheme edit requests");
      Snapshot.Content := To_Unbounded_Wide_Wide_String (Content);

      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetCaretOffset", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.UInt32_Reply
         and then Reply.UInt32 = 2,
         "Linux AT-SPI Text method layer returns neutral caret offsets");
      Snapshot.Caret := A11y.Text.Code_Point_Position (Content'Length + 1);
      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetCaretOffset", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_Range,
         "Linux AT-SPI Text method layer rejects caret offsets outside content");
      Snapshot.Caret := A11y.Text.Code_Point_Position (2);

      Reply := A11y.Linux.ATSPi_Text.Handle_Edit_Method
        (Session,
         To_String (Path),
         "InsertText",
         Start => 1,
         Count => 0,
         Replacement => "X",
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Edit_Request_Reply
         and then Reply.Requested_Edit.Kind = A11y.Text.Insert_Text
         and then A11y.Text.Index
           (A11y.Text.First (Reply.Requested_Edit.Span)) = 1
         and then To_Wide_Wide_String (Reply.Requested_Edit.Text) = "X",
         "Linux AT-SPI Text method layer translates insert edit requests");

      Reply := A11y.Linux.ATSPi_Text.Handle_Edit_Method
        (Session,
         To_String (Path),
         "DeleteText",
         Start => 1,
         Count => 1,
         Replacement => "",
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Edit_Request_Reply
         and then Reply.Requested_Edit.Kind = A11y.Text.Delete_Text
         and then A11y.Text.Length (Reply.Requested_Edit.Span) = 1,
         "Linux AT-SPI Text method layer translates delete edit requests");

      Reply := A11y.Linux.ATSPi_Text.Handle_Edit_Method
        (Session,
         To_String (Path),
         "ReplaceText",
         Start => 1,
         Count => 2,
         Replacement => "YZ",
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Edit_Request_Reply
         and then Reply.Requested_Edit.Kind = A11y.Text.Replace_Text
         and then A11y.Text.Index
           (A11y.Text.First (Reply.Requested_Edit.Span)) = 1
         and then A11y.Text.Length (Reply.Requested_Edit.Span) = 2
         and then To_Wide_Wide_String (Reply.Requested_Edit.Text) = "YZ",
         "Linux AT-SPI Text method layer translates replace edit requests");

      Reply := A11y.Linux.ATSPi_Text.Handle_Edit_Method
        (Session,
         To_String (Path),
         "SetTextContents",
         Start => 0,
         Count => 0,
         Replacement => "Reset",
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Edit_Request_Reply
         and then Reply.Requested_Edit.Kind = A11y.Text.Set_Text
         and then To_Wide_Wide_String (Reply.Requested_Edit.Text) = "Reset",
         "Linux AT-SPI Text method layer translates set-text edit requests");

      Snapshot.Policy := A11y.Text.Protected_Text;
      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetText", 0, 1, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Permission_Denied,
         "Linux AT-SPI Text method layer enforces protected text");

      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetText", Natural'Last, 1, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Permission_Denied,
         "Linux AT-SPI Text method layer enforces protected text before range validation");

      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetCharacterCount", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Permission_Denied,
         "Linux AT-SPI Text method layer blocks protected text character counts");

      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetCaretOffset", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Permission_Denied,
         "Linux AT-SPI Text method layer blocks protected caret offsets");

      Reply := A11y.Linux.ATSPi_Text.Handle_Grapheme_Text_Range
        (Session, To_String (Path), Start => 0, Count => 1,
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Permission_Denied,
         "Linux AT-SPI Text method layer enforces protected grapheme text ranges");

      Reply := A11y.Linux.ATSPi_Text.Handle_Grapheme_Text_Range
        (Session, To_String (Path), Start => Natural'Last, Count => 1,
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Permission_Denied,
         "Linux AT-SPI Text method layer enforces protected grapheme text ranges before offset validation");

      Reply := A11y.Linux.ATSPi_Text.Handle_Edit_Method
        (Session,
         To_String (Path),
         "InsertText",
         Start => 0,
         Count => 0,
         Replacement => "X",
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Permission_Denied,
         "Linux AT-SPI Text method layer blocks protected text edits");

      Snapshot.Policy := A11y.Text.Plain_Text;
      Snapshot.Read_Only := True;
      Reply := A11y.Linux.ATSPi_Text.Handle_Edit_Method
        (Session,
         To_String (Path),
         "InsertText",
         Start => 0,
         Count => 0,
         Replacement => "X",
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Read_Only,
         "Linux AT-SPI Text method layer blocks read-only text edits");
      Snapshot.Read_Only := False;

      Snapshot.Root := Root;
      Snapshot.Use_Tree_Projection := True;
      A11y.Trees.Set_Root (Snapshot.Tree, Root, Result);
      A11y.Trees.Attach (Snapshot.Tree, Root, Node, Result);
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Node)) :=
           A11y.Nodes.Hide_Node_And_Subtree;
      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetCharacterCount", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Text method layer rejects hidden text nodes");

      Reply := A11y.Linux.ATSPi_Text.Handle_Edit_Method
        (Session,
         To_String (Path),
         "InsertText",
         Start => 0,
         Count => 0,
         Replacement => "X",
         Snapshot => Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Text method layer rejects hidden text edit nodes");
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Node)) := A11y.Nodes.Expose_Node;
      Snapshot.Use_Tree_Projection := False;

      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetText", 2, 10, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_Range,
         "Linux AT-SPI Text method layer rejects invalid ranges");

      Snapshot.Defunct := True;
      Reply := A11y.Linux.ATSPi_Text.Handle_Method
        (Session, To_String (Path), "GetCharacterCount", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Text.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Text method layer rejects defunct snapshots");
   end;

   declare
      type Table_Method_Snapshot_Access is
        access A11y.Linux.ATSPi_Table.Table_Method_Snapshot;

      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Root_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (769);
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (770);
      Cell_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (771);
      Hidden_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (772);
      Result : A11y.Results.Result;
      Path : constant Unbounded_String :=
        A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Result);
      Table : A11y.Tables.Table_Snapshot;
      Snapshot_Ref : constant Table_Method_Snapshot_Access :=
        new A11y.Linux.ATSPi_Table.Table_Method_Snapshot;
      Snapshot : A11y.Linux.ATSPi_Table.Table_Method_Snapshot
        renames Snapshot_Ref.all;
      Reply : A11y.Linux.ATSPi_Table.Table_Reply;
   begin
      A11y.Tables.Configure (Table, Rows => 4, Columns => 5);
      A11y.Tables.Add_Cell
        (Table, Cell_Node, Row => 1, Column => 2, Row_Span => 2,
         Column_Span => 3, Result => Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI Table fixture materializes a stable cell");
      A11y.Tables.Set_Current_Cell (Table, Cell_Node, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI Table fixture records current-cell metadata");
      A11y.Tables.Set_Sort
        (Table, Cell_Node, A11y.Tables.Descending, Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux AT-SPI Table fixture records stable sort metadata");

      Snapshot.Id := Node;
      Snapshot.Table := Table;

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetNRows", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.UInt32_Reply
         and then Reply.UInt32 = 4,
         "Linux AT-SPI Table method layer returns row counts");

      declare
         Invalid_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         Invalid_Limits.Limits (A11y.Resource_Limits.Native_Array_Size) := 0;
         Reply := A11y.Linux.ATSPi_Table.Handle_Method
           (Session, To_String (Path), "GetNRows", 0, 0, Snapshot,
            Invalid_Limits);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Table.Error_Reply
            and then Reply.Status = A11y.Results.Invalid_Argument,
            "Linux AT-SPI Table method layer rejects invalid limit configs");
      end;

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetNColumns", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.UInt32_Reply
         and then Reply.UInt32 = 5,
         "Linux AT-SPI Table method layer returns column counts");

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetAccessibleAt", 2, 4, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Node_Reply
         and then Reply.Node = Cell_Node,
         "Linux AT-SPI Table method layer returns stable cell identities");

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetColumnExtentAt", 2, 4, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.UInt32_Reply
         and then Reply.UInt32 = 3,
         "Linux AT-SPI Table method layer returns merged-cell spans");

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetCurrentCell", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Node_Reply
         and then Reply.Node = Cell_Node,
         "Linux AT-SPI Table method layer returns current-cell metadata");

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetSortOrder", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.UInt32_Reply
         and then Reply.UInt32 = A11y.Tables.Sort_Order'Pos
           (A11y.Tables.Descending),
         "Linux AT-SPI Table method layer returns sort-order metadata");

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetSortKey", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Node_Reply
         and then Reply.Node = Cell_Node,
         "Linux AT-SPI Table method layer returns stable sort-key metadata");

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetAccessibleAt", 9, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_Range,
         "Linux AT-SPI Table method layer rejects invalid coordinates");

      A11y.Trees.Set_Root (Snapshot.Tree, Root_Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Root_Node, Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Node, Hidden_Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Hidden_Node, Cell_Node, Result);
      Snapshot.Root := Root_Node;
      Snapshot.Use_Tree_Projection := True;
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Hidden_Node)) :=
          A11y.Nodes.Hide_Node_And_Subtree;

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetAccessibleAt", 2, 4, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Table method layer hides projected cells");

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetColumnExtentAt", 2, 4, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Table method layer hides projected cell spans");

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetCurrentCell", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Table method layer hides projected current cells");

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetSortKey", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Table method layer hides projected sort keys");

      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Hidden_Node)) :=
          A11y.Nodes.Expose_Node;
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Node)) :=
          A11y.Nodes.Hide_Node_And_Subtree;

      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetNRows", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Table method layer rejects hidden table nodes");

      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Node)) :=
          A11y.Nodes.Expose_Node;
      Snapshot.Use_Tree_Projection := False;

      Snapshot.Defunct := True;
      Reply := A11y.Linux.ATSPi_Table.Handle_Method
        (Session, To_String (Path), "GetNRows", 0, 0, Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Table.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Table method layer rejects defunct snapshots");
   end;

   declare
      type Image_Snapshot_Access is
        access A11y.Linux.ATSPi_Image.Image_Snapshot;

      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Root_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (779);
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (780);
      Hidden_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (781);
      Result : A11y.Results.Result;
      Path : constant Unbounded_String :=
        A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Result);
      Metadata : A11y.Images.Image_Metadata;
      Snapshot_Ref : constant Image_Snapshot_Access :=
        new A11y.Linux.ATSPi_Image.Image_Snapshot;
      Snapshot : A11y.Linux.ATSPi_Image.Image_Snapshot
        renames Snapshot_Ref.all;
      Reply : A11y.Linux.ATSPi_Image.Image_Reply;
   begin
      Metadata.Kind := A11y.Images.Informative;
      Metadata.Alternative_Text := To_Unbounded_String ("Revenue chart");
      Metadata.Caption := To_Unbounded_String ("Q1 revenue");
      Metadata.Intrinsic_Dimensions := (Width => 640, Height => 480);
      Metadata.Has_Intrinsic_Size := True;
      Snapshot.Id := Node;
      Snapshot.Metadata := Metadata;

      Reply := A11y.Linux.ATSPi_Image.Handle_Method
        (Session, To_String (Path), "GetImageDescription", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Image.String_Reply
         and then To_String (Reply.Text) = "Revenue chart",
         "Linux AT-SPI Image method layer returns text alternatives");

      Reply := A11y.Linux.ATSPi_Image.Handle_Method
        (Session, To_String (Path), "GetImageCaption", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Image.String_Reply
         and then To_String (Reply.Text) = "Q1 revenue",
         "Linux AT-SPI Image method layer returns captions");

      Snapshot.Metadata.Kind := A11y.Images.Chart;
      Reply := A11y.Linux.ATSPi_Image.Handle_Method
        (Session, To_String (Path), "GetImageKind", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Image.String_Reply
         and then To_String (Reply.Text) = "chart",
         "Linux AT-SPI Image method layer returns image categories");
      Snapshot.Metadata.Kind := A11y.Images.Informative;

      Snapshot.Metadata.Alternative_Text :=
        To_Unbounded_String
          (String'
             (1 .. Natural
               (A11y.Resource_Limits.Value
                  (A11y.Resource_Limits.Default_Config,
                   A11y.Resource_Limits.Text_Returned)) + 1 => 'x'));
      Reply := A11y.Linux.ATSPi_Image.Handle_Method
        (Session, To_String (Path), "GetImageDescription", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Image.Error_Reply
         and then Reply.Status = A11y.Results.Resource_Limit,
         "Linux AT-SPI Image method layer bounds image metadata text");

      Snapshot.Metadata.Alternative_Text := To_Unbounded_String ("Revenue chart");
      declare
         Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         A11y.Resource_Limits.Set_Limit
           (Limits,
            A11y.Resource_Limits.Native_String_Size,
            4,
            Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI Image method layer configures native string limit");

         Reply := A11y.Linux.ATSPi_Image.Handle_Method
           (Session, To_String (Path), "GetImageDescription",
            Snapshot, Limits);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Image.Error_Reply
            and then Reply.Status = A11y.Results.Resource_Limit,
            "Linux AT-SPI Image method layer applies configured native string limits");
      end;

      declare
         Invalid_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         Invalid_Limits.Limits (A11y.Resource_Limits.Native_String_Size) := 0;
         Reply := A11y.Linux.ATSPi_Image.Handle_Method
           (Session, To_String (Path), "GetImageSize",
            Snapshot, Invalid_Limits);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Image.Error_Reply
            and then Reply.Status = A11y.Results.Invalid_Argument,
            "Linux AT-SPI Image method layer rejects invalid limit configs");
      end;

      Reply := A11y.Linux.ATSPi_Image.Handle_Method
        (Session, To_String (Path), "GetImageSize", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Image.Size_Reply
         and then Reply.Size.Width = 640
         and then Reply.Size.Height = 480,
         "Linux AT-SPI Image method layer returns intrinsic dimensions");

      A11y.Trees.Set_Root (Snapshot.Tree, Root_Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Root_Node, Hidden_Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Hidden_Node, Node, Result);
      Snapshot.Root := Root_Node;
      Snapshot.Use_Tree_Projection := True;
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Hidden_Node)) :=
          A11y.Nodes.Hide_Node_And_Subtree;
      Reply := A11y.Linux.ATSPi_Image.Handle_Method
        (Session, To_String (Path), "GetImageDescription", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Image.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Image method layer rejects hidden image nodes");
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Hidden_Node)) :=
          A11y.Nodes.Expose_Node;
      Snapshot.Use_Tree_Projection := False;

      Snapshot.Metadata.Alternative_Text := Null_Unbounded_String;
      Reply := A11y.Linux.ATSPi_Image.Handle_Method
        (Session, To_String (Path), "GetImageDescription", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Image.Error_Reply
         and then Reply.Status = A11y.Results.Unsupported_Property,
         "Linux AT-SPI Image method layer distinguishes missing alternatives");

      Snapshot.Metadata.Kind := A11y.Images.Decorative;
      Reply := A11y.Linux.ATSPi_Image.Handle_Method
        (Session, To_String (Path), "GetImageSize", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Image.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Image method layer omits decorative images");

      Snapshot.Metadata.Kind := A11y.Images.Informative;
      Snapshot.Defunct := True;
      Reply := A11y.Linux.ATSPi_Image.Handle_Method
        (Session, To_String (Path), "GetImageSize", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Image.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Image method layer rejects defunct snapshots");
   end;

   declare
      type Document_Snapshot_Access is
        access A11y.Linux.ATSPi_Document.Document_Snapshot;

      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Root_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (789);
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (790);
      Hidden_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (791);
      Result : A11y.Results.Result;
      Path : constant Unbounded_String :=
        A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Result);
      Metadata : A11y.Documents.Document_Metadata;
      Snapshot_Ref : constant Document_Snapshot_Access :=
        new A11y.Linux.ATSPi_Document.Document_Snapshot;
      Snapshot : A11y.Linux.ATSPi_Document.Document_Snapshot
        renames Snapshot_Ref.all;
      Reply : A11y.Linux.ATSPi_Document.Document_Reply;
   begin
      Metadata.Role := A11y.Documents.Heading;
      Metadata.Heading_Level := 2;
      Metadata.Language := To_Unbounded_String ("en-US");
      Metadata.Title := To_Unbounded_String ("Overview");
      Metadata.Author := To_Unbounded_String ("Ada Team");
      Metadata.Subject := To_Unbounded_String ("Accessibility");
      Metadata.Version := To_Unbounded_String ("1.0");
      Metadata.Revision := To_Unbounded_String ("draft");
      Metadata.Creation_Metadata := To_Unbounded_String ("created");
      Metadata.Modification_Metadata := To_Unbounded_String ("modified");
      Metadata.Landmark := To_Unbounded_String ("main");
      Metadata.Page_Count := 12;
      Metadata.Current_Page := 4;
      Snapshot.Id := Node;
      Snapshot.Metadata := Metadata;

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetLocale", "", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.String_Reply
         and then To_String (Reply.Text) = "en-US",
         "Linux AT-SPI Document method layer returns locale metadata");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "role", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.String_Reply
         and then To_String (Reply.Text) = "heading",
         "Linux AT-SPI Document method layer returns document roles");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "heading-level",
         Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.UInt32_Reply
         and then Reply.UInt32 = 2,
         "Linux AT-SPI Document method layer returns heading levels");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "author", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.String_Reply
         and then To_String (Reply.Text) = "Ada Team",
         "Linux AT-SPI Document method layer returns author metadata");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "subject", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.String_Reply
         and then To_String (Reply.Text) = "Accessibility",
         "Linux AT-SPI Document method layer returns subject metadata");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "version", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.String_Reply
         and then To_String (Reply.Text) = "1.0",
         "Linux AT-SPI Document method layer returns version metadata");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "revision",
         Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.String_Reply
         and then To_String (Reply.Text) = "draft",
         "Linux AT-SPI Document method layer returns revision metadata");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "creation",
         Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.String_Reply
         and then To_String (Reply.Text) = "created",
         "Linux AT-SPI Document method layer returns creation metadata");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "modification",
         Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.String_Reply
         and then To_String (Reply.Text) = "modified",
         "Linux AT-SPI Document method layer returns modification metadata");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "page-count",
         Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.UInt32_Reply
         and then Reply.UInt32 = 12,
         "Linux AT-SPI Document method layer returns page counts");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "current-page",
         Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.UInt32_Reply
         and then Reply.UInt32 = 4,
         "Linux AT-SPI Document method layer returns current pages");

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "IsLandmark", "", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.Boolean_Reply
         and then Reply.Boolean_Item,
         "Linux AT-SPI Document method layer identifies landmarks");

      Snapshot.Metadata.Title :=
        To_Unbounded_String
          (String'
             (1 .. Natural
               (A11y.Resource_Limits.Value
                  (A11y.Resource_Limits.Default_Config,
                   A11y.Resource_Limits.Text_Returned)) + 1 => 'x'));
      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "title", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.Error_Reply
         and then Reply.Status = A11y.Results.Resource_Limit,
         "Linux AT-SPI Document method layer bounds document metadata text");

      Snapshot.Metadata.Title := To_Unbounded_String ("Overview");
      declare
         Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         A11y.Resource_Limits.Set_Limit
           (Limits,
            A11y.Resource_Limits.Native_String_Size,
            4,
            Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI Document method layer configures native string limit");

         Reply := A11y.Linux.ATSPi_Document.Handle_Method
           (Session, To_String (Path), "GetAttributeValue", "title",
            Snapshot, Limits);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Document.Error_Reply
            and then Reply.Status = A11y.Results.Resource_Limit,
            "Linux AT-SPI Document method layer applies configured native string limits");
      end;

      declare
         Invalid_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           A11y.Resource_Limits.Default_Config;
      begin
         Invalid_Limits.Limits (A11y.Resource_Limits.Native_String_Size) := 0;
         Reply := A11y.Linux.ATSPi_Document.Handle_Method
           (Session, To_String (Path), "IsLandmark", "",
            Snapshot, Invalid_Limits);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Document.Error_Reply
            and then Reply.Status = A11y.Results.Invalid_Argument,
            "Linux AT-SPI Document method layer rejects invalid limit configs");
      end;

      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "unknown", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.Error_Reply
         and then Reply.Status = A11y.Results.Unsupported_Property,
         "Linux AT-SPI Document method layer rejects unsupported attributes");

      A11y.Trees.Set_Root (Snapshot.Tree, Root_Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Root_Node, Hidden_Node, Result);
      A11y.Trees.Attach (Snapshot.Tree, Hidden_Node, Node, Result);
      Snapshot.Root := Root_Node;
      Snapshot.Use_Tree_Projection := True;
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Hidden_Node)) :=
          A11y.Nodes.Hide_Node_And_Subtree;
      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetLocale", "", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Document method layer rejects hidden document nodes");
      Snapshot.Exposure
        (A11y.Node_Ids.To_Natural (Hidden_Node)) :=
          A11y.Nodes.Expose_Node;
      Snapshot.Use_Tree_Projection := False;

      Snapshot.Metadata.Heading_Level := 99;
      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetAttributeValue", "heading-level",
         Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.Error_Reply
         and then Reply.Status = A11y.Results.Invalid_Range,
         "Linux AT-SPI Document method layer validates heading levels");

      Snapshot.Defunct := True;
      Reply := A11y.Linux.ATSPi_Document.Handle_Method
        (Session, To_String (Path), "GetLocale", "", Snapshot);
      Check
        (Reply.Kind = A11y.Linux.ATSPi_Document.Error_Reply
         and then Reply.Status = A11y.Results.Node_Unavailable,
         "Linux AT-SPI Document method layer rejects defunct snapshots");
   end;

   declare
      States : A11y.States.State_Set := A11y.States.Empty_State_Set;
      Mapped : A11y.Linux.ATSPi_Mappings.ATSPI_State_Set;
   begin
      declare
         Snapshot : A11y.Semantic_Snapshots.Semantic_Snapshot;
         Node : constant A11y.Node_Ids.Node_Id :=
           A11y.Node_Ids.From_Natural (1_950);
         Caps : A11y.Capabilities.Capability_Set :=
           A11y.Capabilities.Empty_Capability_Set;
         Result : A11y.Results.Result;
         Metadata : A11y.Semantic_Snapshots.Node_Metadata;
      begin
         A11y.Semantic_Snapshots.Set_Node
           (Snapshot,
            Node,
            A11y.Roles.Window,
            "Snapshot Window",
            A11y.States.Empty_State_Set,
            Caps,
            A11y.Nodes.Expose_Node,
            Result);
         Check
           (Result.Status = A11y.Results.Unsupported_Capability
            and then not A11y.Semantic_Snapshots.Has_Node
              (Snapshot, Node),
            "semantic snapshots reject incompatible role metadata without mutation");

         Caps (A11y.Capabilities.Surface) := True;
         A11y.Semantic_Snapshots.Set_Node
           (Snapshot,
            Node,
            A11y.Roles.Window,
            "Snapshot Window",
            "Top-level semantic surface",
            A11y.Properties.Present ("Snapshot help"),
            A11y.Properties.Present ("Snapshot placeholder"),
            A11y.Properties.Present ("Snapshot value"),
            True,
            A11y.States.Empty_State_Set,
            Caps,
            A11y.Nodes.Expose_Node,
            Result);
         Metadata := A11y.Semantic_Snapshots.Metadata (Snapshot, Node);
         Check
           (A11y.Results.Succeeded (Result)
            and then A11y.Semantic_Snapshots.Has_Node (Snapshot, Node)
            and then Metadata.Present
            and then Metadata.Role = A11y.Roles.Window
            and then To_String (Metadata.Name.Value) = "Snapshot Window"
            and then To_String (Metadata.Description.Value) =
              "Top-level semantic surface"
            and then To_String (Metadata.Help_Text.Value) = "Snapshot help"
            and then To_String (Metadata.Placeholder.Value) =
              "Snapshot placeholder"
            and then To_String (Metadata.Value_Text.Value) = "Snapshot value"
            and then Metadata.Protected_Value_Text
            and then Metadata.Bounds.Status = A11y.Properties.Unsupported
            and then A11y.Results.Succeeded
              (A11y.Semantic_Snapshots.Validate_Node (Snapshot, Node)),
            "semantic snapshots store validated per-node semantic metadata");

         A11y.Semantic_Snapshots.Set_Node
           (Snapshot,
            Node,
            A11y.Roles.Window,
            "Snapshot Window",
            "Top-level semantic surface",
            A11y.Properties.Present ("Snapshot help"),
            A11y.Properties.Present ("Snapshot placeholder"),
            A11y.Properties.Present ("Snapshot value"),
            True,
            A11y.Properties.Present
              ((Origin => (X => 10, Y => 20),
                Extent => (Width => 300, Height => 200))),
            A11y.Properties.Present ("snapshot-window-id"),
            A11y.Properties.Present ("Snapshot Visible Title"),
            A11y.Properties.Present ("Alt+S"),
            A11y.Properties.Present ("fr-CA"),
            A11y.Properties.Present ("horizontal"),
            A11y.Properties.Present ("main"),
            A11y.States.Empty_State_Set,
            Caps,
            A11y.Nodes.Expose_Node,
            Result);
         Metadata := A11y.Semantic_Snapshots.Metadata (Snapshot, Node);
         Check
           (A11y.Results.Succeeded (Result)
            and then Metadata.Bounds.Status = A11y.Properties.Present
            and then Metadata.Bounds.Value.Origin.X = 10
            and then Metadata.Bounds.Value.Origin.Y = 20
            and then Metadata.Bounds.Value.Extent.Width = 300
            and then Metadata.Bounds.Value.Extent.Height = 200
            and then Metadata.Semantic_Identifier.Status =
              A11y.Properties.Present
            and then To_String (Metadata.Semantic_Identifier.Value) =
              "snapshot-window-id"
            and then Metadata.Visible_Title.Status = A11y.Properties.Present
            and then To_String (Metadata.Visible_Title.Value) =
              "Snapshot Visible Title"
            and then Metadata.Keyboard_Shortcut.Status =
              A11y.Properties.Present
            and then To_String (Metadata.Keyboard_Shortcut.Value) = "Alt+S"
            and then Metadata.Locale.Status = A11y.Properties.Present
            and then To_String (Metadata.Locale.Value) = "fr-CA"
            and then Metadata.Orientation.Status = A11y.Properties.Present
            and then To_String (Metadata.Orientation.Value) = "horizontal"
            and then Metadata.Landmark.Status = A11y.Properties.Present
            and then To_String (Metadata.Landmark.Value) = "main",
            "semantic snapshots store typed per-node title, shortcut, locale, orientation, landmark, bounds, and identifiers");

         A11y.Semantic_Snapshots.Clear_Node (Snapshot, Node, Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then not A11y.Semantic_Snapshots.Has_Node (Snapshot, Node)
            and then A11y.Semantic_Snapshots.Validate_Node
              (Snapshot, Node).Status = A11y.Results.Node_Unavailable,
            "semantic snapshots clear per-node metadata deterministically");
      end;

      declare
         Session : constant A11y.Native_Identity.Backend_Session_Id :=
           A11y.Native_Identity.Create_Session;
         Root : constant A11y.Node_Ids.Node_Id :=
           A11y.Node_Ids.From_Natural (1_960);
         Child : constant A11y.Node_Ids.Node_Id :=
           A11y.Node_Ids.From_Natural (1_961);
         Result : A11y.Results.Result;
         Root_Path : Unbounded_String;
         Child_Path : Unbounded_String;
         Caps : A11y.Capabilities.Capability_Set :=
           A11y.Capabilities.Empty_Capability_Set;
         Snapshot : A11y.Linux.ATSPi_Accessible.Accessible_Snapshot;
         Reply : A11y.Linux.ATSPi_Accessible.Accessible_Reply;

         function Has_Attribute
           (Items : A11y.Linux.ATSPi_Accessible.Attribute_Entry_Vectors.Vector;
            Key   : String;
            Value : String)
            return Boolean
         is
         begin
            for Item of Items loop
               if To_String (Item.Key) = Key
                 and then To_String (Item.Value) = Value
               then
                  return True;
               end if;
            end loop;
            return False;
         end Has_Attribute;

         function Has_Attribute_Key
           (Items : A11y.Linux.ATSPi_Accessible.Attribute_Entry_Vectors.Vector;
            Key   : String)
            return Boolean
         is
         begin
            for Item of Items loop
               if To_String (Item.Key) = Key then
                  return True;
               end if;
            end loop;
            return False;
         end Has_Attribute_Key;

         function Has_Interface
           (Items : A11y.Linux.DBus_Codec.String_Vectors.Vector;
            Name  : String)
            return Boolean
         is
         begin
            for Item of Items loop
               if To_String (Item) = Name then
                  return True;
               end if;
            end loop;
            return False;
         end Has_Interface;
      begin
         Root_Path := A11y.Linux.ATSPi_Objects.Object_Path
           (Session, Root, Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI metadata fixture builds a root object path");
         Child_Path := A11y.Linux.ATSPi_Objects.Object_Path
           (Session, Child, Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI metadata fixture builds a child object path");

         Snapshot.Id := Root;
         Snapshot.Root := Root;
         Snapshot.Role := A11y.Roles.Application;
         Snapshot.Name := To_Unbounded_String ("Root Application");
         Snapshot.Children.Append (Child);
         Snapshot.Child_Count := 1;
         Snapshot.Use_Node_Metadata := True;
         A11y.Semantic_Snapshots.Set_Node
           (Snapshot.Nodes,
            Root,
            A11y.Roles.Application,
            "Root Application",
            A11y.States.Empty_State_Set,
            A11y.Capabilities.Empty_Capability_Set,
            A11y.Nodes.Expose_Node,
            Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI metadata fixture stores root node metadata");

         Caps (A11y.Capabilities.Action) := True;
         Caps (A11y.Capabilities.Surface) := True;
         A11y.Semantic_Snapshots.Set_Node
           (Snapshot     => Snapshot.Nodes,
            Node         => Child,
            Role         => A11y.Roles.Window,
            Name         => "Snapshot Child Window",
            Description  => "Metadata-backed child surface",
            Help_Text    => A11y.Properties.Present ("Metadata child help"),
            Placeholder  => A11y.Properties.Present
              ("Metadata child placeholder"),
            Value_Text   => A11y.Properties.Present ("Metadata child value"),
            Protected_Value_Text => False,
            Bounds       =>
              (Status => A11y.Properties.Unsupported,
               Value  => A11y.Geometry.Empty_Rectangle),
            Semantic_Identifier =>
              A11y.Properties.Present ("metadata-atspi-id"),
            Visible_Title =>
              A11y.Properties.Present ("Metadata child title"),
            Keyboard_Shortcut => A11y.Properties.Present ("Alt+A"),
            Locale       => A11y.Properties.Present ("fr-CA"),
            Orientation  => A11y.Properties.Present ("horizontal"),
            Landmark     => A11y.Properties.Present ("main"),
            States       => A11y.States.Empty_State_Set,
            Capabilities => Caps,
            Exposure     => A11y.Nodes.Expose_Node,
            Result       => Result);
         Check
           (A11y.Results.Succeeded (Result),
            "Linux AT-SPI metadata fixture stores child node metadata");

         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Child_Path), "GetName", Snapshot);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Accessible.String_Reply
            and then To_String (Reply.Text) = "Snapshot Child Window",
            "Linux AT-SPI Accessible resolves child names from semantic metadata snapshot");

         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Child_Path), "GetRole", Snapshot);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Accessible.Role_Reply
            and then Reply.Role = A11y.Linux.ATSPi_Mappings.Window,
            "Linux AT-SPI Accessible resolves child roles from semantic metadata snapshot");

         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Child_Path), "GetInterfaces", Snapshot);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Accessible.String_Array_Reply
            and then Has_Interface
              (Reply.Strings,
               A11y.Linux.ATSPi_Objects.Interface_Name
                 (A11y.Linux.ATSPi_Objects.Action))
            and then Has_Interface
              (Reply.Strings,
               A11y.Linux.ATSPi_Objects.Interface_Name
                 (A11y.Linux.ATSPi_Objects.Surface)),
            "Linux AT-SPI Accessible resolves child interfaces from semantic metadata snapshot");

         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Child_Path), "GetAttributes", Snapshot);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Accessible.Attribute_Set_Reply
            and then Has_Attribute
              (Reply.Attributes, "help-text", "Metadata child help")
            and then Has_Attribute
              (Reply.Attributes, "placeholder-text",
               "Metadata child placeholder")
            and then Has_Attribute
              (Reply.Attributes, "accessible-value",
               "Metadata child value")
            and then Has_Attribute
              (Reply.Attributes, "semantic-identifier",
               "metadata-atspi-id")
            and then Has_Attribute
              (Reply.Attributes, "visible-title", "Metadata child title")
            and then Has_Attribute
              (Reply.Attributes, "keyboard-shortcut", "Alt+A")
            and then Has_Attribute
              (Reply.Attributes, "locale", "fr-CA")
            and then Has_Attribute
              (Reply.Attributes, "orientation", "horizontal")
            and then Has_Attribute
              (Reply.Attributes, "landmark", "main"),
            "Linux AT-SPI Accessible resolves child attributes from semantic metadata snapshot");

         A11y.Semantic_Snapshots.Set_Node
           (Snapshot     => Snapshot.Nodes,
            Node         => Child,
            Role         => A11y.Roles.Window,
            Name         => "Snapshot Child Window",
            Description  => "Metadata-backed child surface",
            Help_Text    => A11y.Properties.Present ("Metadata child help"),
            Placeholder  => A11y.Properties.Present
              ("Metadata child placeholder"),
            Value_Text   => A11y.Properties.Present ("Secret child value"),
            Protected_Value_Text => True,
            Bounds       =>
              (Status => A11y.Properties.Unsupported,
               Value  => A11y.Geometry.Empty_Rectangle),
            Semantic_Identifier =>
              A11y.Properties.Present ("metadata-atspi-id"),
            Visible_Title =>
              A11y.Properties.Present ("Metadata child title"),
            Keyboard_Shortcut => A11y.Properties.Present ("Alt+A"),
            Locale       => A11y.Properties.Present ("fr-CA"),
            Orientation  => A11y.Properties.Present ("horizontal"),
            Landmark     => A11y.Properties.Present ("main"),
            States       => A11y.States.Empty_State_Set,
            Capabilities => Caps,
            Exposure     => A11y.Nodes.Expose_Node,
            Result       => Result);
         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Child_Path), "GetAttributes", Snapshot);
         Check
           (A11y.Results.Succeeded (Result)
            and then Reply.Kind =
              A11y.Linux.ATSPi_Accessible.Attribute_Set_Reply
            and then Has_Attribute
              (Reply.Attributes, "placeholder-text",
               "Metadata child placeholder")
            and then not Has_Attribute_Key
              (Reply.Attributes, "accessible-value"),
            "Linux AT-SPI Accessible suppresses protected child value text from semantic metadata snapshot");

         Snapshot.Use_Node_Metadata := False;
         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Child_Path), "GetName", Snapshot);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Accessible.Error_Reply
            and then Reply.Status = A11y.Results.Node_Unavailable,
            "Linux AT-SPI Accessible rejects child object paths without semantic metadata snapshot");

         Reply := A11y.Linux.ATSPi_Accessible.Handle_Method
           (Session, To_String (Root_Path), "GetName", Snapshot);
         Check
           (Reply.Kind = A11y.Linux.ATSPi_Accessible.String_Reply
            and then To_String (Reply.Text) = "Root Application",
            "Linux AT-SPI Accessible keeps direct root snapshots working");
      end;

      Check
        (A11y.Linux.ATSPi_Mappings.Map_Role (A11y.Roles.Button)
         = A11y.Linux.ATSPi_Mappings.Push_Button,
         "Linux AT-SPI mapper maps neutral button role");
      Check
        (A11y.Linux.ATSPi_Mappings.Map_Role (A11y.Roles.Password_Field)
         = A11y.Linux.ATSPi_Mappings.Password_Text,
         "Linux AT-SPI mapper maps password field role");

      States (A11y.States.Focused) := True;
      States (A11y.States.Enabled) := True;
      Mapped := A11y.Linux.ATSPi_Mappings.Map_States (States);
      Check
        (Mapped (A11y.Linux.ATSPi_Mappings.Focused)
         and then Mapped (A11y.Linux.ATSPi_Mappings.Enabled),
         "Linux AT-SPI mapper maps neutral state sets");

      Check
        (A11y.Linux.ATSPi_Mappings.Map_Relation
           (A11y.Relations.Labelled_By)
         = A11y.Linux.ATSPi_Mappings.Labelled_By
         and then A11y.Linux.ATSPi_Mappings.Map_Relation
           (A11y.Relations.Active_Descendant)
         = A11y.Linux.ATSPi_Mappings.Active_Descendant,
         "Linux AT-SPI mapper maps neutral relation kinds");

      Check
        (A11y.Linux.ATSPi_Mappings.Event_Name
           (A11y.Events.Focus_Changed) = "object:state-changed:focused",
         "Linux AT-SPI mapper maps focus events");

      for Role in A11y.Roles.Role loop
         Check
           (A11y.Linux.ATSPi_Mappings.Map_Role (Role)
            /= A11y.Linux.ATSPi_Mappings.Invalid,
            "Linux AT-SPI mapper covers every semantic role");
      end loop;

      for Relation in A11y.Relations.Relation_Kind loop
         declare
            Mapped : constant A11y.Linux.ATSPi_Mappings.ATSPI_Relation :=
              A11y.Linux.ATSPi_Mappings.Map_Relation (Relation);
            Expected : constant A11y.Linux.ATSPi_Mappings.ATSPI_Relation :=
              (case Relation is
                 when A11y.Relations.Labelled_By =>
                   A11y.Linux.ATSPi_Mappings.Labelled_By,
                 when A11y.Relations.Label_For =>
                   A11y.Linux.ATSPi_Mappings.Label_For,
                 when A11y.Relations.Described_By =>
                   A11y.Linux.ATSPi_Mappings.Described_By,
                 when A11y.Relations.Description_For =>
                   A11y.Linux.ATSPi_Mappings.Description_For,
                 when A11y.Relations.Controlled_By =>
                   A11y.Linux.ATSPi_Mappings.Controlled_By,
                 when A11y.Relations.Controller_For =>
                   A11y.Linux.ATSPi_Mappings.Controller_For,
                 when A11y.Relations.Flows_To =>
                   A11y.Linux.ATSPi_Mappings.Flows_To,
                 when A11y.Relations.Flows_From =>
                   A11y.Linux.ATSPi_Mappings.Flows_From,
                 when A11y.Relations.Member_Of =>
                   A11y.Linux.ATSPi_Mappings.Member_Of,
                 when A11y.Relations.Details =>
                   A11y.Linux.ATSPi_Mappings.Details,
                 when A11y.Relations.Details_For =>
                   A11y.Linux.ATSPi_Mappings.Details_For,
                 when A11y.Relations.Error_Message =>
                   A11y.Linux.ATSPi_Mappings.Error_Message,
                 when A11y.Relations.Error_For =>
                   A11y.Linux.ATSPi_Mappings.Error_For,
                 when A11y.Relations.Active_Descendant =>
                   A11y.Linux.ATSPi_Mappings.Active_Descendant,
                 when A11y.Relations.Embedded_By =>
                   A11y.Linux.ATSPi_Mappings.Embedded_By,
                 when A11y.Relations.Embeds =>
                   A11y.Linux.ATSPi_Mappings.Embeds,
                 when A11y.Relations.Popup_For =>
                   A11y.Linux.ATSPi_Mappings.Popup_For,
                 when A11y.Relations.Popup_Controlled_By =>
                   A11y.Linux.ATSPi_Mappings.Popup_Controlled_By);
         begin
            Check
              (Mapped = Expected,
               "Linux AT-SPI mapper covers every semantic relation");
         end;
      end loop;
   end;

   A11ykit_Test_Support.Finish;
   end Run;
begin
   A11ykit_Test_Support.Raise_Main_Stack_Limit;
   Run;
end A11ykit_Tests;
