      Outgoing : A11y.Linux.DBus_Messages.Outgoing_Message;
      Result : A11y.Results.Result;
   begin
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Native_String_Size,
         64,
         Result);
      Check
        (A11y.Results.Succeeded (Result),
         "Linux D-Bus envelope fixture sets native string limit");

      Call.Session := Session;
      Call.Object_Path := To_Unbounded_String ("/");
      Call.Interface_Name := To_Unbounded_String ("a.b");
      Call.Method_Name := To_Unbounded_String ("m");
      Incoming.Header :=
        (Kind           => A11y.Linux.DBus_Messages.Method_Call,
         Serial         => 41,
         Reply_Serial   => 0,
         Object_Path    => Call.Object_Path,
         Interface_Name => Call.Interface_Name,
         Member_Name    => Call.Method_Name,
         Error_Name     => Null_Unbounded_String,
         Sender_Name    => Null_Unbounded_String);
      Incoming.Call := Call;

      Check
        (A11y.Results.Succeeded
           (A11y.Linux.DBus_Messages.Validate_Call (Incoming, Limits)),
         "Linux D-Bus message envelope accepts configured-limit calls");

      declare
         Invalid_Limits : A11y.Resource_Limits.Resource_Limit_Config :=
           Limits;
         Stale_Incoming : A11y.Linux.DBus_Messages.Incoming_Call :=
           Incoming;
      begin
         Invalid_Limits.Limits
           (A11y.Resource_Limits.Native_String_Size) := 0;
         Stale_Incoming.Call.Session :=
           A11y.Native_Identity.No_Session;
         Check
           (A11y.Linux.DBus_Messages.Validate_Call
              (Stale_Incoming, Invalid_Limits).Status =
              A11y.Results.Invalid_Argument,
            "Linux D-Bus message envelope rejects invalid limit configs before session lookup");
      end;

      Incoming.Header.Interface_Name := Null_Unbounded_String;
      Incoming.Call.Interface_Name := Incoming.Header.Interface_Name;
      Check
        (A11y.Linux.DBus_Messages.Validate_Call (Incoming, Limits).Status
         = A11y.Results.Invalid_Argument,
         "Linux D-Bus message envelope rejects empty incoming method interfaces");

      Incoming.Header.Interface_Name := To_Unbounded_String ("a.b");
      Incoming.Call.Interface_Name := Incoming.Header.Interface_Name;
      Incoming.Header.Member_Name := To_Unbounded_String (Long_Text);
      Incoming.Call.Method_Name := Incoming.Header.Member_Name;
      Check
        (A11y.Linux.DBus_Messages.Validate_Call (Incoming, Limits).Status
         = A11y.Results.Resource_Limit,
         "Linux D-Bus message envelope enforces configured member limits");

      Incoming.Header.Member_Name := To_Unbounded_String ("m");
      Incoming.Call.Method_Name := Incoming.Header.Member_Name;
      Incoming.Call.Method_Name := To_Unbounded_String (Long_Text);
      Check
        (A11y.Linux.DBus_Messages.Validate_Call (Incoming, Limits).Status
         = A11y.Results.Resource_Limit,
         "Linux D-Bus message envelope enforces configured body method limits");

      Incoming.Call.Method_Name := Incoming.Header.Member_Name;
      Incoming.Call.Attribute := To_Unbounded_String (Long_Text);
      Check
        (A11y.Linux.DBus_Messages.Validate_Call (Incoming, Limits).Status
         = A11y.Results.Resource_Limit,
         "Linux D-Bus message envelope enforces configured body argument limits");

      Incoming.Call.Attribute := Null_Unbounded_String;
      Outgoing := A11y.Linux.DBus_Messages.Build_Reply
        (Incoming, Boundary_Reply, 42, Limits, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Outgoing.Kind = A11y.Linux.DBus_Messages.Error_Return
         and then To_String (Outgoing.Error_Name) =
           A11y.Linux.ATSPi_Objects.Error_Name
             (A11y.Results.Resource_Limit),
         "Linux D-Bus message envelope preserves stable error names under configured limits");
   end;

   declare
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Snapshot : A11y.Linux.ATSPi_Cache.Cache_Snapshot;
      Result : A11y.Results.Result;
