              (Result.Status = A11y.Results.Invalid_Argument
               and then Invalid_Frame.Serial = 0,
               "Linux D-Bus message envelope rejects invalid error-return names before frame build");

            Invalid_Envelope :=
              A11y.Linux.DBus_Messages.Build_Transport_Envelope
                (A11y.Linux.DBus_Messages.Outgoing_Message'
                   (Kind         => A11y.Linux.DBus_Messages.Error_Return,
                    Serial       => 39,
                    Reply_Serial => 31,
                    Status       => A11y.Results.Invalid_Argument,
                    Object_Path  => Null_Unbounded_String,
                    Error_Name   => To_Unbounded_String ("org.invalid-name")),
                 Result);
            Check
              (Result.Status = A11y.Results.Invalid_Argument
               and then Invalid_Envelope.Serial = 0,
               "Linux D-Bus message envelope rejects invalid outgoing error-return names");

            if Name_Offset > 0 and then Error_Name_Text'Length > 4 then
               Replace_Element (Invalid_Packet, Name_Offset + 3, '-');
               Decoded_Error :=
                 A11y.Linux.DBus_Messages.Decode_Error_Return
                   (Invalid_Packet, Result);
               Check
                 (Result.Status = A11y.Results.Invalid_Argument
                  and then Decoded_Error.Serial = 0,
                  "Linux D-Bus message envelope rejects decoded error-return names with invalid grammar");
            else
               Check
                 (False,
                  "Linux D-Bus message envelope fixture locates serialized error names");
            end if;

            Decoded_Error := Error_Envelope;
            Decoded_Error.Error_Name :=
              To_Unbounded_String ("org.invalid-name");
            Diagnostic :=
              A11y.Linux.DBus_Messages.Diagnostic_For_Error_Return
                (Decoded_Error, Result);
            Check
              (Result.Status = A11y.Results.Invalid_Argument,
               "Linux D-Bus error-return diagnostics reject invalid error names");
         end;
      end;

      Outgoing := A11y.Linux.DBus_Messages.Build_Method_Call
        (Object_Path    => To_Unbounded_String ("/org/a11y/atspi/registry"),
         Interface_Name => To_Unbounded_String ("org.a11y.atspi.Registry"),
         Member_Name    => To_Unbounded_String ("RegisterEvent"),
         Object_Path_Argument => Path,
         Serial         => 34,
         Result         => Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Outgoing.Kind = A11y.Linux.DBus_Messages.Method_Call
         and then Outgoing.Serial = 34
         and then Outgoing.Reply_Serial = 0
         and then Outgoing.Has_Object_Path_Argument
         and then Outgoing.Object_Path_Argument = Path,
         "Linux D-Bus message envelope builds outgoing method calls");

      Envelope := A11y.Linux.DBus_Messages.Build_Transport_Envelope
        (Outgoing, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Envelope.Kind = A11y.Linux.DBus_Messages.Method_Call
         and then Envelope.Serial = 34
         and then Envelope.Object_Path =
           To_Unbounded_String ("/org/a11y/atspi/registry")
         and then Envelope.Interface_Name =
           To_Unbounded_String ("org.a11y.atspi.Registry")
         and then Envelope.Member_Name =
           To_Unbounded_String ("RegisterEvent")
         and then Envelope.Body_Signature = To_Unbounded_String ("o")
         and then Envelope.Body_Object_Path_Argument = Path,
         "Linux D-Bus message envelope normalizes method calls for transport");

      Outgoing := A11y.Linux.DBus_Messages.Build_Method_Call_Object_Reference
        (Object_Path     => To_Unbounded_String ("/org/a11y/atspi/root"),
         Interface_Name  => To_Unbounded_String ("org.a11y.atspi.Socket"),
         Member_Name     => To_Unbounded_String ("Embed"),
         Bus_Name        => To_Unbounded_String (":1.88"),
         Reference_Path  => Path,
         Serial          => 35,
         Result          => Result);
      Outgoing.String_Argument := To_Unbounded_String ("1.invalid");
      Envelope := A11y.Linux.DBus_Messages.Build_Transport_Envelope
        (Outgoing, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Envelope.Serial = 0
         and then Length (Envelope.Body_Signature) = 0,
         "Linux D-Bus message envelope rejects mutated object-reference bus names");

      Outgoing := A11y.Linux.DBus_Messages.Build_Method_Call
        (Object_Path    => To_Unbounded_String ("/org/a11y/atspi/registry"),
         Interface_Name => To_Unbounded_String ("org.a11y.atspi.Registry"),
         Member_Name    => To_Unbounded_String ("RegisterEvent"),
         Object_Path_Argument => Path,
         Serial         => 35,
         Result         => Result);
      Outgoing.Interface_Name := To_Unbounded_String ("org.invalid-name");
      Envelope := A11y.Linux.DBus_Messages.Build_Transport_Envelope
        (Outgoing, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Envelope.Serial = 0,
         "Linux D-Bus message envelope rejects mutated method interfaces");

      Outgoing := A11y.Linux.DBus_Messages.Build_Method_Call
        (Object_Path    => To_Unbounded_String ("/org/a11y/atspi/registry"),
         Interface_Name => To_Unbounded_String ("org.a11y.atspi.Registry"),
         Member_Name    => To_Unbounded_String ("RegisterEvent"),
         Object_Path_Argument => Path,
         Serial         => 35,
         Result         => Result);
      Outgoing.Member_Name := To_Unbounded_String ("Register-Event");
      Envelope := A11y.Linux.DBus_Messages.Build_Transport_Envelope
        (Outgoing, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Envelope.Serial = 0,
         "Linux D-Bus message envelope rejects mutated method members");

      Outgoing := A11y.Linux.DBus_Messages.Build_Method_Call
        (Object_Path    => To_Unbounded_String ("/org/a11y/atspi/registry"),
         Interface_Name => To_Unbounded_String ("org.a11y.atspi.Registry"),
         Member_Name    => To_Unbounded_String ("RegisterEvent"),
         Object_Path_Argument => Path,
         Serial         => 34,
         Result         => Result);
      Envelope := A11y.Linux.DBus_Messages.Build_Transport_Envelope
        (Outgoing, Result);

      Frame := A11y.Linux.DBus_Messages.Build_Transport_Frame_Metadata
        (Envelope, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Frame.Kind = A11y.Linux.DBus_Messages.Method_Call
         and then Frame.Serial = 34
         and then Frame.Header_Field_Count = 5
         and then Frame.Body_Field_Count = 1
         and then Frame.Body_Text_Bytes = Length (Path)
         and then Frame.Estimated_Bytes >= Frame.Header_Text_Bytes
           + Frame.Body_Text_Bytes,
         "Linux D-Bus message envelope builds bounded transport frame metadata");

      Byte_Frame := A11y.Linux.DBus_Messages.Build_Transport_Frame
        (Envelope, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Byte_Frame.Metadata.Serial = 34
         and then Length (Byte_Frame.Header_Bytes) > 16
         and then Length (Byte_Frame.Header_Bytes) mod 8 = 0
         and then Length (Byte_Frame.Body_Bytes) >= Length (Path) + 5
         and then Character'Pos (To_String (Byte_Frame.Header_Bytes) (1)) =
           Character'Pos ('l')
         and then Character'Pos (To_String (Byte_Frame.Header_Bytes) (2)) = 1
         and then Character'Pos (To_String (Byte_Frame.Body_Bytes) (1)) =
           Length (Path)
         and then To_String (Byte_Frame.Body_Bytes) (5) = '/',
         "Linux D-Bus message envelope builds bounded transport frame bytes");

      Packet := A11y.Linux.DBus_Messages.Build_Transport_Packet
        (Byte_Frame, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Packet.Metadata.Serial = 34
         and then Length (Packet.Bytes) =
           Length (Byte_Frame.Header_Bytes) + Length (Byte_Frame.Body_Bytes)
         and then To_String (Packet.Bytes) (1 .. 4) =
           To_String (Byte_Frame.Header_Bytes) (1 .. 4)
         and then To_String (Packet.Bytes)
           (Length (Byte_Frame.Header_Bytes) + 5) = '/',
         "Linux D-Bus message envelope builds bounded transport packets");

      Packet_Header := A11y.Linux.DBus_Messages.Decode_Transport_Packet_Header
        (Packet.Bytes, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Packet_Header.Kind = A11y.Linux.DBus_Messages.Method_Call
         and then Packet_Header.Serial = 34
         and then Packet_Header.Body_Length = Length (Byte_Frame.Body_Bytes)
         and then Packet_Header.Header_Length =
           Length (Byte_Frame.Header_Bytes)
         and then Packet_Header.Packet_Length = Length (Packet.Bytes),
         "Linux D-Bus message envelope decodes transport packet headers");

      declare
         Raw : constant String := To_String (Packet.Bytes);
         Fixed_Header : A11y.Linux.DBus_Messages.Transport_Packet_Header;
      begin
         Fixed_Header :=
           A11y.Linux.DBus_Messages.Decode_Transport_Fixed_Header
             (To_Unbounded_String (Raw (Raw'First .. Raw'First + 15)),
              Result);
         Check
           (A11y.Results.Succeeded (Result)
            and then Fixed_Header.Kind =
              A11y.Linux.DBus_Messages.Method_Call
            and then Fixed_Header.Serial = 34
            and then Fixed_Header.Body_Length =
              Length (Byte_Frame.Body_Bytes)
            and then Fixed_Header.Header_Length =
              Length (Byte_Frame.Header_Bytes)
            and then Fixed_Header.Packet_Length = Length (Packet.Bytes),
            "Linux D-Bus message envelope decodes fixed transport headers before body reads");
