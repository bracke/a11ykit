         declare
            Invalid_Envelope : A11y.Linux.DBus_Messages.Transport_Envelope :=
              Error_Envelope;
            Invalid_Frame : A11y.Linux.DBus_Messages.Transport_Frame_Metadata;
            Invalid_Packet : Unbounded_String := Error_Packet.Bytes;
            Error_Name_Text : constant String :=
              To_String (Error_Envelope.Error_Name);
            Name_Offset : constant Natural :=
              Index (Invalid_Packet, Error_Name_Text);
