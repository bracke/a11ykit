   declare
      Metadata : A11y.Values.Value_Metadata;
      Result : A11y.Results.Result;
      Converted : Long_Float;
      Decimal_Value : constant A11y.Values.Semantic_Value :=
        A11y.Values.Exact_Decimal (Units => 1_234, Scale => 2);
   begin
      Check
        (Decimal_Value.Kind = A11y.Values.Decimal_Value
         and then Decimal_Value.Decimal_Item.Units = 1_234
         and then Decimal_Value.Decimal_Item.Scale = 2,
         "value framework stores exact decimal values without floating conversion");

      Check
        (A11y.Values.Stable_Name (A11y.Values.Decimal_Value) = "decimal"
         and then A11y.Values.Metadata (A11y.Values.Decimal_Value).Numeric
         and then A11y.Values.Stable_Name (A11y.Values.Writable) = "writable"
         and then A11y.Values.Metadata (A11y.Values.Writable).Mutable,
         "value framework exposes stable value and access metadata");

      Check
        (not A11y.Values.Metadata (A11y.Values.Unknown).Known
         and then not A11y.Values.Is_Known ((Kind => A11y.Values.Unknown))
         and then not A11y.Values.Is_Known ((Kind => A11y.Values.Indeterminate)),
         "value framework distinguishes unknown and indeterminate from known values");

      Metadata.Current := A11y.Values.Integer (5);
      Metadata.Minimum := A11y.Values.Integer (0);
      Metadata.Maximum := A11y.Values.Integer (10);
      Metadata.Small_Increment := A11y.Values.Integer (1);
      Metadata.Large_Increment := A11y.Values.Integer (5);
      Metadata.Mode := A11y.Values.Writable;
      Check
        (A11y.Values.In_Range (Metadata),
         "value framework validates numeric range metadata");
      Check
        (A11y.Results.Succeeded (A11y.Values.Validate (Metadata)),
         "value framework validates coherent value metadata");
      Check
        (A11y.Results.Succeeded
           (A11y.Values.Validate_Numeric_Set_Request
              (Metadata, A11y.Values.Integer (7))),
         "value framework validates writable numeric set requests");
      declare
         Provider : Test_Value_Provider :=
           (Metadata => Metadata,
            Set_Calls => 0,
            Last_Node => A11y.Node_Ids.No_Node,
            Last_Value => (Kind => A11y.Values.Unknown),
            Raise_On_Metadata => False,
            Raise_On_Set => False);
         Provider_Node : constant A11y.Node_Ids.Node_Id :=
           A11y.Node_Ids.From_Natural (701);
         Set_Result : A11y.Results.Result;
         Safe_Metadata : A11y.Values.Value_Metadata;
      begin
         Safe_Metadata := A11y.Values.Current_Metadata_Safely (Provider);
         Check
           (A11y.Values.Equal (Safe_Metadata.Current, A11y.Values.Integer (5))
            and then Safe_Metadata.Mode = A11y.Values.Writable,
            "value provider safely returns current semantic metadata");

         Provider.Metadata.Minimum := A11y.Values.Boolean (False);
         Safe_Metadata := A11y.Values.Current_Metadata_Safely (Provider);
         Check
           (Safe_Metadata.Current.Kind = A11y.Values.Unknown
            and then Safe_Metadata.Mode = A11y.Values.Read_Only,
            "value provider normalizes invalid metadata as read-only unknown values");
         Provider.Metadata.Minimum := A11y.Values.Integer (0);

         Set_Result :=
           A11y.Values.Set_Current_Safely
             (Provider, Provider_Node, A11y.Values.Integer (7));
         Check
           (A11y.Results.Succeeded (Set_Result)
            and then Provider.Set_Calls = 1
            and then Provider.Last_Node = Provider_Node
            and then A11y.Values.Equal
              (Provider.Last_Value, A11y.Values.Integer (7))
            and then A11y.Values.Equal
              (Provider.Metadata.Current, A11y.Values.Integer (7)),
            "value provider safely applies writable numeric set requests");

         Set_Result :=
           A11y.Values.Set_Current_Safely
             (Provider, Provider_Node, A11y.Values.Integer (11));
         Check
           (Set_Result.Status = A11y.Results.Invalid_Range
            and then Provider.Set_Calls = 1,
            "value provider rejects out-of-range values before mutation");

         Provider.Metadata.Mode := A11y.Values.Read_Only;
         Set_Result :=
           A11y.Values.Set_Current_Safely
             (Provider, Provider_Node, A11y.Values.Integer (6));
         Check
           (Set_Result.Status = A11y.Results.Read_Only
            and then Provider.Set_Calls = 1,
            "value provider rejects read-only set requests before mutation");

         Provider.Metadata.Mode := A11y.Values.Writable;
         Set_Result :=
           A11y.Values.Set_Current_Safely
             (Provider, A11y.Node_Ids.No_Node, A11y.Values.Integer (6));
         Check
           (Set_Result.Status = A11y.Results.Node_Unavailable
            and then Provider.Set_Calls = 1,
            "value provider rejects invalid node identities before mutation");

         Provider.Raise_On_Set := True;
         Set_Result :=
           A11y.Values.Set_Current_Safely
             (Provider, Provider_Node, A11y.Values.Integer (6));
         Check
           (Set_Result.Status = A11y.Results.Internal_Error
            and then Provider.Set_Calls = 1,
            "value provider contains mutation exceptions");

         Provider.Raise_On_Metadata := True;
         Safe_Metadata := A11y.Values.Current_Metadata_Safely (Provider);
         Check
           (Safe_Metadata.Current.Kind = A11y.Values.Unknown
            and then Safe_Metadata.Mode = A11y.Values.Read_Only,
            "value provider contains metadata exceptions as read-only unknown values");
      end;
      Check
        (A11y.Values.Validate_Numeric_Set_Request
           (Metadata, A11y.Values.Integer (11)).Status =
           A11y.Results.Invalid_Range,
         "value framework rejects out-of-range numeric set requests");
      Check
