      A11y.Linux.DBus_Messages.Set_Queue_Capacity (Queue, 0, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then A11y.Linux.DBus_Messages.Queue_Capacity (Queue) = 2,
         "Linux D-Bus outgoing queue rejects invalid capacity");

      A11y.Linux.DBus_Messages.Set_Queue_Capacity (Queue, 1, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Linux.DBus_Messages.Queue_Capacity (Queue) = 1,
         "Linux D-Bus outgoing queue accepts capacity matching queued messages");

      A11y.Linux.DBus_Messages.Clear (Queue);
      A11y.Linux.DBus_Messages.Dequeue (Queue, Message, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Message.Kind = A11y.Linux.DBus_Messages.Error_Return
         and then To_String (Message.Error_Name) =
           A11y.Linux.ATSPi_Objects.Error_Name
             (A11y.Results.Node_Unavailable)
         and then A11y.Linux.DBus_Messages.Queue_Length (Queue) = 0,
