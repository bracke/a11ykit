      Second : A11y.Linux.ATSPi_Object_Registry.Object_Record_Snapshot;
      Found : A11y.Linux.ATSPi_Object_Registry.Object_Record_Snapshot;
      Export : A11y.Linux.ATSPi_Object_Registry.Object_Export_Descriptor;
      Call : A11y.Linux.ATSPi_Object_Registry.Object_Call_Context;
      Stale_Call : A11y.Linux.ATSPi_Object_Registry.Object_Call_Context;
      Call_View : A11y.Linux.ATSPi_Object_Registry.Object_Call_Snapshot;
      View : A11y.Linux.ATSPi_Object_Registry.Registry_Snapshot;
      Report : A11y.Linux.ATSPi_Object_Registry.Registry_Mutation_Report;
      Call_Report :
        A11y.Linux.ATSPi_Object_Registry.Native_Call_Mutation_Report;
      Result : A11y.Results.Result;
      Generation_After_Configure : Natural;
      Generation_After_First_Ensure : Natural;
      Generation_After_Second_Ensure : Natural;
      Generation_After_Defunct : Natural;
      Generation_After_Release : Natural;
   begin
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Native_Object_Cache_Size,
         2,
         Result);
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Tombstone_Retention,
         1,
         Result);
      A11y.Linux.ATSPi_Object_Registry.Configure
        (Registry, Limits, Result);
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Check
        (A11y.Results.Succeeded (Result)
         and then View.Capacity = 2
         and then View.Tombstone_Capacity = 1
         and then View.Outstanding_Calls = 0
         and then View.Generation = 1,
         "Linux AT-SPI object registry accepts resource limits");
      Generation_After_Configure := View.Generation;

      A11y.Linux.ATSPi_Object_Registry.Ensure_Object_With_Report
        (Registry, Session, Node_1, First, Report, Result);
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Native_Object_Caches.Is_Valid (First.Object)
         and then First.Node = Node_1
         and then A11y.Native_Identity.Is_Valid (First.Session)
         and then Length (First.Path) > 0
         and then View.Generation > Generation_After_Configure
         and then First.Registry_Generation = View.Generation,
         "Linux AT-SPI object registry creates stable object records");
      Check
        (Report.Operation =
           A11y.Linux.ATSPi_Object_Registry.Registry_Ensure_Object
         and then Report.Generation_Before = Generation_After_Configure
         and then Report.Generation_After = View.Generation
         and then Report.Live_Before = 0
         and then Report.Live_After = 1
         and then Report.Object = First.Object
         and then Report.Session = Session
         and then Report.Node = Node_1
         and then Report.Status = A11y.Results.Success
         and then Report.Generation_Advanced
         and then Report.Live_Changed
         and then not Report.Tombstone_Changed
         and then not Report.Outstanding_Changed
         and then Report.Object_Returned,
         "Linux AT-SPI object registry reports object creation mutation details");
      Generation_After_First_Ensure := View.Generation;

      A11y.Linux.ATSPi_Object_Registry.Ensure_Object_With_Report
        (Registry, Session, Node_1, Found, Report, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Found.Object = First.Object
         and then Found.Registry_Generation = Generation_After_First_Ensure
         and then A11y.Linux.ATSPi_Object_Registry.Snapshot
           (Registry).Generation = Generation_After_First_Ensure,
         "Linux AT-SPI object registry treats repeated ensure as idempotent");
      Check
        (Report.Operation =
           A11y.Linux.ATSPi_Object_Registry.Registry_Ensure_Object
         and then Report.Generation_Before = Generation_After_First_Ensure
         and then Report.Generation_After = Generation_After_First_Ensure
         and then Report.Object = First.Object
         and then Report.Node = Node_1
         and then Report.Status = A11y.Results.Success
         and then not Report.Generation_Advanced
         and then not Report.Live_Changed
         and then not Report.Tombstone_Changed
         and then Report.Object_Returned,
         "Linux AT-SPI object registry reports idempotent ensure without mutation");

      A11y.Linux.ATSPi_Object_Registry.Export_Descriptor
        (Registry, Session, First.Object, Export);
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Check
        (Export.Exportable
         and then Export.Status = A11y.Results.Success
         and then Export.Object = First.Object
         and then Export.Session = Session
         and then Export.Node = Node_1
         and then To_String (Export.Path) = To_String (First.Path)
         and then not Export.Defunct
         and then not Export.Released
         and then Export.Registry_Generation = Generation_After_First_Ensure
         and then View.Live_Count = 1,
         "Linux AT-SPI object registry exports D-Bus object descriptors without materialization");

      A11y.Linux.ATSPi_Object_Registry.Export_Descriptor
        (Registry, Other_Session, First.Object, Export);
      Check
        (not Export.Exportable
         and then Export.Status = A11y.Results.Node_Unavailable
         and then not Export.Defunct
         and then Export.Object = A11y.Native_Object_Caches.No_Object
         and then A11y.Linux.ATSPi_Object_Registry.Snapshot
           (Registry).Generation = Generation_After_First_Ensure,
         "Linux AT-SPI object registry rejects cross-session export descriptors");

      A11y.Linux.ATSPi_Object_Registry.Resolve_Path
        (Registry, Session, To_String (First.Path), Found, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Found.Object = First.Object
         and then Found.Node = Node_1
         and then Found.Registry_Generation = Generation_After_First_Ensure
         and then A11y.Linux.ATSPi_Object_Registry.Snapshot
           (Registry).Generation = Generation_After_First_Ensure,
         "Linux AT-SPI object registry resolves D-Bus paths to native records");

      A11y.Linux.ATSPi_Object_Registry.Resolve_Path
        (Registry, Other_Session, To_String (First.Path), Found, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then A11y.Linux.ATSPi_Object_Registry.Snapshot
           (Registry).Generation = Generation_After_First_Ensure,
         "Linux AT-SPI object registry rejects cross-session paths");

      A11y.Linux.ATSPi_Object_Registry.Resolve_Path
        (Registry, Session, "not/a/path", Found, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then A11y.Linux.ATSPi_Object_Registry.Snapshot
           (Registry).Generation = Generation_After_First_Ensure,
         "Linux AT-SPI object registry rejects malformed paths");

      A11y.Linux.ATSPi_Object_Registry.Ensure_Object
        (Registry, Session, Node_2, Second, Result);
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Native_Object_Caches.Is_Valid (Second.Object)
         and then View.Generation > Generation_After_First_Ensure
         and then Second.Registry_Generation = View.Generation,
         "Linux AT-SPI object registry admits a second live object");
      Generation_After_Second_Ensure := View.Generation;

      A11y.Linux.ATSPi_Object_Registry.Begin_Native_Call_With_Report
        (Registry, Session, Second.Object, Call, Call_Report, Result);
      Stale_Call := Call;
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Call_View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Call);
      Check
        (A11y.Results.Succeeded (Result)
         and then View.Outstanding_Calls = 1
         and then View.Generation = Generation_After_Second_Ensure
         and then Call_View.Active
         and then Call_View.Object = Second.Object
         and then Call_View.Session = Session
         and then Call_View.Node = Node_2
         and then Call_View.Registry_Generation =
           Generation_After_Second_Ensure,
         "Linux AT-SPI object registry admits bounded native calls without registry mutation");
      Check
        (Call_Report.Operation =
           A11y.Linux.ATSPi_Object_Registry.Registry_Begin_Native_Call
         and then Call_Report.Generation_Before =
           Generation_After_Second_Ensure
         and then Call_Report.Generation_After =
           Generation_After_Second_Ensure
         and then Call_Report.Outstanding_Before = 0
         and then Call_Report.Outstanding_After = 1
         and then Call_Report.Object = Second.Object
         and then Call_Report.Session = Session
         and then Call_Report.Node = Node_2
         and then Call_Report.Context.Active
         and then Call_Report.Status = A11y.Results.Success
         and then not Call_Report.Generation_Changed
         and then Call_Report.Outstanding_Changed
         and then Call_Report.Call_Active,
         "Linux AT-SPI object registry reports native-call admission details");

      A11y.Linux.ATSPi_Object_Registry.Ensure_Object_With_Report
        (Registry, Session, Node_3, Found, Report, Result);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then A11y.Linux.ATSPi_Object_Registry.Snapshot
           (Registry).Generation = Generation_After_Second_Ensure,
         "Linux AT-SPI object registry enforces configured capacity");
      Check
        (Report.Operation =
           A11y.Linux.ATSPi_Object_Registry.Registry_Ensure_Object
         and then Report.Generation_Before = Generation_After_Second_Ensure
         and then Report.Generation_After = Generation_After_Second_Ensure
         and then Report.Live_Before = 2
         and then Report.Live_After = 2
         and then Report.Status = A11y.Results.Resource_Limit
         and then not Report.Generation_Advanced
         and then not Report.Live_Changed
         and then not Report.Object_Returned,
         "Linux AT-SPI object registry reports resource-limit rejection");

      A11y.Linux.ATSPi_Object_Registry.Mark_Defunct_With_Report
        (Registry, Session, Node_1, Report, Result);
      A11y.Linux.ATSPi_Object_Registry.Resolve_Path
        (Registry, Session, To_String (First.Path), Found, Result);
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then View.Live_Count = 1
         and then View.Tombstones = 1
         and then View.Generation > Generation_After_Second_Ensure,
         "Linux AT-SPI object registry rejects stale defunct paths");
      Check
        (Report.Operation =
           A11y.Linux.ATSPi_Object_Registry.Registry_Mark_Defunct
         and then Report.Generation_Before = Generation_After_Second_Ensure
         and then Report.Generation_After = View.Generation
         and then Report.Live_Before = 2
         and then Report.Live_After = 1
         and then Report.Tombstones_Before = 0
         and then Report.Tombstones_After = 1
         and then Report.Object = First.Object
         and then Report.Node = Node_1
         and then Report.Status = A11y.Results.Success
         and then Report.Generation_Advanced
         and then Report.Live_Changed
         and then Report.Tombstone_Changed
         and then Report.Object_Returned,
         "Linux AT-SPI object registry reports defunct mutation details");
      Generation_After_Defunct := View.Generation;
      A11y.Linux.ATSPi_Object_Registry.Export_Descriptor
        (Registry, Session, First.Object, Export);
      Check
        (not Export.Exportable
         and then Export.Status = A11y.Results.Node_Unavailable
         and then Export.Object = First.Object
         and then Export.Session = Session
         and then Export.Node = Node_1
         and then To_String (Export.Path) = To_String (First.Path)
         and then Export.Defunct
         and then Export.Registry_Generation = Generation_After_Defunct,
         "Linux AT-SPI object registry rejects defunct export descriptors");

      A11y.Linux.ATSPi_Object_Registry.Reset_When_Drained_With_Report
        (Registry, Report, Result);
      Check
        (Result.Status = A11y.Results.Busy
         and then A11y.Linux.ATSPi_Object_Registry.Snapshot
           (Registry).Generation = Generation_After_Defunct,
         "Linux AT-SPI object registry rejects checked reset while live or pinned");
      Check
        (Report.Operation = A11y.Linux.ATSPi_Object_Registry.Registry_Reset
         and then Report.Generation_Before = Generation_After_Defunct
         and then Report.Generation_After = Generation_After_Defunct
         and then Report.Status = A11y.Results.Busy
         and then not Report.Generation_Advanced
         and then not Report.Live_Changed
         and then not Report.Tombstone_Changed,
         "Linux AT-SPI object registry reports busy checked reset without mutation");

      A11y.Linux.ATSPi_Object_Registry.Release
        (Registry, Other_Session, Second.Object, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then A11y.Linux.ATSPi_Object_Registry.Snapshot
           (Registry).Generation = Generation_After_Defunct,
         "Linux AT-SPI object registry rejects cross-session release");

      A11y.Linux.ATSPi_Object_Registry.Release_With_Report
        (Registry, Session, Second.Object, Report, Result);
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Check
        (A11y.Results.Succeeded (Result)
         and then not A11y.Linux.ATSPi_Object_Registry.Drained (Registry)
         and then View.Outstanding_Calls = 1
         and then View.Generation > Generation_After_Defunct,
         "Linux AT-SPI object registry keeps released objects pinned by native calls");
      Check
        (Report.Operation =
           A11y.Linux.ATSPi_Object_Registry.Registry_Release_Object
         and then Report.Generation_Before = Generation_After_Defunct
         and then Report.Generation_After = View.Generation
         and then Report.Live_Before = 1
         and then Report.Live_After = 0
         and then Report.Tombstones_Before = 1
         and then Report.Tombstones_After = 1
         and then Report.Outstanding_Before = 1
         and then Report.Outstanding_After = 1
         and then Report.Object = Second.Object
         and then Report.Node = Node_2
         and then Report.Status = A11y.Results.Success
         and then Report.Generation_Advanced
         and then Report.Live_Changed
         and then not Report.Tombstone_Changed
         and then not Report.Outstanding_Changed
         and then Report.Object_Returned,
         "Linux AT-SPI object registry reports release mutation details");
      Generation_After_Release := View.Generation;

      A11y.Linux.ATSPi_Object_Registry.End_Native_Call_With_Report
        (Registry, Other_Session, Second.Object, Call, Call_Report, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then A11y.Linux.ATSPi_Object_Registry.Snapshot
           (Registry).Outstanding_Calls = 1,
         "Linux AT-SPI object registry rejects cross-session native call completion");
      Check
        (Call_Report.Operation =
           A11y.Linux.ATSPi_Object_Registry.Registry_End_Native_Call
         and then Call_Report.Outstanding_Before = 1
         and then Call_Report.Outstanding_After = 1
         and then Call_Report.Object = Second.Object
         and then Call_Report.Session = Other_Session
         and then Call_Report.Status = A11y.Results.Node_Unavailable
         and then not Call_Report.Outstanding_Changed
         and then Call_Report.Call_Active,
         "Linux AT-SPI object registry reports rejected native-call completion without draining");

      A11y.Linux.ATSPi_Object_Registry.End_Native_Call_With_Report
        (Registry, Session, Second.Object, Call, Call_Report, Result);
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Call_View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Call);
      Check
        (A11y.Results.Succeeded (Result)
         and then View.Outstanding_Calls = 0
         and then A11y.Linux.ATSPi_Object_Registry.Drained (Registry)
         and then not Call_View.Active
         and then View.Generation = Generation_After_Release,
         "Linux AT-SPI object registry drains after native call completion");
      Check
        (Call_Report.Operation =
           A11y.Linux.ATSPi_Object_Registry.Registry_End_Native_Call
         and then Call_Report.Generation_Before = Generation_After_Release
         and then Call_Report.Generation_After = Generation_After_Release
         and then Call_Report.Outstanding_Before = 1
         and then Call_Report.Outstanding_After = 0
         and then Call_Report.Object = Second.Object
         and then Call_Report.Session = Session
         and then Call_Report.Node = Node_2
         and then not Call_Report.Context.Active
         and then Call_Report.Status = A11y.Results.Success
         and then not Call_Report.Generation_Changed
         and then Call_Report.Outstanding_Changed
         and then not Call_Report.Call_Active,
         "Linux AT-SPI object registry reports native-call completion details");

      A11y.Linux.ATSPi_Object_Registry.End_Native_Call_With_Report
        (Registry, Session, Second.Object, Stale_Call, Call_Report, Result);
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Call_View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Stale_Call);
      Check
        (Result.Status = A11y.Results.Invalid_State
         and then View.Outstanding_Calls = 0
         and then A11y.Linux.ATSPi_Object_Registry.Drained (Registry)
         and then not Call_View.Active
         and then View.Generation = Generation_After_Release,
         "Linux AT-SPI object registry rejects stale copied native call tokens");
      Check
        (Call_Report.Operation =
           A11y.Linux.ATSPi_Object_Registry.Registry_End_Native_Call
         and then Call_Report.Generation_Before = Generation_After_Release
         and then Call_Report.Generation_After = Generation_After_Release
         and then Call_Report.Outstanding_Before = 0
         and then Call_Report.Outstanding_After = 0
         and then Call_Report.Object = Second.Object
         and then Call_Report.Session = Session
         and then Call_Report.Status = A11y.Results.Invalid_State
         and then not Call_Report.Context.Active
         and then not Call_Report.Generation_Changed
         and then not Call_Report.Outstanding_Changed
         and then not Call_Report.Call_Active,
         "Linux AT-SPI object registry reports stale copied native call token rejection");

      A11y.Linux.ATSPi_Object_Registry.Reset_When_Drained_With_Report
        (Registry, Report, Result);
      View := A11y.Linux.ATSPi_Object_Registry.Snapshot (Registry);
      Check
        (A11y.Results.Succeeded (Result)
         and then View.Live_Count = 0
         and then View.Tombstones = 0
         and then View.Generation > Generation_After_Release,
         "Linux AT-SPI object registry checked reset clears drained records");
      Check
        (Report.Operation = A11y.Linux.ATSPi_Object_Registry.Registry_Reset
         and then Report.Generation_Before = Generation_After_Release
         and then Report.Generation_After = View.Generation
         and then Report.Live_Before = 0
         and then Report.Live_After = 0
         and then Report.Tombstones_Before = 1
         and then Report.Tombstones_After = 0
         and then Report.Outstanding_Before = 0
         and then Report.Outstanding_After = 0
         and then Report.Status = A11y.Results.Success
         and then Report.Generation_Advanced
         and then not Report.Live_Changed
         and then Report.Tombstone_Changed
         and then not Report.Object_Returned,
         "Linux AT-SPI object registry reports drained reset mutation details");
   end;

   declare
      Result : A11y.Results.Result;
      Address : A11y.Linux.ATSPi_Bus.Bus_Address;
      Context : A11y.Linux.ATSPi_Bus.Connection_Context;
      First_Session : A11y.Native_Identity.Backend_Session_Id;
      Registration : A11y.Linux.DBus_Messages.Outgoing_Message;
      Application_Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (905);
      Application_Path : Unbounded_String;
      Serial_1 : Natural;
      Serial_2 : Natural;
      Previous_Serial : Natural;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
      Queued : A11y.Linux.DBus_Messages.Outgoing_Message;
      Envelope : A11y.Linux.DBus_Messages.Transport_Envelope;
      Transport_Frame : A11y.Linux.DBus_Messages.Transport_Frame;
      Packet : A11y.Linux.DBus_Messages.Transport_Packet;
      Queue_Interest : A11y.Linux.DBus_Messages.Queue_Posting_Interest;
   begin
      Address := A11y.Linux.ATSPi_Bus.Parse_Address
        ("unix:path=/run/user/1000/at-spi/bus", Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Address.State = A11y.Linux.ATSPi_Bus.Address_Valid
         and then Address.Transport = A11y.Linux.ATSPi_Bus.Unix_Transport
         and then Address.Field_Count = 1,
         "Linux AT-SPI bus layer accepts unix D-Bus addresses");
      Check
        (A11y.Linux.ATSPi_Local_Channel.Unix_Path (Address, Result) =
           "/run/user/1000/at-spi/bus"
         and then A11y.Results.Succeeded (Result),
         "Linux AT-SPI local channel adapter extracts unix D-Bus socket paths");
      Address := A11y.Linux.ATSPi_Bus.Parse_Address
        ("unix:guid=abc,path=/tmp/at-spi-bus", Result);
      Check
        (A11y.Linux.ATSPi_Local_Channel.Unix_Path (Address, Result) =
           "/tmp/at-spi-bus"
         and then A11y.Results.Succeeded (Result),
         "Linux AT-SPI local channel adapter extracts non-leading unix path fields");

      Address := A11y.Linux.ATSPi_Bus.Parse_Address
        ("unix:abstract=/tmp/dbus-a11y-test", Result);
      Check
        (A11y.Linux.ATSPi_Local_Channel.Unix_Abstract_Name
           (Address, Result) = "/tmp/dbus-a11y-test"
         and then A11y.Results.Succeeded (Result),
         "Linux AT-SPI local channel adapter extracts unix abstract socket names");

      Address := A11y.Linux.ATSPi_Bus.Parse_Address
        ("unix:guid=abc,abstract=%2Ftmp%2Fdbus-a11y-test", Result);
      Check
        (A11y.Linux.ATSPi_Local_Channel.Unix_Abstract_Name
           (Address, Result) = "/tmp/dbus-a11y-test"
         and then A11y.Results.Succeeded (Result),
         "Linux AT-SPI local channel adapter decodes escaped abstract socket names");

      Address := A11y.Linux.ATSPi_Bus.Parse_Address
        ("unix:path=%2Ftmp%2Fat-spi-bus%20socket", Result);
      Check
        (A11y.Linux.ATSPi_Local_Channel.Unix_Path (Address, Result) =
           "/tmp/at-spi-bus socket"
         and then A11y.Results.Succeeded (Result),
         "Linux AT-SPI local channel adapter decodes escaped unix path fields");

      Address := A11y.Linux.ATSPi_Bus.Parse_Address
        ("unix:path=/tmp/%zz", Result);
      Check
        (A11y.Linux.ATSPi_Local_Channel.Unix_Path (Address, Result) = ""
         and then Result.Status = A11y.Results.Invalid_Argument,
         "Linux AT-SPI local channel adapter rejects malformed path escapes");

      Address := A11y.Linux.ATSPi_Bus.Parse_Address
        ("unix:path=/tmp/%00secret", Result);
      Check
        (A11y.Linux.ATSPi_Local_Channel.Unix_Path (Address, Result) = ""
         and then Result.Status = A11y.Results.Invalid_Argument,
         "Linux AT-SPI local channel adapter rejects NUL path escapes");

      Address := A11y.Linux.ATSPi_Bus.Parse_Address
        ("tcp:host=localhost,port=12345", Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Address.Transport = A11y.Linux.ATSPi_Bus.Tcp_Transport
         and then Address.Field_Count = 2,
         "Linux AT-SPI bus layer accepts multi-field D-Bus addresses");
      Check
        (A11y.Linux.ATSPi_Local_Channel.Unix_Path (Address, Result) = ""
         and then Result.Status = A11y.Results.Unsupported_Capability,
         "Linux AT-SPI local channel adapter rejects non-unix D-Bus transports");

      Check
        (A11y.Linux.ATSPi_Local_Channel.Unix_Abstract_Name
           (Address, Result) = ""
         and then Result.Status = A11y.Results.Unsupported_Capability,
         "Linux AT-SPI local channel adapter rejects abstract names for non-unix transports");

      Address := A11y.Linux.ATSPi_Bus.Parse_Address ("", Result);
      Check
        (Result.Status = A11y.Results.Backend_Unavailable
         and then Address.State = A11y.Linux.ATSPi_Bus.Address_Unavailable,
         "Linux AT-SPI bus layer reports missing bus addresses");

      Address := A11y.Linux.ATSPi_Bus.Parse_Address ("unix:path", Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Address.State = A11y.Linux.ATSPi_Bus.Address_Invalid,
         "Linux AT-SPI bus layer rejects malformed D-Bus addresses");

      declare
         Oversized_Address : constant String
           (1 .. A11y.Linux.ATSPi_Bus.Max_Address_Length + 1) :=
             [others => 'x'];
      begin
         Address :=
           A11y.Linux.ATSPi_Bus.Parse_Address
             (Oversized_Address, Result);
         Check
           (Result.Status = A11y.Results.Resource_Limit
            and then Address.State = A11y.Linux.ATSPi_Bus.Address_Invalid,
            "Linux AT-SPI bus layer rejects oversized D-Bus addresses");
      end;

      declare
         Many_Fields : Unbounded_String := To_Unbounded_String ("unix:k0=v0");
      begin
         for Index in 1 .. A11y.Linux.ATSPi_Bus.Max_Address_Fields loop
            pragma Unreferenced (Index);
            Append
              (Many_Fields,
               ",k=v");
         end loop;
         Address :=
           A11y.Linux.ATSPi_Bus.Parse_Address
             (To_String (Many_Fields), Result);
         Check
           (Result.Status = A11y.Results.Resource_Limit
            and then Address.State = A11y.Linux.ATSPi_Bus.Address_Invalid,
            "Linux AT-SPI bus layer bounds D-Bus address field counts");
      end;

      Check
        (A11y.Linux.ATSPi_Bus.Transport_Name
           (A11y.Linux.ATSPi_Bus.Launchd_Transport) = "launchd",
         "Linux AT-SPI bus layer names known transports");

      declare
         Auth_Command : Unbounded_String;
         Auth_Response : A11y.Linux.DBus_Auth.Auth_Response;
      begin
         Check
           (A11y.Linux.DBus_Auth.Encode_External_User_Id (1000, Result)
              = "31303030"
            and then A11y.Results.Succeeded (Result),
            "Linux D-Bus auth codec hex-encodes EXTERNAL user identifiers");

         Check
