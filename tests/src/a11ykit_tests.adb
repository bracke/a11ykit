   declare
      Session : A11y.Sessions.Semantic_Session;
      Root : A11y.Node_Ids.Node_Id;
      Field : A11y.Node_Ids.Node_Id;
      Label : A11y.Node_Ids.Node_Id;
      Help : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Event : A11y.Events.Event;
      Targets : A11y.Relations.Target_Vectors.Vector;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      A11y.Sessions.Create_Node (Session, null, Root, Result);
      A11y.Sessions.Create_Node (Session, null, Field, Result);
      A11y.Sessions.Create_Node (Session, null, Label, Result);
      A11y.Sessions.Create_Node (Session, null, Help, Result);
      A11y.Sessions.Attach_Root (Session, Root, Result);
      A11y.Sessions.Attach (Session, Root, Field, Result);
      A11y.Sessions.Attach (Session, Root, Label, Result);
      A11y.Sessions.Attach (Session, Root, Help, Result);

      while A11y.Sessions.Pending_Event_Count (Session) > 0 loop
         A11y.Sessions.Dequeue_Event (Session, Event, Result);
      end loop;

      A11y.Sessions.Add_Relation
        (Session, Field, A11y.Relations.Labelled_By, Label, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Field, A11y.Relations.Labelled_By);
      Check
        (A11y.Results.Succeeded (Result)
         and then Natural (Targets.Length) = 1
         and then Targets.First_Element = Label,
         "session owns canonical relation targets");
      Targets := A11y.Sessions.Relation_Targets
        (Session, Label, A11y.Relations.Label_For);
      Check
        (Natural (Targets.Length) = 1 and then Targets.First_Element = Field,
         "session owns inverse relation targets");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Relation_Added
         and then Event.Source = Field,
         "session emits relation-added after committing relation state");
      A11y.Sessions.Add_Relation
        (Session, Field, A11y.Relations.Labelled_By, Label, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Sessions.Pending_Event_Count (Session) = 0,
         "session does not emit relation events for duplicate additions");

      A11y.Sessions.Remove_Relation
        (Session, Field, A11y.Relations.Labelled_By, Label, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Label, A11y.Relations.Label_For);
      Check
        (A11y.Results.Succeeded (Result)
         and then Targets.Is_Empty,
         "session removes inverse relation targets coherently");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Relation_Removed
         and then Event.Source = Field,
         "session emits relation-removed after committing relation state");
      A11y.Sessions.Remove_Relation
        (Session, Field, A11y.Relations.Labelled_By, Label, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Sessions.Pending_Event_Count (Session) = 0,
         "session does not emit relation events for absent removals");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Relation_Targets_Returned,
         1,
         Result);
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      A11y.Sessions.Add_Relation
        (Session, Field, A11y.Relations.Described_By, Label, Result);
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      A11y.Sessions.Add_Relation
        (Session, Field, A11y.Relations.Described_By, Help, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Field, A11y.Relations.Described_By);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Natural (Targets.Length) = 1
         and then Targets.First_Element = Label
         and then A11y.Sessions.Pending_Event_Count (Session) = 0,
         "session rejects relation overflow before partial event emission");

      A11y.Sessions.Destroy (Session, Label, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Field, A11y.Relations.Described_By);
      Check
        (A11y.Results.Succeeded (Result)
         and then Targets.Is_Empty,
         "session removes relation targets for destroyed nodes");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Relation_Targets_Changed
         and then Event.Source = Field,
         "session emits relation-target changes after destroy cleanup");
      A11y.Sessions.Add_Relation
        (Session, Field, A11y.Relations.Described_By, Label, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable,
         "session rejects relations to destroyed nodes");
   end;

   declare
      Session : A11y.Sessions.Semantic_Session;
      Root : A11y.Node_Ids.Node_Id;
      Field : A11y.Node_Ids.Node_Id;
      Label : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Event : A11y.Events.Event;
      Targets : A11y.Relations.Target_Vectors.Vector;
   begin
      A11y.Sessions.Create_Node (Session, null, Root, Result);
      A11y.Sessions.Create_Node (Session, null, Field, Result);
      A11y.Sessions.Create_Node (Session, null, Label, Result);
      A11y.Sessions.Attach_Root (Session, Root, Result);
      A11y.Sessions.Attach (Session, Root, Field, Result);
      A11y.Sessions.Attach (Session, Root, Label, Result);

      while A11y.Sessions.Pending_Event_Count (Session) > 0 loop
         A11y.Sessions.Dequeue_Event (Session, Event, Result);
      end loop;

      A11y.Sessions.Add_Relation
        (Session, Field, A11y.Relations.Labelled_By, Label, Result);
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Field, A11y.Relations.Labelled_By);
      Check
        (Natural (Targets.Length) = 1 and then Targets.First_Element = Label,
         "session exposes relations between attached nodes");

      A11y.Sessions.Detach (Session, Label, Result);
      while A11y.Sessions.Pending_Event_Count (Session) > 0 loop
         A11y.Sessions.Dequeue_Event (Session, Event, Result);
      end loop;
      Targets := A11y.Sessions.Relation_Targets
        (Session, Field, A11y.Relations.Labelled_By);
      Check
        (Targets.Is_Empty,
         "session hides relation targets when target nodes detach");

      A11y.Sessions.Attach (Session, Root, Label, Result);
      while A11y.Sessions.Pending_Event_Count (Session) > 0 loop
         A11y.Sessions.Dequeue_Event (Session, Event, Result);
      end loop;
      Targets := A11y.Sessions.Relation_Targets
        (Session, Field, A11y.Relations.Labelled_By);
      Check
        (Natural (Targets.Length) = 1 and then Targets.First_Element = Label,
         "session restores relation visibility when targets reattach");

      A11y.Sessions.Detach (Session, Field, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Field, A11y.Relations.Labelled_By);
      Check
        (Targets.Is_Empty,
         "session hides relation targets when source nodes detach");
   end;

   declare
      Session : A11y.Sessions.Semantic_Session;
      Root : A11y.Node_Ids.Node_Id;
      Owner : A11y.Node_Ids.Node_Id;
      First : A11y.Node_Ids.Node_Id;
      Second : A11y.Node_Ids.Node_Id;
      Result : A11y.Results.Result;
      Event : A11y.Events.Event;
      Targets : A11y.Relations.Target_Vectors.Vector;
      Limits : A11y.Resource_Limits.Resource_Limit_Config :=
        A11y.Resource_Limits.Default_Config;
   begin
      A11y.Sessions.Create_Node (Session, null, Root, Result);
      A11y.Sessions.Create_Node (Session, null, Owner, Result);
      A11y.Sessions.Create_Node (Session, null, First, Result);
      A11y.Sessions.Create_Node (Session, null, Second, Result);
      A11y.Sessions.Attach_Root (Session, Root, Result);
      A11y.Sessions.Attach (Session, Root, Owner, Result);
      A11y.Sessions.Attach (Session, Owner, First, Result);
      A11y.Sessions.Attach (Session, Owner, Second, Result);

      while A11y.Sessions.Pending_Event_Count (Session) > 0 loop
         A11y.Sessions.Dequeue_Event (Session, Event, Result);
      end loop;

      A11y.Sessions.Add_Relation
        (Session, Owner, A11y.Relations.Active_Descendant, Owner, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Owner, A11y.Relations.Active_Descendant);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Targets.Is_Empty
         and then A11y.Sessions.Pending_Event_Count (Session) = 0,
         "session rejects active-descendant self targets before mutation");

      A11y.Sessions.Add_Relation
        (Session, Owner, A11y.Relations.Active_Descendant, Root, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Owner, A11y.Relations.Active_Descendant);
      Check
        (Result.Status = A11y.Results.Invalid_Argument
         and then Targets.Is_Empty
         and then A11y.Sessions.Pending_Event_Count (Session) = 0,
         "session rejects active-descendant targets outside the source subtree");

      A11y.Sessions.Add_Relation
        (Session, Owner, A11y.Relations.Active_Descendant, First, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Owner, A11y.Relations.Active_Descendant);
      Check
        (A11y.Results.Succeeded (Result)
         and then Natural (Targets.Length) = 1
         and then Targets.First_Element = First,
         "session stores one active-descendant target");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Active_Descendant_Changed
         and then Event.Source = Owner,
         "session emits active-descendant change events");

      A11y.Sessions.Add_Relation
        (Session, Owner, A11y.Relations.Active_Descendant, Second, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Owner, A11y.Relations.Active_Descendant);
      Check
        (A11y.Results.Succeeded (Result)
         and then Natural (Targets.Length) = 1
         and then Targets.First_Element = Second,
         "session replaces active descendants instead of accumulating targets");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Event.Kind = A11y.Events.Active_Descendant_Changed
         and then Event.Source = Owner,
         "session emits active-descendant replacement events");

      A11y.Sessions.Add_Relation
        (Session, Owner, A11y.Relations.Active_Descendant, Second, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then A11y.Sessions.Pending_Event_Count (Session) = 0,
         "session suppresses unchanged active-descendant events");

      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         0,
         Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument,
         "session active-descendant fixture rejects impossible event limits");
      A11y.Resource_Limits.Set_Limit
        (Limits,
         A11y.Resource_Limits.Event_Queue_Size,
         1,
         Result);
      A11y.Sessions.Configure_Limits (Session, Limits, Result);
      A11y.Sessions.Add_Relation
        (Session, Owner, A11y.Relations.Labelled_By, Root, Result);
      A11y.Sessions.Add_Relation
        (Session, Owner, A11y.Relations.Active_Descendant, First, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Owner, A11y.Relations.Active_Descendant);
      Check
        (Result.Status = A11y.Results.Resource_Limit
         and then Natural (Targets.Length) = 1
         and then Targets.First_Element = Second,
         "session rejects active-descendant replacement before partial mutation");
      A11y.Sessions.Dequeue_Event (Session, Event, Result);

      A11y.Sessions.Remove_Relation
        (Session, Owner, A11y.Relations.Active_Descendant, Second, Result);
      Targets := A11y.Sessions.Relation_Targets
        (Session, Owner, A11y.Relations.Active_Descendant);
      Check
        (A11y.Results.Succeeded (Result)
         and then Targets.Is_Empty,
         "session removes active descendants through the relation API");
   end;

