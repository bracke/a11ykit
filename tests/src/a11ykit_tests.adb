   declare
      Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Other_Session : constant A11y.Native_Identity.Backend_Session_Id :=
        A11y.Native_Identity.Create_Session;
      Node : constant A11y.Node_Ids.Node_Id :=
        A11y.Node_Ids.From_Natural (601);
      Result : A11y.Results.Result;
      Path_Result : A11y.Results.Result;
      Path : Unbounded_String;
      Parsed : A11y.Node_Ids.Node_Id;
      Last_Slash : Natural;
   begin
      Path := A11y.Linux.ATSPi_Objects.Object_Path (Session, Node, Path_Result);
      Parsed := A11y.Linux.ATSPi_Objects.Node_From_Object_Path
        (To_String (Path), Session, Result);
      Check
        (A11y.Results.Succeeded (Path_Result)
         and then A11y.Results.Succeeded (Result)
         and then Parsed = Node,
         "Linux AT-SPI object resolver round-trips stable object paths");

      Parsed := A11y.Linux.ATSPi_Objects.Node_From_Object_Path
        (To_String (Path), Other_Session, Result);
      Check
        (Result.Status = A11y.Results.Node_Unavailable
         and then Parsed = A11y.Node_Ids.No_Node,
         "Linux AT-SPI object resolver rejects wrong backend session");

      Parsed := A11y.Linux.ATSPi_Objects.Node_From_Object_Path
        ("/bad/path", Session, Result);
      Check
        (Result.Status = A11y.Results.Invalid_Argument,
         "Linux AT-SPI object resolver rejects malformed paths");

      declare
         Valid_Path : constant String := To_String (Path);
      begin
         Last_Slash := 0;
         for Index in Valid_Path'Range loop
            if Valid_Path (Index) = '/' then
               Last_Slash := Index;
            end if;
         end loop;

         Parsed := A11y.Linux.ATSPi_Objects.Node_From_Object_Path
           (Valid_Path (Valid_Path'First .. Last_Slash)
            & "999999999999999999999999999999999999999999999999",
            Session,
            Result);
         Check
           (Result.Status = A11y.Results.Resource_Limit
            and then Parsed = A11y.Node_Ids.No_Node,
            "Linux AT-SPI object resolver preserves numeric overflow errors");
      end;

      Check
        (A11y.Linux.ATSPi_Objects.Interface_Name
           (A11y.Linux.ATSPi_Objects.Accessible)
         = "org.a11y.atspi.Accessible",
         "Linux AT-SPI object layer names native interfaces");
      Check
        (A11y.Linux.ATSPi_Objects.Error_Name
           (A11y.Results.Unsupported_Action)
         = "org.a11y.atspi.Error.NotSupported",
         "Linux AT-SPI object layer maps structured errors");

      declare
         function Expected (Status : A11y.Results.Status_Code) return String is
           (case Status is
              when A11y.Results.Success |
                   A11y.Results.Accepted_Asynchronous =>
                 "org.a11y.atspi.Success",
              when A11y.Results.Node_Unavailable =>
                 "org.a11y.atspi.Error.NoSuchObject",
              when A11y.Results.Unsupported_Property |
                   A11y.Results.Unsupported_Capability |
                   A11y.Results.Unsupported_Action =>
                 "org.a11y.atspi.Error.NotSupported",
              when A11y.Results.Invalid_Argument |
                   A11y.Results.Invalid_Range =>
                 "org.freedesktop.DBus.Error.InvalidArgs",
              when A11y.Results.Invalid_State =>
                 "org.a11y.atspi.Error.InvalidState",
              when A11y.Results.Read_Only =>
                 "org.a11y.atspi.Error.ReadOnly",
              when A11y.Results.Disabled =>
                 "org.a11y.atspi.Error.Disabled",
              when A11y.Results.Busy =>
                 "org.a11y.atspi.Error.Busy",
              when A11y.Results.Timed_Out =>
                 "org.a11y.atspi.Error.Timeout",
              when A11y.Results.Cancelled =>
                 "org.a11y.atspi.Error.Cancelled",
              when A11y.Results.Shutting_Down =>
                 "org.a11y.atspi.Error.ShuttingDown",
              when A11y.Results.Permission_Denied =>
                 "org.freedesktop.DBus.Error.AccessDenied",
              when A11y.Results.Resource_Limit |
                   A11y.Results.Out_Of_Resources =>
                 "org.a11y.atspi.Error.ResourceLimit",
              when A11y.Results.Backend_Unavailable |
                   A11y.Results.Accessibility_Service_Unavailable =>
                 "org.a11y.atspi.Error.BackendUnavailable",
              when A11y.Results.Protocol_Failure =>
                 "org.a11y.atspi.Error.ProtocolFailure",
              when A11y.Results.Native_Failure =>
                 "org.a11y.atspi.Error.NativeFailure",
              when A11y.Results.Internal_Error =>
                 "org.a11y.atspi.Error.Internal");

         Complete : Boolean := True;
      begin
         for Status in A11y.Results.Status_Code loop
            Complete := Complete
              and then A11y.Linux.ATSPi_Objects.Error_Name (Status)
                = Expected (Status);
         end loop;
         Check
           (Complete,
           "Linux AT-SPI object layer maps every structured status");
      end;

      declare
         function Expected
           (Name : String)
            return A11y.Results.Status_Code is
           (A11y.Linux.ATSPi_Objects.Status_For_Error_Name (Name));
      begin
         Check
           (Expected ("org.a11y.atspi.Success") = A11y.Results.Success
            and then Expected ("org.a11y.atspi.Error.NoSuchObject")
              = A11y.Results.Node_Unavailable
            and then Expected ("org.a11y.atspi.Error.NotSupported")
              = A11y.Results.Unsupported_Capability
            and then Expected ("org.freedesktop.DBus.Error.InvalidArgs")
              = A11y.Results.Invalid_Argument
            and then Expected ("org.a11y.atspi.Error.InvalidState")
              = A11y.Results.Invalid_State
            and then Expected ("org.a11y.atspi.Error.ReadOnly")
              = A11y.Results.Read_Only
            and then Expected ("org.a11y.atspi.Error.Disabled")
              = A11y.Results.Disabled
            and then Expected ("org.a11y.atspi.Error.Busy")
              = A11y.Results.Busy
            and then Expected ("org.a11y.atspi.Error.Timeout")
              = A11y.Results.Timed_Out
            and then Expected ("org.a11y.atspi.Error.Cancelled")
              = A11y.Results.Cancelled
            and then Expected ("org.a11y.atspi.Error.ShuttingDown")
              = A11y.Results.Shutting_Down
            and then Expected ("org.freedesktop.DBus.Error.AccessDenied")
              = A11y.Results.Permission_Denied
            and then Expected ("org.a11y.atspi.Error.ResourceLimit")
              = A11y.Results.Resource_Limit
            and then Expected ("org.a11y.atspi.Error.BackendUnavailable")
              = A11y.Results.Backend_Unavailable
            and then Expected ("org.a11y.atspi.Error.ProtocolFailure")
              = A11y.Results.Protocol_Failure
            and then Expected ("org.a11y.atspi.Error.NativeFailure")
              = A11y.Results.Native_Failure
            and then Expected ("org.a11y.atspi.Error.Internal")
              = A11y.Results.Internal_Error
            and then Expected ("org.example.Unknown")
              = A11y.Results.Protocol_Failure,
            "Linux AT-SPI object layer maps native error names to statuses");
      end;

      declare
         Result : A11y.Results.Result;
         Diagnostic : constant A11y.Diagnostics.Diagnostic :=
           A11y.Linux.ATSPi_Objects.Diagnostic_For_Error_Name
             ("org.a11y.atspi.Error.NoSuchObject", Result);
      begin
         Check
           (A11y.Results.Succeeded (Result)
            and then A11y.Diagnostics.Has_Field
              (Diagnostic, "error_name", "org.a11y.atspi.Error.NoSuchObject")
            and then A11y.Diagnostics.Has_Field
              (Diagnostic, "known", "true")
            and then A11y.Diagnostics.Has_Field
              (Diagnostic, "structured_status", "node-unavailable"),
            "Linux AT-SPI object layer creates error-name diagnostics");
      end;

      declare
         package UIA renames A11y.Windows_Backend.UIA_Provider_Boundary;

         function Expected
           (Status : A11y.Results.Status_Code)
            return UIA.HRESULT_Status is
           (case Status is
              when A11y.Results.Success |
                   A11y.Results.Accepted_Asynchronous =>
                 UIA.S_OK,
              when A11y.Results.Unsupported_Property |
                   A11y.Results.Unsupported_Capability |
                   A11y.Results.Unsupported_Action =>
                 UIA.S_FALSE,
              when A11y.Results.Backend_Unavailable |
                   A11y.Results.Accessibility_Service_Unavailable |
                   A11y.Results.Node_Unavailable |
                   A11y.Results.Shutting_Down =>
                 UIA.UIA_E_ELEMENTNOTAVAILABLE,
              when A11y.Results.Disabled =>
                 UIA.UIA_E_ELEMENTNOTENABLED,
              when A11y.Results.Invalid_Argument |
                   A11y.Results.Invalid_Range =>
                 UIA.E_INVALIDARG,
              when A11y.Results.Permission_Denied =>
                 UIA.E_ACCESSDENIED,
              when A11y.Results.Resource_Limit |
                   A11y.Results.Out_Of_Resources =>
                 UIA.E_OUTOFMEMORY,
              when A11y.Results.Invalid_State |
                   A11y.Results.Read_Only |
                   A11y.Results.Busy |
                   A11y.Results.Timed_Out |
                   A11y.Results.Cancelled =>
                 UIA.UIA_E_INVALIDOPERATION,
              when A11y.Results.Protocol_Failure |
                   A11y.Results.Native_Failure |
                   A11y.Results.Internal_Error =>
                 UIA.E_FAIL);

         Complete : Boolean := True;
      begin
         for Status in A11y.Results.Status_Code loop
            Complete := Complete
              and then UIA.HResult_For (Status) = Expected (Status);
         end loop;

         Check
           (Complete
            and then UIA.HResult_Code (UIA.S_OK) = "0x00000000"
            and then UIA.HResult_Code (UIA.S_FALSE) = "0x00000001"
            and then UIA.HResult_Code (UIA.UIA_E_ELEMENTNOTAVAILABLE)
              = "0x80040201"
            and then UIA.HResult_Code (UIA.UIA_E_ELEMENTNOTENABLED)
              = "0x80040200"
            and then UIA.HResult_Code (UIA.UIA_E_INVALIDOPERATION)
              = "0x80131509"
            and then UIA.HResult_Code (UIA.E_INVALIDARG) = "0x80070057"
            and then UIA.HResult_Code (UIA.E_ACCESSDENIED) = "0x80070005"
            and then UIA.HResult_Code (UIA.E_OUTOFMEMORY) = "0x8007000E"
            and then UIA.HResult_Code (UIA.E_FAIL) = "0x80004005",
            "Windows UIA provider boundary maps every structured status to stable HRESULT codes");
      end;

      declare
         package UIA renames A11y.Windows_Backend.UIA_Provider_Boundary;
      begin
         Check
           (UIA.Status_For_HResult (UIA.S_OK) = A11y.Results.Success
            and then UIA.Status_For_HResult (UIA.S_FALSE)
              = A11y.Results.Unsupported_Capability
            and then UIA.Status_For_HResult (UIA.UIA_E_ELEMENTNOTAVAILABLE)
              = A11y.Results.Node_Unavailable
            and then UIA.Status_For_HResult (UIA.UIA_E_ELEMENTNOTENABLED)
              = A11y.Results.Disabled
            and then UIA.Status_For_HResult (UIA.UIA_E_INVALIDOPERATION)
              = A11y.Results.Invalid_State
            and then UIA.Status_For_HResult (UIA.E_INVALIDARG)
              = A11y.Results.Invalid_Argument
            and then UIA.Status_For_HResult (UIA.E_ACCESSDENIED)
              = A11y.Results.Permission_Denied
            and then UIA.Status_For_HResult (UIA.E_OUTOFMEMORY)
              = A11y.Results.Resource_Limit
            and then UIA.Status_For_HResult (UIA.E_FAIL)
              = A11y.Results.Internal_Error,
            "Windows UIA provider boundary maps HRESULTs to statuses");
      end;

      declare
         package UIA renames A11y.Windows_Backend.UIA_Provider_Boundary;
         Result : A11y.Results.Result;
         Diagnostic : constant A11y.Diagnostics.Diagnostic :=
           UIA.Diagnostic_For_HResult
             (UIA.UIA_E_ELEMENTNOTAVAILABLE, Result);
      begin
         Check
           (A11y.Results.Succeeded (Result)
            and then A11y.Diagnostics.Has_Field
              (Diagnostic, "hresult_code", "0x80040201")
            and then A11y.Diagnostics.Has_Field
              (Diagnostic, "structured_status", "node-unavailable"),
            "Windows UIA provider boundary creates HRESULT diagnostics");
      end;

   end;

