         and then Message.Kind = A11y.Linux.DBus_Messages.Method_Call
         and then Message.Serial = 71
         and then A11y.Linux.DBus_Messages.Queue_Length (Queue) = 2,
         "Linux D-Bus outgoing queue peeks the first message without consuming it");

      A11y.Linux.DBus_Messages.Dequeue (Queue, Message, Result);
      Check
        (A11y.Results.Succeeded (Result)
         and then Message.Serial = 71
         and then A11y.Linux.DBus_Messages.Queue_Length (Queue) = 1,
