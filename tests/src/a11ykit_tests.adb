      A11y.Native_Relation_Calls.Query_Object_Active_Descendant
        (Gate,
         Runtime,
         Dispatcher,
         Object,
         Graph,
         Relation_Result);
      Gate_View := Gate.Snapshot;
      Check
        (Relation_Result.Status = A11y.Results.Invalid_State
