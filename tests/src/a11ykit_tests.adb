   declare
      Gate : A11y.Native_Callbacks.Callback_Gate;
      Runtime : A11y.Native_Runtimes.Native_Runtime;
      Dispatcher : A11y.Dispatchers.Immediate_Dispatcher;
      Graph : A11y.Relations.Relation_Graph;
      Source : constant A11y.Node_Ids.Node_Id :=
