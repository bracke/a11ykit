            and then A11y.Results.Succeeded (Result)
            and then Sender_Envelope.Kind = Envelope.Kind
            and then Sender_Envelope.Serial = Envelope.Serial
            and then Sender_Envelope.Object_Path = Envelope.Object_Path
            and then Sender_Envelope.Interface_Name =
