               "Linux D-Bus message envelope fixture sets relation-target array limit");

            Payload := A11y.Linux.DBus_Messages.Method_Return_Payload_Bytes
              (Outgoing, Tight_Limits, Result);
            Check
              (Result.Status = A11y.Results.Resource_Limit
               and then Length (Payload) = 0,
               "Linux D-Bus message envelope validates relation targets through bounded object-path arrays");
