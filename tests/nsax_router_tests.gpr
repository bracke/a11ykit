with "../a11ykit.gpr";
with "config/a11y_tests_config.gpr";
with "../../hostkit/hostkit.gpr";

project NSAX_Router_Tests is

   --  native_client_nsax drives the shared test fixture, which runs on the
   --  Linux backend, so it is built only there; the router suite needs
   --  nothing but the library and is built everywhere.
   case A11y_Tests_Config.Alire_Host_OS is
      when "macos" =>
         --  The library already carries the macOS backend and its provider.
         for Languages use ("Ada", "C", "Objective-C");
         for Source_Dirs use ("src", "src/platform/macos");
         for Main use ("nsax_router_tests.adb");
      when "linux" =>
         for Languages use ("Ada");
         for Source_Dirs use
            ("src",
             "src/platform/unsupported",
             "../src/platform/macos");
         for Excluded_Source_Files use ("a11ykit-provider.adb");
         for Main use ("nsax_router_tests.adb", "native_client_nsax.adb");
      when others =>
         for Languages use ("Ada");
         for Source_Dirs use
            ("src",
             "src/platform/unsupported",
             "../src/platform/macos");
         for Excluded_Source_Files use ("a11ykit-provider.adb");
         for Main use ("nsax_router_tests.adb");
   end case;
   for Object_Dir use "obj/nsax_router";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnat2022", "-gnatwa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      case A11y_Tests_Config.Alire_Host_OS is
         when "macos" =>
            for Switches ("Ada") use
              ("-framework", "AppKit",
               "-framework", "Foundation",
               "-framework", "ApplicationServices");
         when others =>
            for Switches ("Ada") use ();
      end case;
   end Linker;

end NSAX_Router_Tests;
