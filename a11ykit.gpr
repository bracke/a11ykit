with "config/a11ykit_config.gpr";
project A11ykit is

   for Library_Name use "A11ykit";
   for Library_Version use Project'Library_Name & ".so." & A11ykit_Config.Crate_Version;

   --  The provider body is per-OS: each host talks to its own screen-reader
   --  service (AT-SPI over D-Bus on Linux, UI Automation on Windows, the
   --  NSAccessibility protocol on macOS). The platform-agnostic tree model and
   --  the provider spec live in src/ and are shared.
   case A11ykit_Config.Alire_Host_OS is
      when "windows" =>
         for Source_Dirs use ("src/", "config/", "src/platform/windows");
      when "macos" =>
         for Source_Dirs use ("src/", "config/", "src/platform/macos");
      when "linux" =>
         for Source_Dirs use ("src/", "config/", "src/platform/linux");
      when others =>
         for Source_Dirs use ("src/", "config/", "src/platform/unsupported");
   end case;
   for Object_Dir use "obj/" & A11ykit_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("A11YKIT_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        A11ykit_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end A11ykit;
