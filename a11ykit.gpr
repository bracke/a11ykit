with "config/a11y_config.gpr";
with "hostkit.gpr";
with "messages.gpr";
project A11ykit is

   for Library_Name use "A11ykit";
   for Library_Version use Project'Library_Name & ".so." & A11y_Config.Crate_Version;

   --  The provider body is per-OS: each host talks to its own screen-reader
   --  service (AT-SPI over D-Bus on Linux, UI Automation on Windows, the
   --  NSAccessibility protocol on macOS). The platform-agnostic tree model and
   --  the provider spec live in src/ and are shared.
   case A11y_Config.Alire_Host_OS is
      when "windows" =>
         for Languages use ("Ada", "C");
         for Source_Dirs use
           ("src/",
            "config/",
            "src/platform/windows",
            "native/windows");
      when "macos" =>
         for Languages use ("Ada", "C", "Objective-C");
         for Source_Dirs use
           ("src/",
            "config/",
            "src/platform/macos",
            "native/macos");
      when "linux" =>
         for Languages use ("Ada");
         for Source_Dirs use ("src/", "config/", "src/platform/linux");
      when others =>
         for Languages use ("Ada");
         for Source_Dirs use ("src/", "config/", "src/platform/unsupported");
   end case;
   for Object_Dir use "obj/" & A11y_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("A11YKIT_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Naming is
      --  GPR's Objective-C language does not supply a default body suffix.
      --  Without this mapping the macOS bridge is silently omitted and every
      --  native provider symbol remains unresolved in downstream programs.
      for Body_Suffix ("Objective-C") use ".m";
   end Naming;

   package Compiler is
      for Default_Switches ("Ada") use
        A11y_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
      case A11y_Config.Alire_Host_OS is
         when "macos" =>
            --  Apple's system Clang provides the Objective-C frontend.  An
            --  empty driver makes GPR discover .m sources but silently omit
            --  their object files from the library.
            for Driver ("Objective-C") use "clang";
            for Leading_Required_Switches ("Objective-C") use ("-c");
            for PIC_Option ("Objective-C") use ("-fPIC");
         when others =>
            null;
      end case;
   end Compiler;

   package Linker is
      case A11y_Config.Alire_Host_OS is
         when "windows" =>
            --  The native UIA bridge is part of the library, so consumers
            --  must inherit its COM, Automation, and UIA dependencies.
            for Linker_Options use
              ("-lole32", "-loleaut32", "-luiautomationcore", "-luuid");
         when "macos" =>
            for Linker_Options use
              ("-framework", "AppKit",
               "-framework", "Foundation",
               "-framework", "ApplicationServices");
         when others =>
            null;
      end case;
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end A11ykit;
