with "../a11ykit.gpr";

project A11y_Examples is
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("platform_neutral_provider_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnat2022", "-gnatwa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end A11y_Examples;
